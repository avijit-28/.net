<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="MiniProject.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - TechMart E-Commerce</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Application CSS in Content/ folder -->
    <link href="Content/site.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Top Announcement Bar -->
        <div class="bg-primary text-white py-1 small text-center fw-medium">
            <i class="bi bi-truck me-1"></i> Free Shipping on all orders over $100! 
            <span class="d-none d-sm-inline ms-2">| Use code <strong>TECH10</strong> for extra perks</span>
        </div>

        <!-- Main Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container">
                <a class="brand-logo" href="Default.aspx">
                    <i class="bi bi-cpu-fill"></i>
                    <span>TechMart</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="Default.aspx"><i class="bi bi-grid me-1"></i> Catalog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="Default.aspx?cat=Audio"><i class="bi bi-headphones me-1"></i> Audio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="Default.aspx?cat=Laptops"><i class="bi bi-laptop me-1"></i> Laptops</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="Default.aspx?cat=Gaming"><i class="bi bi-controller me-1"></i> Gaming</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <a href="Cart.aspx" class="btn-cart-nav">
                            <i class="bi bi-cart3"></i>
                            <span>Cart</span>
                            <asp:Label ID="lblCartCount" runat="server" CssClass="badge bg-primary text-white rounded-pill ms-1" Text="0"></asp:Label>
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Body Content -->
        <main class="py-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Trust Badges Section -->
        <section class="container py-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="trust-badge">
                        <div class="trust-icon"><i class="bi bi-box-seam"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark">Free Worldwide Delivery</h6>
                            <p class="small text-muted mb-0">On all eligible orders over $100</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="trust-badge">
                        <div class="trust-icon"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark">30-Day Money Back</h6>
                            <p class="small text-muted mb-0">100% guarantee on all electronics</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="trust-badge">
                        <div class="trust-icon"><i class="bi bi-headset"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark">24/7 Expert Support</h6>
                            <p class="small text-muted mb-0">Dedicated assistance anytime</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer-custom pt-5 pb-4">
            <div class="container">
                <div class="row g-4 mb-4">
                    <div class="col-lg-4 col-md-6">
                        <div class="brand-logo text-white mb-3">
                            <i class="bi bi-cpu-fill text-primary"></i>
                            <span>TechMart</span>
                        </div>
                        <p class="small text-secondary mb-3">
                            Your premier destination for the latest premium technology, audio gear, computing power, and gaming accessories.
                        </p>
                        <div class="d-flex gap-2">
                            <span class="badge bg-secondary p-2"><i class="bi bi-twitter-x"></i></span>
                            <span class="badge bg-secondary p-2"><i class="bi bi-github"></i></span>
                            <span class="badge bg-secondary p-2"><i class="bi bi-linkedin"></i></span>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-6">
                        <h5>Categories</h5>
                        <a href="Default.aspx?cat=Audio" class="footer-link">Audio Gear</a>
                        <a href="Default.aspx?cat=Laptops" class="footer-link">Laptops & PCs</a>
                        <a href="Default.aspx?cat=Gaming" class="footer-link">Gaming Hardware</a>
                        <a href="Default.aspx?cat=Wearables" class="footer-link">Smart Watches</a>
                        <a href="Default.aspx?cat=Accessories" class="footer-link">Accessories</a>
                    </div>

                    <div class="col-lg-2 col-md-6 col-6">
                        <h5>Quick Links</h5>
                        <a href="Default.aspx" class="footer-link">Home Catalog</a>
                        <a href="Cart.aspx" class="footer-link">Shopping Cart</a>
                        <a href="Checkout.aspx" class="footer-link">Checkout</a>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <h5>About This Project</h5>
                        <p class="small text-secondary mb-2">
                            Built with <strong>ASP.NET Web Forms (.NET 4.8)</strong>, C#, Bootstrap 5, Session-based Cart Management, and Server Controls.
                        </p>
                        <div class="alert alert-dark border-secondary py-2 px-3 small text-light">
                            <i class="bi bi-check-circle-fill text-success me-1"></i> Mini Project ready for deployment & demo.
                        </div>
                    </div>
                </div>

                <hr class="border-secondary my-4" />

                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small text-secondary">
                    <div>&copy; <%: DateTime.Now.Year %> TechMart MiniProject. All rights reserved.</div>
                    <div class="mt-2 mt-sm-0">
                        <span>ASP.NET Web Forms Architecture</span>
                    </div>
                </div>
            </div>
        </footer>
    </form>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
