@{
    ViewData["Title"] = "Doctor Management";
}

<div class="container-fluid py-4">
    <!-- Header & Action Row -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light rounded d-flex flex-wrap align-items-center justify-content-between gap-3 p-3">
            <div>
                <h3 class="fw-bold mb-1 text-primary">
                    <i class="bi bi-person-badge"></i> Doctor Management
                </h3>
                <p class="text-muted mb-0 small">Perform Create, Read, Update, and Delete operations using Stored Procedures.</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" onclick="loadDoctors()" title="Refresh List">
                    <span id="refreshSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                    Refresh
                </button>
                <button type="button" class="btn btn-primary" onclick="openAddModal()">
                    + Add New Doctor
                </button>
            </div>
        </div>
    </div>

    <!-- Alert / Toast Banner for Feedback Messages -->
    <div id="alertBox" class="alert alert-dismissible fade d-none mb-3" role="alert">
        <span id="alertMessage"></span>
        <button type="button" class="btn-close" onclick="closeAlert()"></button>
    </div>

    <!-- Search & Summary Bar -->
    <div class="row mb-3 align-items-center">
        <div class="col-md-6 col-lg-4">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted">🔍</span>
                <input type="text" id="searchInput" class="form-control" placeholder="Search doctor by name, spec, email..." onkeyup="filterDoctors()" />
            </div>
        </div>
        <div class="col-md-6 col-lg-8 text-md-end text-muted small mt-2 mt-md-0">
            Total Doctors: <strong id="doctorCount" class="text-dark">0</strong>
        </div>
    </div>

    <!-- Doctors Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="doctorTable">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 80px;">ID</th>
                            <th>Doctor Name</th>
                            <th>Specialization</th>
                            <th>Dept ID</th>
                            <th>Email</th>
                            <th>Phone Number</th>
                            <th class="text-end pe-3" style="min-width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="doctorTableBody">
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading doctors...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal: Add Doctor                                                         -->
<!-- ========================================================================= -->
<div class="modal fade" id="addDoctorModal" tabindex="-1" aria-labelledby="addDoctorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addDoctorModalLabel">Add New Doctor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addDoctorForm" onsubmit="submitAddDoctor(event)">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addFirstName" required maxlength="100" placeholder="e.g. John" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addLastName" required maxlength="100" placeholder="e.g. Doe" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Specialization <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addSpecialization" required maxlength="100" placeholder="e.g. Cardiology, Neurology" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Department ID <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="addDepartmentId" required min="1" placeholder="e.g. 1" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="addPhone" required maxlength="20" placeholder="e.g. +1 555-0199" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="addEmail" required maxlength="100" placeholder="e.g. john.doe@hospital.com" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="addSubmitBtn">Save Doctor</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal: Edit Doctor                                                        -->
<!-- ========================================================================= -->
<div class="modal fade" id="editDoctorModal" tabindex="-1" aria-labelledby="editDoctorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="editDoctorModalLabel">Edit Doctor Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editDoctorForm" onsubmit="submitEditDoctor(event)">
                <input type="hidden" id="editDoctorId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editFirstName" required maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editLastName" required maxlength="100" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Specialization <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editSpecialization" required maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Department ID <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="editDepartmentId" required min="1" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="editPhone" required maxlength="20" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="editEmail" required maxlength="100" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-semibold" id="editSubmitBtn">Update Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal: View Details                                                       -->
<!-- ========================================================================= -->
<div class="modal fade" id="viewDoctorModal" tabindex="-1" aria-labelledby="viewDoctorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="viewDoctorModalLabel">Doctor Profile</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2" style="width: 70px; height: 70px;">
                        <span class="fs-2 text-primary">👨‍⚕️</span>
                    </div>
                    <h4 class="mb-0 fw-bold" id="viewFullName">-</h4>
                    <span class="badge bg-primary text-uppercase" id="viewSpecialization">-</span>
                </div>
                <hr />
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Doctor ID:</span>
                        <strong id="viewDoctorId">-</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Department ID:</span>
                        <strong id="viewDeptId">-</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Email:</span>
                        <span id="viewEmail" class="text-primary">-</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Phone Number:</span>
                        <span id="viewPhone">-</span>
                    </li>
                </ul>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal: Delete Confirmation                                                -->
<!-- ========================================================================= -->
<div class="modal fade" id="deleteDoctorModal" tabindex="-1" aria-labelledby="deleteDoctorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteDoctorModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <span class="fs-1 text-danger">⚠️</span>
                <p class="fs-5 mt-2 mb-1">Are you sure you want to delete this doctor?</p>
                <p class="fw-bold text-dark fs-6" id="deleteDoctorName">-</p>
                <p class="text-muted small mb-0">This operation uses Stored Procedure <code>set_DeleteDoctorDetails</code> and cannot be undone.</p>
                <input type="hidden" id="deleteDoctorId" />
            </div>
            <div class="modal-footer bg-light justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="deleteConfirmBtn" onclick="confirmDeleteDoctor()">Delete Permanently</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let allDoctors = [];
    const apiBase = '/api/DoctorApi';

    document.addEventListener("DOMContentLoaded", function () {
        loadDoctors();
    });

    // Alert helper
    function showAlert(message, type = 'success') {
        const box = document.getElementById('alertBox');
        const text = document.getElementById('alertMessage');
        box.className = `alert alert-${type} alert-dismissible fade show mb-3`;
        text.innerText = message;
        box.classList.remove('d-none');
        setTimeout(() => closeAlert(), 6000);
    }

    function closeAlert() {
        const box = document.getElementById('alertBox');
        box.classList.add('d-none');
    }

    // 1. READ ALL (Stored Procedure: get_AllDoctorDetails)
    async function loadDoctors() {
        const spinner = document.getElementById('refreshSpinner');
        spinner.classList.remove('d-none');

        try {
            const res = await fetch(apiBase);
            const result = await res.json();

            if (result.success) {
                allDoctors = result.data || [];
                renderTable(allDoctors);
            } else {
                showAlert(result.message || 'Failed to load doctors', 'danger');
            }
        } catch (err) {
            showAlert('Error connecting to API: ' + err.message, 'danger');
        } finally {
            spinner.classList.add('d-none');
        }
    }

    // Render table
    function renderTable(list) {
        const tbody = document.getElementById('doctorTableBody');
        const countSpan = document.getElementById('doctorCount');
        countSpan.innerText = list.length;

        if (list.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">No doctors found in the database.</td></tr>`;
            return;
        }

        let html = '';
        list.forEach(doc => {
            html += `
                <tr>
                    <td class="ps-3"><span class="badge bg-light text-dark border">#${doc.doctorId}</span></td>
                    <td class="fw-bold">${escapeHtml(doc.firstName)} ${escapeHtml(doc.lastName)}</td>
                    <td><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">${escapeHtml(doc.specialization)}</span></td>
                    <td><span class="badge bg-secondary-subtle text-secondary-emphasis">Dept ${doc.departmentId}</span></td>
                    <td><a href="mailto:${escapeHtml(doc.email)}" class="text-decoration-none">${escapeHtml(doc.email)}</a></td>
                    <td>${escapeHtml(doc.phoneNumber)}</td>
                    <td class="text-end pe-3">
                        <button class="btn btn-sm btn-outline-info me-1" onclick="openViewModal(${doc.doctorId})" title="View Details">👁️</button>
                        <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(${doc.doctorId})" title="Edit">✏️</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(${doc.doctorId}, '${escapeHtml(doc.firstName)} ${escapeHtml(doc.lastName)}')" title="Delete">🗑️</button>
                    </td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
    }

    // Client-side search filter
    function filterDoctors() {
        const term = document.getElementById('searchInput').value.toLowerCase().trim();
        if (!term) {
            renderTable(allDoctors);
            return;
        }
        const filtered = allDoctors.filter(d => 
            d.firstName.toLowerCase().includes(term) ||
            d.lastName.toLowerCase().includes(term) ||
            d.specialization.toLowerCase().includes(term) ||
            d.email.toLowerCase().includes(term) ||
            d.phoneNumber.toLowerCase().includes(term) ||
            d.departmentId.toString().includes(term)
        );
        renderTable(filtered);
    }

    // 2. CREATE (Stored Procedure: set_InsertDoctorDetails)
    function openAddModal() {
        document.getElementById('addDoctorForm').reset();
        const modal = new bootstrap.Modal(document.getElementById('addDoctorModal'));
        modal.show();
    }

    async function submitAddDoctor(e) {
        e.preventDefault();
        const btn = document.getElementById('addSubmitBtn');
        btn.disabled = true;
        btn.innerText = 'Saving...';

        const doctor = {
            firstName: document.getElementById('addFirstName').value.trim(),
            lastName: document.getElementById('addLastName').value.trim(),
            specialization: document.getElementById('addSpecialization').value.trim(),
            departmentId: parseInt(document.getElementById('addDepartmentId').value),
            email: document.getElementById('addEmail').value.trim(),
            phoneNumber: document.getElementById('addPhone').value.trim()
        };

        try {
            const res = await fetch(apiBase, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(doctor)
            });
            const data = await res.json();
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('addDoctorModal')).hide();
                showAlert(data.message, 'success');
                await loadDoctors();
            } else {
                showAlert(data.message || 'Failed to add doctor', 'danger');
            }
        } catch (err) {
            showAlert('Error: ' + err.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.innerText = 'Save Doctor';
        }
    }

    // 3. READ BY ID (Stored Procedure: get_DoctorDetails) & EDIT
    async function openViewModal(id) {
        try {
            const res = await fetch(`${apiBase}/${id}`);
            const result = await res.json();
            if (result.success && result.data) {
                const doc = result.data;
                document.getElementById('viewFullName').innerText = `${doc.firstName} ${doc.lastName}`;
                document.getElementById('viewSpecialization').innerText = doc.specialization;
                document.getElementById('viewDoctorId').innerText = doc.doctorId;
                document.getElementById('viewDeptId').innerText = doc.departmentId;
                document.getElementById('viewEmail').innerText = doc.email;
                document.getElementById('viewPhone').innerText = doc.phoneNumber;

                const modal = new bootstrap.Modal(document.getElementById('viewDoctorModal'));
                modal.show();
            } else {
                showAlert(result.message || 'Doctor not found', 'danger');
            }
        } catch (err) {
            showAlert('Error: ' + err.message, 'danger');
        }
    }

    async function openEditModal(id) {
        try {
            const res = await fetch(`${apiBase}/${id}`);
            const result = await res.json();
            if (result.success && result.data) {
                const doc = result.data;
                document.getElementById('editDoctorId').value = doc.doctorId;
                document.getElementById('editFirstName').value = doc.firstName;
                document.getElementById('editLastName').value = doc.lastName;
                document.getElementById('editSpecialization').value = doc.specialization;
                document.getElementById('editDepartmentId').value = doc.departmentId;
                document.getElementById('editEmail').value = doc.email;
                document.getElementById('editPhone').value = doc.phoneNumber;

                const modal = new bootstrap.Modal(document.getElementById('editDoctorModal'));
                modal.show();
            } else {
                showAlert(result.message || 'Could not fetch doctor details', 'danger');
            }
        } catch (err) {
            showAlert('Error: ' + err.message, 'danger');
        }
    }

    // 4. UPDATE (Stored Procedure: UpdateDoctorDetails)
    async function submitEditDoctor(e) {
        e.preventDefault();
        const btn = document.getElementById('editSubmitBtn');
        btn.disabled = true;
        btn.innerText = 'Updating...';

        const id = document.getElementById('editDoctorId').value;
        const doctor = {
            doctorId: parseInt(id),
            firstName: document.getElementById('editFirstName').value.trim(),
            lastName: document.getElementById('editLastName').value.trim(),
            specialization: document.getElementById('editSpecialization').value.trim(),
            departmentId: parseInt(document.getElementById('editDepartmentId').value),
            email: document.getElementById('editEmail').value.trim(),
            phoneNumber: document.getElementById('editPhone').value.trim()
        };

        try {
            const res = await fetch(`${apiBase}/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(doctor)
            });
            const data = await res.json();
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('editDoctorModal')).hide();
                showAlert(data.message, 'success');
                await loadDoctors();
            } else {
                showAlert(data.message || 'Failed to update doctor', 'danger');
            }
        } catch (err) {
            showAlert('Error: ' + err.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.innerText = 'Update Changes';
        }
    }

    // 5. DELETE (Stored Procedure: set_DeleteDoctorDetails)
    function openDeleteModal(id, name) {
        document.getElementById('deleteDoctorId').value = id;
        document.getElementById('deleteDoctorName').innerText = `Dr. ${name} (ID: ${id})`;
        const modal = new bootstrap.Modal(document.getElementById('deleteDoctorModal'));
        modal.show();
    }

    async function confirmDeleteDoctor() {
        const btn = document.getElementById('deleteConfirmBtn');
        const id = document.getElementById('deleteDoctorId').value;
        btn.disabled = true;
        btn.innerText = 'Deleting...';

        try {
            const res = await fetch(`${apiBase}/${id}`, {
                method: 'DELETE'
            });
            const data = await res.json();
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('deleteDoctorModal')).hide();
                showAlert(data.message, 'success');
                await loadDoctors();
            } else {
                showAlert(data.message || 'Failed to delete doctor', 'danger');
            }
        } catch (err) {
            showAlert('Error: ' + err.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.innerText = 'Delete Permanently';
        }
    }

    function escapeHtml(text) {
        if (!text) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }
</script>
}
