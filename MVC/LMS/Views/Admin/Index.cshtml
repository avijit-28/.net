@model LMS.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "Admin Control Center";
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Enterprise Administration
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Admin Operations Control Center</h2>
            <p class="text-muted small mb-0">Platform telemetry, operational analytics, user directory, and course governance</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-dark rounded-pill px-3 fw-semibold">
                <i class="bi bi-people me-1"></i> Users Directory
            </a>
            <a href="@Url.Action("Courses", "Admin")" class="btn btn-outline-primary rounded-pill px-3 fw-semibold">
                <i class="bi bi-journal-text me-1"></i> Course Governance
            </a>
            <a href="@Url.Action("CreateAnnouncement", "Admin")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-megaphone me-1"></i> Post Bulletin
            </a>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover" style="border-left: 4px solid #4f46e5;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Gross Platform Sales</span>
                        <h3 class="fw-extrabold text-dark mt-2 mb-0"><span class="rupee-symbol">₹</span>@Model.TotalRevenue.ToString("N2")</h3>
                        <small class="text-success"><i class="bi bi-graph-up-arrow me-1"></i>All-time revenue</small>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle shadow-xs">
                        <i class="bi bi-currency-rupee fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover" style="border-left: 4px solid #10b981;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Total Enrollments</span>
                        <h3 class="fw-extrabold text-dark mt-2 mb-0">@Model.TotalEnrollments</h3>
                        <small class="text-muted">Across all tracks</small>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle shadow-xs">
                        <i class="bi bi-mortarboard-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover" style="border-left: 4px solid #06b6d4;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Active Learners</span>
                        <h3 class="fw-extrabold text-dark mt-2 mb-0">@Model.TotalStudents</h3>
                        <small class="text-info fw-semibold">@Model.TotalInstructors Instructors</small>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle shadow-xs">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover" style="border-left: 4px solid #f59e0b;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Course Catalog</span>
                        <h3 class="fw-extrabold text-dark mt-2 mb-0">@Model.PublishedCourses / @Model.TotalCourses</h3>
                        <small class="text-muted">Published / Total Catalog</small>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle shadow-xs">
                        <i class="bi bi-journal-check fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Bar -->
    <div class="card card-custom shadow-sm mb-4 bg-white">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 justify-content-between text-center">
                <a href="@Url.Action("Users", "Admin")" class="btn btn-light flex-grow-1 border card-hover p-2">
                    <i class="bi bi-people text-primary fs-5 d-block mb-1"></i>
                    <span class="small fw-bold">Users Directory</span>
                </a>
                <a href="@Url.Action("Categories", "Admin")" class="btn btn-light flex-grow-1 border card-hover p-2">
                    <i class="bi bi-tags text-success fs-5 d-block mb-1"></i>
                    <span class="small fw-bold">Categories (@Model.TotalCategories)</span>
                </a>
                <a href="@Url.Action("Courses", "Admin")" class="btn btn-light flex-grow-1 border card-hover p-2">
                    <i class="bi bi-journal-richtext text-warning fs-5 d-block mb-1"></i>
                    <span class="small fw-bold">Course Catalog</span>
                </a>
                <a href="@Url.Action("Enrollments", "Admin")" class="btn btn-light flex-grow-1 border card-hover p-2">
                    <i class="bi bi-person-check text-info fs-5 d-block mb-1"></i>
                    <span class="small fw-bold">Enrollments</span>
                </a>
                <a href="@Url.Action("Payments", "Admin")" class="btn btn-light flex-grow-1 border card-hover p-2">
                    <i class="bi bi-credit-card text-danger fs-5 d-block mb-1"></i>
                    <span class="small fw-bold">Transactions</span>
                </a>
                <a href="@Url.Action("Announcements", "Admin")" class="btn btn-light flex-grow-1 border card-hover p-2">
                    <i class="bi bi-megaphone text-secondary fs-5 d-block mb-1"></i>
                    <span class="small fw-bold">Bulletins</span>
                </a>
                <a href="@Url.Action("Reports", "Admin")" class="btn btn-light flex-grow-1 border card-hover p-2">
                    <i class="bi bi-graph-up-arrow text-dark fs-5 d-block mb-1"></i>
                    <span class="small fw-bold">Reports</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Tables Split -->
    <div class="row g-4 mb-4">
        <!-- Recent Enrollments -->
        <div class="col-lg-6">
            <div class="card card-custom shadow-sm h-100 bg-white">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-mortarboard me-2 text-primary"></i>Recent Enrollments</h5>
                    <a href="@Url.Action("Enrollments", "Admin")" class="small text-primary text-decoration-none fw-semibold">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Student</th>
                                <th>Course</th>
                                <th>Enrolled Date</th>
                                <th>Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentEnrollments.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No enrollments recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var e in Model.RecentEnrollments)
                                {
                                    <tr>
                                        <td>
                                            <span class="font-monospace small">@e.StudentId</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-truncate text-dark" style="max-width: 200px;">
                                                @(e.Course != null ? e.Course.Title : "Course #" + e.CourseId)
                                            </div>
                                        </td>
                                        <td><small class="text-muted">@e.EnrollmentDate.ToString("MMM dd, yyyy")</small></td>
                                        <td>
                                            <span class="badge @(e.Status == "Completed" ? "bg-success" : "bg-primary") rounded-pill">
                                                @e.ProgressPercentage%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Payments -->
        <div class="col-lg-6">
            <div class="card card-custom shadow-sm h-100 bg-white">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-credit-card me-2 text-success"></i>Recent Transactions</h5>
                    <a href="@Url.Action("Payments", "Admin")" class="small text-primary text-decoration-none fw-semibold">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Txn Ref</th>
                                <th>Course</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentPayments.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No transactions recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var p in Model.RecentPayments)
                                {
                                    <tr>
                                        <td><code class="small text-dark font-monospace">@(p.TransactionId ?? "TXN-" + p.PaymentId)</code></td>
                                        <td>
                                            <div class="fw-semibold text-truncate text-dark" style="max-width: 180px;">
                                                @(p.Course != null ? p.Course.Title : "Course #" + p.CourseId)
                                            </div>
                                        </td>
                                        <td class="fw-bold text-success"><span class="rupee-symbol">₹</span>@p.Amount.ToString("N2")</td>
                                        <td>
                                            <span class="badge @(p.PaymentStatus == "Completed" ? "bg-success" : "bg-secondary") rounded-pill">@p.PaymentStatus</span>
                                        </td>
                                        <td><small class="text-muted">@p.PaymentDate.ToString("MMM dd")</small></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Distribution & Recent Users Split -->
    <div class="row g-4">
        <!-- Category Stats -->
        <div class="col-lg-5">
            <div class="card card-custom shadow-sm h-100 bg-white">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart me-2 text-info"></i>Courses by Category</h5>
                    <a href="@Url.Action("Categories", "Admin")" class="small text-primary text-decoration-none fw-semibold">Manage</a>
                </div>
                <div class="card-body p-4">
                    @if (!Model.CategoryStats.Any())
                    {
                        <p class="text-muted text-center py-3">No categories defined yet.</p>
                    }
                    else
                    {
                        foreach (var cat in Model.CategoryStats)
                        {
                            var pct = Model.TotalCourses > 0 ? (int)((double)cat.CourseCount / Model.TotalCourses * 100) : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small fw-bold mb-1">
                                    <span class="text-dark">@cat.CategoryName</span>
                                    <span class="text-muted">@cat.CourseCount courses (@pct%)</span>
                                </div>
                                <div class="progress" style="height: 7px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @pct%;"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Recent Registered Users -->
        <div class="col-lg-7">
            <div class="card card-custom shadow-sm h-100 bg-white">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-people me-2 text-warning"></i>Recently Registered Users</h5>
                    <a href="@Url.Action("Users", "Admin")" class="small text-primary text-decoration-none fw-semibold">Full Directory</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Joined Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentUsers.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No users registered yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var u in Model.RecentUsers)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@u.FullName</div>
                                        </td>
                                        <td><span class="small text-secondary">@u.Email</span></td>
                                        <td><small class="text-muted">@u.CreatedDate.ToString("MMM dd, yyyy")</small></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
