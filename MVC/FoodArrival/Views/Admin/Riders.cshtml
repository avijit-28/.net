@model List<FoodArrival.Models.Rider>
@{
    ViewBag.Title = "Rider Fleet Tracking - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var affiliations = ViewBag.Affiliations as List<FoodArrival.Models.RiderAffiliation> ?? new List<FoodArrival.Models.RiderAffiliation>();
}

<div class="container-fluid py-4 px-lg-5">
    <div class="row g-4">
        <!-- Admin Left Sidebar -->
        <div class="col-lg-2 col-md-3">
            <div class="admin-sidebar sticky-top" style="top: 85px;">
                <div class="d-flex align-items-center gap-2 mb-4 px-2">
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1"><i class="bi bi-shield-lock-fill me-1"></i> Admin Panel</span>
                </div>
                <div class="nav flex-column gap-1">
                    <a href="@Url.Action("Dashboard", "Admin")" class="admin-nav-item">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("Approvals", "Admin")" class="admin-nav-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Approvals</span>
                    </a>
                    <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })" class="admin-nav-item">
                        <i class="bi bi-card-checklist"></i>
                        <span>Orders</span>
                    </a>
                    <a href="@Url.Action("FoodItems", "Admin")" class="admin-nav-item">
                        <i class="bi bi-egg-fried"></i>
                        <span>Food Menu</span>
                    </a>
                    <a href="@Url.Action("Riders", "Admin")" class="admin-nav-item active">
                        <i class="bi bi-bicycle"></i>
                        <span>Rider Fleet</span>
                    </a>
                    <a href="@Url.Action("Transactions", "Admin")" class="admin-nav-item">
                        <i class="bi bi-cash-stack"></i>
                        <span>Transactions</span>
                    </a>
                    <a href="@Url.Action("Bulletins", "Admin")" class="admin-nav-item">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>Bulletins</span>
                    </a>
                    <hr class="border-secondary my-3" />
                    <a href="@Url.Action("Logout", "Admin")" class="admin-nav-item text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-10 col-md-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h2 class="fw-bold mb-0">Delivery Fleet Tracking</h2>
                    <p class="text-muted small mb-0">Monitor active delivery agents, real-time dispatch status, vehicle types, and multi-restaurant affiliations</p>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                        <i class="bi bi-check-circle-fill me-1"></i> Available: @Model.Count(r => r.CurrentStatus == "Available")
                    </span>
                    <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2">
                        <i class="bi bi-scooter me-1"></i> On Delivery: @Model.Count(r => r.CurrentStatus == "On Delivery")
                    </span>
                </div>
            </div>

            <!-- Fleet Table -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Registered Delivery Agents (@Model.Count)</h6>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0 custom-table">
                        <thead>
                            <tr>
                                <th>Rider</th>
                                <th>Vehicle Type</th>
                                <th>Driving License</th>
                                <th>Live Status</th>
                                <th>Partnered Restaurants</th>
                                <th>Contact</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var rider in Model)
                                {
                                    var riderAffs = affiliations.Where(a => a.RiderId == rider.RiderId).ToList();
                                    string statusBadge = "bg-secondary";
                                    if (rider.CurrentStatus == "Available") { statusBadge = "bg-success"; }
                                    else if (rider.CurrentStatus == "On Delivery") { statusBadge = "bg-primary"; }

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white bg-dark" style="width: 40px; height: 40px;">
                                                    @(string.IsNullOrEmpty(rider.RiderName) ? "R" : rider.RiderName.Substring(0, 1))
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@rider.RiderName</div>
                                                    <div class="small text-muted">@@@rider.Username</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @if (rider.VehicleType.Contains("Bike") || rider.VehicleType.Contains("Motorcycle"))
                                                {
                                                    <i class="bi bi-motorcycle text-warning me-1"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-bicycle text-success me-1"></i>
                                                }
                                                @rider.VehicleType
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(rider.LicenseNumber))
                                            {
                                                <div class="fw-bold text-dark small">@rider.LicenseNumber</div>
                                                if (!string.IsNullOrEmpty(rider.LicenseDocumentUrl))
                                                {
                                                    <a href="@rider.LicenseDocumentUrl" target="_blank" class="small text-primary text-decoration-underline">
                                                        <i class="bi bi-file-earmark-arrow-down me-1"></i> License Document
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">N/A (Bicycle)</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @statusBadge px-2 py-1">
                                                <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> @rider.CurrentStatus
                                            </span>
                                        </td>
                                        <td>
                                            @if (riderAffs.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var aff in riderAffs)
                                                    {
                                                        if (aff.IsVerified)
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success small" title="Verified partner">
                                                                <i class="bi bi-check-circle me-1"></i> @aff.RestaurantName
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning border border-warning small" title="Pending verification">
                                                                <i class="bi bi-hourglass-split me-1"></i> @aff.RestaurantName
                                                            </span>
                                                        }
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">None linked</span>
                                            }
                                        </td>
                                        <td>
                                            <div><i class="bi bi-telephone text-muted me-1"></i> @rider.PhoneNumber</div>
                                            <div class="small text-muted"><i class="bi bi-envelope text-muted me-1"></i> @rider.Email</div>
                                        </td>
                                        <td class="text-end">
                                            @using (Html.BeginForm("ResetUserPassword", "Admin", FormMethod.Post, new { onsubmit = "return confirm('Reset this rider\\'s password to a secure temporary password?');", @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="role" value="Rider" />
                                                <input type="hidden" name="id" value="@rider.RiderId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1" title="Reset rider password securely" style="font-size: 0.75rem;">
                                                    <i class="bi bi-key-fill me-1"></i> Reset Password
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">No riders enrolled in the fleet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
