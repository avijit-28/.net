@model LMS.ViewModels.CourseDetailViewModel
@{
    ViewBag.Title = Model.Course.Title + " - Course Curriculum";
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Courses")" class="text-decoration-none">Courses</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Course.Title</li>
        </ol>
    </nav>

    <!-- Course Header Hero Banner -->
    <div class="card card-custom p-4 p-md-5 mb-4 shadow-sm bg-white position-relative overflow-hidden card-gradient-top">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <span class="badge badge-primary-subtle fw-semibold px-3 py-1 rounded-pill">
                        <i class="bi bi-tag-fill me-1"></i> @(Model.Course.Category?.CategoryName ?? "General")
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill">
                        @Model.Course.Level Level
                    </span>
                    <div class="rating-stars small ms-2 d-flex align-items-center gap-1">
                        <i class="bi bi-star-fill text-warning"></i>
                        <span class="fw-bold text-dark">@Model.AverageRating.ToString("0.0")</span>
                        <span class="text-muted">(@Model.TotalReviews reviews)</span>
                    </div>
                </div>

                <h1 class="fw-extrabold display-6 mb-3 tracking-tight">@Model.Course.Title</h1>
                <p class="lead text-secondary mb-4" style="line-height: 1.6;">
                    @(string.IsNullOrEmpty(Model.Course.Description) ? "Master these essential competencies through progressive modules and project assessments." : Model.Course.Description)
                </p>

                <div class="d-flex flex-wrap gap-4 text-secondary small mb-3">
                    <div><i class="bi bi-clock-history me-1 text-primary fs-6"></i> <strong>@Model.Course.DurationInHours</strong> Hours On-Demand</div>
                    <div><i class="bi bi-people-fill me-1 text-primary fs-6"></i> <strong>@Model.Course.TotalStudents</strong> Enrolled Learners</div>
                    <div><i class="bi bi-award-fill me-1 text-warning fs-6"></i> Official Verifiable Certificate</div>
                    <div><i class="bi bi-phone-fill me-1 text-success fs-6"></i> Accessible on Mobile & Desktop</div>
                </div>

                <div class="d-flex align-items-center gap-2 pt-2 border-top">
                    <span class="small text-muted">Lead Instructor:</span>
                    <strong class="text-dark">@(Model.Instructor?.FullName ?? Model.Instructor?.UserName ?? "Faculty Instructor")</strong>
                    <span class="badge bg-success-subtle text-success small py-0 px-2 rounded-pill"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>
                </div>
            </div>

            <!-- Enrollment / Pricing Card -->
            <div class="col-lg-4">
                <div class="card card-custom p-4 border shadow-sm text-center bg-light">
                    <div class="mb-3">
                        @if (Model.Course.Price == 0)
                        {
                            <span class="display-6 fw-extrabold text-success">FREE</span>
                            <div class="small text-muted mt-1">Full curriculum access included</div>
                        }
                        else
                        {
                            <span class="display-6 fw-extrabold text-dark"><span class="rupee-symbol">&#8377;</span>@Model.Course.Price.ToString("N2")</span>
                            <div class="small text-muted mt-1">One-time payment &bull; @(Model.Course.ValidityInDays > 0 ? Model.Course.ValidityInDays + " Days Access" : "Lifetime Access")</div>
                        }
                    </div>

                    @if (Model.IsEnrolled)
                    {
                        if (Model.Enrollment.IsExpired && Model.Enrollment.Status != "Completed")
                        {
                            <div class="badge bg-danger-subtle text-danger p-2 mb-2 w-100 rounded-3">
                                <i class="bi bi-clock-history me-1"></i> Course Validity Expired (@Model.Course.ValidityInDays Days)
                            </div>
                            <p class="small text-muted mb-3">Your course access period has ended. Please re-enroll to resume lessons and complete your certification.</p>
                            <a href="@Url.Action("Payment", "Courses", new { courseId = Model.Course.CourseId })" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-2">
                                <i class="bi bi-arrow-repeat me-1"></i> Re-Enroll in Course
                            </a>
                        }
                        else if (Model.Enrollment.Status == "Completed")
                        {
                            <div class="badge bg-success-subtle text-success p-2 mb-3 w-100 rounded-3">
                                <i class="bi bi-check-circle-fill me-1"></i> Course Curriculum Completed (100%)
                            </div>
                            <a href="@Url.Action("Certificates", "Student")" class="btn btn-primary w-100 py-2 rounded-pill fw-bold mb-2 shadow-sm text-white">
                                <i class="bi bi-award-fill me-1"></i> View Earned Certificate
                            </a>
                            <a href="@Url.Action("Index", "Learning", new { courseId = Model.Course.CourseId })" class="btn btn-outline-primary w-100 py-2 rounded-pill fw-semibold">
                                Revisit Classroom
                            </a>
                        }
                        else
                        {
                            <div class="badge bg-primary-subtle text-primary p-2 mb-3 w-100 rounded-3">
                                <i class="bi bi-hourglass-split me-1"></i> Enrolled: @Model.Enrollment.CompletionPercentage% &bull; @Model.Enrollment.DaysRemaining days left
                            </div>
                            <a href="@Url.Action("Index", "Learning", new { courseId = Model.Course.CourseId })" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-2">
                                <i class="bi bi-play-circle-fill me-1"></i> Continue Learning Now
                            </a>
                        }
                    }
                    else
                    {
                        if (Model.Course.Price == 0)
                        {
                            using (Html.BeginForm("Enroll", "Courses", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="courseId" value="@Model.Course.CourseId" />
                                <button type="submit" class="btn btn-success w-100 py-3 rounded-pill fw-bold shadow-sm mb-2">
                                    <i class="bi bi-lightning-charge-fill me-1"></i> Enroll Free Now
                                </button>
                            }
                        }
                        else
                        {
                            <a href="@Url.Action("Payment", "Courses", new { courseId = Model.Course.CourseId })" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-2">
                                <i class="bi bi-credit-card-fill me-1"></i> Buy Course & Start Learning
                            </a>
                        }
                        <small class="text-secondary d-block mt-2" style="font-size: 11px;">
                            <i class="bi bi-shield-check text-success me-1"></i> Instant access & official verifiable credential
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Curriculum and Reviews Row -->
    <div class="row g-4">
        <!-- Curriculum Accordion -->
        <div class="col-lg-8">
            <div class="card card-custom curriculum-section p-4 shadow-sm mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <div>
                        <h4 class="fw-bold mb-0"><i class="bi bi-collection-play me-2 text-primary"></i> Course Curriculum</h4>
                        <span class="small text-muted">@Model.Modules.Count Modules &bull; @Model.Modules.Sum(m => m.Lessons.Count) Total Lessons</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="toggleAllModulesBtn">
                        Toggle All Modules
                    </button>
                </div>

                @if (!Model.Modules.Any())
                {
                    <p class="text-muted small py-3">Curriculum syllabus is currently being organized by the instructor.</p>
                }
                else
                {
                    <div class="accordion accordion-flush border rounded-3 overflow-hidden" id="curriculumAccordion">
                        @for (int i = 0; i < Model.Modules.Count; i++)
                        {
                            var module = Model.Modules[i];
                            var moduleTasks = Model.Assignments != null ? Model.Assignments.Where(a => a.ModuleId == module.ModuleId).ToList() : new List<LMS.Models.Assignment>();
                            var moduleQuizzes = Model.ModuleQuizzes != null ? Model.ModuleQuizzes.Where(q => q.ModuleId == module.ModuleId || (q.LessonId.HasValue && module.Lessons.Any(l => l.LessonId == q.LessonId.Value))).ToList() : new List<LMS.Models.Quiz>();
                            int totalModuleItems = module.Lessons.Count + moduleTasks.Count + moduleQuizzes.Count;

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-@module.ModuleId">
                                    <button class="accordion-button @(i > 0 ? "collapsed" : "") bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@module.ModuleId" aria-expanded="@(i == 0 ? "true" : "false")">
                                        <div class="d-flex justify-content-between align-items-center w-100 pe-3">
                                            <strong class="text-dark">Module @(i + 1): @module.ModuleName</strong>
                                            <span class="badge bg-secondary-subtle text-secondary small">@totalModuleItems items</span>
                                        </div>
                                    </button>
                                </h2>
                                <div id="collapse-@module.ModuleId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="heading-@module.ModuleId" data-bs-parent="#curriculumAccordion">
                                    <div class="accordion-body p-0">
                                        <ul class="list-group list-group-flush small">
                                            <!-- Module Lessons -->
                                            @foreach (var lesson in module.Lessons)
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (lesson.LessonType == "Video")
                                                        {
                                                            <i class="bi bi-play-circle-fill text-primary fs-5"></i>
                                                        }
                                                        else if (lesson.LessonType == "Quiz")
                                                        {
                                                            <i class="bi bi-patch-question-fill text-warning fs-5"></i>
                                                        }
                                                        else if (lesson.LessonType == "Assignment")
                                                        {
                                                            <i class="bi bi-file-earmark-code-fill text-info fs-5"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-file-earmark-richtext-fill text-secondary fs-5"></i>
                                                        }
                                                        @if (Model.IsEnrolled && (!Model.Enrollment.IsExpired || Model.Enrollment.Status == "Completed"))
                                                        {
                                                            <a href="@Url.Action("Index", "Learning", new { courseId = Model.Course.CourseId, lessonId = lesson.LessonId })" class="fw-semibold text-dark text-decoration-none chapter-direct-link" title="Open lesson in classroom">
                                                                @lesson.Title <span class="badge bg-primary-subtle text-primary small ms-2"><i class="bi bi-box-arrow-in-right me-1"></i>Open &rarr;</span>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="javascript:void(0);" class="fw-semibold text-dark text-decoration-none btn-trigger-enroll" data-chapter-title="@lesson.Title" title="Click to enroll and unlock this lesson">
                                                                @lesson.Title
                                                            </a>
                                                            if (lesson.IsPreview)
                                                            {
                                                                <button type="button" class="btn btn-xs btn-outline-success rounded-pill px-2 py-0 fw-bold btn-free-preview ms-2 shadow-xs" 
                                                                        data-lesson-id="@lesson.LessonId"
                                                                        data-title="@lesson.Title"
                                                                        data-duration="@lesson.DurationInMinutes"
                                                                        title="Watch free preview lecture">
                                                                    <i class="bi bi-play-circle-fill me-1"></i> Free Preview
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-light text-muted border small ms-2"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                                                            }
                                                        }
                                                    </div>
                                                    <span class="text-muted"><i class="bi bi-clock me-1"></i> @lesson.DurationInMinutes min</span>
                                                </li>
                                            }

                                            <!-- Module Tasks -->
                                            @foreach (var task in moduleTasks)
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-info-subtle bg-opacity-10">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-file-earmark-code-fill text-info fs-5"></i>
                                                        @if (Model.IsEnrolled && (!Model.Enrollment.IsExpired || Model.Enrollment.Status == "Completed"))
                                                        {
                                                            <a href="@Url.Action("Details", "Assignment", new { id = task.AssignmentId })" class="fw-semibold text-dark text-decoration-none chapter-direct-link" title="Open task workspace">
                                                                <span class="badge bg-info-subtle text-info me-1 py-0 px-1" style="font-size: 9px;">TASK</span> @task.Title <span class="badge bg-info-subtle text-info small ms-2"><i class="bi bi-box-arrow-in-right me-1"></i>Open Task &rarr;</span>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="javascript:void(0);" class="fw-semibold text-dark text-decoration-none btn-trigger-enroll" data-chapter-title="@task.Title" title="Click to enroll and unlock this task">
                                                                <span class="badge bg-info-subtle text-info me-1 py-0 px-1" style="font-size: 9px;">TASK</span> @task.Title
                                                            </a>
                                                            <span class="badge bg-light text-muted border small ms-2"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                                                        }
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge bg-light text-dark border"><i class="bi bi-award text-success me-1"></i>@task.MaxMarks pts</span>
                                                    </div>
                                                </li>
                                            }

                                            <!-- Module Quizzes -->
                                            @foreach (var quiz in moduleQuizzes)
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-warning-subtle bg-opacity-10">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-patch-question-fill text-warning fs-5"></i>
                                                        @if (Model.IsEnrolled && (!Model.Enrollment.IsExpired || Model.Enrollment.Status == "Completed"))
                                                        {
                                                            <a href="@Url.Action("Take", "Quiz", new { id = quiz.QuizId })" class="fw-semibold text-dark text-decoration-none chapter-direct-link" title="Take quiz">
                                                                <span class="badge bg-warning-subtle text-dark me-1 py-0 px-1" style="font-size: 9px;">QUIZ</span> @quiz.Title <span class="badge bg-warning-subtle text-dark small ms-2"><i class="bi bi-lightning-charge me-1"></i>Take Quiz &rarr;</span>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="javascript:void(0);" class="fw-semibold text-dark text-decoration-none btn-trigger-enroll" data-chapter-title="@quiz.Title" title="Click to enroll and unlock this quiz">
                                                                <span class="badge bg-warning-subtle text-dark me-1 py-0 px-1" style="font-size: 9px;">QUIZ</span> @quiz.Title
                                                            </a>
                                                            <span class="badge bg-light text-muted border small ms-2"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                                                        }
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge bg-light text-dark border"><i class="bi bi-stopwatch text-primary me-1"></i>@(quiz.TimeLimitMinutes ?? 30) min</span>
                                                        <span class="badge bg-light text-dark border">Pass: @quiz.PassingPercentage%</span>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Course-Wide Projects (if any) -->
                        @{
                            var courseWideTasks = Model.Assignments != null ? Model.Assignments.Where(a => !a.ModuleId.HasValue).ToList() : new List<LMS.Models.Assignment>();
                        }
                        @if (courseWideTasks.Any())
                        {
                            <div class="accordion-item border-top">
                                <h2 class="accordion-header" id="heading-course-assignments">
                                    <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-course-assignments" aria-expanded="false">
                                        <div class="d-flex justify-content-between align-items-center w-100 pe-3">
                                            <strong class="text-dark"><i class="bi bi-folder-check text-info me-2"></i>Capstone Tasks &amp; Hands-On Projects</strong>
                                            <span class="badge bg-info-subtle text-info small">@courseWideTasks.Count tasks</span>
                                        </div>
                                    </button>
                                </h2>
                                <div id="collapse-course-assignments" class="accordion-collapse collapse" aria-labelledby="heading-course-assignments" data-bs-parent="#curriculumAccordion">
                                    <div class="accordion-body p-0">
                                        <ul class="list-group list-group-flush small">
                                            @foreach (var task in courseWideTasks)
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-file-earmark-code-fill text-info fs-5"></i>
                                                        @if (Model.IsEnrolled && (!Model.Enrollment.IsExpired || Model.Enrollment.Status == "Completed"))
                                                        {
                                                            <a href="@Url.Action("Details", "Assignment", new { id = task.AssignmentId })" class="fw-semibold text-dark text-decoration-none chapter-direct-link" title="Open task workspace">
                                                                @task.Title <span class="badge bg-info-subtle text-info small ms-2"><i class="bi bi-box-arrow-in-right me-1"></i>Open Task &rarr;</span>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="javascript:void(0);" class="fw-semibold text-dark text-decoration-none btn-trigger-enroll" data-chapter-title="@task.Title" title="Click to enroll and unlock this task">
                                                                @task.Title
                                                            </a>
                                                            <span class="badge bg-light text-muted border small ms-2"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                                                        }
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge bg-light text-dark border"><i class="bi bi-award text-success me-1"></i>@task.MaxMarks pts</span>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Dedicated Final Mandatory Course Exam Section -->
                    if (Model.FinalExam != null)
                    {
                        <div class="card card-custom p-4 mt-4 border @(Model.HasPassedFinalExam ? "border-success bg-success-subtle bg-opacity-25" : (Model.IsFinalExamUnlocked ? "border-warning bg-warning-subtle bg-opacity-25" : "border-secondary-subtle bg-light text-muted")) shadow-sm">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle @(Model.HasPassedFinalExam ? "bg-success text-white" : (Model.IsFinalExamUnlocked ? "bg-warning text-dark" : "bg-secondary text-white")) p-3 d-flex align-items-center justify-content-center shadow-xs" style="width: 52px; height: 52px;">
                                        <i class="bi @(Model.HasPassedFinalExam ? "bi-award-fill" : (Model.IsFinalExamUnlocked ? "bi-unlock-fill" : "bi-lock-fill")) fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                            <span class="badge @(Model.HasPassedFinalExam ? "bg-success text-white" : (Model.IsFinalExamUnlocked ? "bg-warning text-dark" : "bg-secondary text-white")) rounded-pill px-3 py-1 small fw-bold">
                                                @(Model.HasPassedFinalExam ? "EXAM CLEARED - CERTIFICATE ISSUED" : (Model.IsFinalExamUnlocked ? "FINAL EXAM UNLOCKED - READY TO ATTEMPT" : "MANDATORY FINAL EXAM - LOCKED"))
                                            </span>
                                            <span class="font-monospace small text-muted"><i class="bi bi-stopwatch me-1"></i>@(Model.FinalExam.TimeLimitMinutes ?? 30) min limit &bull; Passing: @Model.FinalExam.PassingPercentage%</span>
                                        </div>
                                        <h5 class="fw-bold mb-1 @(Model.IsFinalExamUnlocked || Model.HasPassedFinalExam ? "text-dark" : "text-muted")">@Model.FinalExam.Title</h5>
                                        <p class="small text-muted mb-0">@(string.IsNullOrEmpty(Model.FinalExam.Description) ? "Mandatory final exam required after completing 100% of curriculum modules to unlock your official verified certificate." : Model.FinalExam.Description)</p>
                                    </div>
                                </div>
                                <div>
                                    @if (Model.HasPassedFinalExam)
                                    {
                                        <a href="@Url.Action("Certificates", "Student")" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm">
                                            <i class="bi bi-award-fill me-1"></i> View Certificate
                                        </a>
                                    }
                                    else if (Model.IsFinalExamUnlocked)
                                    {
                                        <a href="@Url.Action("Take", "Quiz", new { id = Model.FinalExam.QuizId })" class="btn btn-warning text-dark rounded-pill fw-bold px-4 shadow-sm">
                                            <i class="bi bi-lightning-charge-fill me-1"></i> Take Final Exam Now
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary rounded-pill px-4 opacity-75" disabled title="Complete all modules first to unlock this final exam">
                                            <i class="bi bi-lock-fill me-1"></i> Complete Modules to Unlock
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Student Reviews Section -->
            <div class="card card-custom reviews-section p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-0"><i class="bi bi-star-half me-2 text-warning"></i> Student Feedback & Reviews</h4>
                        <span class="small text-muted">@Model.TotalReviews verified ratings</span>
                    </div>
                    @if (Model.IsEnrolled)
                    {
                        <button class="btn btn-sm btn-outline-primary rounded-pill fw-semibold" data-bs-toggle="modal" data-bs-target="#reviewModal">
                            <i class="bi bi-pencil-square me-1"></i> @(Model.HasReviewed ? "Update Review" : "Write a Review")
                        </button>
                    }
                </div>

                @if (!Model.Reviews.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-chat-left-dots fs-1 text-muted mb-2"></i>
                        <p class="text-muted small">No reviews submitted for this course yet.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="rating-stars small">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <i class="bi @(s <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                        }
                                        <span class="fw-bold text-dark ms-2">@review.Rating.0</span>
                                    </div>
                                    <span class="text-muted" style="font-size: 11px;">@review.CreatedDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <p class="mb-0 small text-secondary">@review.ReviewText</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Instructor Profile Sidebar -->
        <div class="col-lg-4">
            <div class="card card-custom p-4 shadow-sm mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-person-badge me-2 text-primary"></i> Instructor Profile</h5>
                <div class="d-flex align-items-center gap-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.Instructor?.ProfilePicture))
                    {
                        <img src="@Model.Instructor.ProfilePicture" class="rounded-circle shadow-sm" style="width: 56px; height: 56px; object-fit: cover;" alt="@(Model.Instructor?.FullName ?? "Instructor")" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    }
                    <div class="rounded-circle bg-primary text-white align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 56px; height: 56px; display: @(string.IsNullOrWhiteSpace(Model.Instructor?.ProfilePicture) ? "flex" : "none");">
                        @(Model.Instructor?.FullName?.Substring(0, 1) ?? "I")
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">@(Model.Instructor?.FullName ?? Model.Instructor?.UserName ?? "Faculty Instructor")</h6>
                        <small class="text-muted">Verified Educator & Specialist</small>
                    </div>
                </div>
                <p class="small text-muted mb-0" style="line-height: 1.6;">
                    @(Model.Instructor?.Bio ?? "Dedicated industry specialist bringing real-world software engineering expertise and research experience into the curriculum.")
                </p>
            </div>

            <!-- Guarantee Card -->
            <div class="card card-custom p-4 shadow-sm bg-light border">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-patch-check-fill text-success me-2"></i> Quality Guarantee</h6>
                <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-2">
                    <li><i class="bi bi-check2 text-success me-1"></i> @(Model.Course.ValidityInDays > 0 ? Model.Course.ValidityInDays + " days full curriculum access period" : "Unlimited lifetime access to curriculum")</li>
                    <li><i class="bi bi-check2 text-success me-1"></i> Interactive classroom player with focus mode</li>
                    <li><i class="bi bi-check2 text-success me-1"></i> Verifiable certificate issued upon completion</li>
                    <li><i class="bi bi-check2 text-success me-1"></i> Graded projects and live timed quizzes</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Review Modal -->
@if (Model.IsEnrolled)
{
    <div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="reviewModalLabel">Leave Course Feedback</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                @using (Html.BeginForm("AddReview", "Courses", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CourseId" value="@Model.Course.CourseId" />
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Your Rating</label>
                            <select name="Rating" class="form-select" required>
                                <option value="5" @(Model.UserReview?.Rating == 5 ? "selected" : "")>5 Stars (5 - Exceptional)</option>
                                <option value="4" @(Model.UserReview?.Rating == 4 ? "selected" : "")>4 Stars (4 - Very Good)</option>
                                <option value="3" @(Model.UserReview?.Rating == 3 ? "selected" : "")>3 Stars (3 - Average)</option>
                                <option value="2" @(Model.UserReview?.Rating == 2 ? "selected" : "")>2 Stars (2 - Below Average)</option>
                                <option value="1" @(Model.UserReview?.Rating == 1 ? "selected" : "")>1 Star (1 - Needs Improvement)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Detailed Review</label>
                            <textarea name="ReviewText" class="form-control" rows="4" placeholder="Share your experience with other learners..." required>@(Model.UserReview?.ReviewText)</textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Submit Review</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Free Preview Modal Pop-up -->
<div class="modal fade" id="freePreviewModal" tabindex="-1" aria-labelledby="freePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success rounded-pill px-3 py-1 small">Free Preview</span>
                    <h5 class="modal-title fw-bold mb-0 text-truncate" id="freePreviewModalLabel">Lesson Preview</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 bg-black">
                <div id="previewVideoContainer" class="ratio ratio-16x9 w-100 bg-black d-flex align-items-center justify-content-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading lesson stream...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <div class="small text-muted" id="previewDurationText"><i class="bi bi-clock me-1"></i> Preview duration</div>
                    <div class="small fw-semibold text-dark mt-1 text-truncate" style="max-width: 400px;" id="previewSummaryText"></div>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                    @if (!Model.IsEnrolled)
                    {
                        <a href="@Url.Action("Payment", "Courses", new { courseId = Model.Course.CourseId })" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                            Enroll in Course &rarr;
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Enroll Prompt Modal Pop-up -->
<div class="modal fade" id="enrollPromptModal" tabindex="-1" aria-labelledby="enrollPromptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-lock-fill fs-5"></i>
                    <h5 class="modal-title fw-bold mb-0" id="enrollPromptModalLabel">Enrollment Required</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="rounded-circle bg-primary-subtle text-primary p-3 d-inline-flex mb-3 shadow-xs">
                    <i class="bi bi-mortarboard-fill display-5"></i>
                </div>
                <h5 class="fw-bold mb-2 text-dark" id="enrollPromptChapterName">Selected Lesson</h5>
                <p class="text-muted small mb-3">
                    This lecture is part of the complete structured curriculum for <strong class="text-dark">@Model.Course.Title</strong>. Enroll now to unlock all video lectures, hands-on assignments, quizzes, code resources, and an accredited certificate!
                </p>

                <div class="p-3 bg-light rounded-3 border mb-3 text-start small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Access Validity:</span>
                        <strong class="text-dark"><i class="bi bi-hourglass-split text-primary me-1"></i>@(Model.Course.ValidityInDays > 0 ? Model.Course.ValidityInDays + " Days Access" : "Lifetime Access")</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Course Price:</span>
                        <strong class="text-success fs-6">
                            @if (Model.Course.Price == 0)
                            {
                                <span>FREE</span>
                            }
                            else
                            {
                                <span><span class="rupee-symbol">&#8377;</span>@Model.Course.Price.ToString("N2")</span>
                            }
                        </strong>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                @if (Model.Course.Price == 0)
                {
                    using (Html.BeginForm("Enroll", "Courses", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@Model.Course.CourseId" />
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> Enroll Free Now
                        </button>
                    }
                }
                else
                {
                    <a href="@Url.Action("Payment", "Courses", new { courseId = Model.Course.CourseId })" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-unlock-fill me-1"></i> Buy &amp; Unlock Now &rarr;
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var allCollapsed = false;
            $('#toggleAllModulesBtn').on('click', function () {
                if (!allCollapsed) {
                    $('.accordion-collapse').collapse('hide');
                    $(this).text('Expand All Modules');
                    allCollapsed = true;
                } else {
                    $('.accordion-collapse').collapse('show');
                    $(this).text('Collapse All Modules');
                    allCollapsed = false;
                }
            });

            // Free Preview Modal Handler
            var previewModalEl = document.getElementById('freePreviewModal');
            var previewModal = previewModalEl ? new bootstrap.Modal(previewModalEl) : null;

            $('.btn-free-preview').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var lessonId = $(this).data('lesson-id');
                var fallbackTitle = $(this).data('title') || 'Lesson Preview';
                var duration = $(this).data('duration') || 0;

                $('#freePreviewModalLabel').text(fallbackTitle);
                $('#previewDurationText').html('<i class="bi bi-clock me-1 text-primary"></i> ' + duration + ' min');
                $('#previewSummaryText').text('Loading preview details...');
                $('#previewVideoContainer').html('<div class="d-flex align-items-center justify-content-center h-100 text-white"><div class="spinner-border text-primary me-2"></div> Initializing stream...</div>');

                if (previewModal) {
                    previewModal.show();
                }

                $.ajax({
                    url: '@Url.Action("FreePreview", "Courses")',
                    type: 'GET',
                    data: { lessonId: lessonId },
                    success: function (res) {
                        if (res && res.success) {
                            $('#freePreviewModalLabel').text(res.title);
                            $('#previewDurationText').html('<i class="bi bi-clock me-1 text-primary"></i> ' + res.duration + ' minutes &bull; Free Preview');
                            $('#previewSummaryText').text(res.summary || res.courseTitle || '');

                            var videoHtml = '';
                            if (res.isDirectVideo && res.videoUrl) {
                                videoHtml = '<video controls autoplay playsinline class="w-100 h-100" style="object-fit: contain; background: #000;">' +
                                    '<source src="' + res.videoUrl + '" type="video/mp4">' +
                                    'Your browser does not support the video tag.' +
                                    '</video>';
                            } else if (res.embedUrl) {
                                videoHtml = '<iframe src="' + res.embedUrl + '" class="w-100 h-100 border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>';
                            } else {
                                videoHtml = '<div class="d-flex flex-column align-items-center justify-content-center h-100 text-white p-4 text-center">' +
                                    '<i class="bi bi-file-earmark-text display-3 text-primary mb-2"></i>' +
                                    '<h5 class="fw-bold mb-2">' + res.title + '</h5>' +
                                    '<p class="small text-secondary mb-0">' + (res.summary || 'Free preview notes available.') + '</p>' +
                                    '</div>';
                            }
                            $('#previewVideoContainer').html(videoHtml);
                        } else {
                            $('#previewVideoContainer').html('<div class="text-white text-center p-4">' + (res.message || 'Unable to load preview.') + '</div>');
                        }
                    },
                    error: function () {
                        $('#previewVideoContainer').html('<div class="text-white text-center p-4 text-danger"><i class="bi bi-exclamation-triangle-fill fs-2 d-block mb-2"></i> Error loading free preview. Please try again.</div>');
                    }
                });
            });

            if (previewModalEl) {
                previewModalEl.addEventListener('hidden.bs.modal', function () {
                    $('#previewVideoContainer').html('');
                });
            }

            // Enroll Prompt Modal Handler for locked chapters
            var enrollModalEl = document.getElementById('enrollPromptModal');
            var enrollModal = enrollModalEl ? new bootstrap.Modal(enrollModalEl) : null;

            $('.btn-trigger-enroll').on('click', function (e) {
                e.preventDefault();
                var chapterTitle = $(this).data('chapter-title') || 'Selected Chapter';
                $('#enrollPromptChapterName').text(chapterTitle);
                if (enrollModal) {
                    enrollModal.show();
                }
            });
        });
    </script>
}
