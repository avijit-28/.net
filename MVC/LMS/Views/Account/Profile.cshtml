@model LMS.ViewModels.ProfileViewModel
@{
    ViewBag.Title = "Account Profile";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Profile Settings</li>
            </ol>
        </nav>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="position-relative" style="width: 64px; height: 64px;">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePicture))
                    {
                        <img src="@Model.ProfilePicture" id="profileHeaderImg" class="rounded-circle shadow-sm" style="width: 64px; height: 64px; object-fit: cover;" alt="@Model.FullName" onerror="this.style.display='none'; document.getElementById('profileHeaderFallback').style.display='flex';" />
                    }
                    <div id="profileHeaderFallback" class="rounded-circle bg-primary text-white align-items-center justify-content-center fw-bold shadow-sm" style="width: 64px; height: 64px; font-size: 24px; display: @(string.IsNullOrWhiteSpace(Model.ProfilePicture) ? "flex" : "none");">
                        @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                </div>
                <div>
                    <h3 class="fw-extrabold mb-0 tracking-tight">@Model.FullName</h3>
                    <p class="text-muted small mb-0">@Model.Email</p>
                </div>
            </div>
            <div>
                <span class="badge badge-primary-subtle px-3 py-2 rounded-pill fs-6 fw-semibold">
                    Role: @Model.Role
                </span>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card card-custom p-4 p-md-5 shadow-sm bg-white card-gradient-top border-0 mb-4">
            <h5 class="fw-bold text-dark mb-4"><i class="bi bi-person-gear me-2 text-primary"></i>Personal Information</h5>

            @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 mb-4" })

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FullName, "Full Name", new { @class = "form-label fw-bold small text-dark" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Email, "Registered Email Address", new { @class = "form-label fw-bold small text-dark" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light", @readonly = "readonly", disabled = "disabled" })
                        <small class="text-muted" style="font-size: 11px;">Primary identity email address cannot be changed.</small>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PhoneNumber, "Phone Number", new { @class = "form-label fw-bold small text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-telephone text-muted"></i></span>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+1 (555) 000-0000" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ProfilePicture, "Profile Avatar Image Address (URL)", new { @class = "form-label fw-bold small text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-image text-muted"></i></span>
                            @Html.TextBoxFor(m => m.ProfilePicture, new { @class = "form-control", id = "inputProfilePicture", placeholder = "https://images.unsplash.com/... or image link" })
                        </div>
                        <small class="text-muted d-block mt-1" style="font-size: 11px;">Paste any direct image URL. It will automatically show as your avatar across the platform.</small>
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.Bio, "Professional Biography / Study Interests", new { @class = "form-label fw-bold small text-dark" })
                        @Html.TextAreaFor(m => m.Bio, new { @class = "form-control", rows = 4, placeholder = "Share your background, technical focus areas, and learning ambitions..." })
                    </div>
                    <div class="col-12 d-flex justify-content-between align-items-center pt-3 border-top mt-4">
                        <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-key me-1"></i> Change Password
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-check2 me-1"></i> Save Profile
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var input = document.getElementById('inputProfilePicture');
            var headerImg = document.getElementById('profileHeaderImg');
            var headerFallback = document.getElementById('profileHeaderFallback');

            if (input && headerFallback) {
                input.addEventListener('input', function () {
                    var url = (this.value || '').trim();
                    if (url) {
                        if (!headerImg) {
                            headerImg = document.createElement('img');
                            headerImg.id = 'profileHeaderImg';
                            headerImg.className = 'rounded-circle shadow-sm';
                            headerImg.style.width = '64px';
                            headerImg.style.height = '64px';
                            headerImg.style.objectFit = 'cover';
                            headerFallback.parentNode.insertBefore(headerImg, headerFallback);
                        }
                        headerImg.src = url;
                        headerImg.style.display = 'block';
                        headerFallback.style.display = 'none';

                        headerImg.onerror = function () {
                            headerImg.style.display = 'none';
                            headerFallback.style.display = 'flex';
                        };
                    } else {
                        if (headerImg) headerImg.style.display = 'none';
                        headerFallback.style.display = 'flex';
                    }
                });
            }
        });
    </script>
}
