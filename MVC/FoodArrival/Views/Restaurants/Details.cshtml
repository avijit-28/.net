@model FoodArrival.Models.RestaurantPageViewModel
@{
    ViewBag.Title = Model.Restaurant.Name;
}
<p class="mb-3"><a href="@Url.Action("Index")">← All restaurants</a></p>
<section class="surface-card p-4 p-lg-5 mb-4">
    <p class="eyebrow">@Model.Restaurant.Cuisine · @Model.Restaurant.City</p>
    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-end">
        <div><h1 class="section-heading">@Model.Restaurant.Name</h1><p class="text-muted mb-0">@Model.Restaurant.Description</p></div>
        <span class="status-pill">@(Model.Restaurant.AverageRating.HasValue ? "★ " + Model.Restaurant.AverageRating.Value.ToString("0.0") + " · " + Model.Restaurant.ReviewCount + " reviews" : "New kitchen")</span>
    </div>
</section>
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-3">
    <div><p class="eyebrow mb-1">Fresh from the kitchen</p><h2 class="section-heading mb-0">Menu</h2></div>
    @using (Html.BeginForm("Details", "Restaurants", FormMethod.Get, new { @class = "d-flex gap-2 align-items-center" }))
    {
        @Html.Hidden("id", Model.Restaurant.RestaurantId)
        <label class="form-check-label small" for="vegOnly">Vegetarian</label>
        <input class="form-check-input" id="vegOnly" name="vegetarianOnly" type="checkbox" value="true" @(Model.VegetarianOnly ? "checked" : "") onchange="this.form.submit()" />
    }
</div>
@if (!Model.Menu.Any())
{
    <div class="empty-state"><h3 class="h5">Nothing on the menu right now</h3><p class="text-muted mb-0">Please check back a little later.</p></div>
}
else
{
    foreach (var item in Model.Menu)
    {
        <article class="menu-row">
            <div>
                <div class="fw-bold"><span class="food-dot @(item.IsVegetarian ? "" : "nonveg")" aria-label="@(item.IsVegetarian ? "Vegetarian" : "Non-vegetarian")"></span>@item.Name</div>
                @if (!String.IsNullOrWhiteSpace(item.Description)) { <p class="small text-muted mb-1">@item.Description</p> }
                @if (!String.IsNullOrWhiteSpace(item.Category)) { <span class="small text-muted">@item.Category</span> }
            </div>
            <div class="d-flex flex-column align-items-end gap-2"><span class="menu-price">₹@item.Price.ToString("0.00")</span>
                <form action="@Url.Action("Add", "Cart")" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="restaurantId" value="@Model.Restaurant.RestaurantId" /><input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                    <label class="visually-hidden" for="qty-@item.MenuItemId">Quantity for @item.Name</label>
                    <input class="form-control form-control-sm" style="width:68px" id="qty-@item.MenuItemId" name="quantity" type="number" min="1" max="50" value="1" />
                    <button class="btn btn-warning btn-sm" type="submit">Add</button>
                </form>
            </div>
        </article>
    }
}
