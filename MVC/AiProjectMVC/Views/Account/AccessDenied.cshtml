@{
    ViewBag.Title = "Access Denied (403 Forbidden)";
    var currentUser = Session["CurrentUser"] as AiProjectMVC.Models.EmployeeUser;
    var currentRole = Session["UserRole"] as string ?? "Guest";
    string requiredRole = ViewBag.RequiredRole as string;
    string attemptedUrl = ViewBag.AttemptedUrl as string;
    if (string.IsNullOrWhiteSpace(attemptedUrl))
    {
        attemptedUrl = Request.QueryString["url"];
    }
    if (string.IsNullOrWhiteSpace(requiredRole))
    {
        requiredRole = Request.QueryString["required"];
    }
    if (string.IsNullOrWhiteSpace(requiredRole))
    {
        requiredRole = "Higher Role Privilege";
    }
}

<div class="row justify-content-center py-5">
    <div class="col-lg-7 col-md-9">
        <div class="custom-card shadow-lg border-danger border-opacity-50 overflow-hidden text-center">
            <!-- Red Header Banner -->
            <div class="p-4 text-white" style="background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #dc2626 100%);">
                <div class="d-inline-flex p-3 rounded-circle bg-white bg-opacity-20 text-white mb-2 shadow-sm">
                    <i class="bi bi-shield-x fs-1"></i>
                </div>
                <h2 class="fw-bold mb-1">403 - Access Denied</h2>
                <p class="text-white-50 mb-0">Role Authorization Restriction Enforced</p>
            </div>

            <div class="custom-card-body p-4 text-start">
                <!-- Clear explanation box -->
                <div class="alert alert-danger d-flex align-items-start gap-3 p-3 rounded-3 mb-4">
                    <i class="bi bi-exclamation-octagon-fill fs-3 text-danger flex-shrink-0 mt-1"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">You do not have permission to view this page</h5>
                        <p class="mb-0 small">
                            The security filter <code>[AuthorizeRole]</code> intercepted your request because your currently active role does not meet the minimum privileges required for this route.
                        </p>
                    </div>
                </div>

                <!-- Comparison Matrix Details -->
                <div class="card bg-light border-0 p-3 mb-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="small text-muted text-uppercase fw-semibold mb-1">Attempted Page:</div>
                            <div class="fw-bold text-dark font-monospace">
                                @(!string.IsNullOrEmpty(attemptedUrl) ? attemptedUrl : "/Home/About")
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted text-uppercase fw-semibold mb-1">Required Role:</div>
                            <span class="badge bg-danger fs-6 px-3 py-1">
                                <i class="bi bi-lock-fill me-1"></i> @requiredRole
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted text-uppercase fw-semibold mb-1">Logged In As:</div>
                            <div class="fw-bold text-dark">
                                @(currentUser != null ? currentUser.Name : (User.Identity.IsAuthenticated ? User.Identity.Name : "Anonymous Visitor"))
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted text-uppercase fw-semibold mb-1">Your Active Role:</div>
                            <span class="badge bg-secondary fs-6 px-3 py-1">
                                <i class="bi bi-person-badge me-1"></i> @currentRole
                            </span>
                        </div>
                    </div>
                </div>

                <!-- 1-Click Role Swapping to Resolve -->
                <div class="mb-4">
                    <div class="small text-muted fw-bold text-uppercase mb-2">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> 1-Click Resolution (Switch Role to Access):
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="@Url.Action("QuickSwitch", "Account", new { role = "SuperAdmin", returnUrl = attemptedUrl })" 
                           class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-award-fill me-1"></i> Switch to SuperAdmin & Retry
                        </a>
                        <a href="@Url.Action("QuickSwitch", "Account", new { role = "Admin", returnUrl = attemptedUrl })" 
                           class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-shield-lock-fill me-1"></i> Switch to Admin & Retry
                        </a>
                    </div>
                </div>

                <hr class="my-3 text-muted" />

                <!-- Action Buttons -->
                <div class="d-flex flex-column flex-sm-row justify-content-between gap-2">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary-gradient">
                        <i class="bi bi-table me-1"></i> Back to Permission Matrix
                    </a>
                    <a href="@Url.Action("Dashboard", "Employee")" class="btn btn-outline-secondary">
                        <i class="bi bi-speedometer2 me-1"></i> Employee Dashboard
                    </a>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-dark">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In as Different User
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
