@model LMS.Models.Course
@{
    ViewBag.Title = "Secure Checkout - " + Model.Title;
    string stripePub = System.Configuration.ConfigurationManager.AppSettings["StripePublishableKey"] ?? "pk_test_51UWzjwAM9KvfIco7QVuDX765v8YNbA14GtJRsLMiUgNraytejekJaP7PejOfP3ERsOOzu6aAc8Fwyp2eVPmf1Nna00KARQlvDN";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-10">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Courses")" class="text-decoration-none">Courses</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Details", "Courses", new { id = Model.CourseId })" class="text-decoration-none">@Model.Title</a></li>
                <li class="breadcrumb-item active" aria-current="page">Checkout</li>
            </ol>
        </nav>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-danger mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-info mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2 text-info"></i>@TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Course Summary -->
            <div class="col-md-5 order-md-2">
                <div class="card card-custom p-4 shadow-sm bg-white card-gradient-top">
                    <h5 class="fw-bold mb-3"><i class="bi bi-cart3 me-2 text-primary"></i> Order Summary</h5>
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <h6 class="fw-bold mb-1 text-dark">@Model.Title</h6>
                        <span class="badge badge-primary-subtle small">@(Model.Category?.CategoryName ?? "General")</span>
                        <div class="small text-muted mt-2"><i class="bi bi-clock me-1"></i> @Model.DurationInHours Hours Content &bull; Lifetime Access</div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Curriculum Access</span>
                        <span><span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Verifiable Certificate</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>Platform Processing</span>
                        <span class="text-success fw-bold">FREE (0.00)</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between fs-4 fw-extrabold text-dark mb-4">
                        <span>Total Due</span>
                        <span class="text-primary"><span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2")</span>
                    </div>

                    <!-- Stripe Security Badge -->
                    <div class="p-3 rounded-3 border bg-light small mb-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-dark px-2 py-1"><i class="bi bi-stripe text-info me-1"></i> Stripe Test Mode</span>
                            <span class="badge bg-success-subtle text-success small">Verified Live Key</span>
                        </div>
                        <div class="text-muted" style="font-size: 0.8rem;">
                            End-to-end encrypted sandbox test environment powered by official Stripe APIs.
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border small text-secondary d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-3"></i>
                        <span>Instant automated enrollment and full classroom unlock.</span>
                    </div>
                </div>
            </div>

            <!-- Payment Methods -->
            <div class="col-md-7 order-md-1">
                <div class="card card-custom p-4 p-md-5 shadow-sm bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h4 class="fw-extrabold mb-0 tracking-tight">Payment Gateway</h4>
                        <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill">
                            <i class="bi bi-shield-lock-fill me-1"></i> 256-Bit SSL
                        </span>
                    </div>
                    <p class="text-muted small mb-4">Select your checkout gateway to authorize your course enrollment.</p>

                    <!-- Option A: Stripe Hosted Checkout (Official Redirect) -->
                    <div class="p-4 rounded-3 border border-2 border-primary bg-primary-subtle bg-opacity-10 mb-4 position-relative">
                        <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                    <i class="bi bi-credit-card fs-6"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">Stripe Hosted Checkout</h6>
                                    <small class="text-muted">Pay securely on official Stripe page with Cards or Apple Pay / Google Pay</small>
                                </div>
                            </div>
                            <span class="badge bg-primary text-white rounded-pill px-2 py-1 small">Recommended</span>
                        </div>

                        <p class="small text-secondary mb-3">
                            Click below to open Stripe's hosted checkout simulator pre-configured with test cases.
                        </p>

                        @using (Html.BeginForm("CreateStripeCheckout", "Courses", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@Model.CourseId" />
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-box-arrow-up-right"></i> Launch Stripe Hosted Checkout (<span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2"))
                            </button>
                        }
                    </div>

                    <!-- Option B: Direct Stripe Card (In-Page Test Case Simulator) -->
                    <div class="card p-4 rounded-3 border mb-4 bg-white shadow-none">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-credit-card-2-front text-primary me-2"></i> Direct Card Checkout (Stripe API)
                            </h6>
                            <span class="badge bg-info-subtle text-info rounded-pill px-2 py-1 small">Stripe Test Cases</span>
                        </div>

                        <!-- Test Case Preset Selector -->
                        <div class="mb-3 p-3 bg-light rounded-3 border">
                            <label class="form-label small fw-bold text-dark mb-1 d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-sliders me-1 text-primary"></i> Choose Stripe Test Case Scenario:</span>
                            </label>
                            <select id="stripeTestCaseSelect" class="form-select form-select-sm" onchange="applyStripeTestCase(this.value)">
                                <option value="visa_success" selected>&#10004; Success - Visa (4242 4242 4242 4242)</option>
                                <option value="mastercard_success">&#10004; Success - Mastercard (5555 5555 5555 4444)</option>
                                <option value="declined">&#10008; Decline - Generic Card Declined (4000 0000 0000 0002)</option>
                                <option value="insufficient_funds">&#10008; Decline - Insufficient Funds (4000 0000 0000 9995)</option>
                                <option value="expired">&#10008; Decline - Expired Card (4000 0000 0000 0069)</option>
                                <option value="incorrect_cvc">&#10008; Decline - Incorrect Security Code (4000 0000 0000 0127)</option>
                            </select>
                            <div id="testCaseFeedback" class="small text-success mt-1 fw-semibold">
                                <i class="bi bi-check-circle me-1"></i> Pre-configured for immediate successful payment & classroom unlock.
                            </div>
                        </div>

                        @using (Html.BeginForm("Payment", "Courses", FormMethod.Post, new { id = "directPaymentForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@Model.CourseId" />
                            <input type="hidden" name="paymentMethod" value="Stripe Card (Test Gateway)" />

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-1">Card Number (Stripe Test Case)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-credit-card text-muted"></i></span>
                                    <input type="text" id="cardNumber" name="cardNumber" class="form-control border-start-0 font-monospace" placeholder="4242 4242 4242 4242" value="4242 4242 4242 4242" required />
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <label class="form-label small fw-bold text-dark mb-1">Exp Month</label>
                                    <input type="text" id="expMonth" name="expMonth" class="form-control font-monospace" placeholder="12" value="12" maxlength="2" required />
                                </div>
                                <div class="col-4">
                                    <label class="form-label small fw-bold text-dark mb-1">Exp Year</label>
                                    <input type="text" id="expYear" name="expYear" class="form-control font-monospace" placeholder="2028" value="2028" maxlength="4" required />
                                </div>
                                <div class="col-4">
                                    <label class="form-label small fw-bold text-dark mb-1">CVC / CVV</label>
                                    <input type="text" id="cvc" name="cvc" class="form-control font-monospace" placeholder="123" value="123" maxlength="4" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-outline-dark w-100 py-2 rounded-pill fw-bold">
                                <i class="bi bi-lock-fill me-1"></i> Authorize Direct Test Card (<span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2"))
                            </button>
                        }
                    </div>

                    <!-- Option C: Alternate Simulated Channels -->
                    <div class="accordion" id="altPaymentAccordion">
                        <div class="accordion-item border rounded-3 overflow-hidden">
                            <h2 class="accordion-header" id="headingAlt">
                                <button class="accordion-button collapsed py-2 text-secondary small fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAlt" aria-expanded="false" aria-controls="collapseAlt">
                                    <i class="bi bi-wallet2 me-2"></i> Other Payment Channels (UPI, Net Banking)
                                </button>
                            </h2>
                            <div id="collapseAlt" class="accordion-collapse collapse" aria-labelledby="headingAlt" data-bs-parent="#altPaymentAccordion">
                                <div class="accordion-body p-3">
                                    @using (Html.BeginForm("Payment", "Courses", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="courseId" value="@Model.CourseId" />
                                        <div class="d-flex flex-column gap-2 mb-3">
                                            <div class="form-check p-2 border rounded bg-light">
                                                <input class="form-check-input ms-0 me-2" type="radio" name="paymentMethod" id="pmUpi" value="UPI / QR Payment (Mock)" checked>
                                                <label class="form-check-label fw-semibold text-dark small" for="pmUpi">
                                                    <i class="bi bi-qr-code-scan text-success me-1"></i> UPI / QR Code (GPay, PhonePe, Paytm)
                                                </label>
                                            </div>
                                            <div class="form-check p-2 border rounded bg-light">
                                                <input class="form-check-input ms-0 me-2" type="radio" name="paymentMethod" id="pmNet" value="Net Banking (Mock)">
                                                <label class="form-check-label fw-semibold text-dark small" for="pmNet">
                                                    <i class="bi bi-bank text-primary me-1"></i> Net Banking (All Indian Banks)
                                                </label>
                                            </div>
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-secondary w-100 rounded-pill py-2">
                                            Proceed with Alternative Channel
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Developer Key Inspection Footer -->
                    <div class="mt-4 pt-3 border-top text-center text-muted small">
                        <div><i class="bi bi-key-fill text-warning me-1"></i> Stripe Publishable Key: <code class="text-secondary small">@(stripePub.Substring(0, Math.Min(24, stripePub.Length)))...</code></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function applyStripeTestCase(scenario) {
        var card = document.getElementById('cardNumber');
        var mm = document.getElementById('expMonth');
        var yy = document.getElementById('expYear');
        var cvc = document.getElementById('cvc');
        var feedback = document.getElementById('testCaseFeedback');

        mm.value = '12';
        yy.value = '2028';
        cvc.value = '123';

        switch (scenario) {
            case 'visa_success':
                card.value = '4242 4242 4242 4242';
                feedback.className = 'small text-success mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-check-circle me-1"></i> Pre-configured for immediate successful payment & classroom unlock.';
                break;
            case 'mastercard_success':
                card.value = '5555 5555 5555 4444';
                feedback.className = 'small text-success mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-check-circle me-1"></i> Mastercard test card configured for successful authorization.';
                break;
            case 'declined':
                card.value = '4000 0000 0000 0002';
                feedback.className = 'small text-danger mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-x-circle me-1"></i> Tests gateway card decline error handling ("Your card was declined").';
                break;
            case 'insufficient_funds':
                card.value = '4000 0000 0000 9995';
                feedback.className = 'small text-warning mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> Tests insufficient funds error handling.';
                break;
            case 'expired':
                card.value = '4000 0000 0000 0069';
                feedback.className = 'small text-danger mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-x-circle me-1"></i> Tests expired card rejection handling.';
                break;
            case 'incorrect_cvc':
                card.value = '4000 0000 0000 0127';
                cvc.value = '999';
                feedback.className = 'small text-danger mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-x-circle me-1"></i> Tests incorrect CVC security code failure.';
                break;
        }
    }
</script>
