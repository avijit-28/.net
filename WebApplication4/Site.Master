        <script type="text/javascript">
            // Smart dropdown alignment to prevent overflowing screen edges
            function alignMenuDropdown() {
                var panel = document.getElementById('megaMenuPanel');
                var btn = document.getElementById('megaMenuBtn');
                if (!panel || !btn) return;

                // Temporarily ensure panel can be measured
                panel.style.left = '0px';
                panel.style.right = 'auto';

                var btnRect = btn.getBoundingClientRect();
                var panelWidth = panel.offsetWidth;
                if (!panelWidth || panelWidth <= 0) {
                    var prevDisplay = panel.style.display;
                    var prevVisibility = panel.style.visibility;
                    panel.style.visibility = 'hidden';
                    panel.style.display = 'block';
                    panelWidth = panel.offsetWidth || 820;
                    panel.style.display = prevDisplay;
                    panel.style.visibility = prevVisibility;
                }

                var viewportWidth = window.innerWidth || document.documentElement.clientWidth;
                var screenLeft = btnRect.left;
                var maxScreenRight = viewportWidth - 16;

                // If menu panel overflows the right edge of viewport, shift it left
                if (screenLeft + panelWidth > maxScreenRight) {
                    screenLeft = maxScreenRight - panelWidth;
                }

                // Never allow left edge of panel to go off-screen (minimum 16px from screen edge)
                if (screenLeft < 16) {
                    screenLeft = 16;
                }

                var relativeLeft = screenLeft - btnRect.left;
                panel.style.left = relativeLeft + 'px';
                panel.style.right = 'auto';
            }

            document.addEventListener('DOMContentLoaded', function () {
                var menuBtn = document.getElementById('megaMenuBtn');
                var menuWrapper = document.querySelector('.menu-dropdown-wrapper');

                if (menuBtn && menuWrapper) {
                    menuBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        var willBeActive = !menuWrapper.classList.contains('active');
                        menuWrapper.classList.toggle('active');
                        if (willBeActive) {
                            alignMenuDropdown();
                        }
                    });

                    menuWrapper.addEventListener('mouseenter', function () {
                        alignMenuDropdown();
                    });

                    menuBtn.addEventListener('focus', function () {
                        alignMenuDropdown();
                    });
                }

                document.addEventListener('click', function (e) {
                    if (menuWrapper && !menuWrapper.contains(e.target)) {
                        menuWrapper.classList.remove('active');
                    }
                });

                // Close dropdown on Escape key
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        if (menuWrapper) {
                            menuWrapper.classList.remove('active');
                        }
                    }
                });

                window.addEventListener('resize', function () {
                    if (menuWrapper && (menuWrapper.classList.contains('active') || menuWrapper.matches(':hover'))) {
                        alignMenuDropdown();
                    }
                });
            });
        </script>

        <!-- Project-Wide Centered Modal Dialog (Confirmations, Alerts & Session Expiry) -->
        <div id="globalConfirmModal" class="global-modal-overlay" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true">
            <div class="global-modal-card" role="document">
                <button type="button" class="global-modal-close" id="globalConfirmCloseBtn" aria-label="Close dialog">&times;</button>
                
                <div class="global-modal-icon-wrap" id="globalConfirmIconWrap">
                    <div id="globalConfirmIconContainer"></div>
                </div>

                <h3 class="global-modal-title" id="globalConfirmTitle">Notice</h3>
                
                <div class="global-modal-body" id="globalConfirmMessage">
                    Operation notification
                </div>

                <div class="global-modal-actions">
                    <button type="button" class="global-modal-btn global-modal-btn-cancel" id="globalConfirmCancelBtn">Cancel</button>
                    <button type="button" class="global-modal-btn global-modal-btn-confirm" id="globalConfirmOkBtn">OK</button>
                </div>
            </div>
        </div>

        <script type="text/javascript">
            // ========================================================
            // Global Centered UI Modal Controller (Confirm & Notify)
            // ========================================================
            (function () {
                var _activePendingAction = null;
                var _autoCloseTimer = null;

                function hideGlobalConfirmModal() {
                    if (_autoCloseTimer) {
                        clearTimeout(_autoCloseTimer);
                        _autoCloseTimer = null;
                    }
                    var modal = document.getElementById('globalConfirmModal');
                    if (!modal) return;
                    modal.classList.remove('active');
                    modal.setAttribute('aria-hidden', 'true');
                    setTimeout(function () {
                        modal.style.display = 'none';
                    }, 220);
                    _activePendingAction = null;
                }

                // Generic Modal Dialog: Supports 2 buttons (Confirm) or 1 button (Notify/Alert)
                window.showConfirmDialog = function (options) {
                    if (_autoCloseTimer) {
                        clearTimeout(_autoCloseTimer);
                        _autoCloseTimer = null;
                    }

                    var modal = document.getElementById('globalConfirmModal');
                    var iconWrap = document.getElementById('globalConfirmIconWrap');
                    var iconContainer = document.getElementById('globalConfirmIconContainer');
                    var titleEl = document.getElementById('globalConfirmTitle');
                    var msgEl = document.getElementById('globalConfirmMessage');
                    var okBtn = document.getElementById('globalConfirmOkBtn');
                    var cancelBtn = document.getElementById('globalConfirmCancelBtn');

                    if (!modal) return;

                    var type = options.type || 'delete';
                    iconWrap.className = 'global-modal-icon-wrap type-' + type;

                    if (type === 'delete') {
                        iconContainer.innerHTML = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>';
                        okBtn.className = 'global-modal-btn global-modal-btn-confirm btn-delete';
                        okBtn.innerHTML = '&#128465; ' + (options.confirmText || 'Yes, Delete');
                    } else if (type === 'update') {
                        iconContainer.innerHTML = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>';
                        okBtn.className = 'global-modal-btn global-modal-btn-confirm btn-update';
                        okBtn.innerHTML = '&#10003; ' + (options.confirmText || 'Yes, Save Changes');
                    } else if (type === 'insert') {
                        iconContainer.innerHTML = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>';
                        okBtn.className = 'global-modal-btn global-modal-btn-confirm btn-insert';
                        okBtn.innerHTML = '&#10010; ' + (options.confirmText || 'Yes, Insert Record');
                    } else if (type === 'success') {
                        iconContainer.innerHTML = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>';
                        okBtn.className = 'global-modal-btn global-modal-btn-confirm btn-success';
                        okBtn.innerHTML = '&#10003; ' + (options.confirmText || 'Got it');
                    } else if (type === 'timeout') {
                        iconContainer.innerHTML = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>';
                        okBtn.className = 'global-modal-btn global-modal-btn-confirm btn-timeout';
                        okBtn.innerHTML = '&#128272; ' + (options.confirmText || 'Sign In Again');
                    } else {
                        iconContainer.innerHTML = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';
                        okBtn.className = 'global-modal-btn global-modal-btn-confirm btn-warning';
                        okBtn.innerHTML = options.confirmText || 'OK';
                    }

                    titleEl.textContent = options.title || (type === 'delete' ? 'Confirm Deletion' : (type === 'update' ? 'Confirm Update' : (type === 'insert' ? 'Confirm Insert' : 'Notice')));
                    msgEl.innerHTML = options.message || 'Are you sure you want to proceed?';

                    if (options.hideCancel) {
                        cancelBtn.style.display = 'none';
                    } else {
                        cancelBtn.style.display = 'inline-flex';
                        cancelBtn.textContent = options.cancelText || 'Cancel';
                    }

                    _activePendingAction = {
                        onConfirm: options.onConfirm,
                        onCancel: options.onCancel
                    };

                    modal.style.display = 'flex';
                    void modal.offsetWidth; // Force reflow
                    modal.classList.add('active');
                    modal.setAttribute('aria-hidden', 'false');

                    if (options.hideCancel) {
                        okBtn.focus();
                    } else {
                        cancelBtn.focus();
                    }
                };

                // Notification Modal (Single button, with optional auto-dismiss)
                window.showNotificationModal = function (options) {
                    options.hideCancel = true;
                    var origConfirm = options.onConfirm;

                    window.showConfirmDialog({
                        title: options.title || 'Notice',
                        message: options.message,
                        type: options.type || 'success',
                        confirmText: options.confirmText || 'Got it',
                        hideCancel: true,
                        onConfirm: function () {
                            if (_autoCloseTimer) clearTimeout(_autoCloseTimer);
                            if (typeof origConfirm === 'function') origConfirm();
                        }
                    });

                    // Auto dismiss after 4.5 seconds if user does not click
                    if (options.autoClose !== false) {
                        _autoCloseTimer = setTimeout(function () {
                            hideGlobalConfirmModal();
                        }, 4500);
                    }
                };

                // Attach modal button event listeners
                document.getElementById('globalConfirmOkBtn').addEventListener('click', function () {
                    if (_activePendingAction && typeof _activePendingAction.onConfirm === 'function') {
                        var action = _activePendingAction.onConfirm;
                        hideGlobalConfirmModal();
                        action();
                    } else {
                        hideGlobalConfirmModal();
                    }
                });

                document.getElementById('globalConfirmCancelBtn').addEventListener('click', function () {
                    if (_activePendingAction && typeof _activePendingAction.onCancel === 'function') {
                        _activePendingAction.onCancel();
                    }
                    hideGlobalConfirmModal();
                });

                document.getElementById('globalConfirmCloseBtn').addEventListener('click', function () {
                    if (_activePendingAction && typeof _activePendingAction.onCancel === 'function') {
                        _activePendingAction.onCancel();
                    }
                    hideGlobalConfirmModal();
                });

                // Backdrop click to cancel
                document.getElementById('globalConfirmModal').addEventListener('click', function (e) {
                    if (e.target === this) {
                        if (_activePendingAction && typeof _activePendingAction.onCancel === 'function') {
                            _activePendingAction.onCancel();
                        }
                        hideGlobalConfirmModal();
                    }
                });

                // Keyboard escape to cancel
                document.addEventListener('keydown', function (e) {
                    var modal = document.getElementById('globalConfirmModal');
                    if (!modal || !modal.classList.contains('active')) return;
                    if (e.key === 'Escape' || e.keyCode === 27) {
                        hideGlobalConfirmModal();
                    }
                });

                // Universal Capture-Phase Click Interceptor - STRICTLY for Insert, Update, and Delete Operations
                document.addEventListener('click', function (e) {
                    var target = e.target.closest('a, button, input[type="submit"], input[type="button"]');
                    if (!target) return;

                    // Skip if action was already confirmed via our UI modal
                    if (target._modalConfirmed) {
                        delete target._modalConfirmed;
                        return; // Let the postback click proceed naturally!
                    }

                    // Skip clicks inside our modal
                    if (target.closest('#globalConfirmModal')) return;

                    var text = (target.textContent || target.value || '').trim();
                    var textLower = text.toLowerCase().replace(/\s+/g, ' ');
                    var href = target.getAttribute('href') || '';
                    var cmd = (target.getAttribute('data-command') || '').toLowerCase();
                    var idAttr = (target.getAttribute('id') || '').toLowerCase();
                    var onclickAttr = target.getAttribute('onclick') || '';

                    // =========================================================================
                    // 1. STRICT EXCLUSIONS: Never show popup on non-CRUD buttons/links
                    // =========================================================================

                    // A) Pagination numbers, Prev, Next buttons
                    if (target.classList.contains('pager-page-btn') ||
                        target.closest('.custom-pager-container, .gridview-pager') ||
                        idAttr.indexOf('paginglinkbutton') > -1 ||
                        href.indexOf('$Page$') > -1 ||
                        /^\d+$/.test(text) || text === '...' || text === 'Next' || text === 'Prev' || text === 'First' || text === 'Last') {
                        return;
                    }

                    // B) Edit buttons (opening the row for edit, NOT saving)
                    if (cmd === 'edit' || cmd === 'editrow' ||
                        target.classList.contains('btn-action-edit') ||
                        href.indexOf('$Edit$') > -1 || href.indexOf('$EditRow$') > -1 ||
                        textLower === 'edit' || textLower.endsWith(' edit') || textLower.startsWith('edit ')) {
                        return;
                    }

                    // C) Cancel buttons
                    if (cmd === 'cancel' || cmd === 'cancelupdate' ||
                        target.classList.contains('btn-action-cancel') ||
                        href.indexOf('$Cancel$') > -1 || href.indexOf('$CancelUpdate$') > -1 ||
                        textLower === 'cancel' || textLower.endsWith(' cancel') || textLower.startsWith('cancel ')) {
                        return;
                    }

                    // D) Search inputs and search buttons
                    if (idAttr.indexOf('search') > -1 || cmd === 'search' ||
                        textLower === 'search' || textLower.startsWith('search ')) {
                        return;
                    }

                    // E) Navigation links, hero buttons, auth buttons, footer links
                    if (target.classList.contains('btn-auth') ||
                        target.classList.contains('btn-hero-link') ||
                        target.classList.contains('btn-hub-return') ||
                        target.classList.contains('module-link') ||
                        target.classList.contains('menu-item-link') ||
                        target.closest('.site-header, .site-footer, .mega-menu-container') ||
                        textLower.indexOf('sign in') > -1 || textLower.indexOf('sign out') > -1 || textLower.indexOf('logout') > -1) {
                        return;
                    }

                    // F) Column sort links
                    if (href.indexOf('$Sort$') > -1) {
                        return;
                    }

                    // =========================================================================
                    // 2. INCLUSIONS: ONLY Delete, Update, and Insert
                    // =========================================================================

                    // Detect Delete operation
                    var isDelete = cmd === 'delete' ||
                                   cmd === 'deleterow' ||
                                   href.indexOf('$Delete$') > -1 ||
                                   href.indexOf('$DeleteRow$') > -1 ||
                                   target.classList.contains('btn-action-delete') ||
                                   target.classList.contains('btn-delete') ||
                                   textLower === 'delete' ||
                                   textLower.indexOf('delete') > -1 ||
                                   textLower.indexOf('remove') > -1;

                    // Detect Update operation
                    var isUpdate = cmd === 'update' ||
                                   cmd === 'updaterow' ||
                                   href.indexOf('$Update$') > -1 ||
                                   href.indexOf('$UpdateRow$') > -1 ||
                                   target.classList.contains('btn-action-update') ||
                                   target.classList.contains('btn-update') ||
                                   textLower === 'update' ||
                                   textLower.indexOf('update') > -1 ||
                                   textLower.indexOf('save changes') > -1;

                    // Detect Insert operation
                    var isInsert = cmd === 'insert' ||
                                   cmd === 'insertrow' ||
                                   cmd === 'addnew' ||
                                   href.indexOf('$Insert$') > -1 ||
                                   href.indexOf('$InsertRow$') > -1 ||
                                   href.indexOf('$AddNew$') > -1 ||
                                   target.classList.contains('btn-insert-user') ||
                                   target.classList.contains('btn-insert-confirm') ||
                                   target.classList.contains('btn-insert') ||
                                   idAttr.indexOf('btnadd') > -1 ||
                                   idAttr.indexOf('lbinsert') > -1 ||
                                   textLower.indexOf('insert') > -1 ||
                                   textLower.indexOf('add user') > -1 ||
                                   textLower.indexOf('add employee') > -1 ||
                                   textLower.indexOf('add product') > -1;

                    // If NOT Insert, NOT Update, and NOT Delete -> NEVER SHOW POPUP!
                    if (!isDelete && !isUpdate && !isInsert) {
                        return;
                    }

                    // If client-side validation is active and fails, let validation messages appear instead of modal
                    if (typeof Page_ClientValidate === 'function') {
                        var valGroupMatch = onclickAttr.match(/Page_ClientValidate\(['"](.*?)['"]\)/);
                        if (valGroupMatch) {
                            var group = valGroupMatch[1];
                            if (!Page_ClientValidate(group)) {
                                return;
                            }
                        }
                    }

                    // Intercept click and stop immediate postback
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    var type = isDelete ? 'delete' : (isUpdate ? 'update' : 'insert');
                    var title = isDelete ? 'Confirm Deletion' : (isUpdate ? 'Confirm Update' : 'Confirm Insert');
                    var confirmBtnText = isDelete ? 'Yes, Delete' : (isUpdate ? 'Yes, Save Changes' : 'Yes, Insert Record');
                    var message = '';

                    // Extract custom message from inline confirm() if present
                    var confirmMatch = onclickAttr.match(/confirm\(\s*(['"])([\s\S]*?)\1\s*\)/);
                    if (confirmMatch && confirmMatch[2]) {
                        message = confirmMatch[2]
                            .replace(/\\r\\n|\\n/g, '<br/>')
                            .replace(/\\'/g, "'")
                            .replace(/\\"/g, '"');
                    } else {
                        if (isDelete) {
                            message = 'Are you sure you want to <strong>DELETE</strong> this record?<br/><span style="font-size:12.5px;color:#ef4444;margin-top:6px;display:inline-block;">This action is permanent and cannot be undone.</span>';
                        } else if (isUpdate) {
                            message = 'Are you sure you want to <strong>SAVE changes</strong> and update this record in the database?';
                        } else {
                            message = 'Are you sure you want to <strong>INSERT</strong> this new record into the database?';
                        }
                    }

                    window.showConfirmDialog({
                        title: title,
                        message: message,
                        type: type,
                        confirmText: confirmBtnText,
                        cancelText: 'Cancel',
                        onConfirm: function () {
                            target._modalConfirmed = true;

                            var originalConfirm = window.confirm;
                            window.confirm = function () { return true; };

                            try {
                                if (typeof target.click === 'function') {
                                    target.click();
                                } else if (target.tagName === 'A' && href && href.startsWith('javascript:')) {
                                    var script = href.substring(11);
                                    (new Function(script))();
                                }
                            } finally {
                                window.confirm = originalConfirm;
                            }
                        }
                    });
                }, true); // Capture phase listener
                                message: text,
                                type: isErr ? 'warning' : 'success'
                            });
                            break;
                        }
                    }
                });
            })();

            <% if (Session["UserName"] != null && !string.IsNullOrWhiteSpace(Session["UserName"].ToString())) { %>
            // ========================================================
            // Real-Time Session Countdown & Center Expiry Modal
            // ========================================================
            (function () {
                var sessionTotalSeconds = <%= Session.Timeout * 60 %>;
                var expiryTimestamp = Date.now() + (sessionTotalSeconds * 1000);
                var sessionTimerInterval = null;

                function formatTime(sec) {
                    var m = Math.floor(sec / 60);
                    var s = sec % 60;
                    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
                }

                function tickSession() {
                    var timerText = document.getElementById('sessionTimerText');
                    var sessionPill = document.getElementById('sessionPill');
                    var remaining = Math.max(0, Math.round((expiryTimestamp - Date.now()) / 1000));

                    if (timerText) {
                        timerText.textContent = formatTime(remaining);
                    }

                    // Warning state: Last 60 seconds
                    if (sessionPill) {
                        if (remaining <= 60 && remaining > 0) {
                            sessionPill.classList.add('session-warning');
                        } else {
                            sessionPill.classList.remove('session-warning');
                        }
                    }

                    // Expiry state: Session ended
                    if (remaining <= 0) {
                        clearInterval(sessionTimerInterval);
                        sessionTimerInterval = null;

                        // Display Centered Session Expired Modal
                        window.showConfirmDialog({
                            title: 'Session Expired',
                            message: 'Your active session has timed out due to 5 minutes of inactivity.<br/><span style="font-size:12.5px;color:#ea580c;margin-top:6px;display:inline-block;">You are being securely redirected to the sign-in page.</span>',
                            type: 'timeout',
                            confirmText: 'Sign In Now',
                            hideCancel: true,
                            onConfirm: function () {
                                window.location.href = '<%= ResolveUrl("~/FirstPage?timeout=1") %>';
                            }
                        });

                        // Automatically redirect after 4 seconds
                        setTimeout(function () {
                            window.location.href = '<%= ResolveUrl("~/FirstPage?timeout=1") %>';
                        }, 4000);
                    }
                }

                function initSessionCountdown() {
                    if (sessionTimerInterval) clearInterval(sessionTimerInterval);
                    expiryTimestamp = Date.now() + (sessionTotalSeconds * 1000);
                    tickSession();
                    sessionTimerInterval = setInterval(tickSession, 1000);
                }

                // Start countdown immediately
                initSessionCountdown();

                // If user performs an asynchronous AJAX request (UpdatePanel), reset the countdown
                if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                    Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                        initSessionCountdown();
                    });
                }
            })();
            <% } %>
        </script>
    </form>
</body>
</html>
