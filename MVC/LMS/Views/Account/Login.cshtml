@model LMS.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Sign In";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 p-md-5 shadow-sm">
            <div class="text-center mb-4">
                <span class="rounded-circle bg-primary-subtle text-primary p-3 d-inline-flex mb-2">
                    <i class="bi bi-person-lock fs-3"></i>
                </span>
                <h3 class="fw-bold">Welcome Back</h3>
                <p class="text-muted small">Sign in to access your courses, assignments, and dashboard</p>
            </div>

            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold small" })
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0", placeholder = "name@example.com", id = "loginEmail" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold small mb-0" })
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0", placeholder = "••••••••", id = "loginPassword" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="form-check mb-4">
                    @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label small text-muted" })
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            }

            <!-- Quick-fill demo credentials for easy testing -->
            <div class="p-3 bg-light rounded-3 mt-3 border">
                <div class="small fw-bold text-muted mb-2 text-uppercase" style="font-size: 11px;">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Quick Test Sign-In:
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-danger fw-semibold" onclick="fillCreds('admin@lms.com', 'Admin@123')">
                        <i class="bi bi-shield-lock me-1"></i> Admin
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info text-dark fw-semibold" onclick="fillCreds('instructor@lms.com', 'Instructor@123')">
                        <i class="bi bi-mortarboard me-1"></i> Instructor
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" onclick="fillCreds('student@lms.com', 'Student@123')">
                        <i class="bi bi-person me-1"></i> Student
                    </button>
                </div>
            </div>

            <div class="text-center mt-4 small text-muted">
                Don't have an account? <a href="@Url.Action("Register", "Account")" class="text-primary fw-bold text-decoration-none">Create Account</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillCreds(email, password) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = password;
        }
    </script>
}
