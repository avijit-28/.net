@model AiProjectMVC.ViewModels.LoginViewModel

@{
    ViewBag.Title = "User Login";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-5">
        <div class="custom-card shadow-lg border-0 overflow-hidden">
            <!-- Top Header -->
            <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #4338ca 100%);">
                <div class="d-inline-flex p-3 rounded-circle bg-white bg-opacity-10 text-white mb-2 shadow-sm">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </div>
                <h3 class="fw-bold mb-1">Employee Portal Login</h3>
                <p class="text-white-50 small mb-0">Sign in with your username or registered email</p>
            </div>

            <!-- Login Form Body -->
            <div class="custom-card-body p-4">
                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                    {
                        <div class="custom-alert custom-alert-danger mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                            <div class="small">@Html.ValidationSummary(true, "", new { @class = "mb-0" })</div>
                        </div>
                    }

                    <!-- Username / Email Field -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.UserNameOrEmail, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                            @Html.TextBoxFor(m => m.UserNameOrEmail, new { @class = "form-control", placeholder = "Username or Email (e.g. avijit28)", required = "required", id = "usernameInput" })
                        </div>
                        @Html.ValidationMessageFor(m => m.UserNameOrEmail, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key text-muted"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter password", required = "required", id = "passwordInput" })
                            <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn" title="Toggle visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Remember Me -->
                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label small text-muted" })
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary-gradient w-100 py-2 fs-6 shadow-sm mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Dashboard
                    </button>
                }

                <!-- Quick Test Role Selector -->
                <div class="mt-4 pt-3 border-top">
                    <div class="text-muted small fw-bold mb-2 text-uppercase text-center">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick 1-Click Role Login
                    </div>
                    <div class="row g-2">
                        <!-- Admin -->
                        <div class="col-4">
                            <button type="button" class="btn btn-outline-danger w-100 py-2 demo-chip d-flex flex-column align-items-center"
                                    data-user="avijit28" data-pass="Avijit@123">
                                <i class="bi bi-shield-fill-check fs-5 mb-1 text-danger"></i>
                                <span class="fw-bold small text-dark">Admin</span>
                                <span class="text-muted text-nowrap" style="font-size: 11px;">Full Access</span>
                            </button>
                        </div>
                        <!-- Manager / HR -->
                        <div class="col-4">
                            <button type="button" class="btn btn-outline-primary w-100 py-2 demo-chip d-flex flex-column align-items-center"
                                    data-user="amit103" data-pass="Amit@123">
                                <i class="bi bi-briefcase-fill fs-5 mb-1 text-primary"></i>
                                <span class="fw-bold small text-dark">Manager/HR</span>
                                <span class="text-muted text-nowrap" style="font-size: 11px;">Manage Staff</span>
                            </button>
                        </div>
                        <!-- Employee -->
                        <div class="col-4">
                            <button type="button" class="btn btn-outline-success w-100 py-2 demo-chip d-flex flex-column align-items-center"
                                    data-user="rahul101" data-pass="Rahul@123">
                                <i class="bi bi-person-fill fs-5 mb-1 text-success"></i>
                                <span class="fw-bold small text-dark">Employee</span>
                                <span class="text-muted text-nowrap" style="font-size: 11px;">View Portal</span>
                            </button>
                        </div>
                    </div>
                    <div class="text-center mt-2">
                        <span class="text-muted" style="font-size: 11px;">
                            <i class="bi bi-info-circle me-1"></i> Also supports <code>admin@gmail.com</code> / <code>user@gmail.com</code>
                        </span>
                    </div>
                </div>

                <!-- Register Footer Link -->
                <div class="text-center mt-3 pt-2">
                    <p class="text-muted small mb-0">
                        Don't have an account? 
                        <a href="@Url.Action("Register", "Account")" class="fw-bold text-primary text-decoration-none ms-1">
                            Register New Account
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Password visibility toggle
            $('#togglePasswordBtn').on('click', function () {
                var input = $('#passwordInput');
                var icon = $(this).find('i');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            // Quick demo login chip click
            $('.demo-chip').on('click', function () {
                var user = $(this).data('user');
                var pass = $(this).data('pass');
                $('#usernameInput').val(user);
                $('#passwordInput').val(pass);
            });
        });
    </script>
}
