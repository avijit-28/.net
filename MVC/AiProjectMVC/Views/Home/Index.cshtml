@{
    ViewBag.Title = "Role Authorization Matrix & Security Hub";
    var currentUser = Session["CurrentUser"] as AiProjectMVC.Models.EmployeeUser;
    var currentRole = Session["UserRole"] as string ?? "Guest";
    bool isAuthenticated = User.Identity.IsAuthenticated || currentUser != null;

    bool isSuperAdmin = currentRole.IndexOf("SUPERADMIN", StringComparison.OrdinalIgnoreCase) >= 0;
    bool isAdmin = isSuperAdmin || currentRole.IndexOf("ADMIN", StringComparison.OrdinalIgnoreCase) >= 0;
    bool isManager = isSuperAdmin || isAdmin || currentRole.IndexOf("MANAGER", StringComparison.OrdinalIgnoreCase) >= 0;
    bool isHR = isSuperAdmin || isAdmin || currentRole.IndexOf("HR", StringComparison.OrdinalIgnoreCase) >= 0;
    bool isUser = isSuperAdmin || currentRole.IndexOf("USER", StringComparison.OrdinalIgnoreCase) >= 0 || currentRole.IndexOf("EMPLOYEE", StringComparison.OrdinalIgnoreCase) >= 0;
    bool canManage = AiProjectMVC.Models.RoleAuthHelper.CanManageRecords(Session);
}

<div class="py-4">
    <!-- Quick Role Switcher Banner -->
    <div class="custom-card shadow-lg p-4 mb-4 border-0" 
         style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #4338ca 100%); color: white;">
        <div class="row align-items-center">
            <div class="col-lg-5 mb-3 mb-lg-0">
                <span class="badge bg-primary bg-opacity-25 text-white border border-light border-opacity-25 px-3 py-1 mb-2">
                    <i class="bi bi-shield-check me-1"></i> Interactive Role Switcher
                </span>
                <h3 class="fw-bold mb-1">
                    @(isAuthenticated ? (currentUser?.Name ?? User.Identity.Name) : "Anonymous Visitor (Guest)")
                </h3>
                <div class="text-white-50 small mb-2">
                    @if (isAuthenticated)
                    {
                        <span>Active Role:</span>
                        foreach (var r in currentRole.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="badge bg-success ms-1">@r.Trim()</span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-secondary">Not Signed In (Guest)</span>
                    }
                </div>
                <p class="small text-white-50 mb-0">
                    Click any role button on the right to switch roles instantly and test how access permissions react in real-time.
                </p>
            </div>

            <!-- 1-Click Role Switch Buttons -->
            <div class="col-lg-7">
                <div class="bg-white bg-opacity-10 backdrop-blur p-3 rounded-3 border border-white border-opacity-25">
                    <div class="text-white-50 small text-uppercase fw-bold mb-2">
                        <i class="bi bi-cursor-fill me-1"></i> 1-Click Test Role Switcher (No Password Typing Needed):
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <!-- SuperAdmin -->
                        <a href="@Url.Action("QuickSwitch", "Account", new { role = "SuperAdmin", returnUrl = Url.Action("Index", "Home") })" 
                           class="btn btn-sm @(isSuperAdmin ? "btn-danger fw-bold shadow" : "btn-outline-light")">
                            <i class="bi bi-award-fill me-1"></i> 👑 SuperAdmin
                        </a>

                        <!-- Admin -->
                        <a href="@Url.Action("QuickSwitch", "Account", new { role = "Admin", returnUrl = Url.Action("Index", "Home") })" 
                           class="btn btn-sm @(!isSuperAdmin && isAdmin ? "btn-primary fw-bold shadow" : "btn-outline-light")">
                            <i class="bi bi-shield-lock-fill me-1"></i> 🛡️ Admin
                        </a>

                        <!-- HR -->
                        <a href="@Url.Action("QuickSwitch", "Account", new { role = "HR", returnUrl = Url.Action("Index", "Home") })" 
                           class="btn btn-sm @(!isSuperAdmin && !isAdmin && isHR ? "btn-warning text-dark fw-bold shadow" : "btn-outline-light")">
                            <i class="bi bi-briefcase-fill me-1"></i> 💼 HR
                        </a>

                        <!-- Manager -->
                        <a href="@Url.Action("QuickSwitch", "Account", new { role = "Manager", returnUrl = Url.Action("Index", "Home") })" 
                           class="btn btn-sm @(!isSuperAdmin && !isAdmin && !isHR && isManager ? "btn-info text-dark fw-bold shadow" : "btn-outline-light")">
                            <i class="bi bi-people-fill me-1"></i> 👔 Manager
                        </a>

                        <!-- Standard User -->
                        <a href="@Url.Action("QuickSwitch", "Account", new { role = "User", returnUrl = Url.Action("Index", "Home") })" 
                           class="btn btn-sm @(!isAdmin && isUser ? "btn-success fw-bold shadow" : "btn-outline-light")">
                            <i class="bi bi-person-fill me-1"></i> 👤 Standard User
                        </a>

                        <!-- Guest / Logout -->
                        <a href="@Url.Action("QuickSwitch", "Account", new { role = "Guest", returnUrl = Url.Action("Index", "Home") })" 
                           class="btn btn-sm @(!isAuthenticated ? "btn-secondary fw-bold shadow" : "btn-outline-light")">
                            <i class="bi bi-box-arrow-right me-1"></i> 🚪 Guest (Logout)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Clear Permission Matrix Table -->
    <div class="custom-card shadow-sm border-0 mb-4 overflow-hidden">
        <div class="p-4 bg-light border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-1 text-dark">
                    <i class="bi bi-table text-primary me-2"></i> Who Can Access What? (Live Permission Matrix)
                </h4>
                <p class="text-muted small mb-0">
                    This table updates dynamically based on your currently selected role. Click <strong>Test Access</strong> on any row to observe the filter behavior.
                </p>
            </div>
            <div>
                <span class="badge bg-primary px-3 py-2 fs-6">
                    Current: <strong>@currentRole</strong>
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 22%;">Page & Action URL</th>
                        <th style="width: 20%;">Filter & Allowed Role</th>
                        <th style="width: 20%;">Your Live Status</th>
                        <th style="width: 23%;">What Happens When You Click</th>
                        <th style="width: 15%; text-align: center;">Test Access</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- 1. NonSecureMethod -->
                    <tr class="@(isAuthenticated ? "" : "table-success bg-opacity-25")">
                        <td>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-unlock-fill text-success me-1"></i> Non-Secure Method
                            </div>
                            <small class="text-muted"><code>/Home/NonSecureMethod</code></small>
                        </td>
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                [AllowAnonymous]
                            </span>
                            <div class="small text-muted mt-1">Anyone (Public)</div>
                        </td>
                        <td>
                            <span class="badge bg-success px-2 py-1 fs-6">
                                <i class="bi bi-check-circle-fill me-1"></i> ✅ ALLOWED
                            </span>
                        </td>
                        <td class="small text-muted">
                            Opens immediately without login.
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("NonSecureMethod", "Home")" class="btn btn-sm btn-outline-success px-3">
                                <i class="bi bi-arrow-right"></i> Open Page
                            </a>
                        </td>
                    </tr>

                    <!-- 2. SecureMethod -->
                    <tr class="@(isAuthenticated ? "table-success bg-opacity-25" : "table-warning bg-opacity-25")">
                        <td>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-shield-lock-fill text-primary me-1"></i> Secure Method
                            </div>
                            <small class="text-muted"><code>/Home/SecureMethod</code></small>
                        </td>
                        <td>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                [Authorize]
                            </span>
                            <div class="small text-muted mt-1">Any Logged-in Account</div>
                        </td>
                        <td>
                            @if (isAuthenticated)
                            {
                                <span class="badge bg-success px-2 py-1 fs-6">
                                    <i class="bi bi-check-circle-fill me-1"></i> ✅ ALLOWED
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-2 py-1 fs-6">
                                    <i class="bi bi-lock-fill me-1"></i> 🔒 LOGIN REQUIRED
                                </span>
                            }
                        </td>
                        <td class="small text-muted">
                            @if (isAuthenticated)
                            {
                                <span class="text-success">Opens page because you are logged in.</span>
                            }
                            else
                            {
                                <span class="text-warning">Redirects to <code>/Account/Login</code> (HTTP 302).</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("SecureMethod", "Home")" class="btn btn-sm @(isAuthenticated ? "btn-outline-primary" : "btn-warning text-dark") px-3">
                                <i class="bi bi-arrow-right"></i> Test Access
                            </a>
                        </td>
                    </tr>

                    <!-- 3. UserPage -->
                    <tr class="@(isUser ? "table-success bg-opacity-25" : (isAuthenticated ? "table-danger bg-opacity-25" : "table-warning bg-opacity-25"))">
                        <td>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-person-badge-fill text-info me-1"></i> Standard User Page
                            </div>
                            <small class="text-muted"><code>/Home/UserPage</code></small>
                        </td>
                        <td>
                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">
                                [AuthorizeRole(Role.USER)]
                            </span>
                            <div class="small text-muted mt-1">Requires <code>USER</code> Role</div>
                        </td>
                        <td>
                            @if (isUser)
                            {
                                <span class="badge bg-success px-2 py-1 fs-6">
                                    <i class="bi bi-check-circle-fill me-1"></i> ✅ ALLOWED
                                </span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="badge bg-danger px-2 py-1 fs-6">
                                    <i class="bi bi-x-circle-fill me-1"></i> ❌ ACCESS DENIED
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-2 py-1 fs-6">
                                    <i class="bi bi-lock-fill me-1"></i> 🔒 LOGIN REQUIRED
                                </span>
                            }
                        </td>
                        <td class="small text-muted">
                            @if (isUser)
                            {
                                <span class="text-success">Opens page because you have the USER role.</span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="text-danger fw-semibold">Redirects to <code>AccessDenied</code> (HTTP 403).</span>
                            }
                            else
                            {
                                <span class="text-warning">Redirects to Login first.</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("UserPage", "Home")" class="btn btn-sm @(isUser ? "btn-outline-info" : "btn-outline-danger") px-3">
                                <i class="bi bi-arrow-right"></i> Test Access
                            </a>
                        </td>
                    </tr>

                    <!-- 4. Contact (Admin) -->
                    <tr class="@(isAdmin ? "table-success bg-opacity-25" : (isAuthenticated ? "table-danger bg-opacity-25" : "table-warning bg-opacity-25"))">
                        <td>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-shield-check text-warning me-1"></i> Admin Contact Portal
                            </div>
                            <small class="text-muted"><code>/Home/Contact</code></small>
                        </td>
                        <td>
                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25">
                                [AuthorizeRole(Role.ADMIN)]
                            </span>
                            <div class="small text-muted mt-1">Requires <code>ADMIN</code> Role</div>
                        </td>
                        <td>
                            @if (isAdmin)
                            {
                                <span class="badge bg-success px-2 py-1 fs-6">
                                    <i class="bi bi-check-circle-fill me-1"></i> ✅ ALLOWED
                                </span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="badge bg-danger px-2 py-1 fs-6">
                                    <i class="bi bi-x-circle-fill me-1"></i> ❌ ACCESS DENIED
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-2 py-1 fs-6">
                                    <i class="bi bi-lock-fill me-1"></i> 🔒 LOGIN REQUIRED
                                </span>
                            }
                        </td>
                        <td class="small text-muted">
                            @if (isAdmin)
                            {
                                <span class="text-success">Opens page because your role is ADMIN.</span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="text-danger fw-semibold">Redirects to <code>AccessDenied</code> (HTTP 403).</span>
                            }
                            else
                            {
                                <span class="text-warning">Redirects to Login first.</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("Contact", "Home")" class="btn btn-sm @(isAdmin ? "btn-outline-warning" : "btn-outline-danger") px-3">
                                <i class="bi bi-arrow-right"></i> Test Access
                            </a>
                        </td>
                    </tr>

                    <!-- 5. About (SuperAdmin) -->
                    <tr class="@(isSuperAdmin ? "table-success bg-opacity-25" : (isAuthenticated ? "table-danger bg-opacity-25" : "table-warning bg-opacity-25"))">
                        <td>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-award-fill text-danger me-1"></i> SuperAdmin About
                            </div>
                            <small class="text-muted"><code>/Home/About</code></small>
                        </td>
                        <td>
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                [AuthorizeRole(Role.SUPERADMIN)]
                            </span>
                            <div class="small text-muted mt-1">Requires <code>SUPERADMIN</code> Role</div>
                        </td>
                        <td>
                            @if (isSuperAdmin)
                            {
                                <span class="badge bg-success px-2 py-1 fs-6">
                                    <i class="bi bi-check-circle-fill me-1"></i> ✅ ALLOWED
                                </span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="badge bg-danger px-2 py-1 fs-6">
                                    <i class="bi bi-x-circle-fill me-1"></i> ❌ ACCESS DENIED
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-2 py-1 fs-6">
                                    <i class="bi bi-lock-fill me-1"></i> 🔒 LOGIN REQUIRED
                                </span>
                            }
                        </td>
                        <td class="small text-muted">
                            @if (isSuperAdmin)
                            {
                                <span class="text-success">Opens page because you are SUPERADMIN.</span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="text-danger fw-semibold">Blocked! Redirects to <code>AccessDenied</code>.</span>
                            }
                            else
                            {
                                <span class="text-warning">Redirects to Login first.</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("About", "Home")" class="btn btn-sm @(isSuperAdmin ? "btn-outline-success" : "btn-outline-danger") px-3">
                                <i class="bi bi-arrow-right"></i> Test Access
                            </a>
                        </td>
                    </tr>

                    <!-- 6. Add Employee (Admin, HR, Manager) -->
                    <tr class="@(canManage ? "table-success bg-opacity-25" : (isAuthenticated ? "table-danger bg-opacity-25" : "table-warning bg-opacity-25"))">
                        <td>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-person-plus-fill text-primary me-1"></i> Add Employee
                            </div>
                            <small class="text-muted"><code>/Employee/Create</code></small>
                        </td>
                        <td>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                Admin, HR, Manager
                            </span>
                            <div class="small text-muted mt-1">RoleAuthHelper Check</div>
                        </td>
                        <td>
                            @if (canManage)
                            {
                                <span class="badge bg-success px-2 py-1 fs-6">
                                    <i class="bi bi-check-circle-fill me-1"></i> ✅ ALLOWED
                                </span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="badge bg-danger px-2 py-1 fs-6">
                                    <i class="bi bi-x-circle-fill me-1"></i> ❌ BLOCKED
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-2 py-1 fs-6">
                                    <i class="bi bi-lock-fill me-1"></i> 🔒 LOGIN REQUIRED
                                </span>
                            }
                        </td>
                        <td class="small text-muted">
                            @if (canManage)
                            {
                                <span class="text-success">Opens registration with registered user dropdown.</span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="text-danger fw-semibold">Denied: Only Admin, HR, Manager can add.</span>
                            }
                            else
                            {
                                <span class="text-warning">Even admin must sign in first.</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("Create", "Employee")" class="btn btn-sm @(canManage ? "btn-outline-primary" : "btn-outline-danger") px-3">
                                <i class="bi bi-arrow-right"></i> Test Access
                            </a>
                        </td>
                    </tr>

                    <!-- 7. Add Address (Admin, HR, Manager) -->
                    <tr class="@(canManage ? "table-success bg-opacity-25" : (isAuthenticated ? "table-danger bg-opacity-25" : "table-warning bg-opacity-25"))">
                        <td>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i> Add Address
                            </div>
                            <small class="text-muted"><code>/Address/Create</code></small>
                        </td>
                        <td>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                Admin, HR, Manager
                            </span>
                            <div class="small text-muted mt-1">RoleAuthHelper Check</div>
                        </td>
                        <td>
                            @if (canManage)
                            {
                                <span class="badge bg-success px-2 py-1 fs-6">
                                    <i class="bi bi-check-circle-fill me-1"></i> ✅ ALLOWED
                                </span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="badge bg-danger px-2 py-1 fs-6">
                                    <i class="bi bi-x-circle-fill me-1"></i> ❌ BLOCKED
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-2 py-1 fs-6">
                                    <i class="bi bi-lock-fill me-1"></i> 🔒 LOGIN REQUIRED
                                </span>
                            }
                        </td>
                        <td class="small text-muted">
                            @if (canManage)
                            {
                                <span class="text-success">Opens address creation form.</span>
                            }
                            else if (isAuthenticated)
                            {
                                <span class="text-danger fw-semibold">Denied: Only Admin, HR, Manager can add.</span>
                            }
                            else
                            {
                                <span class="text-warning">Even admin must sign in first.</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("Create", "Address")" class="btn btn-sm @(canManage ? "btn-outline-primary" : "btn-outline-danger") px-3">
                                <i class="bi bi-arrow-right"></i> Test Access
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Verified Workflow Feature Cards (Addressing user screenshots) -->
    <div class="row g-3">
        <!-- 1. Password Only Login -->
        <div class="col-md-4">
            <div class="custom-card p-3 h-100 border-start border-4 border-primary">
                <div class="fw-bold text-dark mb-1">
                    <i class="bi bi-key-fill text-primary me-1"></i> 1. Strict Password Login
                </div>
                <p class="text-muted small mb-0">
                    Sign in strictly with registered username/email and password. Phone numbers are no longer accepted as passwords. Even administrators must sign in.
                </p>
            </div>
        </div>

        <!-- 2. Edit Employee Salary -->
        <div class="col-md-4">
            <div class="custom-card p-3 h-100 border-start border-4 border-success">
                <div class="fw-bold text-dark mb-1">
                    <i class="bi bi-currency-rupee text-success me-1"></i> 2. Edit Employee & Salary
                </div>
                <p class="text-muted small mb-0">
                    Salary is fetched directly from database and displayed in the edit box. Admin, HR, and Manager modifications directly update the <code>Employee</code> table.
                </p>
            </div>
        </div>

        <!-- 3. Strict Validations -->
        <div class="col-md-4">
            <div class="custom-card p-3 h-100 border-start border-4 border-info">
                <div class="fw-bold text-dark mb-1">
                    <i class="bi bi-shield-check text-info me-1"></i> 3. Registration Validations
                </div>
                <p class="text-muted small mb-0">
                    Mandatory fields enforced: RFC standard email, exactly 10-digit phone, and minimum 8 alphanumeric chars with special symbols for passwords.
                </p>
            </div>
        </div>

        <!-- 4. Registered User Dropdown -->
        <div class="col-md-4">
            <div class="custom-card p-3 h-100 border-start border-4 border-warning">
                <div class="fw-bold text-dark mb-1">
                    <i class="bi bi-person-lines-fill text-warning me-1"></i> 4. Employee ID Dropdown
                </div>
                <p class="text-muted small mb-0">
                    When adding an employee, ID field is a dropdown showing only users registered in <code>EmployeeUser</code> who are not yet in <code>Employee</code>.
                </p>
            </div>
        </div>

        <!-- 5. Mandatory Address ID -->
        <div class="col-md-4">
            <div class="custom-card p-3 h-100 border-start border-4 border-danger">
                <div class="fw-bold text-dark mb-1">
                    <i class="bi bi-geo-fill text-danger me-1"></i> 5. Mandatory Address (No NULLs)
                </div>
                <p class="text-muted small mb-0">
                    Linked Address is mandatory to satisfy database NOT NULL constraints. Clear error messages prevent SQL exceptions.
                </p>
            </div>
        </div>

        <!-- 6. City to Address Correlation -->
        <div class="col-md-4">
            <div class="custom-card p-3 h-100 border-start border-4 border-secondary">
                <div class="fw-bold text-dark mb-1">
                    <i class="bi bi-link-45deg text-secondary me-1"></i> 6. City & Address Matching
                </div>
                <p class="text-muted small mb-0">
                    Validates that employee City matches the selected Linked Address. If City is Kolkata, an address in Delhi is automatically flagged and rejected.
                </p>
            </div>
        </div>
    </div>
</div>
