@model IEnumerable<LMS.Models.Submission>
@{
    ViewBag.Title = "My Assignment Submissions";
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Student")" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Assignments</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Project Portfolio
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Project & Assignment Submissions</h2>
            <p class="text-muted small mb-0">Track evaluation progress, faculty feedback remarks, and score rubrics</p>
        </div>
        <div>
            <a href="@Url.Action("MyCourses", "Student")" class="btn btn-outline-primary rounded-pill px-4 fw-semibold shadow-xs">
                <i class="bi bi-play-circle me-1"></i> Continue Courses
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white border-0">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-file-earmark-check text-muted display-4"></i>
            </div>
            <h4 class="fw-bold">No assignments submitted yet</h4>
            <p class="text-muted small mb-3">Practical project challenges can be accessed directly from within your course classroom player.</p>
            <div>
                <a href="@Url.Action("MyCourses", "Student")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    Go to My Courses
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom shadow-sm overflow-hidden bg-white border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-4">Assignment Title</th>
                            <th>Curriculum Track</th>
                            <th>Submitted Date</th>
                            <th>Review Status</th>
                            <th>Awarded Score</th>
                            <th>Faculty Feedback</th>
                            <th class="text-end pe-4">Workspace</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@s.Assignment.Title</div>
                                    <small class="text-muted font-monospace" style="font-size: 11px;">Max: @s.Assignment.MaxMarks pts</small>
                                </td>
                                <td><span class="badge bg-light text-dark border rounded-pill px-3 py-1">@(s.Assignment.Course?.Title ?? "Course")</span></td>
                                <td><span class="small text-muted">@s.SubmittedDate.ToString("MMM dd, yyyy")</span></td>
                                <td>
                                    @if (s.Status == "Graded")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Graded
                                        </span>
                                    }
                                    else if (s.Status == "Late")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                                            Late Submission
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                            <span class="pulse-dot pulse-primary"></span> In Review
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (s.Marks.HasValue)
                                    {
                                        <strong class="text-success font-monospace">@s.Marks / @s.Assignment.MaxMarks pts</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Pending Grading</span>
                                    }
                                </td>
                                <td class="small text-secondary" style="max-width: 250px;">
                                    @(string.IsNullOrEmpty(s.Feedback) ? "Awaiting faculty evaluation" : (s.Feedback.Length > 80 ? s.Feedback.Substring(0, 77) + "..." : s.Feedback))
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Details", "Assignment", new { id = s.AssignmentId })" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                        View Details &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
