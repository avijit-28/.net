@model IEnumerable<LMS.Models.Submission>
@{
    var assignment = (LMS.Models.Assignment)ViewBag.Assignment;
    ViewBag.Title = "Submissions - " + assignment.Title;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Assignments", "Instructor", new { courseId = assignment.CourseId })">Assignments</a></li>
            <li class="breadcrumb-item active" aria-current="page">Submissions: @assignment.Title</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-inbox-fill me-2 text-primary"></i>Student Submissions</h2>
            <p class="text-muted mb-0">Reviewing answers for <strong>@assignment.Title</strong> (Course: @assignment.Course.Title)</p>
        </div>
        <div>
            <span class="badge bg-light text-dark border p-2 fs-6">
                Max Score: <strong>@assignment.MaxMarks</strong> pts
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-folder2-open text-muted display-4"></i>
                <h4 class="mt-3 fw-bold">No submissions yet</h4>
                <p class="text-muted">Enrolled students have not submitted responses for this assignment yet.</p>
                <a href="@Url.Action("Assignments", "Instructor", new { courseId = assignment.CourseId })" class="btn btn-outline-secondary mt-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to Assignments
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student ID</th>
                            <th>Submitted Date</th>
                            <th>Status</th>
                            <th>Score</th>
                            <th>Attached Work</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@sub.StudentId</div>
                                </td>
                                <td>
                                    @sub.SubmittedDate.ToString("MMM dd, yyyy HH:mm")
                                    @if (assignment.DueDate.HasValue && sub.SubmittedDate > assignment.DueDate.Value)
                                    {
                                        <span class="badge bg-danger ms-1">Late</span>
                                    }
                                </td>
                                <td>
                                    @if (sub.Status == "Graded")
                                    {
                                        <span class="badge bg-success">Graded</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending Review</span>
                                    }
                                </td>
                                <td>
                                    @if (sub.Marks.HasValue)
                                    {
                                        <span class="fw-bold text-primary">@sub.Marks / @assignment.MaxMarks</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-- / @assignment.MaxMarks</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(sub.FileUrl))
                                    {
                                        <a href="@sub.FileUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-paperclip me-1"></i> Attachment
                                        </a>
                                    }
                                    else if (!string.IsNullOrEmpty(sub.SubmissionText))
                                    {
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;">
                                            @sub.SubmissionText
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="@Url.Action("Grade", "Instructor", new { id = sub.SubmissionId })" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil-square me-1"></i> Grade & Feedback
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
