                    <!-- Master Search Box (Passing Data to Content Page) -->
                    <asp:Panel ID="pnlMasterSearch" runat="server" DefaultButton="btnMasterSearch" CssClass="master-search-bar">
                        <div class="search-input-group">
                            <span class="search-icon">&#128269;</span>
                            <asp:TextBox ID="txtMasterSearch" runat="server" CssClass="master-search-input" placeholder="Search User..." autocomplete="off"></asp:TextBox>
                            <asp:Button ID="btnMasterSearch" runat="server" Text="Search" OnClick="btnMasterSearch_Click" CssClass="master-search-btn" CausesValidation="false" />
                        </div>
                    </asp:Panel>

                    <div class="online-pill" title="Live Users Online (Application State)">
                        <span class="online-dot"></span>
                        <span>Online: </span>
                        <asp:Label ID="lblOnlineUsers" runat="server" Text="0"></asp:Label>
                    </div>

                    <% if (Session["UserName"] != null && !string.IsNullOrWhiteSpace(Session["UserName"].ToString())) { %>
                        <div id="sessionPill" class="session-pill" title="Live Session Countdown &bull; Auto-redirects to sign-in upon expiry">
                            <span class="session-dot"></span>
                            <span>Session: </span>
                            <span id="sessionTimerText">--:--</span>
                        </div>
                    <% } %>

                    <div class="user-badge">
                        <span>&#128100;</span>
                        <asp:Label ID="lblCurrentUser" runat="server" Text="Guest"></asp:Label>
                    </div>

                    <% if (Session["UserName"] != null && !string.IsNullOrWhiteSpace(Session["UserName"].ToString())) { %>
                        <a href="<%= ResolveUrl("~/FirstPage?action=logout") %>" class="btn-auth btn-auth-logout" title="Sign out of current session">
                            &#128682; Sign Out
                        </a>
                    <% } else { %>
                        <a href="<%= ResolveUrl("~/FirstPage") %>" class="btn-auth" title="Sign in to your account">
                            &#128272; Sign In
                        </a>
                    <% } %>
                </div>
