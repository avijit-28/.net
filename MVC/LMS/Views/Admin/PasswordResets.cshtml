@model IEnumerable<LMS.Models.PasswordResetRequest>
@{
    ViewBag.Title = "Password Reset Requests";
    string currentStatus = ViewBag.CurrentStatus as string ?? "Pending";
    string search = ViewBag.Search as string ?? "";
    int pendingCount = ViewBag.PendingCount != null ? (int)ViewBag.PendingCount : 0;
    int approvedCount = ViewBag.ApprovedCount != null ? (int)ViewBag.ApprovedCount : 0;
    int rejectedCount = ViewBag.RejectedCount != null ? (int)ViewBag.RejectedCount : 0;
    int completedCount = ViewBag.CompletedCount != null ? (int)ViewBag.CompletedCount : 0;
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-cyan text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("PendingApprovals", "Admin")" class="text-cyan text-decoration-none">Approvals</a></li>
            <li class="breadcrumb-item active text-white-50" aria-current="page">Password Reset Requests</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge px-3 py-1 rounded-pill fw-semibold" style="background: rgba(255, 122, 24, 0.2); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.4);">
                    <i class="bi bi-key-fill me-1"></i> Security Verification Portal
                </span>
                @if (pendingCount > 0)
                {
                    <span class="badge bg-danger rounded-pill px-2 py-1">@pendingCount Pending Verification</span>
                }
            </div>
            <h2 class="fw-extrabold mb-1 tracking-tight text-white">Password Reset Authorizations</h2>
            <p class="text-muted small mb-0">
                Review and approve password reset requests from instructors and users before granting reset access.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("PendingApprovals", "Admin")" class="btn rounded-pill px-3 fw-semibold text-white" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2);">
                <i class="bi bi-shield-check me-1 text-cyan"></i> Registration Approvals
            </a>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-primary rounded-pill px-3 fw-semibold text-white shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert" style="background: rgba(53, 201, 138, 0.2); color: #35C98A; border-left: 4px solid #35C98A !important;">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert" style="background: rgba(255, 122, 24, 0.2); color: #FF7A18; border-left: 4px solid #FF7A18 !important;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["WarningMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert" style="background: rgba(239, 68, 68, 0.2); color: #EF4444; border-left: 4px solid #EF4444 !important;">
            <i class="bi bi-x-circle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter & Search Controls -->
    <div class="card p-3 mb-4 shadow-sm" style="background: rgba(11, 52, 69, 0.7); border: 1px solid rgba(255, 255, 255, 0.12); backdrop-filter: blur(8px);">
        @using (Html.BeginForm("PasswordResets", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-lg-7 d-flex flex-wrap gap-2 align-items-center">
                <span class="small fw-bold text-white-50 text-uppercase me-1" style="font-size: 11px;">Filter:</span>
                <a href="@Url.Action("PasswordResets", "Admin", new { statusFilter = "Pending", search = search })" 
                   class="btn btn-sm rounded-pill px-3 fw-bold @(currentStatus == "Pending" ? "text-white" : "text-white-50")"
                   style="@(currentStatus == "Pending" ? "background: #FF7A18; border: 1px solid #FF7A18;" : "background: rgba(6, 35, 48, 0.6); border: 1px solid rgba(255,255,255,0.1);")">
                    <i class="bi bi-clock-history me-1"></i> Pending (@pendingCount)
                </a>
                <a href="@Url.Action("PasswordResets", "Admin", new { statusFilter = "Approved", search = search })" 
                   class="btn btn-sm rounded-pill px-3 fw-bold @(currentStatus == "Approved" ? "text-white" : "text-white-50")"
                   style="@(currentStatus == "Approved" ? "background: #35C98A; border: 1px solid #35C98A;" : "background: rgba(6, 35, 48, 0.6); border: 1px solid rgba(255,255,255,0.1);")">
                    <i class="bi bi-check-circle me-1"></i> Approved (@approvedCount)
                </a>
                <a href="@Url.Action("PasswordResets", "Admin", new { statusFilter = "Rejected", search = search })" 
                   class="btn btn-sm rounded-pill px-3 fw-bold @(currentStatus == "Rejected" ? "text-white" : "text-white-50")"
                   style="@(currentStatus == "Rejected" ? "background: #EF4444; border: 1px solid #EF4444;" : "background: rgba(6, 35, 48, 0.6); border: 1px solid rgba(255,255,255,0.1);")">
                    <i class="bi bi-x-circle me-1"></i> Declined (@rejectedCount)
                </a>
                <a href="@Url.Action("PasswordResets", "Admin", new { statusFilter = "Completed", search = search })" 
                   class="btn btn-sm rounded-pill px-3 fw-bold @(currentStatus == "Completed" ? "text-white" : "text-white-50")"
                   style="@(currentStatus == "Completed" ? "background: #27B8D6; border: 1px solid #27B8D6;" : "background: rgba(6, 35, 48, 0.6); border: 1px solid rgba(255,255,255,0.1);")">
                    <i class="bi bi-shield-lock-fill me-1"></i> Completed (@completedCount)
                </a>
                <a href="@Url.Action("PasswordResets", "Admin", new { statusFilter = "All", search = search })" 
                   class="btn btn-sm rounded-pill px-3 fw-bold @(currentStatus == "All" ? "text-white" : "text-white-50")"
                   style="@(currentStatus == "All" ? "background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3);" : "background: rgba(6, 35, 48, 0.6); border: 1px solid rgba(255,255,255,0.1);")">
                    All
                </a>
            </div>

            <div class="col-lg-5">
                <div class="input-group input-group-sm">
                    <input type="hidden" name="statusFilter" value="@currentStatus" />
                    <input type="text" name="search" value="@search" class="form-control text-white" placeholder="Search requester name or email..." style="background: rgba(6, 35, 48, 0.85); border-color: rgba(255, 255, 255, 0.15);" />
                    <button type="submit" class="btn text-white fw-bold px-3" style="background: #FF7A18; border-color: #FF7A18;">
                        <i class="bi bi-search"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(search) || currentStatus != "Pending")
                    {
                        <a href="@Url.Action("PasswordResets", "Admin")" class="btn btn-outline-light" title="Reset Filters">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Requests Table Card -->
    <div class="card shadow-sm overflow-hidden" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12);">
        <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center" style="background: rgba(11, 52, 69, 0.7); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
            <h5 class="fw-bold mb-0 text-white">
                <i class="bi bi-key me-2 text-orange"></i>Requests List (@Model.Count())
            </h5>
            <span class="badge rounded-pill text-white-50 small" style="background: rgba(255,255,255,0.08);">
                Filter: @currentStatus
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-shield-check text-cyan" style="font-size: 3rem;"></i>
                </div>
                <h5 class="text-white fw-bold">No Password Reset Requests Found</h5>
                <p class="text-muted small mb-3">There are no password reset authorization requests matching the selected filter criteria.</p>
                <a href="@Url.Action("PasswordResets", "Admin", new { statusFilter = "All" })" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    View All Historical Records
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-white" style="border-color: rgba(255, 255, 255, 0.08);">
                    <thead style="background: rgba(4, 24, 34, 0.8); font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4 text-white-50">Requester</th>
                            <th class="text-white-50">Account Role</th>
                            <th class="text-white-50">Request Reason</th>
                            <th class="text-white-50">Submitted</th>
                            <th class="text-white-50">Status</th>
                            <th class="text-white-50">Verification Action / Reset Link</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var resetUrl = Url.Action("ResetPassword", "Account", new { token = item.ResetToken }, Request.Url.Scheme);
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 38px; height: 38px; background: #FF7A18; flex-shrink: 0;">
                                            @(item.User?.FullName?.Substring(0, 1).ToUpper() ?? item.Email.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">@(item.User?.FullName ?? "User Account")</div>
                                            <div class="small text-muted font-monospace">@item.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Role == "Instructor")
                                    {
                                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(39, 184, 214, 0.2); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.4);">
                                            <i class="bi bi-mortarboard me-1"></i> Instructor
                                        </span>
                                    }
                                    else if (item.Role == "Admin")
                                    {
                                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(239, 68, 68, 0.2); color: #EF4444; border: 1px solid rgba(239, 68, 68, 0.4);">
                                            <i class="bi bi-shield-lock me-1"></i> Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(53, 201, 138, 0.2); color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.4);">
                                            <i class="bi bi-person me-1"></i> @(item.Role ?? "Student")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="small text-light" style="max-width: 260px; line-height: 1.4;">
                                        @(string.IsNullOrEmpty(item.RequestReason) ? "No reason specified" : item.RequestReason)
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-white">@item.RequestDate.ToString("MMM dd, yyyy")</div>
                                    <div class="small text-muted font-monospace">@item.RequestDate.ToString("hh:mm tt") UTC</div>
                                </td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold">
                                            <i class="bi bi-clock-history me-1"></i> Pending
                                        </span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success px-3 py-1 rounded-pill fw-bold">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approved
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger px-3 py-1 rounded-pill fw-bold">
                                            <i class="bi bi-x-circle-fill me-1"></i> Declined
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge px-3 py-1 rounded-pill fw-bold" style="background: rgba(39, 184, 214, 0.2); color: #27B8D6; border: 1px solid #27B8D6;">
                                            <i class="bi bi-shield-lock-fill me-1"></i> Completed
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <div class="d-flex gap-2">
                                            @using (Html.BeginForm("ApprovePasswordReset", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", item.RequestId)
                                                <button type="submit" class="btn btn-sm text-white fw-bold px-3 rounded-pill" style="background: #35C98A; border: none;" onclick="return confirm('Approve password reset request for @item.Email?');">
                                                    <i class="bi bi-check-circle me-1"></i> Approve
                                                </button>
                                            }
                                            @using (Html.BeginForm("RejectPasswordReset", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", item.RequestId)
                                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold px-3 rounded-pill" onclick="return confirm('Decline password reset request for @item.Email?');">
                                                    <i class="bi bi-x-circle me-1"></i> Decline
                                                </button>
                                            }
                                        </div>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" onclick="navigator.clipboard.writeText('@resetUrl'); alert('Reset link copied to clipboard!\n@resetUrl');">
                                                <i class="bi bi-clipboard me-1 text-cyan"></i> Copy Link
                                            </button>
                                            <a href="@resetUrl" target="_blank" class="btn btn-sm rounded-pill px-2 text-white" style="background: rgba(255, 122, 24, 0.3); border: 1px solid #FF7A18;" title="Open Reset Link">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        </div>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="small text-muted"><i class="bi bi-check2-all text-success me-1"></i>Password reset finished</span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted"><i class="bi bi-slash-circle me-1"></i>Declined by admin</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
