@model IEnumerable<LMS.Models.QuizAttempt>
@{
    ViewBag.Title = "Quiz Attempt History";
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Student")" class="text-white-50 text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active text-white" aria-current="page">Quiz Assessments</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge rounded-pill mb-2 fw-semibold px-3 py-1" style="background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.3);">
                <i class="bi bi-patch-question-fill me-1"></i> Assessment History
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight text-white">Quiz Assessment Records</h2>
            <p class="small mb-0" style="color: rgba(255, 255, 255, 0.7);">Review exam performance, percentage scores, pass/fail evaluations, and breakdowns</p>
        </div>
        <div>
            <a href="@Url.Action("MyCourses", "Student")" class="btn btn-primary rounded-pill px-4 fw-semibold text-white shadow-sm">
                <i class="bi bi-play-circle me-1"></i> Continue Courses
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm border-0" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.12); backdrop-filter: blur(8px);">
            <div class="rounded-circle p-4 d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; background: rgba(255, 122, 24, 0.12); color: #FF7A18;">
                <i class="bi bi-patch-question display-5"></i>
            </div>
            <h4 class="fw-bold text-white mb-2">No quizzes taken yet</h4>
            <p class="small mb-4" style="color: rgba(255, 255, 255, 0.65); max-width: 480px; margin-left: auto; margin-right: auto;">
                Interactive assessments can be launched directly within each module in the classroom after completing curriculum lessons.
            </p>
            <div>
                <a href="@Url.Action("MyCourses", "Student")" class="btn btn-primary rounded-pill px-4 py-2 fw-bold text-white shadow-sm">
                    <i class="bi bi-collection-play me-1"></i> Go to My Courses
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom shadow-sm overflow-hidden border-0" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.12); backdrop-filter: blur(8px);">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="color: #E2E8F0;">
                    <thead style="background: #0B3445; color: #94A3B8; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4 py-3">Quiz Title</th>
                            <th class="py-3">Curriculum Track</th>
                            <th class="py-3">Score %</th>
                            <th class="py-3">Earned Marks</th>
                            <th class="py-3">Evaluation Outcome</th>
                            <th class="py-3">Completed Timestamp</th>
                            <th class="text-end pe-4 py-3">Breakdown</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr style="border-color: rgba(255, 255, 255, 0.08);">
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-white">@a.Quiz.Title</div>
                                    <small class="font-monospace" style="font-size: 11px; color: rgba(255, 255, 255, 0.5);">Attempt ID: #@a.AttemptId</small>
                                </td>
                                <td>
                                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(39, 184, 214, 0.15); color: #38BDF8; border: 1px solid rgba(56, 189, 248, 0.25);">
                                        @(a.Quiz.Course?.Title ?? "Course")
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-extrabold fs-6 @(a.IsPassed ? "text-success" : "text-danger")">
                                        @a.Score%
                                    </div>
                                </td>
                                <td><span class="small font-monospace text-white-50">@a.ObtainedMarks / @a.TotalMarks pts</span></td>
                                <td>
                                    @if (a.IsPassed)
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(16, 185, 129, 0.15); color: #34D399; border: 1px solid rgba(52, 211, 153, 0.3);">
                                            <i class="bi bi-check-circle-fill me-1"></i>PASSED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(239, 68, 68, 0.15); color: #F87171; border: 1px solid rgba(248, 113, 113, 0.3);">
                                            <i class="bi bi-x-circle-fill me-1"></i>FAILED
                                        </span>
                                    }
                                </td>
                                <td><span class="small" style="color: rgba(255, 255, 255, 0.65);">@(a.CompletedAt.HasValue ? a.CompletedAt.Value.ToString("MMM dd, yyyy HH:mm") : "-")</span></td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Result", "Quiz", new { attemptId = a.AttemptId })" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                        View Result &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
