        <!-- TAB 3: COMPLETE REFERENCE & GUIDE          -->
        <!-- ========================================== -->
        <div class="tab-pane fade" id="pills-guide" role="tabpanel">

            <div class="row g-4">
                
                <div class="col-lg-6">
                    <div class="card-modern p-4 h-100">
                        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-layers-half me-2"></i>What is 3-Layer Architecture?</h5>
                        <p class="text-muted">
                            The 3-tier/layer architectural pattern cleanly separates concerns into three distinct layers:
                        </p>
                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item px-0">
                                <strong class="text-dark">1. BEL (Business Entity Layer):</strong>
                                <p class="text-muted small mb-0">Holds POCO models (like <code>Users</code> and <code>Customer</code>) that map to database table rows and carry data across layers.</p>
                            </li>
                            <li class="list-group-item px-0">
                                <strong class="text-dark">2. BLL (Business Logic Layer):</strong>
                                <p class="text-muted small mb-0">Encapsulates business rules and validations (e.g., <code>UserService</code>). It calls the DAL and does not touch SQL directly.</p>
                            </li>
                            <li class="list-group-item px-0">
                                <strong class="text-dark">3. DAL (Data Access Layer):</strong>
                                <p class="text-muted small mb-0">Responsible exclusively for communicating with the database (e.g., <code>DBFunction</code>) using ADO.NET commands and stored procedures.</p>
                            </li>
                        </ul>
                        <div class="alert alert-info py-2 small mb-0">
                            <strong>Key Benefit:</strong> Changes in the database or business rules do not break the API or Frontend, ensuring high maintainability and security.
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card-modern p-4 h-100">
                        <h5 class="fw-bold text-success mb-3"><i class="bi bi-code-slash me-2"></i>HTTP Verbs &amp; Parameter Binding</h5>
                        <p class="text-muted">
                            RESTful APIs map CRUD operations directly to standard HTTP verbs:
                        </p>
                        <div class="table-responsive mb-3">
                            <table class="table table-bordered table-sm small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>CRUD Action</th>
                                        <th>HTTP Verb</th>
                                        <th>Attribute</th>
                                        <th>Parameter Source</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>Create</strong></td>
                                        <td><span class="badge badge-method badge-post">POST</span></td>
                                        <td><code>[HttpPost]</code></td>
                                        <td><code>[FromBody]</code> (Request payload)</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Read</strong></td>
                                        <td><span class="badge badge-method badge-get">GET</span></td>
                                        <td><code>[HttpGet]</code></td>
                                        <td><code>[FromUri]</code> (URL query string)</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Update</strong></td>
                                        <td><span class="badge badge-method badge-put">PUT</span></td>
                                        <td><code>[HttpPut]</code></td>
                                        <td>ID in URI + Data in <code>[FromBody]</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Delete</strong></td>
                                        <td><span class="badge badge-method badge-delete">DELETE</span></td>
                                        <td><code>[HttpDelete]</code></td>
                                        <td><code>[FromUri]</code> or route parameter</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="p-3 bg-light rounded-3 border small">
                            <strong>Parameter Binding Rule:</strong> Simple types (<code>int</code>, <code>string</code>) default to <code>[FromUri]</code>; Complex types (<code>Users</code>, <code>Customer</code>) default to <code>[FromBody]</code>.
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card-modern p-4">
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-database-check text-info me-2"></i>Stored Procedures Reference (WEBAPI_DB)</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="border rounded p-3 bg-light">
                                    <h6 class="fw-bold text-primary">Project 1 Stored Procedures:</h6>
                                    <ul class="small mb-0 text-muted">
                                        <li><code>spGetLoginDetails</code> - Validates UserID &amp; UserPassword.</li>
                                        <li><code>spInsertUsers</code> - Creates a new user record.</li>
                                        <li><code>spUpdateUsers</code> - Updates existing user details.</li>
                                        <li><code>spDeleteUser</code> - Deletes a user by ID.</li>
                                        <li><code>spGetAllUsers</code> - Retrieves full user list.</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded p-3 bg-light">
                                    <h6 class="fw-bold text-success">Project 2 Stored Procedures:</h6>
                                    <ul class="small mb-0 text-muted">
                                        <li><code>spGetCustomers</code> - Fetches all customer records.</li>
                                        <li><code>spGetCustomerByID</code> - Fetches specific customer by ID.</li>
                                        <li><code>spInsertCustomer</code> - Inserts customer and returns generated ID via <code>OUTPUT</code>.</li>
                                        <li><code>spUpdateCustomer</code> - Updates customer data by ID.</li>
                                        <li><code>spDeleteCustomer</code> - Deletes customer by ID.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>

<!-- Customer Edit Modal -->
<div class="modal fade" id="customerEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="customerModalTitle">Edit Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="modalEditCustForm" onsubmit="event.preventDefault(); submitCustomerEditModal();">
                    <input type="hidden" id="modalCustId">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Name</label>
                        <input type="text" id="modalCustName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mobile Number</label>
                        <input type="text" id="modalCustMobile" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email</label>
                        <input type="email" id="modalCustEmail" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Country</label>
                        <input type="text" id="modalCustCountry" class="form-control" required>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning fw-semibold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    // --- Helper Functions ---
    function logResponse(method, url, status, data, isCust = false) {
        const statusBadge = document.getElementById(isCust ? 'custResponseStatusBadge' : 'responseStatusBadge');
        const urlInfo = document.getElementById(isCust ? 'custRequestUrlInfo' : 'requestUrlInfo');
        const output = document.getElementById(isCust ? 'custResponseOutput' : 'responseOutput');

        if (status >= 200 && status < 300) {
            statusBadge.className = 'badge bg-success';
            statusBadge.innerText = `HTTP ${status} OK`;
        } else {
            statusBadge.className = 'badge bg-danger';
            statusBadge.innerText = `HTTP ${status} Error`;
        }

        urlInfo.innerText = `${method} ${url}`;
        output.innerText = typeof data === 'object' ? JSON.stringify(data, null, 2) : String(data);
    }

    // ==========================================
    // PROJECT 1: USERS API HANDLERS
    // ==========================================
    function loadUsersTable() {
        const tbody = document.getElementById('usersTableBody');
        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Refreshing users...</td></tr>';
        
        fetch('/api/User/GetAllUsers')
            .then(res => res.json())
            .then(users => {
                if (!users || users.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">No users found. Use form above to add one.</td></tr>';
                    return;
                }
                tbody.innerHTML = users.map(u => `
                    <tr>
                        <td class="ps-3"><span class="badge bg-light text-dark border">#${u.UserID}</span></td>
                        <td class="fw-semibold text-primary">${u.UserName || ''}</td>
                        <td><code>•••••••</code></td>
                        <td><span class="badge bg-secondary">${u.UserRoles || 'User'}</span></td>
                        <td>${u.UserEmailID || ''}</td>
                        <td class="text-end pe-3">
                            <button class="btn btn-sm btn-outline-primary me-1" onclick="selectUserForLogin(${u.UserID}, '${u.UserPassword}')">
                                <i class="bi bi-key-fill"></i> Test Login
                            </button>
                            <button class="btn btn-sm btn-outline-warning me-1" onclick="selectUserForUpdate(${u.UserID}, '${u.UserName}', '${u.UserRoles}', '${u.UserEmailID}')">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteUserPrompt(${u.UserID})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            })
            .catch(err => {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-3 text-danger">Error loading users: ${err.message}</td></tr>`;
            });
    }

    function selectUserForLogin(id, pwd) {
        document.getElementById('loginUserId').value = id;
        document.getElementById('loginPassword').value = pwd;
        handleUserLogin();
    }

    function selectUserForUpdate(id, name, role, email) {
        document.getElementById('updateUserId').value = id;
        document.getElementById('updateUserName').value = name;
        document.getElementById('updateUserRole').value = role;
        document.getElementById('updateEmail').value = email;
        window.location.hash = 'formUpdateUser';
    }

    function handleUserLogin() {
        const id = document.getElementById('loginUserId').value;
        const pwd = document.getElementById('loginPassword').value;
        const url = `/api/User/Loging?UserID=${encodeURIComponent(id)}&UserPassword=${encodeURIComponent(pwd)}`;

        fetch(url)
            .then(res => res.json().then(data => ({ status: res.status, data })))
            .then(res => {
                logResponse('GET', url, res.status, res.data);
            })
            .catch(err => logResponse('GET', url, 500, err.message));
    }

    function handleInsertUser() {
        const payload = {
            UserID: parseInt(document.getElementById('insertUserId').value),
            UserName: document.getElementById('insertUserName').value,
            UserRoles: document.getElementById('insertUserRole').value,
            UserPassword: document.getElementById('insertPassword').value,
            UserEmailID: document.getElementById('insertEmail').value
        };
        const url = '/api/User/InsertUser';

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json().then(data => ({ status: res.status, data })))
        .then(res => {
            logResponse('POST', url, res.status, res.data);
            loadUsersTable();
            document.getElementById('formInsertUser').reset();
        })
        .catch(err => logResponse('POST', url, 500, err.message));
    }

    function handleUpdateUser() {
        const id = parseInt(document.getElementById('updateUserId').value);
        const payload = {
            UserID: id,
            UserName: document.getElementById('updateUserName').value,
            UserRoles: document.getElementById('updateUserRole').value,
            UserPassword: document.getElementById('updatePassword').value,
            UserEmailID: document.getElementById('updateEmail').value
        };
        const url = `/api/User/UpdateUser?UserID=${id}`;

        fetch(url, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json().then(data => ({ status: res.status, data })))
        .then(res => {
            logResponse('PUT', url, res.status, res.data);
            loadUsersTable();
        })
        .catch(err => logResponse('PUT', url, 500, err.message));
    }

    function deleteUserPrompt(id) {
        if (confirm(`Are you sure you want to delete User #${id}?`)) {
            document.getElementById('deleteUserId').value = id;
            handleDeleteUser();
        }
    }

    function handleDeleteUser() {
        const id = document.getElementById('deleteUserId').value;
        const url = `/api/User/DeleteUser?UserID=${encodeURIComponent(id)}`;

        fetch(url, { method: 'DELETE' })
            .then(res => res.json().then(data => ({ status: res.status, data })))
            .then(res => {
                logResponse('DELETE', url, res.status, res.data);
                loadUsersTable();
            })
            .catch(err => logResponse('DELETE', url, 500, err.message));
    }

    // ==========================================
    // PROJECT 2: CUSTOMER API HANDLERS
    // ==========================================
    function loadCustomersTable() {
        const tbody = document.getElementById('customersTableBody');
        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Refreshing customers...</td></tr>';

        fetch('/api/CustomerAPI/GetCustomers')
            .then(res => res.json())
            .then(customers => {
                if (!customers || customers.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">No customers found.</td></tr>';
                    return;
                }
                tbody.innerHTML = customers.map(c => `
                    <tr>
                        <td class="ps-3"><span class="badge bg-light text-dark border">#${c.CustomerId}</span></td>
                        <td class="fw-semibold text-primary">${c.Name || ''}</td>
                        <td><code>${c.MobileNo || ''}</code></td>
                        <td>${c.EmailID || ''}</td>
                        <td><span class="badge bg-info text-dark">${c.Country || ''}</span></td>
                        <td class="text-end pe-3">
                            <button class="btn btn-sm btn-outline-warning me-1" onclick="openCustomerEditModal(${c.CustomerId}, '${c.Name}', '${c.MobileNo}', '${c.EmailID}', '${c.Country}')">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteCustomerApi(${c.CustomerId})">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                `).join('');
            })
            .catch(err => {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-3 text-danger">Error: ${err.message}</td></tr>`;
            });
    }

    function handleAddCustomer() {
        const payload = {
            Name: document.getElementById('custName').value,
            MobileNo: document.getElementById('custMobile').value,
            EmailID: document.getElementById('custEmail').value,
            Country: document.getElementById('custCountry').value
        };
        const url = '/api/CustomerAPI/InsertCustomer';

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json().then(data => ({ status: res.status, data })))
        .then(res => {
            logResponse('POST', url, res.status, res.data, true);
            loadCustomersTable();
            document.getElementById('formAddCustomer').reset();
        })
        .catch(err => logResponse('POST', url, 500, err.message, true));
    }

    function handleGetCustomerById() {
        const id = document.getElementById('searchCustomerId').value;
        const url = `/api/CustomerAPI/GetCustomerByID?id=${encodeURIComponent(id)}`;

        fetch(url)
            .then(res => res.json().then(data => ({ status: res.status, data })))
            .then(res => {
                logResponse('GET', url, res.status, res.data, true);
                const resBox = document.getElementById('customerSearchResult');
                if (res.status === 200 && res.data) {
                    resBox.innerHTML = `
                        <div class="text-success fw-bold mb-1"><i class="bi bi-check-circle me-1"></i> Customer Found:</div>
                        <div><strong>Name:</strong> ${res.data.Name}</div>
                        <div><strong>Mobile:</strong> ${res.data.MobileNo} &bull; <strong>Email:</strong> ${res.data.EmailID}</div>
                        <div><strong>Country:</strong> <span class="badge bg-info text-dark">${res.data.Country}</span></div>
                    `;
                } else {
                    resBox.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i> ${res.data || 'Customer not found.'}</span>`;
                }
            })
            .catch(err => {
                logResponse('GET', url, 500, err.message, true);
                document.getElementById('customerSearchResult').innerHTML = `<span class="text-danger">Error: ${err.message}</span>`;
            });
    }

    function openCustomerEditModal(id, name, mobile, email, country) {
        document.getElementById('modalCustId').value = id;
        document.getElementById('modalCustName').value = name;
        document.getElementById('modalCustMobile').value = mobile;
        document.getElementById('modalCustEmail').value = email;
        document.getElementById('modalCustCountry').value = country;
        document.getElementById('customerModalTitle').innerText = `Edit Customer #${id}`;
        new bootstrap.Modal(document.getElementById('customerEditModal')).show();
    }

    function submitCustomerEditModal() {
        const id = document.getElementById('modalCustId').value;
        const payload = {
            CustomerId: parseInt(id),
            Name: document.getElementById('modalCustName').value,
            MobileNo: document.getElementById('modalCustMobile').value,
            EmailID: document.getElementById('modalCustEmail').value,
            Country: document.getElementById('modalCustCountry').value
        };
        const url = `/api/CustomerAPI/UpdateCustomer/${id}`;

        fetch(url, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json().then(data => ({ status: res.status, data })))
        .then(res => {
            logResponse('PUT', url, res.status, res.data, true);
            bootstrap.Modal.getInstance(document.getElementById('customerEditModal')).hide();
            loadCustomersTable();
        })
        .catch(err => logResponse('PUT', url, 500, err.message, true));
    }

    function deleteCustomerApi(id) {
        if (confirm(`Delete Customer #${id}?`)) {
            const url = `/api/CustomerAPI/DeleteCustomer/${id}`;
            fetch(url, { method: 'DELETE' })
                .then(res => res.json().then(data => ({ status: res.status, data })))
                .then(res => {
                    logResponse('DELETE', url, res.status, res.data, true);
                    loadCustomersTable();
                })
                .catch(err => logResponse('DELETE', url, 500, err.message, true));
        }
    }

    // Initial load
    document.addEventListener('DOMContentLoaded', function() {
        loadUsersTable();
        loadCustomersTable();
    });
</script>
}
