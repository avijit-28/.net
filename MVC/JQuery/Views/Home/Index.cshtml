                            <div class="card-body">
                                <p class="small text-muted mb-3">
                                    Send an HTTP POST request to test the stored procedure execution and review the JSON payload returned.
                                </p>
                                
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Stored Procedure Parameter (&#64;SearchTerm):</label>
                                    <input type="text" class="form-control form-control-sm" id="testSearchTerm" placeholder="Leave empty for all, or enter e.g. London, Germany">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Target Action URL:</label>
                                    <input type="text" class="form-control form-control-sm" value="/Home/AjaxMethod" readonly>
                                </div>

                                <button id="btnSendTestAjax" class="btn btn-primary w-100">
                                    <i class="fa-solid fa-paper-plane me-1"></i> Execute Stored Procedure via AJAX
                                </button>

                                <hr class="my-4">

                                <h6 class="fw-bold text-dark small mb-2"><i class="fa-solid fa-gauge-high text-info me-1"></i> Diagnostics</h6>
                                <div class="bg-light p-3 rounded-2 border small">
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="text-muted">Connection String:</span>
                                        <span class="fw-bold text-dark font-monospace">name="DBConn"</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="text-muted">Database Routine:</span>
                                        <span class="fw-bold text-primary font-monospace">dbo.sp_SearchCustomers</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="text-muted">HTTP Status:</span>
                                        <span class="fw-bold text-success" id="diagStatus">200 OK</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="text-muted">Round-trip Time:</span>
                                        <span class="fw-bold text-dark" id="diagDuration">~6 ms</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1">
                                        <span class="text-muted">Records Returned:</span>
                                        <span class="fw-bold text-primary" id="diagRecordCount">20 Customer Objects</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="card border rounded-3 h-100 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-code text-success me-2"></i> Raw JSON Response Payload</h6>
                                <span class="badge bg-dark" id="jsonByteSize">Received JSON</span>
                            </div>
                            <div class="card-body p-0">
                                <pre id="jsonResponseViewer" class="m-0 rounded-0 border-0" style="min-height: 400px;">// Click "Execute Stored Procedure via AJAX" to fetch JSON.</pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal: Add Customer via Stored Procedure dbo.sp_InsertCustomer -->
<div class="modal fade" id="modalAddCustomer" tabindex="-1" aria-labelledby="modalAddCustomerLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalAddCustomerLabel">
                    <i class="fa-solid fa-user-plus text-success me-2"></i> Add Customer (dbo.sp_InsertCustomer)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formAddCustomer">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Contact Name *</label>
                        <input type="text" class="form-control" id="newContactName" required placeholder="e.g. John Doe">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">City *</label>
                            <input type="text" class="form-control" id="newCity" required placeholder="e.g. New York">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Country *</label>
                            <input type="text" class="form-control" id="newCountry" required placeholder="e.g. USA">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Email</label>
                        <input type="email" class="form-control" id="newEmail" placeholder="e.g. john@example.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Phone</label>
                        <input type="text" class="form-control" id="newPhone" placeholder="e.g. 555-1234">
                    </div>
                    <div id="addCustomerAlert" class="alert alert-danger py-2 px-3 small d-none"></div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="btnSubmitAddCustomer">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Save via Stored Procedure
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script type="text/javascript">
    var customerDataTable = null;
    var cachedCustomerData = null;

    $(function () {
        // Initial AJAX call to execute stored procedure
        fetchCustomerDataAndInitTable();

        // Initialize JSGrid
        initJsGrid();

        // Feature control switches
        $("#chkFilter, #chkLength, #chkSort, #chkPaginate").on("change", function () {
            rebuildDataTableWithCurrentSettings();
        });

        // Reload buttons
        $("#btnReloadTable, #btnTriggerGlobalSync").on("click", function () {
            fetchCustomerDataAndInitTable();
        });

        $("#btnReloadJsGrid").on("click", function () {
            $("#jsGridContainer").jsGrid("loadData");
        });

        // Inspector AJAX button
        $("#btnSendTestAjax").on("click", function () {
            var searchTerm = $("#testSearchTerm").val();
            executeAjaxTestCall(searchTerm);
        });

        // Add Customer Form Submit
        $("#btnSubmitAddCustomer").on("click", function () {
            submitNewCustomer();
        });
    });

    function fetchCustomerDataAndInitTable(searchTerm) {
        highlightPipelineNode(2);
        var startTime = performance.now();

        $.ajax({
            type: "POST",
            url: "/Home/AjaxMethod",
            data: JSON.stringify({ searchTerm: searchTerm || "" }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var duration = Math.round(performance.now() - startTime);
                highlightPipelineNode(6);
                
                cachedCustomerData = response;
                updateMetricsUI(response, duration);
                OnSuccess(response);

                $("#jsonResponseViewer").text(JSON.stringify(response, null, 2));
                $("#jsonByteSize").text(JSON.stringify(response).length + " bytes");
                $("#tableStatusFeedback").html('<i class="fa-solid fa-circle-check text-success me-1"></i> Loaded ' + response.length + ' records via Stored Procedure (' + duration + ' ms)');
            },
            failure: function (response) {
                alert("Failure: " + (response.d || response.statusText));
            },
            error: function (response) {
                alert("Error: " + (response.d || response.statusText));
            }
        });
    }

    function OnSuccess(response) {
        if ($.fn.DataTable.isDataTable('#tblCustomers')) {
            $('#tblCustomers').DataTable().destroy();
            $('#tblCustomers tbody').empty();
        }

        var filterEnabled = $("#chkFilter").is(":checked");
        var lengthEnabled = $("#chkLength").is(":checked");
        var sortEnabled = $("#chkSort").is(":checked");
        var paginateEnabled = $("#chkPaginate").is(":checked");

        customerDataTable = $("#tblCustomers").DataTable({
            bLengthChange: lengthEnabled,
            lengthMenu: [[5, 10, -1], [5, 10, "All"]],
            bFilter: filterEnabled,
            bSort: sortEnabled,
            bPaginate: paginateEnabled,
            data: response,
            columns: [
                { 
                    'data': 'CustomerID',
                    'render': function (data) {
                        return '<span class="badge bg-secondary badge-customer">' + data + '</span>';
                    }
                },
                { 
                    'data': 'ContactName',
                    'render': function (data) {
                        return '<strong>' + data + '</strong>';
                    }
                },
                { 'data': 'City' },
                { 
                    'data': 'Country',
                    'render': function (data) {
                        return '<span class="badge bg-light text-dark border">' + data + '</span>';
                    }
                }
            ],
            pageLength: 5,
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search customers..."
            }
        });

        updateCodePreview(filterEnabled, lengthEnabled, sortEnabled, paginateEnabled);
    }

    function rebuildDataTableWithCurrentSettings() {
        if (cachedCustomerData) {
            OnSuccess(cachedCustomerData);
        } else {
            fetchCustomerDataAndInitTable();
        }
    }

    function updateCodePreview(filter, length, sort, paginate) {
        var code = 'function OnSuccess(response) {\n' +
            '    $("#tblCustomers").DataTable({\n' +
            '        bLengthChange: ' + length + ',\n' +
            '        lengthMenu: [[5, 10, -1], [5, 10, "All"]],\n' +
            '        bFilter: ' + filter + ',\n' +
            '        bSort: ' + sort + ',\n' +
            '        bPaginate: ' + paginate + ',\n' +
            '        data: response,\n' +
            '        columns: [\n' +
            '            { \'data\': \'CustomerID\' },\n' +
            '            { \'data\': \'ContactName\' },\n' +
            '            { \'data\': \'City\' },\n' +
            '            { \'data\': \'Country\' }\n' +
            '        ]\n' +
            '    });\n' +
            '};';
        $("#liveConfigDisplay code").text(code);
    }

    function updateMetricsUI(data, latency) {
        if (!data || !data.length) return;
        $("#statCustomerCount").text(data.length);
        $("#statLatency").html('<i class="fa-solid fa-bolt me-1 text-warning"></i> ~' + latency + ' ms Latency');
    }

    function highlightPipelineNode(stepIndex) {
        $(".pipeline-node").removeClass("active-node");
        $("#node-" + stepIndex).addClass("active-node");
    }

    function initJsGrid() {
        $("#jsGridContainer").jsGrid({
            width: "100%",
            height: "420px",
            filtering: true,
            editing: false,
            sorting: true,
            paging: true,
            pageSize: 6,
            pageButtonCount: 5,
            autoload: true,
            controller: {
                loadData: function (filter) {
                    var d = $.Deferred();
                    $.ajax({
                        type: "POST",
                        url: "/Home/GetJsGridData",
                        data: JSON.stringify({
                            filterName: filter.ContactName || "",
                            filterCountry: filter.Country || ""
                        }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (response) {
                            d.resolve(response);
                        },
                        error: function (e) {
                            d.reject(e);
                        }
                    });
                    return d.promise();
                }
            },
            fields: [
                { name: "CustomerID", title: "Customer ID", type: "number", width: 80, readOnly: true },
                { name: "ContactName", title: "Contact Name", type: "text", width: 140 },
                { name: "City", title: "City", type: "text", width: 120 },
                { name: "Country", title: "Country", type: "text", width: 120 },
                { name: "Email", title: "Email", type: "text", width: 170 },
                { name: "Phone", title: "Phone", type: "text", width: 120 }
            ]
        });
    }

    function executeAjaxTestCall(searchTerm) {
        var start = performance.now();
        $("#btnSendTestAjax").prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Running SP...');

        $.ajax({
            type: "POST",
            url: "/Home/AjaxMethod",
            data: JSON.stringify({ searchTerm: searchTerm || "" }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var elapsed = Math.round(performance.now() - start);
                $("#diagStatus").text("200 OK").removeClass("text-danger").addClass("text-success");
                $("#diagDuration").text(elapsed + " ms");
                $("#diagRecordCount").text(response.length + " Customer Records");
                $("#jsonResponseViewer").text(JSON.stringify(response, null, 2));
                $("#jsonByteSize").text(JSON.stringify(response).length + " bytes");
                $("#btnSendTestAjax").prop("disabled", false).html('<i class="fa-solid fa-paper-plane me-1"></i> Execute Stored Procedure via AJAX');
            },
            error: function (xhr) {
                var elapsed = Math.round(performance.now() - start);
                $("#diagStatus").text(xhr.status + " " + xhr.statusText).removeClass("text-success").addClass("text-danger");
                $("#diagDuration").text(elapsed + " ms");
                $("#jsonResponseViewer").text("Error: " + xhr.responseText);
                $("#btnSendTestAjax").prop("disabled", false).html('<i class="fa-solid fa-paper-plane me-1"></i> Execute Stored Procedure via AJAX');
            }
        });
    }

    function submitNewCustomer() {
        var name = $("#newContactName").val().trim();
        var city = $("#newCity").val().trim();
        var country = $("#newCountry").val().trim();
        var email = $("#newEmail").val().trim();
        var phone = $("#newPhone").val().trim();

        if (!name || !city || !country) {
            $("#addCustomerAlert").text("Please fill in Name, City, and Country.").removeClass("d-none");
            return;
        }

        $("#btnSubmitAddCustomer").prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...');

        $.ajax({
            type: "POST",
            url: "/Home/AddCustomer",
            data: JSON.stringify({
                customer: {
                    ContactName: name,
                    City: city,
                    Country: country,
                    Email: email,
                    Phone: phone
                }
            }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {
                $("#btnSubmitAddCustomer").prop("disabled", false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Save via Stored Procedure');
                if (res.success) {
                    var modalEl = document.getElementById('modalAddCustomer');
                    var modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();
                    $("#formAddCustomer")[0].reset();
                    $("#addCustomerAlert").addClass("d-none");
                    // Refresh both grids
                    fetchCustomerDataAndInitTable();
                    $("#jsGridContainer").jsGrid("loadData");
                } else {
                    $("#addCustomerAlert").text(res.message || "Failed to insert customer.").removeClass("d-none");
                }
            },
            error: function () {
                $("#btnSubmitAddCustomer").prop("disabled", false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Save via Stored Procedure');
                $("#addCustomerAlert").text("An error occurred while calling sp_InsertCustomer.").removeClass("d-none");
            }
        });
    }
</script>
}
