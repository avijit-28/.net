@model LMS.ViewModels.ProfileViewModel
@{
    ViewBag.Title = "My Profile";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-0">Account Profile</h3>
                <p class="text-muted small">Manage your personal information and preferences</p>
            </div>
            <span class="badge bg-primary px-3 py-2 rounded-pill fs-6">
                Role: @Model.Role
            </span>
        </div>

        <div class="card card-custom p-4 shadow-sm mb-4">
            @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly", disabled = "disabled" })
                        <small class="text-muted">Email cannot be changed.</small>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+91 9876543210" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ProfilePicture, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.ProfilePicture, new { @class = "form-control", placeholder = "https://example.com/avatar.jpg" })
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.Bio, new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(m => m.Bio, new { @class = "form-control", rows = 4, placeholder = "Tell other students or instructors about your background..." })
                    </div>
                    <div class="col-12 d-flex justify-content-between align-items-center pt-3 border-top">
                        <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-secondary rounded-pill">
                            <i class="bi bi-key me-1"></i> Change Password
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
