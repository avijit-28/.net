@model LMS.ViewModels.StudentDashboardViewModel
@{
    ViewBag.Title = "Student Portal";
}

<div class="py-4">
    <!-- Welcome Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                Student Dashboard
            </span>
            <h2 class="fw-bold mb-0">Welcome Back, @User.Identity.Name!</h2>
            <p class="text-muted small">Track your learning progress, upcoming tasks, and certificates</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Courses")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-compass me-1"></i> Browse More Courses
            </a>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-3 stat-card shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted fw-semibold">Active Courses</div>
                        <div class="fs-3 fw-bold text-primary">@Model.ActiveCourses</div>
                    </div>
                    <div class="rounded-circle bg-primary-subtle text-primary p-3">
                        <i class="bi bi-journal-play fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-3 shadow-sm h-100" style="border-left: 4px solid #10b981;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted fw-semibold">Completed</div>
                        <div class="fs-3 fw-bold text-success">@Model.CompletedCourses</div>
                    </div>
                    <div class="rounded-circle bg-success-subtle text-success p-3">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-3 shadow-sm h-100" style="border-left: 4px solid #f59e0b;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted fw-semibold">Certificates</div>
                        <div class="fs-3 fw-bold text-warning">@Model.CertificatesCount</div>
                    </div>
                    <div class="rounded-circle bg-warning-subtle text-warning p-3">
                        <i class="bi bi-award-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-3 shadow-sm h-100" style="border-left: 4px solid #8b5cf6;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted fw-semibold">Quizzes Taken</div>
                        <div class="fs-3 fw-bold text-purple" style="color: #8b5cf6;">@Model.CompletedQuizzes</div>
                    </div>
                    <div class="rounded-circle bg-purple-subtle p-3" style="background: #ede9fe; color: #8b5cf6;">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Courses Section -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card card-custom p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-collection-play me-2 text-primary"></i> In-Progress & Active Courses</h5>
                    <a href="@Url.Action("MyCourses", "Student")" class="small text-primary text-decoration-none fw-semibold">View All &rarr;</a>
                </div>

                @if (!Model.EnrolledCourses.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-journal-x fs-1 text-muted mb-2"></i>
                        <h6 class="fw-bold text-dark">You have not enrolled in any courses yet.</h6>
                        <p class="text-muted small mb-3">Explore our published course tracks and start learning today!</p>
                        <a href="@Url.Action("Index", "Courses")" class="btn btn-sm btn-primary rounded-pill px-4">Browse Courses</a>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var enrollment in Model.EnrolledCourses.Take(4))
                        {
                            <div class="col-md-6">
                                <div class="card card-custom p-3 h-100 bg-light border">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-primary-subtle text-primary small">
                                            @(enrollment.Course?.Category?.CategoryName ?? "Course")
                                        </span>
                                        <span class="badge @(enrollment.Status == "Completed" ? "bg-success" : "bg-info text-dark") small">
                                            @enrollment.Status
                                        </span>
                                    </div>

                                    <h6 class="fw-bold mb-2">@enrollment.Course.Title</h6>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                            <span>Progress</span>
                                            <span class="fw-bold text-dark">@enrollment.CompletionPercentage%</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @enrollment.CompletionPercentage%;"></div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i> @enrollment.Course.DurationInHours hrs</small>
                                        <a href="@Url.Action("Index", "Learning", new { courseId = enrollment.CourseId })" class="btn btn-sm btn-primary rounded-pill px-3">
                                            Continue Learning &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Recent Quiz Results & Assessments -->
            <div class="card card-custom p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-patch-question me-2 text-warning"></i> Recent Assessment Results</h5>
                    <a href="@Url.Action("Quizzes", "Student")" class="small text-primary text-decoration-none fw-semibold">View History &rarr;</a>
                </div>

                @if (!Model.RecentQuizResults.Any())
                {
                    <p class="text-muted small py-3 mb-0">No quiz assessments completed yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Quiz Title</th>
                                    <th>Course</th>
                                    <th>Score</th>
                                    <th>Result</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in Model.RecentQuizResults)
                                {
                                    <tr>
                                        <td class="fw-bold">@q.Quiz.Title</td>
                                        <td>@(q.Quiz.Course?.Title ?? "Course")</td>
                                        <td>@q.Score% (@q.ObtainedMarks / @q.TotalMarks)</td>
                                        <td>
                                            <span class="badge @(q.IsPassed ? "bg-success" : "bg-danger")">
                                                @(q.IsPassed ? "PASSED" : "FAILED")
                                            </span>
                                        </td>
                                        <td>@(q.CompletedAt.HasValue ? q.CompletedAt.Value.ToString("MMM dd, yyyy") : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar: Announcements & Upcoming Tasks -->
        <div class="col-lg-4">
            <!-- Announcements Card -->
            <div class="card card-custom p-4 shadow-sm mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-megaphone me-2 text-danger"></i> Announcements</h5>
                @if (!Model.Announcements.Any())
                {
                    <p class="text-muted small mb-0">No active announcements at this time.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var a in Model.Announcements)
                        {
                            <div class="p-3 bg-light rounded-3 border-start border-3 border-danger">
                                <h6 class="fw-bold text-dark mb-1">@a.Title</h6>
                                <p class="small text-muted mb-1">@a.Message</p>
                                <small class="text-secondary" style="font-size: 11px;">@a.CreatedDate.ToString("MMM dd, yyyy")</small>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Upcoming Assignments Card -->
            <div class="card card-custom p-4 shadow-sm">
                <h5 class="fw-bold mb-3"><i class="bi bi-calendar-check me-2 text-info"></i> Project Tasks</h5>
                @if (!Model.UpcomingAssignments.Any())
                {
                    <p class="text-muted small mb-0">No pending assignments due.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var assign in Model.UpcomingAssignments)
                        {
                            <div class="p-3 border rounded-3 bg-white">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="fw-bold mb-0 text-dark small">@assign.Title</h6>
                                    <span class="badge bg-light text-dark border small">@assign.MaxMarks pts</span>
                                </div>
                                <div class="small text-muted mb-2">@(assign.Course?.Title ?? "Course")</div>
                                <a href="@Url.Action("Details", "Assignment", new { id = assign.AssignmentId })" class="btn btn-sm btn-outline-primary rounded-pill w-100">
                                    View Instructions &rarr;
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
