@model List<FoodArrival.Models.PasswordResetRequest>
@{
    ViewBag.Title = "Password Recovery Requests - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string currentStatus = ViewBag.CurrentStatus as string ?? "";
    string search = ViewBag.Search as string ?? "";
}

<div class="container-fluid py-4 px-lg-5">
    <div class="row g-4">
        <!-- Admin Left Sidebar -->
        <div class="col-lg-2 col-md-3">
            <div class="admin-sidebar sticky-top" style="top: 85px;">
                <div class="d-flex align-items-center gap-2 mb-4 px-2">
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1"><i class="bi bi-shield-lock-fill me-1"></i> Admin Panel</span>
                </div>
                <div class="nav flex-column gap-1">
                    <a href="@Url.Action("Dashboard", "Admin")" class="admin-nav-item">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("Approvals", "Admin")" class="admin-nav-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Approvals</span>
                    </a>
                    <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })" class="admin-nav-item">
                        <i class="bi bi-card-checklist"></i>
                        <span>Orders</span>
                    </a>
                    <a href="@Url.Action("FoodItems", "Admin")" class="admin-nav-item">
                        <i class="bi bi-egg-fried"></i>
                        <span>Food Menu</span>
                    </a>
                    <a href="@Url.Action("Riders", "Admin")" class="admin-nav-item">
                        <i class="bi bi-bicycle"></i>
                        <span>Rider Fleet</span>
                    </a>
                    <a href="@Url.Action("Transactions", "Admin")" class="admin-nav-item">
                        <i class="bi bi-cash-stack"></i>
                        <span>Transactions</span>
                    </a>
                    <a href="@Url.Action("Bulletins", "Admin")" class="admin-nav-item">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>Bulletins</span>
                    </a>
                    <a href="@Url.Action("PasswordRequests", "Admin")" class="admin-nav-item active">
                        <i class="bi bi-key-fill"></i>
                        <span>Password Requests</span>
                    </a>
                    <hr class="border-secondary my-3" />
                    <a href="@Url.Action("Logout", "Admin")" class="admin-nav-item text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-10 col-md-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h2 class="fw-bold mb-0">Password Recovery & Reset Requests</h2>
                    <p class="text-muted small mb-0">Review user identity, verify account existence, approve password changes or reject unauthorized inquiries</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Approvals", "Admin", new { tab = "passwords" })" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left-right me-1"></i> Approvals Tab View
                    </a>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Filter Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <form method="get" action="@Url.Action("PasswordRequests", "Admin")" class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="" @(string.IsNullOrEmpty(currentStatus) ? "selected" : "")>All Statuses</option>
                                <option value="Pending" @(currentStatus == "Pending" ? "selected" : "")>Pending Review</option>
                                <option value="Approved" @(currentStatus == "Approved" ? "selected" : "")>Approved</option>
                                <option value="Rejected" @(currentStatus == "Rejected" ? "selected" : "")>Rejected</option>
                                <option value="Completed" @(currentStatus == "Completed" ? "selected" : "")>Completed</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" class="form-control" placeholder="Search by email, reason, user role..." value="@search" />
                                <button type="submit" class="btn btn-primary">Search</button>
                                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(currentStatus))
                                {
                                    <a href="@Url.Action("PasswordRequests", "Admin")" class="btn btn-outline-secondary">Reset</a>
                                }
                            </div>
                        </div>
                        <div class="col-md-3 text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#verifyUserModal">
                                <i class="bi bi-person-check-fill me-1"></i> Quick User Verifier
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Requests Table Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-list-ul me-2"></i>Requests List (@(Model?.Count ?? 0))</span>
                    <span class="small text-muted">Auto-refreshed via Secure Stored Procedures</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 70px;">ID</th>
                                <th>User / Email</th>
                                <th>Reason for Reset</th>
                                <th>Requested</th>
                                <th>Status</th>
                                <th>Admin Notes</th>
                                <th class="text-end" style="min-width: 220px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var req in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary font-monospace">#@req.RequestId</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">
                                                <i class="bi bi-envelope me-1 text-primary"></i>@req.Email
                                            </div>
                                            <div class="small text-muted">
                                                @if (!string.IsNullOrEmpty(req.UserRole))
                                                {
                                                    <span class="badge bg-info-subtle text-info border border-info me-1">@req.UserRole</span>
                                                }
                                                @(string.IsNullOrEmpty(req.UserName) ? "Unverified Account" : req.UserName)
                                            </div>
                                        </td>
                                        <td>
                                            <div class="small p-2 bg-light rounded text-break" style="max-width: 320px;">
                                                <i class="bi bi-chat-left-quote text-muted me-1"></i>@req.Reason
                                            </div>
                                        </td>
                                        <td class="small text-muted">
                                            @req.CreatedAt.ToString("dd MMM yyyy")<br />
                                            <span class="text-secondary">@req.CreatedAt.ToString("hh:mm tt")</span>
                                        </td>
                                        <td>
                                            @if (req.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Pending</span>
                                            }
                                            else if (req.Status == "Approved")
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Approved</span>
                                            }
                                            else if (req.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@req.Status</span>
                                            }
                                        </td>
                                        <td class="small text-muted">
                                            @(string.IsNullOrEmpty(req.AdminNotes) ? "-" : req.AdminNotes)
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-info me-1" onclick="quickVerify('@req.Email')">
                                                <i class="bi bi-shield-check"></i> Verify
                                            </button>

                                            @if (req.Status == "Pending")
                                            {
                                                using (Html.BeginForm("ApprovePasswordRequest", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="requestId" value="@req.RequestId" />
                                                    <input type="hidden" name="adminNotes" value="Verified and approved by admin." />
                                                    <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                                                    <button type="submit" class="btn btn-sm btn-success me-1" onclick="return confirm('Approve password reset request for @req.Email?');">
                                                        <i class="bi bi-check-lg"></i> Approve
                                                    </button>
                                                }

                                                using (Html.BeginForm("RejectPasswordRequest", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="requestId" value="@req.RequestId" />
                                                    <input type="hidden" name="adminNotes" value="Identity verification failed or unverified request." />
                                                    <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject password reset request for @req.Email?');">
                                                        <i class="bi bi-x-lg"></i> Reject
                                                    </button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-shield-check display-6 text-success d-block mb-2"></i>
                                        No password reset requests found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: User Existence & Identity Verifier -->
<div class="modal fade" id="verifyUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-check-fill text-primary me-2"></i>User Existence Verifier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="input-group mb-3">
                    <input type="email" id="modalVerifyEmail" class="form-control" placeholder="Enter user email to verify..." />
                    <button class="btn btn-primary" type="button" onclick="runModalVerify()">
                        <i class="bi bi-search me-1"></i> Verify Email
                    </button>
                </div>
                <div id="verifyResultContainer" style="display:none;" class="p-3 rounded-3 border">
                    <!-- Dynamic result inserted here -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function quickVerify(email) {
        document.getElementById('modalVerifyEmail').value = email;
        var modal = new bootstrap.Modal(document.getElementById('verifyUserModal'));
        modal.show();
        runModalVerify();
    }

    function runModalVerify() {
        var email = document.getElementById('modalVerifyEmail').value.trim();
        var container = document.getElementById('verifyResultContainer');
        if (!email) return;

        container.style.display = 'block';
        container.innerHTML = '<div class="text-center text-muted py-3"><span class="spinner-border spinner-border-sm me-2"></span>Searching accounts...</div>';

        fetch('@Url.Action("VerifyUserEmail", "Admin")?email=' + encodeURIComponent(email))
            .then(res => res.json())
            .then(data => {
                if (data.found) {
                    container.className = 'p-3 rounded-3 border bg-success-subtle border-success text-dark';
                    container.innerHTML = `
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span class="fw-bold">User Exists & Registered</span>
                            <span class="badge bg-primary ms-auto">${data.role}</span>
                        </div>
                        <ul class="list-unstyled small mb-0">
                            <li><strong>Name:</strong> ${data.name || 'N/A'}</li>
                            <li><strong>Username:</strong> ${data.username || 'N/A'}</li>
                            <li><strong>Email:</strong> ${data.email}</li>
                            <li><strong>Phone:</strong> ${data.phone || 'N/A'}</li>
                            <li><strong>Active Status:</strong> ${data.isActive ? '<span class="text-success fw-bold">Active</span>' : '<span class="text-danger">Inactive</span>'}</li>
                            <li><strong>Registered On:</strong> ${data.createdAt || 'N/A'}</li>
                        </ul>
                    `;
                } else {
                    container.className = 'p-3 rounded-3 border bg-danger-subtle border-danger text-dark';
                    container.innerHTML = `
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                            <div>
                                <div class="fw-bold text-danger">No Registered User Found</div>
                                <div class="small text-muted">No account with email "${email}" exists in the database. Request may be invalid or spam.</div>
                            </div>
                        </div>
                    `;
                }
            })
            .catch(err => {
                container.className = 'p-3 rounded-3 border bg-danger-subtle border-danger text-dark';
                container.innerHTML = '<div class="text-danger small">Error checking account: ' + err.message + '</div>';
            });
    }
</script>
