@model IEnumerable<LMS.Models.Enrollment>
@{
    ViewBag.Title = "All Enrollments";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Enrollments</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>Global Course Enrollments</h2>
            <p class="text-muted mb-0">Complete enrollment records, student course assignments, and completion statuses</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 p-2">Total Enrollments: @Model.Count()</span>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Enrollment #</th>
                        <th>Student ID</th>
                        <th>Course</th>
                        <th>Enrolled Date</th>
                        <th>Progress</th>
                        <th>Status</th>
                        <th>Completed Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No enrollments recorded in the system.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="fw-bold">#@item.EnrollmentId</span></td>
                                <td><code class="small text-dark">@item.StudentId</code></td>
                                <td>
                                    <div class="fw-semibold text-truncate" style="max-width: 280px;">
                                        @(item.Course != null ? item.Course.Title : "Course #" + item.CourseId)
                                    </div>
                                </td>
                                <td>@item.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                                <td style="width: 200px;">
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @item.ProgressPercentage%;"></div>
                                        </div>
                                        <span class="small fw-bold">@item.ProgressPercentage%</span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Active</span>
                                    }
                                </td>
                                <td>
                                    @(item.CompletedDate.HasValue ? item.CompletedDate.Value.ToString("MMM dd, yyyy") : "--")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
