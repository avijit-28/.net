@model LMS.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "Admin Control Center";
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Enterprise Administration
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Admin Operations Control Center</h2>
            <p class="text-muted small mb-0">Platform telemetry, operational analytics, user directory, and course governance</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("InstructorApplications", "Admin")" class="btn btn-primary rounded-pill px-3 fw-bold text-white shadow-sm position-relative" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                <i class="bi bi-mortarboard me-1"></i> Teacher Applications
                @if (Model.PendingInstructorsCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-1">@Model.PendingInstructorsCount</span>
                }
            </a>
            <a href="@Url.Action("PendingApprovals", "Admin")" class="btn btn-outline-light rounded-pill px-3 fw-semibold text-white shadow-xs position-relative" style="background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.25);">
                <i class="bi bi-clock-history me-1 text-orange"></i> All Approvals
                @if (Model.PendingApprovalsCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-1">@Model.PendingApprovalsCount</span>
                }
            </a>
            <a href="@Url.Action("Users", "Admin")" class="btn rounded-pill px-3 fw-bold shadow-xs text-white" style="background: rgba(39, 184, 214, 0.25); border: 1.5px solid #27B8D6;">
                <i class="bi bi-people-fill me-1 text-cyan"></i> Users Directory
            </a>
            <a href="@Url.Action("Courses", "Admin")" class="btn btn-outline-light rounded-pill px-3 fw-semibold text-white shadow-xs" style="background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.2);">
                <i class="bi bi-journal-text me-1 text-orange"></i> Course Governance
            </a>
            <a href="@Url.Action("Payments", "Admin")" class="btn rounded-pill px-3 fw-semibold shadow-xs" style="color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.5); background: rgba(53, 201, 138, 0.1);">
                <i class="bi bi-credit-card me-1"></i> Payments Ledger
            </a>
            <a href="@Url.Action("CreateAnnouncement", "Admin")" class="btn btn-primary rounded-pill px-4 fw-semibold text-white shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                <i class="bi bi-megaphone me-1"></i> Post Bulletin
            </a>
        </div>
    </div>

    @if (Model.PendingInstructorsCount > 0)
    {
        <div class="card p-3 mb-4 rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 shadow-sm" style="background: rgba(255, 122, 24, 0.12); border: 1px solid rgba(255, 122, 24, 0.35); border-left: 5px solid #FF7A18 !important; backdrop-filter: blur(8px);">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(255, 122, 24, 0.2); color: #FF7A18;">
                    <i class="bi bi-mortarboard-fill fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-white mb-1">@Model.PendingInstructorsCount Instructor Candidate(s) Awaiting Administrator Verification</h6>
                    <small style="color: #94A3B8;">Teachers registering on EduPlatform require administrator approval before gaining course publishing privileges.</small>
                </div>
            </div>
            <a href="@Url.Action("InstructorApplications", "Admin")" class="btn btn-sm text-white fw-bold rounded-pill px-4 shadow-sm text-nowrap" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                Review Candidate Dossiers <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    }
    else if (Model.PendingApprovalsCount > 0)
    {
        <div class="card p-3 mb-4 rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 shadow-sm" style="background: rgba(255, 122, 24, 0.12); border: 1px solid rgba(255, 122, 24, 0.35); border-left: 5px solid #FF7A18 !important; backdrop-filter: blur(8px);">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(255, 122, 24, 0.2); color: #FF7A18;">
                    <i class="bi bi-person-exclamation fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-white mb-1">@Model.PendingApprovalsCount Registration(s) Awaiting Admin Verification</h6>
                    <small style="color: #94A3B8;">Newly registered users require administrator approval before gaining platform access.</small>
                </div>
            </div>
            <a href="@Url.Action("PendingApprovals", "Admin")" class="btn btn-sm text-white fw-bold rounded-pill px-4 shadow-sm text-nowrap" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                Review & Approve <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover" style="border-left: 4px solid #4f46e5;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Gross Platform Sales</span>
                        <h3 class="fw-extrabold text-dark mt-2 mb-0"><span class="rupee-symbol">&#8377;</span>@Model.TotalRevenue.ToString("N2")</h3>
                        <small class="text-success"><i class="bi bi-graph-up-arrow me-1"></i>All-time revenue</small>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle shadow-xs">
                        <i class="bi bi-currency-rupee fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover" style="border-left: 4px solid #10b981;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Total Enrollments</span>
                        <h3 class="fw-extrabold text-dark mt-2 mb-0">@Model.TotalEnrollments</h3>
                        <small class="text-muted">Across all tracks</small>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle shadow-xs">
                        <i class="bi bi-mortarboard-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover" style="border-left: 4px solid #06b6d4;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Active Learners</span>
                        <h3 class="fw-extrabold text-dark mt-2 mb-0">@Model.TotalStudents</h3>
                        <small class="text-info fw-semibold">@Model.TotalInstructors Instructors</small>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle shadow-xs">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover" style="border-left: 4px solid #f59e0b;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Course Catalog</span>
                        <h3 class="fw-extrabold text-dark mt-2 mb-0">@Model.PublishedCourses / @Model.TotalCourses</h3>
                        <small class="text-muted">Published / Total Catalog</small>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle shadow-xs">
                        <i class="bi bi-journal-check fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Bar -->
    <div class="card card-custom shadow-sm mb-4" style="background: rgba(11, 52, 69, 0.7); border: 1px solid rgba(255, 255, 255, 0.12); backdrop-filter: blur(8px);">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 justify-content-between text-center">
                <a href="@Url.Action("PendingApprovals", "Admin")" class="admin-quick-btn flex-grow-1 p-2 rounded-3 text-decoration-none" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s;">
                    <i class="bi bi-shield-check text-orange fs-4 d-block mb-1"></i>
                    <span class="small fw-bold text-white d-block">Approvals</span>
                    @if (Model.PendingApprovalsCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill mt-1" style="font-size: 10px;">@Model.PendingApprovalsCount</span>
                    }
                </a>
                <a href="@Url.Action("PasswordResets", "Admin")" class="admin-quick-btn flex-grow-1 p-2 rounded-3 text-decoration-none" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s;">
                    <i class="bi bi-key-fill text-orange fs-4 d-block mb-1"></i>
                    <span class="small fw-bold text-white d-block">Password Resets</span>
                </a>
                <a href="@Url.Action("Users", "Admin")" class="admin-quick-btn flex-grow-1 p-2 rounded-3 text-decoration-none" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s;">
                    <i class="bi bi-people text-cyan fs-4 d-block mb-1"></i>
                    <span class="small fw-bold text-white d-block">Users Directory</span>
                </a>
                <a href="@Url.Action("Categories", "Admin")" class="admin-quick-btn flex-grow-1 p-2 rounded-3 text-decoration-none" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s;">
                    <i class="bi bi-tags text-success fs-4 d-block mb-1"></i>
                    <span class="small fw-bold text-white d-block">Categories (@Model.TotalCategories)</span>
                </a>
                <a href="@Url.Action("Courses", "Admin")" class="admin-quick-btn flex-grow-1 p-2 rounded-3 text-decoration-none" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s;">
                    <i class="bi bi-journal-richtext text-orange fs-4 d-block mb-1"></i>
                    <span class="small fw-bold text-white d-block">Course Catalog</span>
                </a>
                <a href="@Url.Action("Enrollments", "Admin")" class="admin-quick-btn flex-grow-1 p-2 rounded-3 text-decoration-none" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s;">
                    <i class="bi bi-person-check text-cyan fs-4 d-block mb-1"></i>
                    <span class="small fw-bold text-white d-block">Enrollments</span>
                </a>
                <a href="@Url.Action("Payments", "Admin")" class="admin-quick-btn flex-grow-1 p-2 rounded-3 text-decoration-none" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s;">
                    <i class="bi bi-credit-card text-success fs-4 d-block mb-1"></i>
                    <span class="small fw-bold text-white d-block">Transactions</span>
                </a>
                <a href="@Url.Action("Announcements", "Admin")" class="admin-quick-btn flex-grow-1 p-2 rounded-3 text-decoration-none" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s;">
                    <i class="bi bi-megaphone text-orange fs-4 d-block mb-1"></i>
                    <span class="small fw-bold text-white d-block">Bulletins</span>
                </a>
                <a href="@Url.Action("Reports", "Admin")" class="admin-quick-btn flex-grow-1 p-2 rounded-3 text-decoration-none" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s;">
                    <i class="bi bi-graph-up-arrow text-cyan fs-4 d-block mb-1"></i>
                    <span class="small fw-bold text-white d-block">Reports</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Tables Split -->
    <div class="row g-4 mb-4">
        <!-- Recent Enrollments -->
        <div class="col-lg-6">
            <div class="card card-custom shadow-sm h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12);">
                <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center" style="background: rgba(11, 52, 69, 0.7); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary bg-opacity-20 text-cyan p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-white">Recent Enrollments</h5>
                    </div>
                    <a href="@Url.Action("Enrollments", "Admin")" class="small text-cyan text-decoration-none fw-semibold">View All <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="color: #E2E8F0;">
                        <thead style="background: #0B3445; color: #94A3B8; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">
                            <tr>
                                <th class="py-3 px-3">Student</th>
                                <th class="py-3 px-3">Course</th>
                                <th class="py-3 px-3">Enrolled Date</th>
                                <th class="py-3 px-3">Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentEnrollments.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-white-50">No enrollments recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var e in Model.RecentEnrollments)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                                        <td class="px-3">
                                            <span class="font-monospace small text-cyan">@e.StudentId</span>
                                        </td>
                                        <td class="px-3">
                                            <div class="fw-semibold text-truncate text-white" style="max-width: 200px;">
                                                @(e.Course != null ? e.Course.Title : "Course #" + e.CourseId)
                                            </div>
                                        </td>
                                        <td class="px-3"><small class="text-white-50">@e.EnrollmentDate.ToString("MMM dd, yyyy")</small></td>
                                        <td class="px-3">
                                            <span class="badge @(e.Status == "Completed" ? "bg-success" : "bg-primary") rounded-pill">
                                                @e.ProgressPercentage%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Payments -->
        <div class="col-lg-6">
            <div class="card card-custom shadow-sm h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12);">
                <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center" style="background: rgba(11, 52, 69, 0.7); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-success bg-opacity-20 text-success p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-credit-card"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-white">Recent Transactions</h5>
                    </div>
                    <a href="@Url.Action("Payments", "Admin")" class="small text-cyan text-decoration-none fw-semibold">View All <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="color: #E2E8F0;">
                        <thead style="background: #0B3445; color: #94A3B8; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">
                            <tr>
                                <th class="py-3 px-3">Txn Ref</th>
                                <th class="py-3 px-3">Course</th>
                                <th class="py-3 px-3">Amount</th>
                                <th class="py-3 px-3">Status</th>
                                <th class="py-3 px-3">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentPayments.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-white-50">No transactions recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var p in Model.RecentPayments)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                                        <td class="px-3"><code class="small text-cyan font-monospace">@(p.TransactionId ?? "TXN-" + p.PaymentId)</code></td>
                                        <td class="px-3">
                                            <div class="fw-semibold text-truncate text-white" style="max-width: 180px;">
                                                @(p.Course != null ? p.Course.Title : "Course #" + p.CourseId)
                                            </div>
                                        </td>
                                        <td class="px-3 fw-bold text-success"><span class="rupee-symbol">&#8377;</span>@p.Amount.ToString("N2")</td>
                                        <td class="px-3">
                                            <span class="badge @(p.PaymentStatus == "Completed" ? "bg-success" : "bg-secondary") rounded-pill">@p.PaymentStatus</span>
                                        </td>
                                        <td class="px-3"><small class="text-white-50">@p.PaymentDate.ToString("MMM dd")</small></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Distribution & Recent Users Split -->
    <div class="row g-4">
        <!-- Category Stats -->
        <div class="col-lg-5">
            <div class="card card-custom shadow-sm h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12);">
                <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center" style="background: rgba(11, 52, 69, 0.7); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-info bg-opacity-20 text-cyan p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-pie-chart-fill"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-white">Courses by Category</h5>
                    </div>
                    <a href="@Url.Action("Categories", "Admin")" class="small text-cyan text-decoration-none fw-semibold">Manage <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body p-4">
                    @if (!Model.CategoryStats.Any())
                    {
                        <p class="text-white-50 text-center py-3">No categories defined yet.</p>
                    }
                    else
                    {
                        foreach (var cat in Model.CategoryStats)
                        {
                            var pct = Model.TotalCourses > 0 ? (int)((double)cat.CourseCount / Model.TotalCourses * 100) : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small fw-bold mb-1">
                                    <span class="text-white">@cat.CategoryName</span>
                                    <span class="text-white-50">@cat.CourseCount courses (@pct%)</span>
                                </div>
                                <div class="progress" style="height: 7px; background: rgba(255, 255, 255, 0.1);">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @pct%;"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Recent Registered Users -->
        <div class="col-lg-7">
            <div class="card card-custom shadow-sm h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12);">
                <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center" style="background: rgba(11, 52, 69, 0.7); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-warning bg-opacity-20 text-orange p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-white">Recently Registered Users</h5>
                    </div>
                    <a href="@Url.Action("Users", "Admin")" class="small text-cyan text-decoration-none fw-semibold">Full Directory <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="color: #E2E8F0;">
                        <thead style="background: #0B3445; color: #94A3B8; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">
                            <tr>
                                <th class="py-3 px-3">Name</th>
                                <th class="py-3 px-3">Email</th>
                                <th class="py-3 px-3">Joined Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentUsers.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-white-50">No users registered yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var u in Model.RecentUsers)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                                        <td class="px-3">
                                            <div class="fw-bold text-white">@u.FullName</div>
                                        </td>
                                        <td class="px-3"><span class="small text-cyan">@u.Email</span></td>
                                        <td class="px-3"><small class="text-white-50">@u.CreatedDate.ToString("MMM dd, yyyy")</small></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
