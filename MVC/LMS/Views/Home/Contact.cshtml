@{
    ViewBag.Title = "Contact & Support";
}

<div class="py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                    <span class="pulse-dot pulse-primary"></span> Get in Touch
                </span>
                <h2 class="fw-extrabold tracking-tight">Contact Our Advisory & Support Team</h2>
                <p class="text-secondary small">Have questions regarding curriculums, enterprise enrollments, or instructor onboarding?</p>
            </div>

            <div class="card card-custom p-4 p-md-5 shadow-sm bg-white card-gradient-top">
                <form onsubmit="event.preventDefault(); LMS.toast('Thank you for reaching out! Our team will respond to your inquiry shortly.', 'success'); this.reset();">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Your Name</label>
                            <input type="text" class="form-control" placeholder="John Doe" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Email Address</label>
                            <input type="email" class="form-control" placeholder="name@example.com" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Subject</label>
                            <input type="text" class="form-control" placeholder="Inquiry about courses, grading, or certificates" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Message</label>
                            <textarea class="form-control" rows="5" placeholder="Write your inquiry or question here..." required></textarea>
                        </div>
                        <div class="col-12 text-end pt-2">
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-send-fill me-1"></i> Send Inquiry
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="row g-4 mt-4 text-center">
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 border card-hover">
                        <i class="bi bi-geo-alt-fill fs-3 text-primary mb-2"></i>
                        <h6 class="fw-bold mb-1">Campus Hub</h6>
                        <small class="text-muted">Kolkata, West Bengal, India</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 border card-hover">
                        <i class="bi bi-envelope-fill fs-3 text-primary mb-2"></i>
                        <h6 class="fw-bold mb-1">Email Advisory</h6>
                        <small class="text-muted">support@lms.edu</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 border card-hover">
                        <i class="bi bi-telephone-fill fs-3 text-primary mb-2"></i>
                        <h6 class="fw-bold mb-1">Direct Line</h6>
                        <small class="text-muted">+91 (033) 2200-LMS-EDU</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>