@model LMS.ViewModels.ForgotPasswordViewModel
@{
    ViewBag.Title = "Request Password Reset";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom p-4 p-md-5 shadow-lg border-0" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25) !important; border-radius: 20px; backdrop-filter: blur(16px); color: #FFFFFF;">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 shadow-sm" style="background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.3);">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </div>
                <h3 class="fw-extrabold text-white tracking-tight mb-1">Forgot Password?</h3>
                <p class="small mb-0" style="color: #94A3B8;">
                    Submit a password reset request. Once verified and approved by the administrator or faculty director, you will be authorized to set a new password.
                </p>
            </div>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small border-0 border-start border-4 border-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold small text-white" })
                    <div class="input-group">
                        <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-envelope"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "instructor@lms.com", required = "required", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Reason, new { @class = "form-label fw-bold small text-white" })
                    @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = 3, placeholder = "Explain your password issue or identity confirmation details for faculty admin...", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                    <small style="color: #94A3B8; font-size: 11px;">Providing your full name or instructor registration details speeds up admin approval.</small>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary py-2 rounded-pill fw-bold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                        <i class="bi bi-send-fill me-1"></i> Send Verification Request
                    </button>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light py-2 rounded-pill fw-semibold" style="border-color: rgba(255, 255, 255, 0.25);">
                        <i class="bi bi-arrow-left me-1"></i> Return to Login
                    </a>
                </div>
            }
        </div>
    </div>
</div>
