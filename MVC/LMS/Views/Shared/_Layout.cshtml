@{
    string activeCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string activeAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isHome = (activeCtrl == "Home" && (activeAct == "Index" || string.IsNullOrEmpty(activeAct)));

    string pageClass = ViewBag.PageClass as string;
    if (string.IsNullOrEmpty(pageClass))
    {
        if (isHome) { pageClass = "page-home"; }
        else if (activeCtrl == "Home" && activeAct == "Instructors") { pageClass = "page-instructors"; }
        else if (activeCtrl == "Home" && activeAct == "About") { pageClass = "page-about"; }
        else if (activeCtrl == "Home" && activeAct == "Contact") { pageClass = "page-contact"; }
        else if (activeCtrl == "Courses" && activeAct == "Index") { pageClass = "page-courses"; }
        else if (activeCtrl == "Courses" && activeAct == "Details") { pageClass = "page-course-details"; }
        else if (activeCtrl == "Student" && activeAct == "Index") { pageClass = "page-student-dashboard"; }
        else if (activeCtrl == "Student" && activeAct == "MyCourses") { pageClass = "page-my-courses"; }
        else if (activeCtrl == "Student" && (activeAct == "Receipt" || activeAct == "AllReceipts")) { pageClass = "page-receipt"; }
        else if (activeCtrl == "Student" && activeAct == "Payments") { pageClass = "page-my-courses"; }
        else if (activeCtrl == "Student" && activeAct == "Quizzes") { pageClass = "page-quiz"; }
        else if (activeCtrl == "Student" && (activeAct == "Assignments" || activeAct == "AssignmentDetails")) { pageClass = "page-assignment"; }
        else if (activeCtrl == "Student" && activeAct == "Certificates") { pageClass = "page-certificate"; }
        else if (activeCtrl == "Learning") { pageClass = "page-learning"; }
        else if (activeCtrl == "Quiz" && activeAct == "Take") { pageClass = "page-quiz"; }
        else if (activeCtrl == "Quiz" && (activeAct == "Result" || activeAct == "Results")) { pageClass = "page-quiz-result"; }
        else if (activeCtrl == "Certificate" && activeAct == "ViewCertificate") { pageClass = "page-certificate"; }
        else if (activeCtrl == "Certificate" && (activeAct == "Verify" || activeAct == "VerifyCertificate")) { pageClass = "page-certificate-verify"; }
        else if (activeCtrl == "Instructor" && activeAct == "Index") { pageClass = "page-instructor-dashboard"; }
        else if (activeCtrl == "Instructor" && (activeAct == "Courses" || activeAct == "CreateCourse" || activeAct == "EditCourse" || activeAct == "Modules" || activeAct == "Lessons" || activeAct == "EditLesson" || activeAct == "Earnings" || activeAct == "Payments")) { pageClass = "page-instructor-management"; }
        else if (activeCtrl == "Instructor" && (activeAct == "Assignments" || activeAct == "Grade" || activeAct == "Submissions")) { pageClass = "page-assignment"; }
        else if (activeCtrl == "Admin" && activeAct == "Index") { pageClass = "page-admin-dashboard"; }
        else if (activeCtrl == "Admin") { pageClass = "page-admin-management"; }
        else if (activeCtrl == "Account" && (activeAct == "Login" || activeAct == "ForgotPassword" || activeAct == "ForgotPasswordConfirmation" || activeAct == "ResetPassword" || activeAct == "ResetPasswordConfirmation" || activeAct == "ResetPasswordError" || activeAct == "PendingApproval")) { pageClass = "page-login"; }
        else if (activeCtrl == "Account" && activeAct == "Register") { pageClass = "page-register"; }
        else if (activeCtrl == "Account" && (activeAct == "Profile" || activeAct == "ChangePassword")) { pageClass = "page-profile"; }
        else if (activeCtrl == "Notifications") { pageClass = "page-notifications"; }
        else if (activeCtrl == "Account") { pageClass = "page-login"; }
        else { pageClass = "page-" + activeCtrl.ToLower(); }
    }
}
