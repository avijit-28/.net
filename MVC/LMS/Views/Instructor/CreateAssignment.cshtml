@model LMS.ViewModels.AssignmentFormViewModel
@{
    ViewBag.Title = "Create Assignment";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Assignments", "Instructor", new { courseId = Model.CourseId })">Assignments</a></li>
            <li class="breadcrumb-item active" aria-current="page">New Assignment</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-file-earmark-plus me-2"></i>Create New Assignment</h4>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("CreateAssignment", "Instructor", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.CourseId)
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Title, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Build an E-Commerce Cart Application" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Description, new { @class = "form-label fw-bold" })
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 6, placeholder = "Describe the instructions, requirements, evaluation criteria, and repository or zip submission guidelines." })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.MaxMarks, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.MaxMarks, new { @class = "form-control", type = "number", min = "1", max = "1000", placeholder = "100" })
                                @Html.ValidationMessageFor(m => m.MaxMarks, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.DueDate, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                                <small class="text-muted">Optional deadline for student submissions</small>
                                @Html.ValidationMessageFor(m => m.DueDate, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="@Url.Action("Assignments", "Instructor", new { courseId = Model.CourseId })" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i> Save Assignment
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
