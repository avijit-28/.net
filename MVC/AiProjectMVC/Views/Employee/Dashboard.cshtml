@model AiProjectMVC.ViewModels.EmployeeDashboardViewModel

@{
    ViewBag.Title = "Employee Dashboard";
    var user = Model.CurrentUser;
    var emp = Model.EmployeeProfile;
    var addr = Model.AddressDetails;
    var teammates = Model.DepartmentColleagues ?? new List<AiProjectMVC.Models.Employee>();
    var users = Model.SystemUsers ?? new List<AiProjectMVC.Models.EmployeeUser>();

    var initials = user != null && !string.IsNullOrWhiteSpace(user.Name) ? user.Name.Substring(0, 1).ToUpper() : "U";
    var role = user?.Role ?? "Employee";
    var roleBadge = role.ToLower().Contains("admin") ? "bg-danger" :
                    role.ToLower().Contains("manager") ? "bg-warning text-dark" :
                    role.ToLower().Contains("hr") ? "bg-info text-dark" :
                    role.ToLower().Contains("lead") ? "bg-purple text-white" : "bg-primary";
}

<!-- Welcome Hero Header -->
<div class="custom-card mb-4 overflow-hidden border-0 shadow-sm">
    <div class="p-4 p-md-5 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #3730a3 100%);">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 76px; height: 76px; border-radius: 20px; background: rgba(255,255,255,0.18); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; font-size: 2.4rem; font-weight: 800; border: 2px solid rgba(255,255,255,0.3); box-shadow: 0 8px 24px rgba(0,0,0,0.2);">
                    @initials
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge @roleBadge px-2 py-1 fs-6">
                            <i class="bi bi-shield-check me-1"></i> @role
                        </span>
                        <span class="badge bg-white bg-opacity-20 text-white px-2 py-1">
                            <i class="bi bi-at"></i> @(user?.UserName ?? "user")
                        </span>
                    </div>
                    <h2 class="fw-bold mb-1">Welcome, @(user?.Name ?? "Employee")!</h2>
                    <p class="text-white-50 small mb-0">Employee Portal Dashboard &bull; Connected to Assignmet Database</p>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-light btn-sm px-3">
                    <i class="bi bi-people-fill me-1"></i> All Employees
                </a>
                <a href="@Url.Action("Index", "Address")" class="btn btn-outline-light btn-sm px-3">
                    <i class="bi bi-geo-alt-fill me-1"></i> Addresses
                </a>
                <a href="@Url.Action("Logout", "Account")" class="btn btn-danger btn-sm px-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Statistics KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon-wrapper stat-icon-primary">
                <i class="bi bi-hash"></i>
            </div>
            <div>
                <div class="stat-label">Employee ID</div>
                <div class="stat-value">#(emp != null ? emp.ID.ToString() : user?.ID.ToString() ?? "N/A")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon-wrapper stat-icon-info">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <div class="stat-label">Department</div>
                <div class="stat-value text-truncate" style="max-width: 140px;">@(emp?.Dept ?? "General")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon-wrapper stat-icon-success">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <div class="stat-label">Current Salary</div>
                <div class="stat-value">&#8377;@(emp != null ? emp.Salary.ToString("N0") : "50,000")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon-wrapper stat-icon-warning">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="stat-label">Total System Users</div>
                <div class="stat-value">@Model.TotalUsers</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: User Profile & Address -->
    <div class="col-lg-7">
        <!-- Personal Profile Details -->
        <div class="custom-card mb-4">
            <div class="custom-card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i> User Profile & Contact Info</h5>
                @if (emp != null)
                {
                    <a href="@Url.Action("Edit", "Employee", new { id = emp.ID })" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil"></i> Edit Profile
                    </a>
                }
            </div>
            <div class="custom-card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Full Name</div>
                            <div class="fw-bold text-dark">@(user?.Name ?? "N/A")</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">System Username</div>
                            <div class="fw-bold text-primary font-monospace">@(user?.UserName ?? "N/A")</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Email Address</div>
                            <div class="fw-semibold text-dark"><i class="bi bi-envelope me-1 text-muted"></i>@(user?.Email ?? "N/A")</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Phone Number</div>
                            <div class="fw-semibold text-dark"><i class="bi bi-telephone me-1 text-muted"></i>@(user?.PhoneNumber ?? "N/A")</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Designation / Role</div>
                            <div class="fw-bold text-dark"><span class="badge @roleBadge">@role</span></div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Base Office / City</div>
                            <div class="fw-semibold text-dark"><i class="bi bi-geo-alt me-1 text-muted"></i>@(emp?.City ?? "Kolkata")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Linked Postal Address -->
        <div class="custom-card mb-4">
            <div class="custom-card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-geo-alt-fill text-danger me-2"></i> My Linked Address</h5>
                @if (addr != null)
                {
                    <a href="@Url.Action("Edit", "Address", new { id = addr.AddressId })" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-pencil"></i> Edit Address
                    </a>
                }
            </div>
            <div class="custom-card-body">
                @if (addr != null)
                {
                    <div class="row g-3">
                        <div class="col-sm-6 col-md-3">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Address ID</div>
                            <div class="fw-bold text-primary">#@addr.AddressId</div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">City</div>
                            <div class="fw-bold text-dark">@addr.City</div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">State</div>
                            <div class="fw-semibold text-dark">@addr.State</div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Country</div>
                            <div class="fw-semibold text-dark">@addr.Country</div>
                        </div>
                        <div class="col-12">
                            <div class="p-2 px-3 bg-light rounded-2 border d-inline-flex align-items-center gap-2">
                                <span class="text-muted small">Postal PIN:</span>
                                <span class="badge bg-dark font-monospace">@addr.Pin</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-light border rounded-3 p-3 mb-0 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle text-warning fs-5"></i>
                            <div class="small text-muted">No address linked to this profile.</div>
                        </div>
                        <a href="@Url.Action("Create", "Address")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-plus-lg"></i> Add Address
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Department Teammates & Directory -->
    <div class="col-lg-5">
        <!-- Department Colleagues -->
        <div class="custom-card mb-4">
            <div class="custom-card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-people text-info me-2"></i> Department Colleagues
                </h5>
                <span class="badge bg-light text-dark border">@(emp?.Dept ?? "Team")</span>
            </div>
            <div class="custom-card-body p-0">
                @if (teammates.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var colleague in teammates.Take(5))
                        {
                            <li class="list-group-item d-flex align-items-center justify-content-between p-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 38px; height: 38px; border-radius: 10px; background: #eef2ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                                        @(colleague.Name.Length > 0 ? colleague.Name.Substring(0, 1) : "?")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">@colleague.Name</div>
                                        <div class="text-muted smaller"><i class="bi bi-geo-alt me-1"></i>@colleague.City</div>
                                    </div>
                                </div>
                                <a href="@Url.Action("Details", "Employee", new { id = colleague.ID })" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" title="View details">
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">
                        <i class="bi bi-person-check fs-2 text-secondary d-block mb-1"></i>
                        No other colleagues in this department.
                    </div>
                }
            </div>
        </div>

        <!-- System User Directory Preview -->
        <div class="custom-card">
            <div class="custom-card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-workspace text-warning me-2"></i> Staff Directory (20)</h5>
                <a href="@Url.Action("Index", "Employee")" class="small text-primary text-decoration-none fw-semibold">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="custom-card-body p-0">
                <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                    <table class="table custom-table mb-0">
                        <thead class="sticky-top bg-light">
                            <tr>
                                <th>Name</th>
                                <th>Role</th>
                                <th>Contact</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in users)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold text-dark small">@u.Name</span>
                                        <div class="smaller text-muted">@@@u.UserName</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border smaller">@u.Role</span>
                                    </td>
                                    <td>
                                        <span class="smaller font-monospace text-muted">@u.PhoneNumber</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
