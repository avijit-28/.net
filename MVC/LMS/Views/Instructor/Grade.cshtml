@model LMS.ViewModels.GradeSubmissionViewModel
@{
    ViewBag.Title = "Grade Submission - " + Model.AssignmentTitle;
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Submissions", "Instructor", new { assignmentId = Model.AssignmentId })" class="text-decoration-none">Submissions</a></li>
            <li class="breadcrumb-item active" aria-current="page">Grade: @Model.StudentName</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-award-fill text-primary me-1"></i> Faculty Evaluation
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Grade Submission: @Model.StudentName</h2>
            <p class="text-muted small mb-0">Project: <strong>@Model.AssignmentTitle</strong> (Course: @Model.CourseTitle)</p>
        </div>
        <div>
            <a href="@Url.Action("Submissions", "Instructor", new { assignmentId = Model.AssignmentId })" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to Submissions
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Student Work Showcase -->
        <div class="col-lg-7">
            <div class="card card-custom p-4 p-md-5 shadow-sm bg-white border-0 card-gradient-top mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px;">Enrolled Student</span>
                        <div class="fw-bold fs-5 text-dark">@Model.StudentName</div>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px;">Submitted Timestamp</span>
                        <div class="small text-dark font-monospace">@Model.SubmittedDate.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-dark">Assignment Objective & Rubric</label>
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="fw-bold text-dark mb-1">@Model.AssignmentTitle</div>
                        <small class="text-muted">Max Score Standard: <strong>@Model.MaxMarks pts</strong></small>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-dark">Student Implementation Notes</label>
                    <div class="p-4 bg-light rounded-3 border font-monospace text-dark small" style="white-space: pre-wrap; min-height: 140px; line-height: 1.7;">
                        @(string.IsNullOrWhiteSpace(Model.SubmissionText) ? "No written text submitted." : Model.SubmissionText)
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.FileUrl))
                {
                    <div class="p-3 border rounded-3 bg-white shadow-xs d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary-subtle text-primary p-2">
                                <i class="bi bi-github fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold small">Project Source Repository / Attachment</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 320px;">@Model.FileUrl</small>
                            </div>
                        </div>
                        <a href="@Model.FileUrl" target="_blank" class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Open Repo
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Grading & Feedback Form -->
        <div class="col-lg-5">
            <div class="card card-custom p-4 p-md-5 shadow-sm bg-white border-0">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Score & Evaluation</h5>

                @using (Html.BeginForm("Grade", "Instructor", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.SubmissionId)
                    @Html.HiddenFor(m => m.AssignmentId)
                    @Html.HiddenFor(m => m.AssignmentTitle)
                    @Html.HiddenFor(m => m.CourseTitle)
                    @Html.HiddenFor(m => m.StudentName)
                    @Html.HiddenFor(m => m.SubmittedDate)
                    @Html.HiddenFor(m => m.SubmissionText)
                    @Html.HiddenFor(m => m.FileUrl)
                    @Html.HiddenFor(m => m.MaxMarks)

                    if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger rounded-3 mb-3">@TempData["ErrorMessage"]</div>
                    }

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-dark">Awarded Score (0 to @Model.MaxMarks pts)</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Marks, new { @class = "form-control fs-4 fw-extrabold text-primary", type = "number", min = "0", max = Model.MaxMarks.ToString(), required = "required" })
                            <span class="input-group-text bg-light fw-bold">/ @Model.MaxMarks pts</span>
                        </div>
                        @Html.ValidationMessageFor(m => m.Marks, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Feedback, "Faculty Feedback & Review Remarks", new { @class = "form-label fw-bold small text-dark" })
                        @Html.TextAreaFor(m => m.Feedback, new { @class = "form-control", rows = 6, placeholder = "Provide constructive feedback on architectural choices, code quality, strengths, and areas for improvement..." })
                        @Html.ValidationMessageFor(m => m.Feedback, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill py-3 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Grade & Publish Feedback
                        </button>
                        <a href="@Url.Action("Submissions", "Instructor", new { assignmentId = Model.AssignmentId })" class="btn btn-outline-secondary rounded-pill py-2">
                            Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
