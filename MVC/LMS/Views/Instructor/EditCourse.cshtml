@model LMS.ViewModels.CourseFormViewModel
@{
    ViewBag.Title = "Edit Course - " + Model.Title;
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-0">Edit Course</h3>
                <p class="text-muted small">Update course metadata, syllabus descriptions, and publication status</p>
            </div>
            <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Courses
            </a>
        </div>

        <div class="card card-custom p-4 p-md-5 shadow-sm">
            @using (Html.BeginForm("EditCourse", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CourseId)
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.CategoryId, "Subject / Category", new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(m => m.CategoryId, Model.Categories, "-- Select Subject / Category --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Level, new { @class = "form-label fw-semibold" })
                        <select name="Level" class="form-select">
                            <option value="Beginner" @(Model.Level == "Beginner" ? "selected" : "")>Beginner</option>
                            <option value="Intermediate" @(Model.Level == "Intermediate" ? "selected" : "")>Intermediate</option>
                            <option value="Advanced" @(Model.Level == "Advanced" ? "selected" : "")>Advanced</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Price, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text"><span class="rupee-symbol">&#8377;</span></span>
                            @Html.TextBoxFor(m => m.Price, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.DurationInHours, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.DurationInHours, new { @class = "form-control" })
                            <span class="input-group-text">Hours</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Thumbnail, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Thumbnail, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Publication Status</label>
                    <select name="Status" class="form-select">
                        <option value="Draft" @(Model.Status == "Draft" ? "selected" : "")>Draft (Private)</option>
                        <option value="Published" @(Model.Status == "Published" ? "selected" : "")>Published (Public & Enrollable)</option>
                        <option value="Archived" @(Model.Status == "Archived" ? "selected" : "")>Archived (Hidden from catalog)</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary rounded-pill">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="bi bi-save me-1"></i> Update Course
                    </button>
                </div>
            }
        </div>
    </div>
</div>
