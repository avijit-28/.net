@model LMS.ViewModels.QuizFormViewModel
@{
    ViewBag.Title = "Edit Assessment Quiz - " + (Model.CourseTitle ?? "Course");
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")" class="text-decoration-none">My Courses</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Quizzes", "Instructor", new { courseId = Model.CourseId })" class="text-decoration-none">Quizzes</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit Quiz</li>
            </ol>
        </nav>

        <div class="card card-custom p-4 p-md-5 shadow-sm bg-white card-gradient-top border-0">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="rounded-circle bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center shadow-xs" style="width: 50px; height: 50px;">
                    <i class="bi bi-pencil-square fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-extrabold mb-0 tracking-tight">Edit Assessment Quiz</h3>
                    <p class="text-muted small mb-0">Modify passing percentage standards, time limits, and evaluation metadata</p>
                </div>
            </div>

            @using (Html.BeginForm("EditQuiz", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.QuizId)
                @Html.HiddenFor(m => m.CourseId)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, "Quiz Title", new { @class = "form-label fw-bold small text-dark" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Module 2: Core Concepts Assessment", required = "required" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="card p-3 mb-3 border bg-light-subtle rounded-3">
                    <label class="form-label fw-bold small text-dark mb-2">Quiz Scope & Category</label>
                    <div class="form-check mb-2">
                        @Html.RadioButtonFor(m => m.IsFinalExam, false, new { @class = "form-check-input", id = "quizTypeModule", onchange = "toggleQuizScope()" })
                        <label class="form-check-label fw-semibold small text-dark" for="quizTypeModule">
                            <i class="bi bi-collection-play-fill text-primary me-1"></i> Module Checkpoint Quiz
                            <span class="text-muted fw-normal d-block small">Embedded inside a curriculum module. Required to complete that module's progress.</span>
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.IsFinalExam, true, new { @class = "form-check-input", id = "quizTypeFinal", onchange = "toggleQuizScope()" })
                        <label class="form-check-label fw-semibold small text-dark" for="quizTypeFinal">
                            <i class="bi bi-award-fill text-warning me-1"></i> Final Mandatory Course Exam
                            <span class="text-muted fw-normal d-block small">Placed after all modules. Unlocks ONLY when 100% of modules are finished. Passing this issues the certificate.</span>
                        </label>
                    </div>
                </div>

                <div class="mb-3" id="moduleSelectGroup">
                    <label class="form-label fw-bold small text-dark">Associated Curriculum Module</label>
                    @Html.DropDownListFor(m => m.ModuleId, Model.ModuleList, new { @class = "form-select", id = "moduleDropdown" })
                    <small class="text-muted">Choose which module this checkpoint quiz evaluates.</small>
                    @Html.ValidationMessageFor(m => m.ModuleId, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Description, "Quiz Instructions & Scope", new { @class = "form-label fw-bold small text-dark" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "Explain what areas are evaluated, rules on attempts, and grading criteria..." })
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PassingPercentage, "Passing Threshold (%)", new { @class = "form-label fw-bold small text-dark" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.PassingPercentage, new { @class = "form-control", placeholder = "60", required = "required" })
                            <span class="input-group-text bg-light">%</span>
                        </div>
                        <small class="text-muted">Minimum percentage required to earn passing status.</small>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.TimeLimitMinutes, "Timer Limit (Minutes)", new { @class = "form-label fw-bold small text-dark" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.TimeLimitMinutes, new { @class = "form-control", placeholder = "30" })
                            <span class="input-group-text bg-light"><i class="bi bi-stopwatch"></i></span>
                        </div>
                        <small class="text-muted">Countdown duration before auto-submission.</small>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="@Url.Action("Quizzes", "Instructor", new { courseId = Model.CourseId })" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Update Quiz
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        function toggleQuizScope() {
            var isFinal = document.getElementById('quizTypeFinal').checked;
            var modGroup = document.getElementById('moduleSelectGroup');
            if (modGroup) {
                modGroup.style.display = isFinal ? 'none' : 'block';
            }
        }
        document.addEventListener('DOMContentLoaded', toggleQuizScope);
    </script>
}
