{
  "info": {
    "name": "Inventory Tracking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7001" },
    { "key": "token", "value": "" },
    { "key": "assetId", "value": "1" },
    { "key": "username", "value": "replace-with-user" },
    { "key": "password", "value": "replace-with-password" }
  ],
  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "Login success",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.collectionVariables.set('token', body.accessToken);"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Login invalid credentials",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }
        }
      ]
    },
    {
      "name": "Assets",
      "item": [
        { "name": "List assets", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }], "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/api/assets" } },
        { "name": "Get asset by ID", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/api/assets/{{assetId}}" } },
        { "name": "Create asset", "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('assetId', pm.response.json().assetId);"] , "type": "text/javascript" } }], "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"assetName\": \"Lab Laptop\",\n  \"category\": \"Computer\",\n  \"purchaseDate\": \"2026-11-12\",\n  \"status\": \"Active\",\n  \"price\": 850.00\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/assets" } },
        { "name": "Create asset invalid body", "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }], "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"assetName\": \"\",\n  \"category\": \"\",\n  \"price\": -5\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/assets" } },
        { "name": "Update asset", "request": { "method": "PUT", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"assetName\": \"Lab Laptop Updated\",\n  \"category\": \"Computer\",\n  \"purchaseDate\": \"2026-11-12\",\n  \"status\": \"Active\",\n  \"price\": 825.00\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/assets/{{assetId}}" } },
        { "name": "Delete asset (soft delete)", "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/api/assets/{{assetId}}" } },
        { "name": "Get missing asset", "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }], "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/api/assets/2147483647" } },
        { "name": "List assets without token", "auth": { "type": "noauth" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/assets" } }
      ]
    }
  ]
}
