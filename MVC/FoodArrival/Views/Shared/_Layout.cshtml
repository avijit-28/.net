<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fff8f1" />
    <title>@ViewBag.Title - FoodArrival</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg container py-3" aria-label="Main navigation">
            @Html.ActionLink("FoodArrival", "Index", "Restaurants", null, new { @class = "navbar-brand brand-mark" })
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item">@Html.ActionLink("Restaurants", "Index", "Restaurants", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Your orders", "Index", "Orders", null, new { @class = "nav-link" })</li>
                    @if (Request.IsAuthenticated)
                    {
                        if (User.IsInRole("RestaurantStaff")) { <li class="nav-item">@Html.ActionLink("Restaurant dashboard", "Index", "RestaurantDashboard", null, new { @class = "nav-link" })</li> }
                        if (User.IsInRole("DeliveryAgent")) { <li class="nav-item">@Html.ActionLink("Deliveries", "Index", "Delivery", null, new { @class = "nav-link" })</li> }
                        if (User.IsInRole("Admin")) { <li class="nav-item">@Html.ActionLink("Admin", "Index", "Admin", null, new { @class = "nav-link" })</li> }
                        <li class="nav-item"><span class="nav-link text-muted">My account</span></li>
                        <li class="nav-item">
                            @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-dark btn-sm" type="submit">Sign out</button>
                            }
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">@Html.ActionLink("Sign in", "Login", "Account", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Create account", "Register", "Account", null, new { @class = "btn btn-dark btn-sm px-3" })</li>
                    }
                    <li class="nav-item">@Html.ActionLink("Cart", "Index", "Cart", null, new { @class = "btn btn-warning btn-sm px-3 ms-lg-2" })</li>
                </ul>
            </div>
        </nav>
    </header>
    <main class="container page-shell">
        @if (TempData["Notice"] != null) { <div class="alert alert-success" role="status">@TempData["Notice"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }
        @RenderBody()
    </main>
    <footer class="site-footer"><div class="container d-flex flex-column flex-sm-row justify-content-between gap-2"><span>FoodArrival · Good food, on its way.</span><span>&copy; @DateTime.Now.Year FoodArrival</span></div></footer>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("scripts", required: false)
</body>
</html>
