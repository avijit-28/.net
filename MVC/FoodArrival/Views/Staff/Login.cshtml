@model FoodArrival.Models.LoginViewModel
@{
    ViewBag.Title = "Kitchen Staff Login - FoodReady";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="auth-container shadow-lg rounded-5 overflow-hidden" style="max-width: 880px; margin: 0 auto; background: #FFFFFF;">
        <div class="row g-0">
            <!-- Left Staff Hero Banner -->
            <div class="col-lg-5 p-5 text-white d-flex flex-column justify-content-center position-relative" style="background: linear-gradient(145deg, #1E3A8A 0%, #172554 100%); min-height: 480px;">
                <div class="mb-4">
                    <i class="bi bi-person-workspace display-4 text-warning"></i>
                </div>
                <h1 class="fw-bold mb-3" style="font-size: 2.1rem; letter-spacing: -0.5px;">Kitchen Staff Portal</h1>
                <p class="text-white-50 mb-4" style="line-height: 1.6; font-size: 1.05rem;">
                    Access your staff dashboard, track prep tickets, monitor your performance score (PMS), and propose new recipes.
                </p>
                <div class="mt-auto pt-3 border-top border-secondary text-white-50 small">
                    <i class="bi bi-shield-check text-warning me-1"></i> Kitchen Staff & Culinary Team Only
                </div>
            </div>

            <!-- Right Login Form -->
            <div class="col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center bg-white">
                <div class="text-center mb-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 56px; height: 56px; background: #EFF6FF; color: #1D4ED8;">
                        <i class="bi bi-person-badge fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Staff Member Login</h3>
                    <p class="text-muted small">Enter your staff email or username</p>
                </div>

                @using (Html.BeginForm("Login", "Staff", FormMethod.Post, new { @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Email or Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0 ps-0", placeholder = "staff@example.com or username", required = "required" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0 border-end-0 ps-0", id = "staffPassword", placeholder = "Enter password", required = "required" })
                            <button type="button" class="input-group-text bg-white border-start-0 text-muted" onclick="togglePasswordVisibility('staffPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <button type="submit" class="btn btn-primary-food w-100 py-2 fs-6 fw-bold shadow-sm" style="background: linear-gradient(135deg, #1D4ED8, #2563EB); border-radius: 12px; height: 48px;">
                        Login to Kitchen Portal
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        Need an account? <a href="@Url.Action("Register", "Account", new { role = "RestaurantStaff" })" class="fw-bold text-decoration-none text-primary">Register as Staff</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon = btn.querySelector('i');
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = "password";
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }
</script>
