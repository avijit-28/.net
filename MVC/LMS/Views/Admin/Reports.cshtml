@model LMS.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "Platform Reports & Analytics";
    var completionRate = Model.TotalEnrollments > 0 ? (int)((double)Model.TotalCertificates / Model.TotalEnrollments * 100) : 0;
    var avgRevenuePerStudent = Model.TotalStudents > 0 ? Model.TotalRevenue / Model.TotalStudents : 0;
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Reports & Analytics</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Executive Telemetry
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Operational Reports & Analytics</h2>
            <p class="text-muted small mb-0">Platform health KPIs, completion velocity, revenue metrics, and domain distribution</p>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-4 fw-semibold shadow-xs" onclick="window.print();">
            <i class="bi bi-printer me-1"></i> Print / Export Report
        </button>
    </div>

    <!-- Core KPI Matrix -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover bg-white border-0" style="border-left: 4px solid #10b981 !important;">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 11px;">Completion Rate</span>
                <div class="fs-2 fw-extrabold text-success mt-1">@completionRate%</div>
                <small class="text-muted mt-1">@Model.TotalCertificates / @Model.TotalEnrollments finished</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover bg-white border-0" style="border-left: 4px solid #4f46e5 !important;">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 11px;">Avg Revenue / Learner</span>
                <div class="fs-2 fw-extrabold text-primary mt-1"><span class="rupee-symbol">&#8377;</span>@avgRevenuePerStudent.ToString("N2")</div>
                <small class="text-muted mt-1">Gross lifetime learner value</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover bg-white border-0" style="border-left: 4px solid #06b6d4 !important;">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 11px;">Published Catalog Ratio</span>
                <div class="fs-2 fw-extrabold text-info mt-1">
                    @(Model.TotalCourses > 0 ? ((int)((double)Model.PublishedCourses / Model.TotalCourses * 100)).ToString() : "0")%
                </div>
                <small class="text-muted mt-1">@Model.PublishedCourses active of @Model.TotalCourses total</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-4 shadow-sm h-100 card-hover bg-white border-0" style="border-left: 4px solid #f59e0b !important;">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 11px;">Learner-Instructor Ratio</span>
                <div class="fs-2 fw-extrabold text-warning mt-1">
                    @(Model.TotalInstructors > 0 ? (Model.TotalStudents / Model.TotalInstructors).ToString() : "0"):1
                </div>
                <small class="text-muted mt-1">@Model.TotalStudents learners / @Model.TotalInstructors faculty</small>
            </div>
        </div>
    </div>

    <!-- Analytics Breakdown -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card card-custom shadow-sm h-100 bg-white border-0 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Category Distribution & Demand</h5>
                    <span class="badge bg-light text-muted border small">@Model.CategoryStats.Count Domains</span>
                </div>
                <div class="card-body p-4">
                    @if (!Model.CategoryStats.Any())
                    {
                        <p class="text-muted text-center py-4">No categories recorded.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Category Name</th>
                                        <th>Courses</th>
                                        <th>Catalog Share</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cat in Model.CategoryStats)
                                    {
                                        var pct = Model.TotalCourses > 0 ? (int)((double)cat.CourseCount / Model.TotalCourses * 100) : 0;
                                        <tr>
                                            <td class="fw-semibold text-dark">@cat.CategoryName</td>
                                            <td><span class="badge badge-primary-subtle rounded-pill px-2 py-1">@cat.CourseCount</span></td>
                                            <td style="width: 45%;">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 6px;">
                                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @pct%;"></div>
                                                    </div>
                                                    <span class="small fw-bold text-dark">@pct%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card card-custom shadow-sm h-100 bg-white border-0 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-check me-2 text-success"></i>System Health & Infrastructure</h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                        <span class="pulse-dot pulse-success"></span> All Services Online
                    </span>
                </div>
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <div>
                                <div class="fw-bold text-dark">Database Connectivity</div>
                                <small class="text-muted">Microsoft SQL Server Local Instance & Entity Framework 6</small>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Operational</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <div>
                                <div class="fw-bold text-dark">Authentication Engine</div>
                                <small class="text-muted">ASP.NET Identity 2.2 / OWIN Secure Cookie Authentication</small>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Active</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <div>
                                <div class="fw-bold text-dark">Role-Based Access Control</div>
                                <small class="text-muted">Strict [Authorize(Roles="...")] across Admin, Instructor, Student</small>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Enforced</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <div>
                                <div class="fw-bold text-dark">Automated Assessment Engine</div>
                                <small class="text-muted">Quiz grading with instant certificate issuance threshold</small>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Ready</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <div>
                                <div class="fw-bold text-dark">Payment Gateway Simulator</div>
                                <small class="text-muted">Simulated multi-channel checkout with audit trail logging</small>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Active</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
