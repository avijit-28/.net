@model IEnumerable<LMS.ViewModels.UserManagementViewModel>
@{
    ViewBag.Title = "User Directory & Roles";
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">User Directory</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Identity Governance
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">User Directory & Role Governance</h2>
            <p class="text-muted small mb-0">View registered accounts, inspect privileges, and reassign user permissions across the LMS</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-xs">
                Total Accounts: <strong>@Model.Count()</strong>
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter & Search Controls -->
    <div class="card card-custom p-3 mb-4 shadow-sm bg-white">
        <div class="row g-2 align-items-center justify-content-between">
            <div class="col-md-7 d-flex flex-wrap gap-2 align-items-center">
                <span class="small fw-bold text-muted text-uppercase me-1" style="font-size: 11px;">Filter:</span>
                <a href="@Url.Action("Users", "Admin")" class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.CurrentRoleFilter as string) ? "btn-primary" : "btn-light border") rounded-pill px-3">
                    All Users
                </a>
                <a href="@Url.Action("Users", "Admin", new { roleFilter = "Student" })" class="btn btn-sm @((ViewBag.CurrentRoleFilter as string) == "Student" ? "btn-primary" : "btn-light border") rounded-pill px-3">
                    <i class="bi bi-mortarboard me-1"></i> Students Only
                </a>
                <a href="@Url.Action("Users", "Admin", new { roleFilter = "Instructor" })" class="btn btn-sm @((ViewBag.CurrentRoleFilter as string) == "Instructor" ? "btn-primary" : "btn-light border") rounded-pill px-3">
                    <i class="bi bi-person-badge me-1"></i> Instructors Only
                </a>
                <a href="@Url.Action("Users", "Admin", new { roleFilter = "Admin" })" class="btn btn-sm @((ViewBag.CurrentRoleFilter as string) == "Admin" ? "btn-primary" : "btn-light border") rounded-pill px-3">
                    <i class="bi bi-shield-lock me-1"></i> Admins Only
                </a>
            </div>
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="userQuickSearch" class="form-control border-start-0" placeholder="Filter by name or email..." />
                </div>
            </div>
        </div>
    </div>

    <div class="card card-custom shadow-sm overflow-hidden bg-white border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="usersTable">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Email Address</th>
                        <th>Current Role</th>
                        <th>Registered Date</th>
                        <th>Account Status</th>
                        <th class="text-end pe-4">Update Privileges</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="user-row" data-name="@user.FullName.ToLower()" data-email="@user.Email.ToLower()">
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary-subtle text-primary p-2 me-3 d-flex align-items-center justify-content-center fw-bold shadow-xs" style="width: 38px; height: 38px;">
                                        @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@user.FullName</div>
                                        <small class="text-muted font-monospace" style="font-size: 11px;">#@user.Id.Substring(0, Math.Min(8, user.Id.Length))</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="small text-secondary">@user.Email</span></td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-shield-lock-fill me-1"></i>Administrator
                                    </span>
                                }
                                else if (user.Role == "Instructor")
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-person-badge-fill me-1"></i>Instructor
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-mortarboard-fill me-1"></i>Student
                                    </span>
                                }
                            </td>
                            <td><span class="small text-muted">@user.CreatedDate.ToString("MMM dd, yyyy")</span></td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        <span class="pulse-dot pulse-success"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-lock-fill me-1"></i> Locked
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @using (Html.BeginForm("ChangeRole", "Admin", FormMethod.Post, new { @class = "d-inline-flex gap-1 justify-content-end align-items-center" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <select name="newRole" class="form-select form-select-sm rounded-pill" style="width: 130px;">
                                        <option value="Student" @(user.Role == "Student" ? "selected" : "")>Student</option>
                                        <option value="Instructor" @(user.Role == "Instructor" ? "selected" : "")>Instructor</option>
                                        <option value="Admin" @(user.Role == "Admin" ? "selected" : "")>Admin</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" onclick="return confirm('Confirm updating role for @user.FullName?');">
                                        Save
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#userQuickSearch').on('input', function () {
                var q = $(this).val().toLowerCase().trim();
                $('.user-row').each(function () {
                    var name = $(this).data('name') || '';
                    var email = $(this).data('email') || '';
                    if (!q || name.indexOf(q) !== -1 || email.indexOf(q) !== -1) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });
        });
    </script>
}
