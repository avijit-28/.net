@model LMS.ViewModels.LearningViewModel
@{
    ViewBag.Title = Model.CurrentLesson != null ? Model.CurrentLesson.Title + " - " + Model.Course.Title : Model.Course.Title;
    var currentLessonId = Model.CurrentLesson != null ? Model.CurrentLesson.LessonId : 0;
}

<div class="classroom-container card card-custom shadow-sm border-0 overflow-hidden mb-4">
    <!-- Top Classroom Header Bar -->
    <div class="bg-dark text-white p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-3 border-bottom border-secondary" style="border-color: rgba(255,255,255,0.1) !important;">
        <div class="d-flex align-items-center gap-3">
            <a href="@Url.Action("MyCourses", "Student")" class="btn btn-sm btn-outline-light rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> My Courses
            </a>
            <div>
                <h5 class="fw-bold mb-0 text-white text-truncate" style="max-width: 480px;">@Model.Course.Title</h5>
                <small class="text-secondary">@(Model.CurrentModule != null ? Model.CurrentModule.ModuleName : "Curriculum")</small>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <!-- Focus / Theater Mode Switch -->
            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" id="btnToggleTheater" title="Toggle Theater / Focus Mode [Alt+F]">
                <i class="bi bi-moon-stars me-1"></i> Focus Mode
            </button>

            <!-- Progress Meter -->
            <div class="d-none d-sm-block text-end" style="min-width: 140px;">
                <div class="small text-secondary" style="font-size: 11px;">Course Progress</div>
                <div class="fw-bold text-success" id="progressText">@Model.ProgressPercentage% Completed</div>
            </div>
            <div class="progress" style="width: 130px; height: 10px; background: rgba(255,255,255,0.15);">
                <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="progressBar" role="progressbar" style="width: @Model.ProgressPercentage%;"></div>
            </div>

            @if (Model.IsCourseCompleted)
            {
                <a href="@Url.Action("Certificates", "Student")" class="btn btn-sm btn-warning fw-bold rounded-pill shadow-sm text-dark">
                    <i class="bi bi-award-fill me-1"></i> Certificate Ready!
                </a>
            }
        </div>
    </div>

    <!-- Classroom Body: Split Layout -->
    <div class="row g-0">
        <!-- Curriculum Sidebar -->
        <div class="col-lg-4 col-xl-3 border-end classroom-sidebar bg-light" style="max-height: 85vh; overflow-y: auto;">
            <div class="p-3 border-bottom bg-white sticky-top d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-uppercase small text-muted mb-0">
                    <i class="bi bi-list-check me-1 text-primary"></i> Syllabus Outline
                </h6>
                <span class="badge bg-light text-dark border small">@Model.Modules.Sum(m => m.Lessons.Count) Lessons</span>
            </div>

            <div class="accordion accordion-flush" id="learningAccordion">
                @for (int mIdx = 0; mIdx < Model.Modules.Count; mIdx++)
                {
                    var module = Model.Modules[mIdx];
                    bool isModuleActive = (Model.CurrentLesson != null && module.Lessons.Any(l => l.LessonId == Model.CurrentLesson.LessonId));
                    <div class="accordion-item border-bottom bg-transparent">
                        <h2 class="accordion-header" id="heading-@module.ModuleId">
                            <button class="accordion-button @(isModuleActive ? "" : "collapsed") bg-transparent py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@module.ModuleId">
                                <div class="w-100 pe-2">
                                    <div class="small text-muted fw-bold text-uppercase" style="font-size: 10px;">Module @(mIdx + 1)</div>
                                    <div class="fw-bold text-dark small">@module.ModuleName</div>
                                </div>
                            </button>
                        </h2>
                        <div id="collapse-@module.ModuleId" class="accordion-collapse collapse @(isModuleActive ? "show" : "")" data-bs-parent="#learningAccordion">
                            <div class="accordion-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var lesson in module.Lessons)
                                    {
                                        bool isCurrent = Model.CurrentLesson != null && lesson.LessonId == Model.CurrentLesson.LessonId;
                                        bool isDone = Model.CompletedLessonIds.Contains(lesson.LessonId);
                                        <a href="@Url.Action("Index", "Learning", new { courseId = Model.Course.CourseId, lessonId = lesson.LessonId })"
                                           class="list-group-item list-group-item-action py-3 px-3 d-flex align-items-center justify-content-between @(isCurrent ? "active-lesson bg-white border-start border-4 border-primary fw-bold" : "")">
                                            <div class="d-flex align-items-center gap-2 overflow-hidden pe-2">
                                                @if (isDone)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                }
                                                else if (isCurrent)
                                                {
                                                    <i class="bi bi-play-circle-fill text-primary fs-5"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-circle text-muted fs-5"></i>
                                                }
                                                <div class="small text-truncate">@lesson.Title</div>
                                            </div>
                                            <span class="badge bg-secondary-subtle text-secondary small" style="font-size: 10px;">
                                                @lesson.DurationInMinutes m
                                            </span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Main Lesson Stage -->
        <div class="col-lg-8 col-xl-9 classroom-stage bg-white p-4 p-md-5 d-flex flex-column" style="min-height: 85vh;">
            @if (Model.CurrentLesson == null)
            {
                <div class="text-center my-auto py-5">
                    <i class="bi bi-journal-check display-1 text-muted mb-3"></i>
                    <h4 class="fw-bold">Welcome to the Classroom</h4>
                    <p class="text-muted">Select a lesson from the curriculum sidebar on the left to begin learning.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge badge-primary-subtle small">
                                @Model.CurrentLesson.LessonType Lesson
                            </span>
                            <span class="small text-muted"><i class="bi bi-clock me-1"></i> @Model.CurrentLesson.DurationInMinutes minutes</span>
                        </div>
                        <h3 class="fw-bold mb-0">@Model.CurrentLesson.Title</h3>
                    </div>

                    <div class="mt-2 mt-md-0" id="completionStatusContainer">
                        @if (Model.IsCurrentCompleted)
                        {
                            <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill">
                                <i class="bi bi-check2-circle me-1"></i> Lesson Completed
                            </span>
                        }
                        else
                        {
                            using (Html.BeginForm("MarkComplete", "Learning", FormMethod.Post, new { id = "markCompleteForm", @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lessonId" value="@Model.CurrentLesson.LessonId" />
                                <button type="submit" id="btnMarkComplete" class="btn btn-outline-success rounded-pill px-4 fw-semibold shadow-sm">
                                    <i class="bi bi-check-lg me-1"></i> Mark as Complete
                                </button>
                            }
                        }
                    </div>
                </div>

                <!-- Lesson Content Area -->
                <div class="lesson-viewer flex-grow-1 mb-4">
                    @if (Model.CurrentLesson.LessonType == "Video")
                    {
                        <div class="bg-dark rounded-3 overflow-hidden shadow-sm mb-4 text-center p-3 position-relative" style="min-height: 400px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                            @if (!string.IsNullOrEmpty(Model.CurrentLesson.VideoUrl) && (Model.CurrentLesson.VideoUrl.Contains("embed") || Model.CurrentLesson.VideoUrl.Contains("youtube") || Model.CurrentLesson.VideoUrl.Contains("vimeo")))
                            {
                                <div class="ratio ratio-16x9 w-100 rounded-2 overflow-hidden shadow">
                                    <iframe src="@Model.CurrentLesson.VideoUrl" title="@Model.CurrentLesson.Title" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                </div>
                            }
                            else
                            {
                                <div class="py-5">
                                    <div class="rounded-circle bg-primary text-white p-4 d-inline-flex mb-3 shadow">
                                        <i class="bi bi-play-circle-fill display-4"></i>
                                    </div>
                                    <h5 class="text-white fw-bold">Interactive Video Lesson</h5>
                                    <p class="text-secondary small mb-3">High-definition stream initialized and ready for streaming.</p>
                                    @if (!string.IsNullOrEmpty(Model.CurrentLesson.VideoUrl))
                                    {
                                        <a href="@Model.CurrentLesson.VideoUrl" target="_blank" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Launch Stream in Full View
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (Model.CurrentLesson.LessonType == "Quiz")
                    {
                        var quiz = Model.Course.Quizzes.FirstOrDefault(q => q.LessonId == Model.CurrentLesson.LessonId) ?? Model.Course.Quizzes.FirstOrDefault();
                        <div class="card card-custom p-5 bg-light border-warning text-center my-3 shadow-sm">
                            <div class="rounded-circle bg-warning-subtle text-warning p-4 d-inline-flex mx-auto mb-3">
                                <i class="bi bi-patch-question-fill display-4"></i>
                            </div>
                            <h4 class="fw-bold">Module Knowledge Assessment</h4>
                            <p class="text-muted small mb-4" style="max-width: 500px; margin: 0 auto;">Evaluate your understanding of the concepts covered in this module. Quizzes feature a live timer and instant score calculation.</p>
                            @if (quiz != null)
                            {
                                <div>
                                    <a href="@Url.Action("Take", "Quiz", new { id = quiz.QuizId })" class="btn btn-warning rounded-pill px-5 py-2 fw-bold shadow text-dark">
                                        <i class="bi bi-lightning-charge-fill me-1"></i> Start Assessment Now
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else if (Model.CurrentLesson.LessonType == "Assignment")
                    {
                        var assignment = Model.Course.Assignments.FirstOrDefault(a => a.LessonId == Model.CurrentLesson.LessonId) ?? Model.Course.Assignments.FirstOrDefault();
                        <div class="card card-custom p-5 bg-light border-info text-center my-3 shadow-sm">
                            <div class="rounded-circle bg-info-subtle text-info p-4 d-inline-flex mx-auto mb-3">
                                <i class="bi bi-file-earmark-code-fill display-4"></i>
                            </div>
                            <h4 class="fw-bold">Practical Project Assignment</h4>
                            <p class="text-muted small mb-4" style="max-width: 500px; margin: 0 auto;">Submit your documented solution and GitHub repository link for faculty evaluation and grading.</p>
                            @if (assignment != null)
                            {
                                <div>
                                    <a href="@Url.Action("Details", "Assignment", new { id = assignment.AssignmentId })" class="btn btn-info text-white rounded-pill px-5 py-2 fw-bold shadow">
                                        <i class="bi bi-arrow-up-right-circle me-1"></i> Open Assignment Workspace
                                    </a>
                                </div>
                            }
                        </div>
                    }

                    <!-- Article / Text Content -->
                    @if (!string.IsNullOrEmpty(Model.CurrentLesson.Content))
                    {
                        <div class="lesson-notes-box p-4 bg-light rounded-3 border mb-4">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-book-half me-2 text-primary"></i> Lesson Explanation & Notes</h6>
                            <div class="text-secondary" style="line-height: 1.85;">
                                @Html.Raw(Model.CurrentLesson.Content.Replace("\n", "<br/>"))
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.CurrentLesson.Description))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-2">Lesson Overview</h6>
                            <p class="text-secondary" style="line-height: 1.6;">@Model.CurrentLesson.Description</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.CurrentLesson.ResourceUrl))
                    {
                        <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center bg-white shadow-sm mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-primary-subtle text-primary p-2">
                                    <i class="bi bi-download fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold small">Supplemental Material & Assets</div>
                                    <small class="text-muted">Downloadable guide or source code repository</small>
                                </div>
                            </div>
                            <a href="@Model.CurrentLesson.ResourceUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                Access Download
                            </a>
                        </div>
                    }

                    <!-- Student Interactive Scratchpad (Persisted in LocalStorage) -->
                    <div class="scratchpad-container">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold small text-dark mb-0">
                                <i class="bi bi-pen me-1 text-primary"></i> Personal Lesson Scratchpad
                            </label>
                            <span class="small text-muted" id="scratchpadStatus">
                                <i class="bi bi-check2 text-success"></i> Autosaved locally
                            </span>
                        </div>
                        <textarea id="lessonScratchpad" class="scratchpad-textarea" placeholder="Type your personal insights, code snippets, or study notes here. They will automatically persist in your browser for this lesson..."></textarea>
                    </div>
                </div>

                <!-- Navigation Controls Footer with Keyboard Shortcut Hints -->
                <div class="pt-3 border-top mt-auto d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        @if (Model.PreviousLessonId.HasValue)
                        {
                            <a href="@Url.Action("Index", "Learning", new { courseId = Model.Course.CourseId, lessonId = Model.PreviousLessonId.Value })" id="btnPrevLesson" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> Previous <kbd class="lms-kbd ms-1 d-none d-md-inline">Alt+P</kbd>
                            </a>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (Model.NextLessonId.HasValue)
                        {
                            <a href="@Url.Action("Index", "Learning", new { courseId = Model.Course.CourseId, lessonId = Model.NextLessonId.Value })" id="btnNextLesson" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                Next Lesson <i class="bi bi-arrow-right ms-1"></i> <kbd class="lms-kbd ms-1 d-none d-md-inline" style="background: rgba(255,255,255,0.2); color: white; border-color: rgba(255,255,255,0.3);">Alt+N</kbd>
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Certificates", "Student")" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-award-fill me-1"></i> Finish Course & View Certificate
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMS.initClassroom({
                lessonId: @currentLessonId,
                courseId: @Model.Course.CourseId
            });

            $(document).on('submit', '#markCompleteForm', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find('#btnMarkComplete');
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> Saving...');

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res && res.success) {
                            $('#completionStatusContainer').html(
                                '<span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill"><i class="bi bi-check2-circle me-1"></i> Lesson Completed</span>'
                            );
                            $('#progressText').text(res.progress + '% Completed');
                            $('#progressBar').css('width', res.progress + '%');

                            // Update active item icon in sidebar
                            $('.list-group-item.active-lesson').find('i.bi')
                                .removeClass('bi-play-circle-fill bi-circle text-primary text-muted')
                                .addClass('bi-check-circle-fill text-success');

                            LMS.toast('Lesson marked as complete! Progress: ' + res.progress + '%', 'success');

                            if (res.isCompleted) {
                                LMS.confetti({ particleCount: 100 });
                                LMS.toast('Congratulations! You have completed 100% of this course! Your official certificate is ready.', 'success', 6000);
                                setTimeout(function () {
                                    window.location.reload();
                                }, 2500);
                            }
                        } else {
                            $form.off('submit').submit();
                        }
                    },
                    error: function () {
                        $form.off('submit').submit();
                    }
                });
            });
        });
    </script>
}
