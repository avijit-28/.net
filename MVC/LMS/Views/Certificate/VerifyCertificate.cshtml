@{
    ViewBag.Title = "Verify Certificate of Completion";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 p-md-5 shadow-sm text-center bg-white card-gradient-top">
            <div class="mb-3">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-6 fw-bold shadow-xs">
                    <i class="bi bi-patch-check-fill text-primary me-1"></i> Credential Verification Portal
                </span>
            </div>
            <h2 class="fw-extrabold mb-2 tracking-tight">Verify Official Credential</h2>
            <p class="text-secondary small mb-4">
                Enter the unique cryptographic certificate number found on any official LMS certificate to verify its academic validity and accreditation.
            </p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show text-start mb-4 border-0 border-start border-4 border-danger shadow-xs" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2 text-danger"></i>@ViewBag.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @using (Html.BeginForm("Verify", "Certificate", FormMethod.Get, new { @class = "text-start" }))
            {
                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Certificate ID Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-upc-scan text-muted"></i></span>
                        <input type="text" name="certNumber" class="form-control border-start-0 font-monospace" placeholder="e.g. LMS-2026-123456" required />
                    </div>
                    <small class="text-muted">Standard format: LMS-YEAR-XXXXXX (case sensitive)</small>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary rounded-pill py-3 fw-bold shadow-sm">
                        <i class="bi bi-search me-1"></i> Verify Credential Authenticity
                    </button>
                </div>
            }

            <div class="mt-4 pt-3 border-top">
                <a href="@Url.Action("Index", "Home")" class="text-decoration-none small text-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Return to EduPlatform Homepage
                </a>
            </div>
        </div>
    </div>
</div>
