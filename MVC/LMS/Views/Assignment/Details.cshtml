@model LMS.ViewModels.AssignmentSubmissionViewModel
@{
    ViewBag.Title = Model.Assignment.Title;
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Student")">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Assignments", "Student")">Assignments</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Assignment.Title</li>
            </ol>
        </nav>

        <!-- Assignment Header Card -->
        <div class="card card-custom p-4 shadow-sm mb-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                        Assignment Workspace
                    </span>
                    <h3 class="fw-bold mb-1">@Model.Assignment.Title</h3>
                    <p class="text-muted small mb-0">Max Marks: @Model.Assignment.MaxMarks</p>
                </div>
                <div class="text-end">
                    @if (Model.Assignment.DueDate.HasValue)
                    {
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            <i class="bi bi-calendar-event me-1 text-danger"></i> Due: @Model.Assignment.DueDate.Value.ToString("MMM dd, yyyy")
                        </span>
                    }
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 border mb-3">
                <h6 class="fw-bold text-dark mb-2">Instructions & Problem Description:</h6>
                <p class="text-secondary small mb-0">
                    @(string.IsNullOrEmpty(Model.Assignment.Description) ? "Please implement the specified practical project task and submit your documented solution." : Model.Assignment.Description)
                </p>
            </div>

            <!-- Existing Submission Status -->
            @if (Model.ExistingSubmission != null)
            {
                <div class="p-4 border rounded-3 mb-3 @(Model.ExistingSubmission.Status == "Graded" ? "bg-success-subtle border-success-subtle" : "bg-warning-subtle border-warning-subtle")">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge @(Model.ExistingSubmission.Status == "Graded" ? "bg-success" : "bg-warning text-dark") px-3 py-1 rounded-pill">
                            Status: @Model.ExistingSubmission.Status
                        </span>
                        <small class="text-muted">Submitted on @Model.ExistingSubmission.SubmittedDate.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>

                    @if (Model.ExistingSubmission.Status == "Graded")
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <h4 class="fw-bold text-success mb-0">Score: @Model.ExistingSubmission.Marks / @Model.Assignment.MaxMarks</h4>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.ExistingSubmission.Feedback))
                        {
                            <div class="small text-dark mt-2">
                                <strong>Instructor Feedback:</strong> @Model.ExistingSubmission.Feedback
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <!-- Submission Form -->
        <div class="card card-custom p-4 shadow-sm">
            <h5 class="fw-bold mb-3"><i class="bi bi-upload me-2 text-primary"></i> Your Work Submission</h5>

            @using (Html.BeginForm("Submit", "Assignment", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="AssignmentId" value="@Model.Assignment.AssignmentId" />
                <input type="hidden" name="Assignment.AssignmentId" value="@Model.Assignment.AssignmentId" />

                <div class="mb-3">
                    @Html.LabelFor(m => m.SubmissionText, new { @class = "form-label fw-semibold small" })
                    @Html.TextAreaFor(m => m.SubmissionText, new { @class = "form-control", rows = 6, placeholder = "Type or paste your solution, explanation, and repository notes here..." })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.FileUrl, new { @class = "form-label fw-semibold small" })
                    @Html.TextBoxFor(m => m.FileUrl, new { @class = "form-control", placeholder = "https://github.com/username/project or drive document link" })
                    <small class="text-muted">Provide a valid GitHub repository, Google Drive, or hosted file URL.</small>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("Assignments", "Student")" class="btn btn-outline-secondary rounded-pill">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> @(Model.ExistingSubmission == null ? "Submit Solution" : "Resubmit Solution")
                    </button>
                </div>
            }
        </div>
    </div>
</div>
