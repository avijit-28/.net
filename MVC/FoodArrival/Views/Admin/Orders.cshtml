@model IEnumerable<FoodArrival.Models.Order>
@{
    ViewBag.Title = "Order Management - FoodReady Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string activeTab = ViewBag.ActiveTab as string ?? "pending";
    int pendingCount = ViewBag.PendingCount != null ? (int)ViewBag.PendingCount : 0;
    int acceptedCount = ViewBag.AcceptedCount != null ? (int)ViewBag.AcceptedCount : 0;
    int rejectedCount = ViewBag.RejectedCount != null ? (int)ViewBag.RejectedCount : 0;
}

<div class="container-fluid py-4 px-lg-5">
    <div class="row g-4">
        <!-- Admin Left Sidebar -->
        <div class="col-lg-2 col-md-3">
            <div class="admin-sidebar sticky-top" style="top: 85px;">
                <div class="d-flex align-items-center gap-2 mb-4 px-2">
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1"><i class="bi bi-shield-lock-fill me-1"></i> Admin Panel</span>
                </div>
                <div class="nav flex-column gap-1">
                    <a href="@Url.Action("Dashboard", "Admin")" class="admin-nav-item">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("Approvals", "Admin")" class="admin-nav-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Approvals</span>
                    </a>
                    <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })" class="admin-nav-item active">
                        <i class="bi bi-card-checklist"></i>
                        <span>Orders</span>
                    </a>
                    <a href="@Url.Action("FoodItems", "Admin")" class="admin-nav-item">
                        <i class="bi bi-egg-fried"></i>
                        <span>Food Menu</span>
                    </a>
                    <a href="@Url.Action("Riders", "Admin")" class="admin-nav-item">
                        <i class="bi bi-bicycle"></i>
                        <span>Rider Fleet</span>
                    </a>
                    <a href="@Url.Action("Transactions", "Admin")" class="admin-nav-item">
                        <i class="bi bi-cash-stack"></i>
                        <span>Transactions</span>
                    </a>
                    <a href="@Url.Action("Bulletins", "Admin")" class="admin-nav-item">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>Bulletins</span>
                    </a>
                    <hr class="border-secondary my-3" />
                    <a href="@Url.Action("Logout", "Admin")" class="admin-nav-item text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Orders Management Center -->
        <div class="col-lg-10 col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-0">Order Management</h2>
                    <p class="text-muted small mb-0">Review incoming orders and process acceptances or rejections in real time</p>
                </div>
                <div class="d-flex gap-2">
                    @using (Html.BeginForm("TriggerAutoReject", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-stopwatch-fill me-1"></i> Scan Auto-Reject (>5m)
                        </button>
                    }
                    <a href="@Url.Action("Orders", "Admin", new { tab = activeTab })" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </a>
                </div>
            </div>

            @if (ViewBag.AutoRejectedNotice != null)
            {
                <div class="alert alert-info alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i> @ViewBag.AutoRejectedNotice
                    <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Filter Tabs (Faithfully matching Template Panel 9) -->
            <div class="d-flex gap-2 mb-4">
                <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })" class="btn @(activeTab == "pending" ? "btn-warning text-dark fw-bold shadow-sm" : "btn-light border") px-4 py-2 rounded-pill">
                    Pending (@pendingCount)
                </a>
                <a href="@Url.Action("Orders", "Admin", new { tab = "accepted" })" class="btn @(activeTab == "accepted" ? "btn-success text-white fw-bold shadow-sm" : "btn-light border") px-4 py-2 rounded-pill">
                    Accepted (@acceptedCount)
                </a>
                <a href="@Url.Action("Orders", "Admin", new { tab = "rejected" })" class="btn @(activeTab == "rejected" ? "btn-danger text-white fw-bold shadow-sm" : "btn-light border") px-4 py-2 rounded-pill">
                    Rejected (@rejectedCount)
                </a>
            </div>

            <!-- Orders Table (Faithfully matching Template Panel 9) -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 custom-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Order Time</th>
                                @if (activeTab == "pending")
                                {
                                    <th class="text-center" style="width: 220px;">Action</th>
                                }
                                else if (activeTab == "rejected")
                                {
                                    <th>Rejection Reason</th>
                                }
                                else
                                {
                                    <th>Status</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var order in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">
                                            FD@(1000 + order.OrderId)
                                            <div class="small text-muted fw-normal">@(string.IsNullOrEmpty(order.Items) ? "" : order.Items)</div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@order.CustomerName</div>
                                            <div class="small text-muted">@order.PhoneNumber</div>
                                        </td>
                                        <td class="fw-bold text-dark">&#8377;@order.TotalAmount.ToString("F0")</td>
                                        <td class="text-muted">@order.OrderedAt.ToString("hh:mm tt")</td>

                                        @if (activeTab == "pending")
                                        {
                                            <td class="text-center">
                                                <div class="d-flex justify-content-center gap-2">
                                                    @using (Html.BeginForm("AcceptOrder", "Admin", new { orderId = order.OrderId }, FormMethod.Post, new { @class = "d-inline" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm px-3 fw-bold rounded-2">
                                                            Accept
                                                        </button>
                                                    }

                                                    <button type="button" class="btn btn-danger btn-sm px-3 fw-bold rounded-2" data-bs-toggle="modal" data-bs-target="#rejectModal-@order.OrderId">
                                                        Reject
                                                    </button>
                                                </div>

                                                <!-- Reject Reason Modal -->
                                                <div class="modal fade" id="rejectModal-@order.OrderId" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                                        <div class="modal-content rounded-4 border-0 shadow">
                                                            <div class="modal-header border-bottom">
                                                                <h6 class="modal-title fw-bold text-danger">Reject Order #FD@(1000 + order.OrderId)</h6>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            @using (Html.BeginForm("RejectOrder", "Admin", FormMethod.Post))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                                                <div class="modal-body text-start">
                                                                    <label class="form-label small text-muted">Reason for rejection:</label>
                                                                    <select name="reason" class="form-select form-select-sm mb-2">
                                                                        <option value="Restaurant Out of Stock">Restaurant Out of Stock</option>
                                                                        <option value="Delivery Partner Unavailable">Delivery Partner Unavailable</option>
                                                                        <option value="Kitchen Peak Overload">Kitchen Peak Overload</option>
                                                                        <option value="Address Outside Service Zone">Address Outside Service Zone</option>
                                                                    </select>
                                                                </div>
                                                                <div class="modal-footer border-top p-2">
                                                                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-danger btn-sm fw-bold">Confirm Reject</button>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        }
                                        else if (activeTab == "rejected")
                                        {
                                            <td>
                                                <span class="text-danger small fw-semibold">
                                                    @(string.IsNullOrEmpty(order.RejectionReason) ? "Auto-rejected (> 5 mins)" : order.RejectionReason)
                                                </span>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <span class="status-badge status-accepted">Accepted</span>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox display-6 text-muted d-block mb-2"></i>
                                        No @activeTab orders in the queue.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
