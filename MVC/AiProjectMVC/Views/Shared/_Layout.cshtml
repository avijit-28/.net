@{
    var loggedInUser = Session["CurrentUser"] as AiProjectMVC.Models.EmployeeUser;
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - AiProject MVC</title>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- Modern Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Dashboard", "Employee")">
                <span class="brand-icon">
                    <i class="bi bi-cpu-fill"></i>
                </span>
                <span>AiProject <span class="badge bg-primary fs-6 fw-normal px-2 py-1 ms-1">MVC</span></span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link @(currentCtrl == "Employee" && currentAct == "Dashboard" ? "active text-white" : "")" 
                           href="@Url.Action("Dashboard", "Employee")">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentCtrl == "Employee" && currentAct == "Index" ? "active text-white" : "")" 
                           href="@Url.Action("Index", "Employee")">
                            <i class="bi bi-people-fill me-1"></i> Employees
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentCtrl == "Address" ? "active text-white" : "")" 
                           href="@Url.Action("Index", "Address")">
                            <i class="bi bi-geo-alt-fill me-1"></i> Addresses
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("About", "Home")">
                            <i class="bi bi-info-circle me-1"></i> About
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (loggedInUser != null)
                    {
                        <div class="d-flex align-items-center gap-2 me-2">
                            <div class="text-end d-none d-md-block">
                                <div class="text-white small fw-bold">@loggedInUser.Name</div>
                                <span class="badge bg-primary bg-opacity-25 text-white smaller py-0 px-1">@loggedInUser.Role</span>
                            </div>
                            <div style="width: 34px; height: 34px; border-radius: 8px; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700;">
                                @(loggedInUser.Name.Length > 0 ? loggedInUser.Name.Substring(0, 1) : "U")
                            </div>
                        </div>

                        <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-sm" title="Sign Out">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-primary-gradient btn-sm">
                            <i class="bi bi-person-plus me-1"></i> Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Container Content -->
    <main class="container body-content">
        <!-- Toast / Alert Notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="custom-alert custom-alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="custom-alert custom-alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="custom-alert custom-alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-database-fill-x fs-5 text-danger"></i>
                <div class="flex-grow-1">@ViewBag.ErrorMessage</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Modern Footer -->
    <footer>
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div class="col-md-6 d-flex align-items-center">
                <span class="text-muted">&copy; @DateTime.Now.Year AiProjectMVC — Redesigned Employee Management System</span>
            </div>
            <ul class="nav col-md-6 justify-content-end list-unstyled d-flex gap-3">
                <li class="text-muted"><i class="bi bi-shield-check text-success me-1"></i> SQL Server Connected</li>
                <li class="text-muted"><i class="bi bi-bootstrap text-primary me-1"></i> Bootstrap 5.2</li>
            </ul>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
