@model IEnumerable<LMS.Models.Announcement>
@{
    ViewBag.Title = "System Announcements";
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Announcements</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Platform Broadcasts
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">System Announcements & Notices</h2>
            <p class="text-muted small mb-0">Publish platform maintenance notices, feature drops, and alerts to learners and instructors</p>
        </div>
        <div>
            <a href="@Url.Action("CreateAnnouncement", "Admin")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> New Announcement
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white border-0">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-broadcast text-muted display-4"></i>
            </div>
            <h4 class="fw-bold">No announcements broadcasted</h4>
            <p class="text-muted small mb-3">Post your first system-wide announcement to inform all learners and faculty members.</p>
            <div>
                <a href="@Url.Action("CreateAnnouncement", "Admin")" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-circle me-1"></i> Create First Announcement
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6">
                    <div class="card card-custom p-4 shadow-sm h-100 bg-white border-0 card-hover d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@item.Title</h5>
                            <div>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        <span class="pulse-dot pulse-success"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                                        Archived
                                    </span>
                                }
                            </div>
                        </div>
                        <small class="text-muted d-block mb-3">
                            <i class="bi bi-clock me-1"></i> Posted @item.CreatedDate.ToString("MMM dd, yyyy HH:mm")
                        </small>
                        <p class="text-secondary small flex-grow-1" style="white-space: pre-wrap; line-height: 1.6;">@item.Message</p>
                        <div class="pt-3 border-top mt-auto d-flex justify-content-end">
                            @using (Html.BeginForm("DeleteAnnouncement", "Admin", new { id = item.AnnouncementId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Delete this announcement?');">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
