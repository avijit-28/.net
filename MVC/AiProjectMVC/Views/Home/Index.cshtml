@{
    ViewBag.Title = "Security & Access Control Hub";
    var currentUser = Session["CurrentUser"] as AiProjectMVC.Models.EmployeeUser;
    var currentRole = Session["UserRole"] as string ?? (User.Identity.IsAuthenticated ? "USER" : "Guest");
    bool isAuthenticated = User.Identity.IsAuthenticated || currentUser != null;
    string displayName = currentUser?.Name ?? (User.Identity.IsAuthenticated ? User.Identity.Name : "Anonymous Visitor");

    bool isSuperAdmin = currentRole.IndexOf("SUPERADMIN", StringComparison.OrdinalIgnoreCase) >= 0;
    bool isAdmin = isSuperAdmin || currentRole.IndexOf("ADMIN", StringComparison.OrdinalIgnoreCase) >= 0;
    bool isManager = isSuperAdmin || isAdmin || currentRole.IndexOf("MANAGER", StringComparison.OrdinalIgnoreCase) >= 0;
    bool isHR = isSuperAdmin || isAdmin || currentRole.IndexOf("HR", StringComparison.OrdinalIgnoreCase) >= 0;
    bool isEmployee = isSuperAdmin || isAdmin || isManager || isHR || currentRole.IndexOf("EMPLOYEE", StringComparison.OrdinalIgnoreCase) >= 0 || currentRole.IndexOf("USER", StringComparison.OrdinalIgnoreCase) >= 0;

    var recentLogs = ViewBag.RecentLogs as List<string> ?? new List<string>();
}

<div class="py-4">
    <!-- Hero Status Banner -->
    <div class="custom-card shadow-sm border-0 mb-4 overflow-hidden">
        <div class="p-4 p-md-5 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #3730a3 100%);">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="d-inline-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary bg-opacity-75 px-3 py-1 fs-6">
                            <i class="bi bi-shield-lock-fill me-1"></i> Security &amp; Authorization Center
                        </span>
                        @if (isAuthenticated)
                        {
                            <span class="badge bg-success bg-opacity-75 px-3 py-1 fs-6">
                                <i class="bi bi-check-circle-fill me-1"></i> Signed In
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-1 fs-6">
                                <i class="bi bi-person-x me-1"></i> Guest Mode
                            </span>
                        }
                    </div>
                    <h2 class="fw-bold mb-1">Hello, @displayName!</h2>
                    <p class="text-white-50 mb-0">
                        Active Role: 
                        <strong class="text-white">@currentRole</strong> &bull; Test your role permissions and audit filters below with 1 click.
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light btn-sm px-3">
                        <i class="bi bi-arrow-repeat me-1"></i> Switch User / Role
                    </a>
                    <a href="@Url.Action("Dashboard", "Employee")" class="btn btn-primary-gradient btn-sm px-3">
                        <i class="bi bi-speedometer2 me-1"></i> Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 3 Core Security Steps -->
    <div class="row g-4 mb-4">
        <!-- Step 1: Public vs Protected -->
        <div class="col-lg-6">
            <div class="custom-card shadow-sm border-0 h-100">
                <div class="p-4 border-bottom bg-light d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">
                            <i class="bi bi-globe2 text-success me-2"></i> 1. Public vs. Protected Access
                        </h5>
                        <p class="text-muted small mb-0">Built-in ASP.NET MVC <code>[AllowAnonymous]</code> vs <code>[Authorize]</code></p>
                    </div>
                    <span class="badge bg-primary">Filter Basics</span>
                </div>
                <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                    <div>
                        <!-- Public Endpoint -->
                        <div class="p-3 rounded-3 border mb-3 bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark"><i class="bi bi-unlock-fill text-success me-1"></i> Non-Secure Method</span>
                                <span class="badge bg-success-subtle text-success border border-success border-opacity-25">Public</span>
                            </div>
                            <p class="text-muted small mb-2">
                                Decorated with <code>[AllowAnonymous]</code>. Accessible by anyone, even visitors who are not signed in.
                            </p>
                            <a href="@Url.Action("NonSecureMethod", "Home")" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Test Public Page
                            </a>
                        </div>

                        <!-- Protected Endpoint -->
                        <div class="p-3 rounded-3 border bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark"><i class="bi bi-shield-lock-fill text-primary me-1"></i> Secure Method</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-25">Requires Login</span>
                            </div>
                            <p class="text-muted small mb-2">
                                Decorated with <code>[Authorize]</code>. If an unauthenticated user visits, they are automatically sent to the Login screen.
                            </p>
                            <a href="@Url.Action("SecureMethod", "Home")" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Test Protected Page
                            </a>
                        </div>
                    </div>

                    <div class="mt-3 pt-2 text-muted small border-top">
                        <i class="bi bi-info-circle me-1"></i> Both methods log every visit into the real-time audit log shown on the right.
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2: Role-Based Authorization -->
        <div class="col-lg-6">
            <div class="custom-card shadow-sm border-0 h-100">
                <div class="p-4 border-bottom bg-light d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">
                            <i class="bi bi-person-badge-fill text-primary me-2"></i> 2. Role-Based Permissions
                        </h5>
                        <p class="text-muted small mb-0">Custom <code>[AuthorizeRole]</code> attribute with <code>Role</code> enum</p>
                    </div>
                    <span class="badge bg-info text-dark">Role Checks</span>
                </div>
                <div class="p-4">
                    <p class="text-muted small mb-3">
                        Clicking an action will either allow access or redirect to <strong>Access Denied</strong> based on your current role:
                    </p>

                    <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                        <!-- Employee Workspace -->
                        <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                            <div>
                                <div class="fw-bold text-dark mb-1">
                                    <i class="bi bi-person-check text-info me-1"></i> Employee Workspace
                                </div>
                                <div class="small text-muted">
                                    <code>[AuthorizeRole(Role.USER, Role.EMPLOYEE)]</code>
                                </div>
                            </div>
                            <a href="@Url.Action("UserPage", "Home")" class="btn btn-sm @(isEmployee ? "btn-info text-dark" : "btn-outline-secondary")">
                                Test User Page
                            </a>
                        </div>

                        <!-- Admin Channel -->
                        <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                            <div>
                                <div class="fw-bold text-dark mb-1">
                                    <i class="bi bi-envelope-shield text-warning me-1"></i> Admin Operations
                                </div>
                                <div class="small text-muted">
                                    <code>[AuthorizeRole(Role.ADMIN)]</code>
                                </div>
                            </div>
                            <a href="@Url.Action("Contact", "Home")" class="btn btn-sm @(isAdmin ? "btn-warning text-dark" : "btn-outline-danger")">
                                @(isAdmin ? "Test Admin Page" : "Test (Triggers Denied)")
                            </a>
                        </div>

                        <!-- SuperAdmin Master -->
                        <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                            <div>
                                <div class="fw-bold text-dark mb-1">
                                    <i class="bi bi-award text-danger me-1"></i> SuperAdmin Control
                                </div>
                                <div class="small text-muted">
                                    <code>[AuthorizeRole(Role.SUPERADMIN)]</code>
                                </div>
                            </div>
                            <a href="@Url.Action("About", "Home")" class="btn btn-sm @(isSuperAdmin ? "btn-danger" : "btn-outline-danger")">
                                @(isSuperAdmin ? "Test SuperAdmin" : "Test (Triggers Denied)")
                            </a>
                        </div>

                        <!-- Access Denied Direct Preview -->
                        <div class="list-group-item d-flex align-items-center justify-content-between p-3 bg-light">
                            <div>
                                <div class="fw-bold text-danger mb-1">
                                    <i class="bi bi-shield-x text-danger me-1"></i> Access Denied View
                                </div>
                                <div class="small text-muted">Direct preview of unauthorized rejection screen</div>
                            </div>
                            <a href="@Url.Action("AccessDenied", "Account")" class="btn btn-outline-danger btn-sm">
                                Preview Screen
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 3: Real-Time Audit Log Viewer -->
    <div class="custom-card shadow-sm border-0 mb-4 overflow-hidden">
        <div class="p-4 bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="fw-bold mb-1 text-dark">
                    <i class="bi bi-terminal-fill text-dark me-2"></i> 3. Real-Time Audit Trail
                </h5>
                <p class="text-muted small mb-0">
                    Driven by <code>[EmployeeAuditFilter]</code> writing live execution entries to <code>Log/Log.txt</code>
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success">
                    <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> Active Filter
                </span>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh Logs
                </a>
            </div>
        </div>
        <div class="p-4 bg-dark text-light font-monospace small" style="min-height: 180px;">
            <div class="text-success mb-2 fw-bold">
                // Recent audit filter entries from Server ~/Log/Log.txt:
            </div>
            @if (recentLogs.Count > 0)
            {
                foreach (var logLine in recentLogs)
                {
                    <div class="text-white-50 py-1 border-bottom border-secondary border-opacity-25">
                        <i class="bi bi-caret-right-fill text-info me-1"></i>@logLine
                    </div>
                }
            }
            else
            {
                <div class="text-white-50 fst-italic">
                    Audit log file initialized. Click any test button above to see new entries appended here in real time.
                </div>
            }
        </div>
    </div>

    <!-- Code Reference Accordion (Collapsible, easy to inspect) -->
    <div class="accordion custom-card shadow-sm border-0" id="devRefAccordion">
        <div class="accordion-item border-0">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button collapsed fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                    <i class="bi bi-code-slash text-primary me-2"></i> Developer Reference: How Filters Work in C#
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#devRefAccordion">
                <div class="accordion-body p-4 bg-light">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6 class="fw-bold small text-dark text-uppercase mb-2">1. Custom AuthorizeRole Attribute</h6>
                            <pre class="bg-dark text-white p-3 rounded-3 small mb-0"><code>[AttributeUsage(AttributeTargets.Method | AttributeTargets.Class)]
public class AuthorizeRoleAttribute : AuthorizeAttribute
{
    public AuthorizeRoleAttribute(params object[] roles)
    {
        this.Roles = string.Join(",", roles.Select(r => Enum.GetName(r.GetType(), r)));
    }

    protected override bool AuthorizeCore(HttpContextBase httpContext)
    {
        // Checks FormsAuthentication roles and Session["UserRole"]
        return base.AuthorizeCore(httpContext);
    }
}</code></pre>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold small text-dark text-uppercase mb-2">2. Decorating Controller Actions</h6>
                            <pre class="bg-dark text-white p-3 rounded-3 small mb-0"><code>[Authorize]
public class HomeController : Controller
{
    [AllowAnonymous]
    public ActionResult NonSecureMethod() => View();

    public ActionResult SecureMethod() => View();

    [AuthorizeRole(Role.ADMIN)]
    public ActionResult Contact() => View();
}</code></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
