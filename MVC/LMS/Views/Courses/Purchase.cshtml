@model LMS.Models.Course
@{
    ViewBag.Title = "Secure Checkout - " + Model.Title;
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Courses")">Courses</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Details", "Courses", new { id = Model.CourseId })">@Model.Title</a></li>
                <li class="breadcrumb-item active" aria-current="page">Checkout</li>
            </ol>
        </nav>

        <div class="row g-4">
            <!-- Course Summary -->
            <div class="col-md-5 order-md-2">
                <div class="card card-custom p-4 shadow-sm bg-white">
                    <h5 class="fw-bold mb-3"><i class="bi bi-cart3 me-2 text-primary"></i> Order Summary</h5>
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <h6 class="fw-bold mb-1">@Model.Title</h6>
                        <span class="badge bg-primary-subtle text-primary small">@(Model.Category?.CategoryName ?? "General")</span>
                        <div class="small text-muted mt-2"><i class="bi bi-clock me-1"></i> @Model.DurationInHours Hours Content</div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Original Price</span>
                        <span>$@Model.Price.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>Platform Discount</span>
                        <span class="text-success">$0.00</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between fs-5 fw-bold text-dark mb-4">
                        <span>Total Due</span>
                        <span class="text-primary">$@Model.Price.ToString("N2")</span>
                    </div>

                    <div class="small text-muted d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-4"></i>
                        <span>Secure simulated payment with instant automatic enrollment.</span>
                    </div>
                </div>
            </div>

            <!-- Payment Form -->
            <div class="col-md-7 order-md-1">
                <div class="card card-custom p-4 p-md-5 shadow-sm">
                    <h4 class="fw-bold mb-2">Payment Details</h4>
                    <p class="text-muted small mb-4">Select your preferred payment method to finalize registration.</p>

                    @using (Html.BeginForm("Purchase", "Courses", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@Model.CourseId" />

                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Choose Payment Method:</label>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check p-3 border rounded-3 bg-light">
                                    <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="pmCard" value="Credit Card (Mock / Test)" checked>
                                    <label class="form-check-label fw-semibold" for="pmCard">
                                        <i class="bi bi-credit-card-2-front text-primary me-2"></i> Credit / Debit Card (Test)
                                    </label>
                                </div>
                                <div class="form-check p-3 border rounded-3 bg-light">
                                    <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="pmStripe" value="Stripe Gateway (Mock)">
                                    <label class="form-check-label fw-semibold" for="pmStripe">
                                        <i class="bi bi-stripe text-info me-2"></i> Stripe Integration (Test)
                                    </label>
                                </div>
                                <div class="form-check p-3 border rounded-3 bg-light">
                                    <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="pmPaypal" value="PayPal (Mock)">
                                    <label class="form-check-label fw-semibold" for="pmPaypal">
                                        <i class="bi bi-paypal text-primary me-2"></i> PayPal (Test)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning small border-warning">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            <strong>Development Sandbox:</strong> This checkout runs in secure mock mode. No real bank or credit card data is ever collected or required. Clicking complete will generate a real database transaction and enroll your student account.
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-lock-fill me-1"></i> Complete Payment & Start Learning
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
