@model IEnumerable<LMS.Models.Question>
@{
    var quiz = ViewBag.Quiz as LMS.Models.Quiz;
    ViewBag.Title = "Questions - " + (quiz?.Title ?? "Quiz");
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")">Course Studio</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Quizzes", "Instructor", new { courseId = quiz?.CourseId })">Quizzes</a></li>
                    <li class="breadcrumb-item active">Questions</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0">Question Bank: @(quiz?.Title ?? "Quiz")</h3>
            <p class="text-muted small">Total Marks: @quiz.TotalMarks • Passing Standard: @quiz.PassingPercentage%</p>
        </div>
        <div>
            <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addQuestionModal">
                <i class="bi bi-plus-circle me-1"></i> Add Question
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm">
            <i class="bi bi-patch-question fs-1 text-muted mb-3"></i>
            <h5 class="fw-bold">No questions added yet.</h5>
            <p class="text-muted small mb-3">Add multiple-choice assessment questions and designate the correct answer key.</p>
            <div>
                <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addQuestionModal">
                    Add First Question
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @for (int i = 0; i < Model.Count(); i++)
            {
                var q = Model.ElementAt(i);
                <div class="col-12">
                    <div class="card card-custom p-4 shadow-sm">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-primary rounded-pill px-3 py-2 small fw-bold">
                                Question @(i + 1)
                            </span>
                            <span class="badge bg-light text-dark border">@q.Marks Marks</span>
                        </div>

                        <h5 class="fw-bold text-dark mb-3">@q.QuestionText</h5>

                        <div class="row g-2">
                            @foreach (var opt in q.Options.OrderBy(o => o.OptionOrder))
                            {
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 border @(opt.IsCorrect ? "bg-success-subtle border-success text-success fw-bold" : "bg-light text-dark")">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span>@opt.OptionText</span>
                                            @if (opt.IsCorrect)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add Question Modal -->
<div class="modal fade" id="addQuestionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add Question with 4 Multiple-Choice Options</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("CreateQuestion", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="quizId" value="@(quiz?.QuizId ?? 0)" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Question Text</label>
                        <textarea name="questionText" class="form-control" rows="2" placeholder="e.g. Which algorithm is best suited for binary classification problems?" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Question Marks</label>
                        <input type="number" name="marks" class="form-control" value="1" min="1" required />
                    </div>

                    <label class="form-label fw-semibold">Answer Choices & Key:</label>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Option A</label>
                            <input type="text" name="opt1" class="form-control" placeholder="Choice 1" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Option B</label>
                            <input type="text" name="opt2" class="form-control" placeholder="Choice 2" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Option C</label>
                            <input type="text" name="opt3" class="form-control" placeholder="Choice 3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Option D</label>
                            <input type="text" name="opt4" class="form-control" placeholder="Choice 4" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-success">Select Correct Answer Key:</label>
                        <select name="correctOption" class="form-select border-success">
                            <option value="1">Option A is Correct</option>
                            <option value="2">Option B is Correct</option>
                            <option value="3">Option C is Correct</option>
                            <option value="4">Option D is Correct</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Save Question</button>
                </div>
            }
        </div>
    </div>
</div>
