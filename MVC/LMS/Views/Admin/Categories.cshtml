@model IEnumerable<LMS.ViewModels.CategoryViewModel>
@{
    ViewBag.Title = "Category Management";
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Categories</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Catalog Taxonomy
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Curriculum Categories & Subjects</h2>
            <p class="text-muted small mb-0">Organize and classify course catalog domains, technical specializations, and pathways</p>
        </div>
        <div>
            <a href="@Url.Action("CreateCategory", "Admin")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Category
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-danger mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card card-custom shadow-sm overflow-hidden bg-white border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Category Domain</th>
                        <th>Description</th>
                        <th>Active Courses</th>
                        <th>Publish Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-light text-primary p-2 me-3 d-flex align-items-center justify-content-center shadow-xs" style="width: 38px; height: 38px;">
                                        <i class="bi bi-tag-fill fs-6"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@cat.CategoryName</div>
                                        <small class="text-muted" style="font-size: 11px;">ID: #@cat.CategoryId</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="text-secondary small text-truncate" style="max-width: 380px;">
                                    @(string.IsNullOrEmpty(cat.Description) ? "No description provided." : cat.Description)
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-primary-subtle rounded-pill px-3 py-1 fw-semibold">
                                    <i class="bi bi-collection-play me-1"></i> @cat.CourseCount courses
                                </span>
                            </td>
                            <td>
                                @if (cat.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        <span class="pulse-dot pulse-success"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("EditCategory", "Admin", new { id = cat.CategoryId })" class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-1">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>

                                @using (Html.BeginForm("DeleteCategory", "Admin", new { id = cat.CategoryId }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" onclick="return confirm('Are you sure you want to delete this category?');" @(cat.CourseCount > 0 ? "disabled title='Cannot delete category with active courses'" : "")>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
