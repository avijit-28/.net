# ==============================================================================
# LMS Enterprise RAG AI Learning Assistant - Configuration Example
# ==============================================================================

# Primary LLM (Google Gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Secondary Failover LLM (Groq)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# Routing & Providers
DEFAULT_LLM_PROVIDER=gemini
FAILOVER_LLM_PROVIDER=groq

# Vector Store
QDRANT_STORAGE_PATH=./qdrant_data
QDRANT_COLLECTION=lms_course_knowledge
EMBEDDING_DIMENSION=768

# Semantic Caching
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95

# Hybrid Search & Re-ranking
HYBRID_SEARCH_TOP_K=8
RRF_K=60
DENSE_WEIGHT=0.65
SPARSE_WEIGHT=0.35

# Security & Guardrails
AISERVICE_INTERNAL_KEY=your_internal_service_secret_key
ENABLE_PROMPT_GUARDRAILS=true

# Server
HOST=127.0.0.1
PORT=8000
