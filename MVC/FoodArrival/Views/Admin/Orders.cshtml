@model IEnumerable<FoodArrival.Models.Order>
@{
    ViewBag.Title = "Order Management - FoodReady Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string activeTab = ViewBag.ActiveTab as string ?? "pending";
    int pendingCount = ViewBag.PendingCount != null ? (int)ViewBag.PendingCount : 0;
    int acceptedCount = ViewBag.AcceptedCount != null ? (int)ViewBag.AcceptedCount : 0;
    int rejectedCount = ViewBag.RejectedCount != null ? (int)ViewBag.RejectedCount : 0;
}

<div class="container-fluid py-4 px-lg-5">
    <div class="row g-4">
        <!-- Admin Left Sidebar -->
        <div class="col-lg-2 col-md-3">
            <div class="admin-sidebar sticky-top" style="top: 85px;">
                <div class="d-flex align-items-center gap-2 mb-4 px-2">
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1">Admin Panel</span>
                </div>
                <div class="nav flex-column">
                    <a href="@Url.Action("Dashboard", "Admin")" class="admin-nav-item">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("FoodItems", "Admin")" class="admin-nav-item">
                        <i class="bi bi-egg-fried"></i>
                        <span>Food Items</span>
                    </a>
                    <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })" class="admin-nav-item active">
                        <i class="bi bi-card-checklist"></i>
                        <span>Orders</span>
                    </a>
                    <a href="@Url.Action("Dashboard", "Admin")" class="admin-nav-item">
                        <i class="bi bi-people"></i>
                        <span>Customers</span>
                    </a>
                    <a href="@Url.Action("Dashboard", "Admin")" class="admin-nav-item">
                        <i class="bi bi-graph-up"></i>
                        <span>Reports</span>
                    </a>
                    <hr class="border-secondary my-3" />
                    <a href="@Url.Action("Logout", "Admin")" class="admin-nav-item text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Orders Management Center -->
        <div class="col-lg-10 col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-0">Order Management</h2>
                    <p class="text-muted small mb-0">Review incoming orders and process acceptances or rejections in real time</p>
                </div>
                <a href="@Url.Action("Orders", "Admin", new { tab = activeTab })" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </a>
            </div>

            @if (ViewBag.AutoRejectedNotice != null)
            {
                <div class="alert alert-info alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i> @ViewBag.AutoRejectedNotice
                    <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Filter Tabs -->
            <div class="d-flex gap-2 mb-4">
                <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })" class="btn @(activeTab == "pending" ? "btn-warning text-dark fw-bold shadow-sm" : "btn-light border") px-4 py-2 rounded-pill">
                    Pending <span class="badge bg-dark text-white rounded-pill ms-1">@pendingCount</span>
                </a>
                <a href="@Url.Action("Orders", "Admin", new { tab = "accepted" })" class="btn @(activeTab == "accepted" ? "btn-success text-white fw-bold shadow-sm" : "btn-light border") px-4 py-2 rounded-pill">
                    Accepted <span class="badge bg-white text-success rounded-pill ms-1">@acceptedCount</span>
                </a>
                <a href="@Url.Action("Orders", "Admin", new { tab = "rejected" })" class="btn @(activeTab == "rejected" ? "btn-danger text-white fw-bold shadow-sm" : "btn-light border") px-4 py-2 rounded-pill">
                    Rejected <span class="badge bg-white text-danger rounded-pill ms-1">@rejectedCount</span>
                </a>
            </div>

            <!-- Orders Table -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 custom-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Items</th>
                                <th>Amount</th>
                                <th>Order Time</th>
                                @if (activeTab == "pending")
                                {
                                    <th class="text-center" style="width: 220px;">Action</th>
                                }
                                else if (activeTab == "rejected")
                                {
                                    <th>Rejection Reason</th>
                                }
                                else
                                {
                                    <th>Processed Time</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var order in Model)
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("Details", "Order", new { id = order.OrderId })" class="fw-bold text-dark text-decoration-none">
                                                #FD@(1000 + order.OrderId)
                                            </a>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@order.CustomerName</div>
                                            <div class="text-muted small">@order.Email</div>
                                        </td>
                                        <td class="text-muted small">
                                            @(string.IsNullOrEmpty(order.Items) ? "-" : order.Items)
                                        </td>
                                        <td class="fw-bold fs-6 text-dark">
                                            &#8377;@order.TotalAmount.ToString("F0")
                                        </td>
                                        <td class="text-muted small">
                                            @order.OrderedAt.ToString("dd MMM, hh:mm tt")
                                        </td>

                                        @if (activeTab == "pending")
                                        {
                                            <td class="text-center">
                                                <div class="d-flex justify-content-center gap-2">
                                                    @using (Html.BeginForm("AcceptOrder", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                                        <button type="submit" class="btn btn-success btn-sm px-3 fw-bold rounded-pill">
                                                            <i class="bi bi-check-lg"></i> Accept
                                                        </button>
                                                    }

                                                    <button type="button" class="btn btn-danger btn-sm px-3 fw-bold rounded-pill" data-bs-toggle="modal" data-bs-target="#rejectModal-@order.OrderId">
                                                        <i class="bi bi-x-lg"></i> Reject
                                                    </button>
                                                </div>

                                                <!-- Reject Reason Modal -->
                                                <div class="modal fade" id="rejectModal-@order.OrderId" tabindex="-1">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content rounded-4 border-0 shadow">
                                                            @using (Html.BeginForm("RejectOrder", "Admin", FormMethod.Post))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                                                <div class="modal-header border-0 pb-0">
                                                                    <h5 class="modal-title fw-bold">Reject Order #FD@(1000 + order.OrderId)</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <div class="modal-body text-start">
                                                                    <p class="text-muted small">Please provide an optional reason for rejecting this order:</p>
                                                                    <textarea name="reason" class="form-control" rows="3" placeholder="e.g. Item out of stock, kitchen closed, address unreachable"></textarea>
                                                                </div>
                                                                <div class="modal-footer border-0 pt-0">
                                                                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Confirm Reject</button>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        }
                                        else if (activeTab == "rejected")
                                        {
                                            <td class="text-danger small">
                                                @(string.IsNullOrEmpty(order.RejectionReason) ? "Order rejected." : order.RejectionReason)
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="text-muted small">
                                                @(order.ProcessedAt.HasValue ? order.ProcessedAt.Value.ToString("dd MMM, hh:mm tt") : "-")
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox display-4 text-muted"></i>
                                        <p class="mt-2 mb-0">No @activeTab orders in the system.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
