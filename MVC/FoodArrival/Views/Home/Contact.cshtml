@model FoodArrival.Models.ContactViewModel
@{
    ViewBag.Title = "Contact Us - FoodReady";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string role = Session["UserRole"]?.ToString();
    bool isStaff = role == "RestaurantStaff";
    bool isRider = role == "Rider";
    bool isRestaurant = role == "Restaurant";
    bool isCustomer = role == "Customer" || string.IsNullOrEmpty(role);
}

<!-- Hero Section -->
<div class="py-5 text-white" style="background: linear-gradient(135deg, #1A202C 0%, #2D3748 100%);">
    <div class="container text-center py-4">
        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-3 shadow-sm">
            <i class="bi bi-headset me-1"></i> Direct Communication Desk
        </span>
        @if (isStaff)
        {
            <h1 class="display-5 fw-bold mb-3">Kitchen Staff Contact Portal</h1>
            <p class="lead text-white-50 mx-auto" style="max-width: 680px;">
                Direct communication channel between you and your employer restaurant management: <strong>@Model.SpecificRestaurantName</strong>.
            </p>
        }
        else if (isRider)
        {
            <h1 class="display-5 fw-bold mb-3">Delivery Partner Support Desk</h1>
            <p class="lead text-white-50 mx-auto" style="max-width: 680px;">
                Direct communication with your affiliated partner restaurants for order dispatch, pickups, and kitchen coordination.
            </p>
        }
        else
        {
            <h1 class="display-5 fw-bold mb-3">Get in Touch with FoodReady</h1>
            <p class="lead text-white-50 mx-auto" style="max-width: 680px;">
                Have questions about an active order, payments, food delivery, or account verification? Our central administrator desk is available 24/7.
            </p>
        }
    </div>
</div>

<div class="container py-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <strong>Message Sent:</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <strong>Error:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mb-5">
        <!-- Left: Direct Communication Channels -->
        <div class="col-lg-5">
            <h4 class="fw-bold mb-4 d-flex align-items-center gap-2">
                <i class="bi bi-broadcast text-danger"></i>
                <span>Direct Communication Channels</span>
            </h4>

            <!-- Customer Helpline -->
            <div class="d-flex align-items-start gap-3 p-3 bg-white rounded-4 shadow-sm border mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 48px; height: 48px; background: #FF5E1E;">
                    <i class="bi bi-telephone-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Customer Support Helpline</h6>
                    <p class="small text-muted mb-1">Direct to Central Administrator Operations Desk</p>
                    <a href="tel:18002004567" class="fw-bold text-primary text-decoration-none">+91 1800 200 4567 (Toll-Free)</a>
                    <div class="small text-muted mt-1"><i class="bi bi-envelope me-1"></i> support@foodready.in</div>
                </div>
            </div>

            <!-- Restaurant Partners & Staff Helpline -->
            <div class="d-flex align-items-start gap-3 p-3 bg-white rounded-4 shadow-sm border mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 48px; height: 48px; background: #0284C7;">
                    <i class="bi bi-shop fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Restaurant Partners & Kitchen Desk</h6>
                    <p class="small text-muted mb-1">Direct connection for merchant management & kitchen staff</p>
                    <a href="tel:18002008899" class="fw-bold text-primary text-decoration-none">+91 1800 200 8899 (Merchant Line)</a>
                    <div class="small text-muted mt-1"><i class="bi bi-envelope me-1"></i> partners@foodready.in</div>
                </div>
            </div>

            <!-- Delivery Fleet Operations -->
            <div class="d-flex align-items-start gap-3 p-3 bg-white rounded-4 shadow-sm border mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 48px; height: 48px; background: #16A34A;">
                    <i class="bi bi-scooter fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Delivery Fleet & Dispatch Desk</h6>
                    <p class="small text-muted mb-1">Rider support & partner kitchen coordination</p>
                    <a href="tel:18002009911" class="fw-bold text-primary text-decoration-none">+91 1800 200 9911 (Fleet Hotline)</a>
                    <div class="small text-muted mt-1"><i class="bi bi-envelope me-1"></i> riders@foodready.in</div>
                </div>
            </div>

            <!-- ROLE-SPECIFIC WORKPLACE / AFFILIATION CARDS -->
            @if (isStaff && !string.IsNullOrEmpty(Model.SpecificRestaurantName))
            {
                <div class="p-3 rounded-4 bg-light border border-primary border-opacity-25 mt-3">
                    <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold small text-uppercase">
                        <i class="bi bi-building-check"></i> Your Connected Workplace
                    </div>
                    <h6 class="fw-bold mb-1 text-dark">@Model.SpecificRestaurantName</h6>
                    @if (!string.IsNullOrEmpty(Model.SpecificRestaurantAddress))
                    {
                        <div class="small text-muted mb-1"><i class="bi bi-geo-alt me-1 text-danger"></i> @Model.SpecificRestaurantAddress</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.SpecificRestaurantPhone))
                    {
                        <div class="small text-muted"><i class="bi bi-telephone me-1 text-primary"></i> Direct Phone: <strong>@Model.SpecificRestaurantPhone</strong></div>
                    }
                    <div class="mt-2 pt-2 border-top small text-muted">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Messages submitted below go exclusively to this restaurant's management.
                    </div>
                </div>
            }
            else if (isRider)
            {
                <div class="p-3 rounded-4 bg-light border border-info border-opacity-25 mt-3">
                    <div class="d-flex align-items-center gap-2 mb-2 text-info fw-bold small text-uppercase">
                        <i class="bi bi-link-45deg"></i> Your Connected Partner Kitchens (@Model.RiderAffiliatedRestaurants.Count)
                    </div>
                    @if (Model.RiderAffiliatedRestaurants.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var affil in Model.RiderAffiliatedRestaurants)
                            {
                                <div class="p-2 bg-white rounded-3 border d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold text-dark"><i class="bi bi-shop me-1 text-warning"></i> @affil.RestaurantName</span>
                                    <span class="badge @(affil.IsVerified ? "bg-success" : "bg-warning text-dark") rounded-pill">
                                        @(affil.IsVerified ? "Affiliated" : "Pending Verification")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted">No restaurant affiliations yet. Affiliate with a kitchen from your Rider Dashboard.</div>
                    }
                </div>
            }
        </div>

        <!-- Right: Interactive Context-Aware Message Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <h4 class="fw-bold mb-0">Send Direct Message</h4>
                    @if (isStaff)
                    {
                        <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="bi bi-person-badge me-1"></i> Staff to Restaurant Direct</span>
                    }
                    else if (isRider)
                    {
                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill"><i class="bi bi-bicycle me-1"></i> Rider to Partner Kitchen</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-shield-check me-1"></i> Directly to Central Admin Helpdesk
                        </span>
                    }
                </div>

                @if (isStaff)
                {
                    <div class="alert alert-primary rounded-4 border-0 p-3 mb-4 small">
                        <i class="bi bi-info-circle-fill me-1"></i> You are reaching out to the management of <strong>@Model.SpecificRestaurantName</strong>. Your employer will receive this message directly on their Kitchen Dashboard.
                    </div>
                }
                else if (isRider)
                {
                    <div class="alert alert-info rounded-4 border-0 p-3 mb-4 small text-dark">
                        <i class="bi bi-info-circle-fill me-1"></i> Choose the specific restaurant you are delivering for to communicate with their kitchen dispatch desk.
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-4">Your message goes directly to the <strong>FoodReady Central Administration Desk</strong> for instant assistance.</p>
                }

                <form action="@Url.Action("SendMessage", "Home")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SenderRole" value="@Model.SenderRole" />

                    @if (isStaff)
                    {
                        <!-- STAFF IS LOCKED TO SPECIFIC RESTAURANT -->
                        <input type="hidden" name="SpecificRestaurantId" value="@Model.SpecificRestaurantId" />
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Recipient Workplace</label>
                            <input type="text" class="form-control bg-light" value="@Model.SpecificRestaurantName (Your Employer Restaurant)" readonly />
                        </div>
                    }
                    else if (isRider)
                    {
                        <!-- RIDER CHOOSES FROM CONNECTED RESTAURANTS ONLY -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Select Connected Restaurant <span class="text-danger">*</span></label>
                            @if (Model.RiderAffiliatedRestaurants.Any())
                            {
                                <select name="SpecificRestaurantId" class="form-select" required>
                                    @foreach (var affil in Model.RiderAffiliatedRestaurants)
                                    {
                                        <option value="@affil.RestaurantId">@affil.RestaurantName @(affil.IsVerified ? "(Verified Partner)" : "(Pending Verification)")</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" class="form-control bg-light" value="Central Operations Desk (No affiliated restaurants yet)" readonly />
                            }
                        </div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Your Name <span class="text-danger">*</span></label>
                            <input type="text" name="SenderName" class="form-control" value="@Model.SenderName" placeholder="e.g. Full Name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email Address <span class="text-danger">*</span></label>
                            <input type="email" name="SenderEmail" class="form-control" value="@Model.SenderEmail" placeholder="e.g. name@example.com" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Contact Phone (10 digits) <span class="text-danger">*</span></label>
                            <input type="tel" name="SenderPhone" pattern="[0-9]{10}" class="form-control" value="@Model.SenderPhone" placeholder="10-digit mobile number" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Query Category</label>
                            <input type="text" class="form-control bg-light" value="@(isStaff ? "Kitchen Operations / Duty Query" : (isRider ? "Order Pickup & Dispatch" : (isRestaurant ? "Platform & Payouts" : "Customer Support & Orders")))" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Subject / Query Topic <span class="text-danger">*</span></label>
                        <input type="text" name="Subject" class="form-control" placeholder="e.g. Order #1006 Dispatch or Shift Coordination" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Detailed Message <span class="text-danger">*</span></label>
                        <textarea name="Message" class="form-control" rows="4" placeholder="Describe your request in detail..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary-food w-100 py-3 fs-6 fw-bold shadow-sm" style="background: linear-gradient(135deg, #FF7A18, #FF5E1E); border-radius: 12px;">
                        <i class="bi bi-send-fill me-1"></i> Send Support Message
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Frequently Asked Questions Accordion -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <h4 class="fw-bold mb-4 text-center">Frequently Asked Questions</h4>
        <div class="accordion accordion-flush" id="faqAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="faqOne">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                        How does direct customer support work?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        All inquiries submitted by customers are routed directly to the Central Administration support desk. Our administrators monitor real-time orders, payment transactions, and rider allocation across the platform to provide immediate resolution.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="faqTwo">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                        How do Kitchen Staff and Delivery Riders communicate with restaurants?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        Kitchen staff members are directly connected with their specific employer restaurant. Delivery riders are connected with partner kitchens through their verified affiliations, ensuring all pickup, dish preparation, and timing communications remain focused on that specific restaurant.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
