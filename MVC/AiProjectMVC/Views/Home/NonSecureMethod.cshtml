@{
    ViewBag.Title = "Non-Secure Method";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <!-- Breadcrumb navigation -->
        <div class="mb-3">
            <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Authorization Center
            </a>
        </div>

        <div class="custom-card shadow-sm border-0 overflow-hidden">
            <!-- Header -->
            <div class="p-4 bg-light border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 mb-2">
                        <i class="bi bi-unlock-fill me-1"></i> Public Access &bull; [AllowAnonymous]
                    </span>
                    <h3 class="fw-bold mb-1 text-dark">Non-Secure Method</h3>
                    <p class="text-muted small mb-0">Action filter demonstration of unauthenticated public endpoints</p>
                </div>
                <div class="d-none d-sm-block text-success fs-1">
                    <i class="bi bi-globe2"></i>
                </div>
            </div>

            <!-- Body -->
            <div class="custom-card-body p-4">
                <div class="alert alert-success d-flex align-items-center gap-3 p-3 rounded-3 mb-4">
                    <i class="bi bi-check-circle-fill fs-3 text-success flex-shrink-0"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">This method can be accessed by everyone as it is non-secure method.</h5>
                        <p class="mb-0 small text-success-emphasis">
                            Both authenticated and anonymous users can access this page freely without credentials.
                        </p>
                    </div>
                </div>

                <div class="card bg-light border-0 p-3 mb-4">
                    <h6 class="fw-bold text-dark small text-uppercase mb-2">
                        <i class="bi bi-code-slash text-primary me-1"></i> Technical Implementation
                    </h6>
                    <pre class="bg-dark text-white p-3 rounded-3 small mb-0"><code>[Authorize]
public class HomeController : Controller
{
    [AllowAnonymous]
    public ActionResult NonSecureMethod()
    {
        return View();
    }
}</code></pre>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-2">
                    <div class="small text-muted">
                        Current Status: 
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="badge bg-primary">Authenticated (@User.Identity.Name)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Anonymous Guest</span>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("SecureMethod", "Home")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-shield-lock me-1"></i> Test Secure Method
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary-gradient btn-sm">
                            <i class="bi bi-house me-1"></i> Return to Hub
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
