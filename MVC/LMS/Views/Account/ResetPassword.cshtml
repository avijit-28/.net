@model LMS.ViewModels.ResetPasswordViewModel
@{
    ViewBag.Title = "Set New Account Password";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom p-4 p-md-5 shadow-lg border-0" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25) !important; border-radius: 20px; backdrop-filter: blur(16px); color: #FFFFFF;">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 shadow-sm" style="background: rgba(39, 184, 214, 0.15); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.3);">
                    <i class="bi bi-key-fill fs-2"></i>
                </div>
                <h3 class="fw-extrabold text-white tracking-tight mb-1">Set New Password</h3>
                <p class="small mb-0" style="color: #94A3B8;">
                    Your reset request has been verified by an administrator. Please establish your new secure password below.
                </p>
            </div>

            @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Code)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small border-0 border-start border-4 border-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold small text-white" })
                    <div class="input-group">
                        <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-envelope"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly", style = "background: rgba(4, 24, 34, 0.5); border: 1px solid rgba(255, 255, 255, 0.1); color: #94A3B8;" })
                    </div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, "New Password", new { @class = "form-label fw-bold small text-white" })
                    <div class="input-group">
                        <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-lock"></i></span>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Min 8 chars with uppercase, number & symbol", required = "required", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.ConfirmPassword, "Confirm New Password", new { @class = "form-label fw-bold small text-white" })
                    <div class="input-group">
                        <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-shield-check"></i></span>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Re-type new password", required = "required", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                    </div>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary py-2 rounded-pill fw-bold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                        <i class="bi bi-check2-circle me-1"></i> Update Password &amp; Sign In
                    </button>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light py-2 rounded-pill fw-semibold" style="border-color: rgba(255, 255, 255, 0.25);">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                </div>
            }
        </div>
    </div>
</div>
