@model IEnumerable<LMS.Models.Submission>
@{
    var assignment = (LMS.Models.Assignment)ViewBag.Assignment;
    ViewBag.Title = "Submissions - " + assignment.Title;
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Assignments", "Instructor", new { courseId = assignment.CourseId })" class="text-decoration-none">Assignments</a></li>
            <li class="breadcrumb-item active" aria-current="page">Submissions: @assignment.Title</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-info-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-inbox-fill text-info me-1"></i> Evaluation Queue
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Student Submissions: @assignment.Title</h2>
            <p class="text-muted small mb-0">Course: <strong>@assignment.Course.Title</strong> • Total submissions submitted for faculty evaluation</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-xs">
                Max Score: <strong>@assignment.MaxMarks pts</strong>
            </span>
            <a href="@Url.Action("Assignments", "Instructor", new { courseId = assignment.CourseId })" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Assignments
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white border-0">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-folder2-open text-muted display-4"></i>
            </div>
            <h4 class="fw-bold">No submissions received yet</h4>
            <p class="text-muted small mb-3">Enrolled students have not submitted work for this project challenge yet.</p>
            <div>
                <a href="@Url.Action("Assignments", "Instructor", new { courseId = assignment.CourseId })" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to Assignments
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom shadow-sm overflow-hidden bg-white border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-4">Student Key</th>
                            <th>Submitted Timestamp</th>
                            <th>Review Status</th>
                            <th>Awarded Score</th>
                            <th>Attached Work</th>
                            <th class="text-end pe-4">Faculty Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center fw-bold shadow-xs" style="width: 34px; height: 34px; font-size: 11px;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <code class="small text-dark font-monospace">@sub.StudentId.Substring(0, Math.Min(10, sub.StudentId.Length))...</code>
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted">@sub.SubmittedDate.ToString("MMM dd, yyyy HH:mm")</span>
                                    @if (assignment.DueDate.HasValue && sub.SubmittedDate > assignment.DueDate.Value)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill ms-1 small">Late</span>
                                    }
                                </td>
                                <td>
                                    @if (sub.Status == "Graded")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Graded
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                                            <span class="pulse-dot pulse-primary"></span> Pending Review
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (sub.Marks.HasValue)
                                    {
                                        <span class="fw-bold text-success font-monospace">@sub.Marks / @assignment.MaxMarks pts</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-- / @assignment.MaxMarks</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(sub.FileUrl))
                                    {
                                        <a href="@sub.FileUrl" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            <i class="bi bi-link-45deg me-1"></i> Repo Link
                                        </a>
                                    }
                                    else if (!string.IsNullOrEmpty(sub.SubmissionText))
                                    {
                                        <small class="text-secondary text-truncate d-inline-block" style="max-width: 180px;">
                                            @sub.SubmissionText
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Grade", "Instructor", new { id = sub.SubmissionId })" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold shadow-sm">
                                        <i class="bi bi-pencil-square me-1"></i> Grade & Feedback
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
