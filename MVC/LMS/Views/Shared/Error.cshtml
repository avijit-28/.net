@model System.Web.Mvc.HandleErrorInfo
@{
    ViewBag.Title = "Error - Application Exception";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 p-md-5 shadow-sm text-center bg-white border-0 card-gradient-top">
            <div class="rounded-circle bg-danger-subtle text-danger p-4 d-inline-flex mx-auto mb-3 shadow-xs">
                <i class="bi bi-exclamation-triangle-fill display-3"></i>
            </div>
            <h2 class="fw-extrabold text-dark tracking-tight mb-2">Unexpected Application Error</h2>
            <p class="text-secondary small mb-4" style="line-height: 1.6;">
                An unexpected exception was encountered while executing your request. The operational event has been logged for system administrator review.
            </p>

            @if (Model != null && !string.IsNullOrEmpty(Model.Exception?.Message))
            {
                <div class="alert alert-danger text-start font-monospace small mb-4 rounded-3 p-3">
                    <div class="fw-bold mb-1"><i class="bi bi-bug me-1"></i> Exception Details:</div>
                    <div class="text-break">@Model.Exception.Message</div>
                    @if (!string.IsNullOrEmpty(Model.ControllerName))
                    {
                        <div class="mt-2 text-muted" style="font-size: 11px;">
                            Controller: <strong>@Model.ControllerName</strong> | Action: <strong>@Model.ActionName</strong>
                        </div>
                    }
                </div>
            }

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-house-door me-1"></i> Return Home
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Go Back
                </a>
                <a href="@Url.Action("Contact", "Home")" class="btn btn-light border rounded-pill px-4 text-secondary">
                    <i class="bi bi-headset me-1"></i> Contact Support
                </a>
            </div>
        </div>
    </div>
</div>
