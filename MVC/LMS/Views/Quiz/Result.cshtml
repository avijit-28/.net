@model LMS.ViewModels.QuizResultViewModel
@{
    ViewBag.Title = "Quiz Result - " + Model.QuizTitle;
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 p-md-5 shadow-sm text-center">
            @if (Model.IsPassed)
            {
                <div class="rounded-circle bg-success-subtle text-success p-4 d-inline-flex mx-auto mb-3">
                    <i class="bi bi-patch-check-fill display-4"></i>
                </div>
                <h3 class="fw-bold text-success mb-1">Congratulations! You Passed</h3>
                <p class="text-muted small">You successfully achieved the required score for this assessment.</p>
            }
            else
            {
                <div class="rounded-circle bg-danger-subtle text-danger p-4 d-inline-flex mx-auto mb-3">
                    <i class="bi bi-x-circle-fill display-4"></i>
                </div>
                <h3 class="fw-bold text-danger mb-1">Assessment Needs Improvement</h3>
                <p class="text-muted small">You did not meet the passing threshold. Review the module lessons and attempt again.</p>
            }

            <div class="p-4 bg-light rounded-3 my-4 border">
                <div class="row g-3">
                    <div class="col-6 border-end">
                        <div class="display-6 fw-bold @(Model.IsPassed ? "text-success" : "text-danger")">
                            @Model.Score%
                        </div>
                        <div class="small text-muted fw-semibold">Final Score</div>
                    </div>
                    <div class="col-6">
                        <div class="display-6 fw-bold text-dark">
                            @Model.ObtainedMarks <span class="fs-6 text-muted">/ @Model.TotalMarks</span>
                        </div>
                        <div class="small text-muted fw-semibold">Marks Obtained</div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column gap-2">
                <a href="@Url.Action("Index", "Learning", new { courseId = Model.CourseId })" class="btn btn-primary rounded-pill py-2 fw-semibold shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Return to Classroom
                </a>
                <a href="@Url.Action("Quizzes", "Student")" class="btn btn-outline-secondary rounded-pill py-2">
                    View Assessment History
                </a>
            </div>
        </div>
    </div>
</div>
