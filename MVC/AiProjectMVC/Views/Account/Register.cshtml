@model AiProjectMVC.ViewModels.RegisterViewModel

@{
    ViewBag.Title = "Register Account";
}

<div class="row justify-content-center py-4">
    <div class="col-md-9 col-lg-6">
        <div class="custom-card shadow-lg border-0 overflow-hidden">
            <!-- Header Banner -->
            <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4f46e5 100%);">
                <div class="d-inline-flex p-3 rounded-circle bg-white bg-opacity-10 text-white mb-2 shadow-sm">
                    <i class="bi bi-person-badge-fill fs-2"></i>
                </div>
                <h3 class="fw-bold mb-1">Create Employee Account</h3>
                <p class="text-white-50 small mb-0">Register into the organization database system</p>
            </div>

            <!-- Form Body -->
            <div class="custom-card-body p-4">
                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                    {
                        <div class="custom-alert custom-alert-danger mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                            <div class="small">@Html.ValidationSummary(true, "", new { @class = "mb-0" })</div>
                        </div>
                    }

                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Name, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "e.g. Rahul Sharma", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Username -->
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.UserName, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-at text-muted"></i></span>
                                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "e.g. rahul101", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "e.g. rahul@gmail.com", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Phone Number -->
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone text-muted"></i></span>
                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "e.g. 9876543210", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Role -->
                        <div class="col-12">
                            @Html.LabelFor(m => m.Role, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-award text-muted"></i></span>
                                <select name="Role" id="Role" class="form-select" required>
                                    <option value="Employee" selected>Employee</option>
                                    <option value="HR">HR</option>
                                    <option value="Team Lead">Team Lead</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Admin">Admin</option>
                                </select>
                            </div>
                            @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Password -->
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Create a password" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Confirm Password -->
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-shield-check text-muted"></i></span>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm password" })
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>

                    <div class="mt-4 pt-2">
                        <button type="submit" class="btn btn-primary-gradient w-100 py-2 fs-6 shadow-sm">
                            <i class="bi bi-person-check-fill me-1"></i> Register New Employee
                        </button>
                    </div>
                }

                <div class="text-center mt-4 pt-2 border-top">
                    <p class="text-muted small mb-0">
                        Already have an account? 
                        <a href="@Url.Action("Login", "Account")" class="fw-bold text-primary text-decoration-none ms-1">
                            Sign In Here
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
