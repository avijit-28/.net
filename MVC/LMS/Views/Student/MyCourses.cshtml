@model IEnumerable<LMS.Models.Enrollment>
@{
    ViewBag.Title = "My Enrolled Courses";
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Personal Learning Portfolio
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">My Enrolled Courses</h2>
            <p class="text-muted small mb-0">Continue where you left off across all your active learning curriculums</p>
        </div>
        <a href="@Url.Action("Index", "Courses")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
            <i class="bi bi-compass me-1"></i> Explore More Courses
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-journal-x fs-1 text-muted"></i>
            </div>
            <h5 class="fw-bold">No enrolled courses in your curriculum yet.</h5>
            <p class="text-muted small mb-3">Browse our curated courses and enroll in tracks that match your career goals.</p>
            <div>
                <a href="@Url.Action("Index", "Courses")" class="btn btn-primary rounded-pill px-4">Browse Course Catalog</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom card-hover h-100 overflow-hidden shadow-sm d-flex flex-column bg-white">
                        <div class="bg-light text-center py-4 border-bottom position-relative" style="height: 150px; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #f8fafc 0%, #e2e8f0 100%);">
                            <i class="bi bi-journal-richtext display-3 text-primary opacity-25"></i>
                            <span class="position-absolute top-0 end-0 m-2 badge @(item.Status == "Completed" ? "bg-success" : "bg-primary") rounded-pill px-3 py-1 small">
                                @item.Status
                            </span>
                            <span class="position-absolute bottom-0 start-0 m-2 badge bg-white text-dark shadow-xs border small">
                                <i class="bi bi-clock me-1 text-primary"></i> @item.Course.DurationInHours hrs
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <span class="badge badge-primary-subtle small align-self-start mb-2">
                                @(item.Course?.Category?.CategoryName ?? "General")
                            </span>
                            <h5 class="card-title fw-bold mb-2 text-dark">@item.Course.Title</h5>

                            <div class="mb-3 mt-2">
                                <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                    <span>Curriculum Completion</span>
                                    <strong class="text-dark">@item.CompletionPercentage%</strong>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar @(item.Status == "Completed" ? "bg-success" : "bg-primary")" role="progressbar" style="width: @item.CompletionPercentage%;"></div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                <small class="text-muted"><i class="bi bi-calendar-check me-1"></i> @item.EnrollmentDate.ToString("MMM dd")</small>
                                <a href="@Url.Action("Index", "Learning", new { courseId = item.CourseId })" class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold shadow-xs">
                                    <i class="bi bi-play-circle-fill me-1"></i> Continue
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
