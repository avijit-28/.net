@{
    ViewBag.Title = "Enterprise AJAX Data Management & Routing Hub";
}

<div class="container-fluid px-4 pt-4">
    <!-- Top Executive Header & Action Bar -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-lg-7">
            <div class="d-flex align-items-center">
                <div class="bg-primary text-white p-3 rounded-4 me-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="fa-solid fa-database fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1 text-slate-900 tracking-tight">Enterprise AJAX &amp; Routing Hub</h3>
                    <p class="text-muted mb-0 small">
                        SQL Server <code>Assignmet</code> &bull; Stored Procedures <code>sp_SearchCustomers</code> &bull; <code>usercrudoperations</code>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-5 text-lg-end">
            <button id="btnRefreshAll" class="btn btn-outline-primary me-2">
                <i class="fa-solid fa-arrows-rotate me-1"></i> Sync Data
            </button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddCustomer">
                <i class="fa-solid fa-user-plus me-1"></i> New Customer
            </button>
        </div>
    </div>

    <!-- Live Metric Cards -->
    <div class="row g-3 mb-4" id="dashboard-overview">
        <div class="col-sm-6 col-xl-3">
            <div class="metric-card primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-bold small" style="font-size: 0.75rem;">Total Customers</span>
                        <h2 class="fw-bold mb-0 mt-1 text-slate-900" id="statCustomerCount">20</h2>
                        <small class="text-success fw-semibold"><i class="fa-solid fa-check me-1"></i> SQL Server DBConn</small>
                    </div>
                    <div class="metric-icon-wrap bg-primary bg-opacity-10 text-primary">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="metric-card success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-bold small" style="font-size: 0.75rem;">Countries Covered</span>
                        <h2 class="fw-bold mb-0 mt-1 text-slate-900" id="statCountryCount">10</h2>
                        <small class="text-success fw-semibold"><i class="fa-solid fa-earth-americas me-1"></i> Global Dataset</small>
                    </div>
                    <div class="metric-icon-wrap bg-success bg-opacity-10 text-success">
                        <i class="fa-solid fa-globe"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="metric-card warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-bold small" style="font-size: 0.75rem;">Active Cities</span>
                        <h2 class="fw-bold mb-0 mt-1 text-slate-900" id="statCityCount">16</h2>
                        <small class="text-warning fw-semibold"><i class="fa-solid fa-location-dot me-1"></i> Regional Distribution</small>
                    </div>
                    <div class="metric-icon-wrap bg-warning bg-opacity-10 text-warning">
                        <i class="fa-solid fa-city"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="metric-card info">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-bold small" style="font-size: 0.75rem;">AJAX Round-Trip</span>
                        <h2 class="fw-bold mb-0 mt-1 text-info" id="statLatencyText">~8 ms</h2>
                        <small class="text-muted fw-semibold" id="statStatusPill"><i class="fa-solid fa-bolt me-1 text-warning"></i> HTTP 200 OK</small>
                    </div>
                    <div class="metric-icon-wrap bg-info bg-opacity-10 text-info">
                        <i class="fa-solid fa-gauge-high"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Pills / Tabs -->
    <div class="nav nav-pills nav-pills-modern mb-4" id="mainHubNav" role="tablist">
        <button class="nav-link active" id="tab-datatable-link" data-bs-toggle="pill" data-bs-target="#tab-datatable" type="button" role="tab">
            <i class="fa-solid fa-table me-2 text-primary"></i> DataTables Studio
        </button>
        <button class="nav-link" id="tab-jsgrid-link" data-bs-toggle="pill" data-bs-target="#tab-jsgrid" type="button" role="tab">
            <i class="fa-solid fa-table-cells me-2 text-info"></i> JSGrid Workspace
        </button>
        <button class="nav-link" id="tab-userdetails-link" data-bs-toggle="pill" data-bs-target="#tab-userdetails" type="button" role="tab">
            <i class="fa-solid fa-user-plus me-2 text-success"></i> User Registration (CRUD)
        </button>
        <button class="nav-link" id="tab-redirects-link" data-bs-toggle="pill" data-bs-target="#tab-redirects" type="button" role="tab">
            <i class="fa-solid fa-share-from-square me-2 text-warning"></i> Redirects &amp; Routing
        </button>
        <button class="nav-link" id="tab-status-link" data-bs-toggle="pill" data-bs-target="#tab-status" type="button" role="tab">
            <i class="fa-solid fa-shield-halved me-2 text-danger"></i> Status Results Lab
        </button>
        <button class="nav-link" id="tab-workflow-link" data-bs-toggle="pill" data-bs-target="#tab-workflow" type="button" role="tab">
            <i class="fa-solid fa-diagram-project me-2 text-purple"></i> Architecture Workflow
        </button>
    </div>

    <!-- Tab Contents -->
    <div class="tab-content" id="mainHubContent">

        <!-- ============================================================== -->
        <!-- TAB 1: DATATABLES STUDIO                                        -->
        <!-- ============================================================== -->
        <div class="tab-pane fade show active" id="tab-datatable" role="tabpanel">
            <div class="card card-modern mb-4">
                <div class="card-header-modern">
                    <div>
                        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-sliders text-primary me-2"></i> Interactive Feature Controls</h5>
                        <small class="text-muted">Toggle properties to see how DataTables adjusts behavior in real time</small>
                    </div>
                    <div class="d-flex gap-2">
                        <select id="quickCountryFilter" class="form-select form-select-sm" style="width: auto;">
                            <option value="">All Countries</option>
                            <option value="Germany">Germany</option>
                            <option value="Mexico">Mexico</option>
                            <option value="UK">UK</option>
                            <option value="Sweden">Sweden</option>
                            <option value="France">France</option>
                            <option value="Spain">Spain</option>
                            <option value="Canada">Canada</option>
                            <option value="Brazil">Brazil</option>
                        </select>
                        <button id="btnReloadDataTable" class="btn btn-sm btn-primary">
                            <i class="fa-solid fa-rotate me-1"></i> Re-query SP
                        </button>
                    </div>
                </div>
                <div class="card-body bg-light bg-opacity-50 py-3">
                    <div class="d-flex flex-wrap gap-4 align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="chkFilter" checked>
                            <label class="form-check-label small fw-semibold" for="chkFilter">bFilter (Search Box)</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="chkLength" checked>
                            <label class="form-check-label small fw-semibold" for="chkLength">bLengthChange (Records Per Page)</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="chkSort" checked>
                            <label class="form-check-label small fw-semibold" for="chkSort">bSort (Column Sorting)</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="chkPaginate" checked>
                            <label class="form-check-label small fw-semibold" for="chkPaginate">bPaginate (Page Navigation)</label>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table id="tblCustomers" class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Customer Id</th>
                                    <th>Name</th>
                                    <th>City</th>
                                    <th>Country</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light p-3 border-top">
                    <h6 class="fw-bold small mb-2 text-dark"><i class="fa-solid fa-code text-primary me-1"></i> Dynamically Synced JavaScript Configuration:</h6>
                    <pre class="code-block mb-0" id="liveConfigDisplay"><code>// DataTables initialization script updates dynamically</code></pre>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- TAB 2: JSGRID WORKSPACE                                        -->
        <!-- ============================================================== -->
        <div class="tab-pane fade" id="tab-jsgrid" role="tabpanel">
            <div class="card card-modern mb-4">
                <div class="card-header-modern">
                    <div>
                        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-table-cells text-info me-2"></i> JSGrid Interactive Workspace</h5>
                        <small class="text-muted">Lightweight grid with inline editing, row adding, column filtering, and paging</small>
                    </div>
                    <button id="btnReloadJsGrid" class="btn btn-sm btn-outline-info">
                        <i class="fa-solid fa-rotate me-1"></i> Refresh Grid Data
                    </button>
                </div>
                <div class="card-body p-4">
                    <div id="jsGridContainer"></div>
                </div>
                <div class="card-footer bg-light p-3 border-top">
                    <div class="row g-3 text-muted small">
                        <div class="col-md-6">
                            <i class="fa-solid fa-circle-check text-success me-1"></i> <strong>Inline Editing:</strong> Click the pencil button on any row to edit values directly in-place.
                        </div>
                        <div class="col-md-6">
                            <i class="fa-solid fa-circle-check text-success me-1"></i> <strong>Header Filtering:</strong> Type in the top filter inputs to filter column by column.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- TAB 3: USER DETAILS CRUD (usercrudoperations)                   -->
        <!-- ============================================================== -->
        <div class="tab-pane fade" id="tab-userdetails" role="tabpanel">
            <div class="row g-4">
                <!-- User Form Card -->
                <div class="col-lg-4">
                    <div class="card card-modern h-100">
                        <div class="card-header-modern bg-white">
                            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-user-plus text-success me-2"></i> Register New User</h5>
                        </div>
                        <div class="card-body p-4">
                            <p class="small text-muted mb-3">
                                Inserts into <code>Assignmet.dbo.userdetails</code> using stored procedure <code>usercrudoperations (&#64;status='INSERT')</code>.
                            </p>
                            <form id="formAddUserAjax">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">User Name *</label>
                                    <input type="text" class="form-control" id="txtUserName" required placeholder="e.g. John Doe">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Education *</label>
                                    <input type="text" class="form-control" id="txtEducation" required placeholder="e.g. B.Tech / MBA / Graduate">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Location *</label>
                                    <input type="text" class="form-control" id="txtLocation" required placeholder="e.g. London, UK">
                                </div>
                                <div class="d-grid mt-4">
                                    <button type="submit" id="btnSubmitUserAjax" class="btn btn-success">
                                        <i class="fa-solid fa-check me-1"></i> Register User (Instant AJAX)
                                    </button>
                                </div>
                            </form>
                            <hr class="my-4">
                            <div class="text-center">
                                <a href="@Url.Action("InsertUserDetails", "User")" class="btn btn-outline-secondary btn-sm w-100">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Open Classic Form View
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Table Card -->
                <div class="col-lg-8">
                    <div class="card card-modern h-100">
                        <div class="card-header-modern bg-white">
                            <div>
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-users text-primary me-2"></i> Registered Users Directory</h5>
                                <small class="text-muted">Live query via <code>usercrudoperations (&#64;status='GET')</code></small>
                            </div>
                            <button id="btnRefreshUsers" class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-rotate me-1"></i> Refresh Table
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                                <table id="tblUserDetailsLive" class="table table-striped table-hover mb-0 align-middle">
                                    <thead class="table-dark sticky-top">
                                        <tr>
                                            <th style="width: 80px;">User Id</th>
                                            <th>User Name</th>
                                            <th>Education</th>
                                            <th>Location</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblUserDetailsLiveBody">
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">
                                                <i class="fa-solid fa-spinner fa-spin me-2"></i> Loading users...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- TAB 4: REDIRECTS & ROUTING CENTER                               -->
        <!-- ============================================================== -->
        <div class="tab-pane fade" id="tab-redirects" role="tabpanel">
            <div class="row g-4 mb-4">
                <!-- 1. jQuery window.location.href -->
                <div class="col-md-6 col-xl-3">
                    <div class="action-card">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 me-2">
                                    <i class="fa-brands fa-js fs-4"></i>
                                </div>
                                <h6 class="fw-bold mb-0 text-slate-900">jQuery Client Redirect</h6>
                            </div>
                            <p class="small text-muted">
                                Uses <code>window.location.href = "&#64;Url.Action(...)"</code> on a DOM button click to redirect the browser to another action.
                            </p>
                        </div>
                        <button id="btnClientRedirectDemo" class="btn btn-outline-primary w-100 mt-3">
                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Trigger jQuery Redirect
                        </button>
                    </div>
                </div>

                <!-- 2. RedirectToAction -->
                <div class="col-md-6 col-xl-3">
                    <div class="action-card">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-success bg-opacity-10 text-success p-2 rounded-3 me-2">
                                    <i class="fa-solid fa-arrow-right-arrow-left fs-4"></i>
                                </div>
                                <h6 class="fw-bold mb-0 text-slate-900">RedirectToAction</h6>
                            </div>
                            <p class="small text-muted">
                                Server returns HTTP 302 Redirect specifying target controller and action: <code>RedirectToAction("InsertUserDetails", "User")</code>.
                            </p>
                        </div>
                        <a href="@Url.Action("RedirectToActionDemo", "Home")" class="btn btn-outline-success w-100 mt-3">
                            <i class="fa-solid fa-arrow-right me-1"></i> Test RedirectToAction
                        </a>
                    </div>
                </div>

                <!-- 3. RedirectToRoute -->
                <div class="col-md-6 col-xl-3">
                    <div class="action-card">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-info bg-opacity-10 text-info p-2 rounded-3 me-2">
                                    <i class="fa-solid fa-route fs-4"></i>
                                </div>
                                <h6 class="fw-bold mb-0 text-slate-900">RedirectToRoute</h6>
                            </div>
                            <p class="small text-muted">
                                Redirects using a route value dictionary: <code>RedirectToRoute(new { controller = "Home", action = "About" })</code>.
                            </p>
                        </div>
                        <a href="@Url.Action("RedirectToRouteDemo", "Home")" class="btn btn-outline-info w-100 mt-3">
                            <i class="fa-solid fa-route me-1"></i> Test RedirectToRoute
                        </a>
                    </div>
                </div>

                <!-- 4. Redirect (External URL) -->
                <div class="col-md-6 col-xl-3">
                    <div class="action-card">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-3 me-2">
                                    <i class="fa-solid fa-globe fs-4"></i>
                                </div>
                                <h6 class="fw-bold mb-0 text-slate-900">Redirect(url) External</h6>
                            </div>
                            <p class="small text-muted">
                                Redirects outside the application to a specific URL: <code>Redirect("https://mccit.net")</code>.
                            </p>
                        </div>
                        <a href="@Url.Action("RedirectExternal", "Home")" class="btn btn-outline-warning w-100 mt-3" target="_blank">
                            <i class="fa-solid fa-globe me-1"></i> Test External Redirect
                        </a>
                    </div>
                </div>
            </div>

            <!-- Redirection Technical Summary Card -->
            <div class="card card-modern">
                <div class="card-header-modern bg-white">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-book-open text-primary me-2"></i> Redirection Methods Comparison</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered mb-0 small">
                            <thead class="table-dark">
                                <tr>
                                    <th>Method</th>
                                    <th>Return Type</th>
                                    <th>Parameters</th>
                                    <th>Primary Use Case</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-primary">Redirect(url)</td>
                                    <td><code>RedirectResult</code></td>
                                    <td>URL string (e.g. <code>https://mccit.net</code>)</td>
                                    <td>Redirecting to external websites outside your application.</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-success">RedirectToAction(action, controller)</td>
                                    <td><code>RedirectToRouteResult</code></td>
                                    <td>Action Name, Optional Controller Name</td>
                                    <td>Most convenient way to redirect between controllers within the same MVC app.</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-info">RedirectToRoute(routeValues)</td>
                                    <td><code>RedirectToRouteResult</code></td>
                                    <td>Anonymous object with route keys (<code>controller</code>, <code>action</code>, <code>id</code>)</td>
                                    <td>Redirecting based on defined routes in <code>RouteConfig.cs</code>.</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-warning">jQuery window.location.href</td>
                                    <td>Client-side JavaScript</td>
                                    <td>URL generated by <code>&#64;Url.Action(...)</code></td>
                                    <td>Client-side redirect after AJAX completion or button click without full postback.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- TAB 5: STATUS RESULTS LAB                                      -->
        <!-- ============================================================== -->
        <div class="tab-pane fade" id="tab-status" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card card-modern h-100">
                        <div class="card-header-modern bg-white">
                            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-flask-vial text-danger me-2"></i> Status Results Interactive Tester</h5>
                        </div>
                        <div class="card-body p-4">
                            <p class="small text-muted mb-3">
                                Status Action Results return HTTP status codes and custom descriptions to the browser. Click below to inspect each result live:
                            </p>
                            
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-danger btn-test-status text-start" data-url="/Home/UnauthorizedStatusCode">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="fa-solid fa-lock me-2"></i> HttpStatusCodeResult (401)</span>
                                        <span class="badge bg-danger">Unauthorized</span>
                                    </div>
                                </button>
                                
                                <button class="btn btn-outline-danger btn-test-status text-start" data-url="/Home/BadGateway">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="fa-solid fa-server me-2"></i> HttpStatusCodeResult (502)</span>
                                        <span class="badge bg-danger">Bad Gateway</span>
                                    </div>
                                </button>

                                <button class="btn btn-outline-secondary btn-test-status text-start" data-url="/Home/UnauthorizedResult">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="fa-solid fa-user-slash me-2"></i> HttpUnauthorizedResult</span>
                                        <span class="badge bg-secondary">401 Shorthand</span>
                                    </div>
                                </button>

                                <button class="btn btn-outline-dark btn-test-status text-start" data-url="/Home/NotFound">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="fa-solid fa-magnifying-glass me-2"></i> HttpNotFoundResult</span>
                                        <span class="badge bg-dark">404 Helper</span>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card card-modern h-100">
                        <div class="card-header-modern bg-white">
                            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-terminal text-primary me-2"></i> Live HTTP Diagnostics Inspector</h5>
                            <span class="badge bg-success" id="diagStatusCodePill">Ready</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="bg-light p-3 rounded-3 border mb-3 small">
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Target Endpoint:</span>
                                    <span class="fw-bold font-monospace text-primary" id="diagTargetEndpoint">-</span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">HTTP Status Code:</span>
                                    <span class="fw-bold font-monospace" id="diagCodeDisplay">-</span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Status Description:</span>
                                    <span class="fw-bold font-monospace" id="diagDescriptionDisplay">-</span>
                                </div>
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-muted">Action Result Type:</span>
                                    <span class="fw-bold font-monospace text-dark" id="diagResultType">-</span>
                                </div>
                            </div>

                            <h6 class="fw-bold small text-dark mb-2">Raw Server Response Body / HTML:</h6>
                            <pre class="code-block mb-3" style="max-height: 220px;" id="diagResponseBody"><code>// Click any test button on the left to run an inspection</code></pre>

                            <div class="d-flex justify-content-end">
                                <a id="btnOpenRawTab" href="#" target="_blank" class="btn btn-sm btn-outline-secondary disabled">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Open in New Browser Tab
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- TAB 6: ARCHITECTURE WORKFLOW                                   -->
        <!-- ============================================================== -->
        <div class="tab-pane fade" id="tab-workflow" role="tabpanel">
            <div class="card card-modern mb-4">
                <div class="card-header-modern bg-white">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-diagram-project text-primary me-2"></i> End-to-End Request/Response Cycle</h5>
                </div>
                <div class="card-body p-4">
                    <div class="pipeline-flow">
                        <div class="pipeline-node active-node">
                            <div class="small text-muted fw-bold mb-1">1. DOM READY</div>
                            <i class="fa-brands fa-html5 text-danger fs-3 mb-2"></i>
                            <div class="fw-semibold">HTML Table</div>
                            <div class="small text-secondary">&lt;thead&gt; &amp; &lt;tbody&gt;</div>
                        </div>
                        <div class="pipeline-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                        <div class="pipeline-node active-node">
                            <div class="small text-muted fw-bold mb-1">2. AJAX POST</div>
                            <i class="fa-solid fa-arrow-right-arrow-left text-primary fs-3 mb-2"></i>
                            <div class="fw-semibold">jQuery $.ajax()</div>
                            <div class="small text-secondary">/Home/AjaxMethod</div>
                        </div>
                        <div class="pipeline-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                        <div class="pipeline-node active-node">
                            <div class="small text-muted fw-bold mb-1">3. CONTROLLER</div>
                            <i class="fa-solid fa-server text-success fs-3 mb-2"></i>
                            <div class="fw-semibold">HomeController</div>
                            <div class="small text-secondary">JsonResult</div>
                        </div>
                        <div class="pipeline-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                        <div class="pipeline-node active-node">
                            <div class="small text-muted fw-bold mb-1">4. SQL SERVER</div>
                            <i class="fa-solid fa-database text-warning fs-3 mb-2"></i>
                            <div class="fw-semibold">dbo.sp_SearchCustomers</div>
                            <div class="small text-secondary">Connection: DBConn</div>
                        </div>
                        <div class="pipeline-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                        <div class="pipeline-node active-node">
                            <div class="small text-muted fw-bold mb-1">5. SERIALIZATION</div>
                            <i class="fa-solid fa-file-code text-info fs-3 mb-2"></i>
                            <div class="fw-semibold">Json(customers)</div>
                            <div class="small text-secondary">HTTP 200 Payload</div>
                        </div>
                        <div class="pipeline-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                        <div class="pipeline-node active-node">
                            <div class="small text-muted fw-bold mb-1">6. UI RENDER</div>
                            <i class="fa-solid fa-table-list text-primary fs-3 mb-2"></i>
                            <div class="fw-semibold">DataTables / JSGrid</div>
                            <div class="small text-secondary">Search, Sort, Paging</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL: ADD NEW CUSTOMER (dbo.sp_InsertCustomer)                -->
<!-- ============================================================== -->
<div class="modal fade" id="modalAddCustomer" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--radius-md);">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2"></i> Add New Customer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formAddCustomer">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Contact Name *</label>
                        <input type="text" class="form-control" id="custName" required placeholder="e.g. John Doe">
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">City *</label>
                            <input type="text" class="form-control" id="custCity" required placeholder="e.g. London">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Country *</label>
                            <input type="text" class="form-control" id="custCountry" required placeholder="e.g. UK">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Email</label>
                        <input type="email" class="form-control" id="custEmail" placeholder="e.g. john&#64;example.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Phone</label>
                        <input type="text" class="form-control" id="custPhone" placeholder="e.g. +44 171 555 1234">
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="btnSaveCustomer" class="btn btn-primary">
                        <i class="fa-solid fa-save me-1"></i> Save to SQL Server
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
<script type="text/javascript">
    var customerDataTable = null;
    var cachedCustomerData = null;

    $(function () {
        // Initialize URL Hash navigation
        var hash = window.location.hash;
        if (hash) {
            $('#mainHubNav button[data-bs-target="' + hash + '"]').tab('show');
        }

        // 1. Initial Load of DataTables & JSGrid
        fetchCustomerDataAndInitTable();
        initJsGrid();
        loadUserDetailsLive();

        // 2. Control Switches
        $("#chkFilter, #chkLength, #chkSort, #chkPaginate").on("change", function () {
            rebuildDataTableWithCurrentSettings();
        });

        // 3. Quick Country Filter
        $("#quickCountryFilter").on("change", function () {
            var selectedCountry = $(this).val();
            if (customerDataTable) {
                customerDataTable.column(3).search(selectedCountry).draw();
            }
        });

        // 4. Reload Buttons
        $("#btnReloadDataTable, #btnRefreshAll").on("click", function () {
            fetchCustomerDataAndInitTable();
            loadUserDetailsLive();
        });

        $("#btnReloadJsGrid").on("click", function () {
            $("#jsGridContainer").jsGrid("loadData");
        });

        $("#btnRefreshUsers").on("click", function () {
            loadUserDetailsLive();
        });

        // 5. Add Customer Modal Form Submission (dbo.sp_InsertCustomer)
        $("#formAddCustomer").on("submit", function (e) {
            e.preventDefault();
            var newCustomer = {
                ContactName: $("#custName").val(),
                City: $("#custCity").val(),
                Country: $("#custCountry").val(),
                Email: $("#custEmail").val(),
                Phone: $("#custPhone").val()
            };

            $("#btnSaveCustomer").prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...');

            $.ajax({
                type: "POST",
                url: "/Home/AddCustomer",
                data: JSON.stringify(newCustomer),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (res) {
                    $("#btnSaveCustomer").prop("disabled", false).html('<i class="fa-solid fa-save me-1"></i> Save to SQL Server');
                    if (res.success) {
                        $("#modalAddCustomer").modal("hide");
                        $("#formAddCustomer")[0].reset();

                        Swal.fire({
                            icon: 'success',
                            title: 'Customer Added!',
                            text: 'Saved with CustomerID: ' + res.customerId + ' via dbo.sp_InsertCustomer',
                            timer: 2500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });

                        fetchCustomerDataAndInitTable();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                    }
                },
                error: function (xhr) {
                    $("#btnSaveCustomer").prop("disabled", false).html('<i class="fa-solid fa-save me-1"></i> Save to SQL Server');
                    Swal.fire({ icon: 'error', title: 'Server Error', text: xhr.statusText });
                }
            });
        });

        // 6. Add User AJAX Form Submission (usercrudoperations)
        $("#formAddUserAjax").on("submit", function (e) {
            e.preventDefault();
            var user = {
                UserName: $("#txtUserName").val(),
                Education: $("#txtEducation").val(),
                Location: $("#txtLocation").val()
            };

            $("#btnSubmitUserAjax").prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Registering...');

            $.ajax({
                type: "POST",
                url: "/User/InsertUserAjax",
                data: JSON.stringify(user),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (res) {
                    $("#btnSubmitUserAjax").prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Register User (Instant AJAX)');
                    if (res.success) {
                        $("#formAddUserAjax")[0].reset();

                        Swal.fire({
                            icon: 'success',
                            title: 'User Registered!',
                            text: res.message,
                            timer: 2500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });

                        loadUserDetailsLive();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Registration Failed', text: res.message });
                    }
                },
                error: function (xhr) {
                    $("#btnSubmitUserAjax").prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Register User (Instant AJAX)');
                    Swal.fire({ icon: 'error', title: 'Error', text: xhr.statusText });
                }
            });
        });

        // 7. Client-side jQuery Redirect Demo
        $("#btnClientRedirectDemo").on("click", function () {
            Swal.fire({
                title: 'Executing jQuery Redirect',
                text: 'window.location.href = "/User/InsertUserDetails"',
                icon: 'info',
                timer: 1500,
                showConfirmButton: false
            }).then(function () {
                window.location.href = "@Url.Action("InsertUserDetails", "User")";
            });
        });

        // 8. Live Status Results Inspector
        $(".btn-test-status").on("click", function () {
            var url = $(this).data("url");
            inspectStatusEndpoint(url);
        });
    });

    /**
     * DataTables AJAX Fetch & Bind
     */
    function fetchCustomerDataAndInitTable() {
        var start = performance.now();
        $.ajax({
            type: "POST",
            url: "/Home/AjaxMethod",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var elapsed = Math.round(performance.now() - start);
                cachedCustomerData = response;

                // Update Metrics
                $("#statCustomerCount").text(response.length);
                var countries = {}, cities = {};
                $.each(response, function (i, item) {
                    if (item.Country) countries[item.Country] = true;
                    if (item.City) cities[item.City] = true;
                });
                $("#statCountryCount").text(Object.keys(countries).length);
                $("#statCityCount").text(Object.keys(cities).length);
                $("#statLatencyText").text(elapsed + " ms");
                $("#statStatusPill").html('<i class="fa-solid fa-bolt me-1 text-warning"></i> HTTP 200 OK (' + response.length + ' rows)');

                OnSuccess(response);
            },
            error: function (xhr) {
                Swal.fire({ icon: 'error', title: 'DataTables Fetch Error', text: xhr.statusText });
            }
        });
    }

    /**
     * Initializes DataTables on #tblCustomers
     */
    function OnSuccess(response) {
        if ($.fn.DataTable.isDataTable('#tblCustomers')) {
            $('#tblCustomers').DataTable().destroy();
            $('#tblCustomers tbody').empty();
        }

        var filter = $("#chkFilter").is(":checked");
        var length = $("#chkLength").is(":checked");
        var sort = $("#chkSort").is(":checked");
        var paginate = $("#chkPaginate").is(":checked");

        customerDataTable = $("#tblCustomers").DataTable({
            bLengthChange: length,
            lengthMenu: [[5, 10, -1], [5, 10, "All"]],
            bFilter: filter,
            bSort: sort,
            bPaginate: paginate,
            data: response,
            columns: [
                {
                    data: 'CustomerID',
                    render: function (data) {
                        return '<span class="badge bg-secondary badge-code">' + data + '</span>';
                    }
                },
                {
                    data: 'ContactName',
                    render: function (data) {
                        return '<strong class="text-slate-900">' + data + '</strong>';
                    }
                },
                { data: 'City' },
                {
                    data: 'Country',
                    render: function (data) {
                        return '<span class="badge bg-light text-dark border">' + data + '</span>';
                    }
                },
                {
                    data: 'Email',
                    render: function (data) {
                        return data ? '<span class="text-muted small">' + data + '</span>' : '<span class="text-muted fst-italic">None</span>';
                    }
                },
                {
                    data: 'Phone',
                    render: function (data) {
                        return data ? '<span class="badge-code text-secondary">' + data + '</span>' : '<span class="text-muted fst-italic">None</span>';
                    }
                }
            ],
            pageLength: 5,
            responsive: true,
            dom: '<"d-flex justify-content-between align-items-center mb-3"Bf>rt<"d-flex justify-content-between align-items-center mt-3"lip>',
            buttons: [
                { extend: 'copy', className: 'btn btn-sm btn-outline-secondary' },
                { extend: 'csv', className: 'btn btn-sm btn-outline-secondary' },
                { extend: 'print', className: 'btn btn-sm btn-outline-secondary' }
            ],
            language: {
                search: "",
                searchPlaceholder: "Search any column..."
            }
        });

        updateCodePreview(filter, length, sort, paginate);
    }

    function rebuildDataTableWithCurrentSettings() {
        if (cachedCustomerData) {
            OnSuccess(cachedCustomerData);
        } else {
            fetchCustomerDataAndInitTable();
        }
    }

    function updateCodePreview(filter, length, sort, paginate) {
        var code = '$("#tblCustomers").DataTable({\n' +
            '    bLengthChange: ' + length + ',\n' +
            '    lengthMenu: [[5, 10, -1], [5, 10, "All"]],\n' +
            '    bFilter: ' + filter + ',\n' +
            '    bSort: ' + sort + ',\n' +
            '    bPaginate: ' + paginate + ',\n' +
            '    data: response,\n' +
            '    columns: [\n' +
            '        { \'data\': \'CustomerID\' },\n' +
            '        { \'data\': \'ContactName\' },\n' +
            '        { \'data\': \'City\' },\n' +
            '        { \'data\': \'Country\' }\n' +
            '    ]\n' +
            '});';
        $("#liveConfigDisplay code").text(code);
    }

    /**
     * JSGrid Initialization
     */
    function initJsGrid() {
        $("#jsGridContainer").jsGrid({
            width: "100%",
            height: "440px",
            filtering: true,
            editing: true,
            sorting: true,
            paging: true,
            pageSize: 6,
            autoload: true,
            controller: {
                loadData: function (filter) {
                    var d = $.Deferred();
                    $.ajax({
                        type: "POST",
                        url: "/Home/GetJsGridData",
                        data: JSON.stringify({
                            filterName: filter.ContactName || "",
                            filterCountry: filter.Country || ""
                        }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (res) { d.resolve(res); },
                        error: function (e) { d.reject(e); }
                    });
                    return d.promise();
                }
            },
            fields: [
                { name: "CustomerID", title: "ID", type: "number", width: 60, readOnly: true },
                { name: "ContactName", title: "Name", type: "text", width: 140 },
                { name: "City", title: "City", type: "text", width: 110 },
                { name: "Country", title: "Country", type: "text", width: 110 },
                { name: "Email", title: "Email", type: "text", width: 170 },
                { type: "control", editButton: true, deleteButton: false }
            ]
        });
    }

    /**
     * User Details Live Table Loader
     */
    function loadUserDetailsLive() {
        $.ajax({
            type: "GET",
            url: "/User/GetUsersJson",
            dataType: "json",
            success: function (list) {
                var html = '';
                if (!list || list.length === 0) {
                    html = '<tr><td colspan="4" class="text-center py-4 text-muted">No users found.</td></tr>';
                } else {
                    $.each(list, function (i, u) {
                        html += '<tr>' +
                            '<td><span class="badge bg-secondary badge-code">' + u.UserId + '</span></td>' +
                            '<td class="fw-bold">' + u.UserName + '</td>' +
                            '<td>' + (u.Education || 'N/A') + '</td>' +
                            '<td><span class="badge bg-light text-dark border">' + (u.Location || 'N/A') + '</span></td>' +
                            '</tr>';
                    });
                }
                $("#tblUserDetailsLiveBody").html(html);
            },
            error: function () {
                $("#tblUserDetailsLiveBody").html('<tr><td colspan="4" class="text-center py-4 text-danger">Failed to load user records.</td></tr>');
            }
        });
    }

    /**
     * Live Status Endpoint Inspector
     */
    function inspectStatusEndpoint(url) {
        $("#diagTargetEndpoint").text(url);
        $("#btnOpenRawTab").attr("href", url).removeClass("disabled");

        fetch(url, { method: 'GET' })
            .then(function (response) {
                $("#diagCodeDisplay").text(response.status + " " + response.statusText);
                $("#diagDescriptionDisplay").text(response.statusText);
                $("#diagStatusCodePill").text(response.status).removeClass().addClass("badge " + (response.status >= 400 ? "bg-danger" : "bg-success"));

                if (url.indexOf("Unauthorized") >= 0) {
                    $("#diagResultType").text("HttpUnauthorizedResult / HttpStatusCodeResult");
                } else if (url.indexOf("NotFound") >= 0) {
                    $("#diagResultType").text("HttpNotFoundResult");
                } else if (url.indexOf("BadGateway") >= 0) {
                    $("#diagResultType").text("HttpStatusCodeResult (502)");
                } else {
                    $("#diagResultType").text("HttpStatusCodeResult");
                }

                return response.text();
            })
            .then(function (html) {
                $("#diagResponseBody").text(html.substring(0, 1500) + (html.length > 1500 ? "\n... [truncated]" : ""));
            })
            .catch(function (err) {
                $("#diagCodeDisplay").text("Error");
                $("#diagResponseBody").text(err.toString());
            });
    }
</script>
}
