@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    string currentUserId = User.Identity.GetUserId();
    int unreadNotifCount = 0;
    string userDisplayName = User.Identity.GetUserName() ?? "User";
    string userEmail = User.Identity.GetUserName() ?? "";
    string userProfilePicture = null;
    string roleName = "Student";

    try
    {
        using (var notifDb = new LMS.Data.ApplicationDbContext())
        {
            unreadNotifCount = notifDb.Notifications.Count(n => n.UserId == currentUserId && !n.IsRead);
            var curUser = notifDb.Users.Find(currentUserId);
            if (curUser != null)
            {
                if (!string.IsNullOrWhiteSpace(curUser.FullName))
                {
                    userDisplayName = curUser.FullName;
                }
                if (!string.IsNullOrWhiteSpace(curUser.Email))
                {
                    userEmail = curUser.Email;
                }
                if (!string.IsNullOrWhiteSpace(curUser.ProfilePicture))
                {
                    userProfilePicture = curUser.ProfilePicture;
                }
            }
        }
    }
    catch { }

    if (User.IsInRole("Admin"))
    {
        roleName = "Admin";
    }
    else if (User.IsInRole("Instructor"))
    {
        roleName = "Instructor";
    }
    else
    {
        roleName = "Student";
    }

    <ul class="navbar-nav align-items-lg-center gap-2 mb-0 ms-lg-auto">
        <!-- Notification Bell with Count Badge -->
        <li class="nav-item">
            <a class="nav-icon-btn position-relative" href="@Url.Action("Index", "Notifications")" title="Notifications" aria-label="Notifications">
                <i class="bi bi-bell fs-6"></i>
                <span class="d-lg-none ms-2 fw-medium">Notifications</span>
                @if (unreadNotifCount > 0)
                {
                    <span class="badge rounded-pill bg-danger d-none d-lg-inline-block position-absolute top-0 start-100 translate-middle border border-white" style="font-size: 10px; padding: 0.25em 0.5em; margin-top: 8px; margin-left: -8px;">
                        @(unreadNotifCount > 99 ? "99+" : unreadNotifCount.ToString())
                        <span class="visually-hidden">unread alerts</span>
                    </span>
                    <span class="badge rounded-pill bg-danger d-lg-none ms-auto">
                        @(unreadNotifCount > 99 ? "99+" : unreadNotifCount.ToString())
                    </span>
                }
            </a>
        </li>

        <!-- User Dropdown with Avatar & Name -->
        <li class="nav-item dropdown ms-lg-1">
            <a class="nav-user-btn dropdown-toggle" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="d-inline-flex align-items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(userProfilePicture))
                    {
                        <img src="@userProfilePicture" class="nav-avatar-circle" style="object-fit: cover;" alt="@userDisplayName" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    }
                    <span class="nav-avatar-circle" style="display: @(string.IsNullOrWhiteSpace(userProfilePicture) ? "flex" : "none");">
                        @(string.IsNullOrEmpty(userDisplayName) ? "U" : userDisplayName.Substring(0, 1).ToUpper())
                    </span>
                    <span class="d-inline text-truncate" style="max-width: 130px;">@userDisplayName</span>
                </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2 py-2" aria-labelledby="userMenu" style="min-width: 240px;">
                <li class="px-3 py-3 border-bottom" style="background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1) !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        @if (!string.IsNullOrWhiteSpace(userProfilePicture))
                        {
                            <img src="@userProfilePicture" class="rounded-circle shadow-xs flex-shrink-0" style="width: 38px; height: 38px; object-fit: cover;" alt="@userDisplayName" onerror="this.style.display='none';" />
                        }
                        <div class="overflow-hidden">
                            <div class="fw-bold small text-white text-truncate">@userDisplayName</div>
                            <div class="text-white-50 small text-truncate" style="font-size: 11px;">@userEmail</div>
                        </div>
                    </div>
                    <div>
                        @if (roleName == "Admin")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small fw-semibold">
                                <i class="bi bi-shield-lock-fill me-1"></i> System Administrator
                            </span>
                        }
                        else if (roleName == "Instructor")
                        {
                            <span class="badge bg-info-subtle text-cyan border border-info-subtle rounded-pill px-2 py-1 small fw-semibold">
                                <i class="bi bi-mortarboard-fill me-1"></i> Verified Instructor
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary-subtle text-cyan border border-primary-subtle rounded-pill px-2 py-1 small fw-semibold">
                                <i class="bi bi-person-check-fill me-1"></i> Enrolled Student
                            </span>
                        }
                    </div>
                </li>
                <li><a class="dropdown-item py-2" href="@Url.Action("Profile", "Account")"><i class="bi bi-person-gear me-2 text-primary"></i> Account Profile</a></li>
                <li><a class="dropdown-item py-2" href="@Url.Action("ChangePassword", "Account")"><i class="bi bi-shield-key me-2 text-warning"></i> Change Password</a></li>

                @if (roleName == "Student")
                {
                    <li><a class="dropdown-item py-2" href="@Url.Action("Certificates", "Student")"><i class="bi bi-award me-2 text-success"></i> My Certificates</a></li>
                }
                else if (roleName == "Instructor")
                {
                    <li><a class="dropdown-item py-2" href="@Url.Action("Index", "Instructor")"><i class="bi bi-speedometer2 me-2 text-info"></i> Instructor Studio</a></li>
                    <li><a class="dropdown-item py-2" href="@Url.Action("Payments", "Instructor")"><i class="bi bi-cash-coin me-2 text-success"></i> Course Earnings</a></li>
                }
                else if (roleName == "Admin")
                {
                    <li><a class="dropdown-item py-2" href="@Url.Action("Index", "Admin")"><i class="bi bi-speedometer2 me-2 text-danger"></i> Admin Console</a></li>
                    <li><a class="dropdown-item py-2" href="@Url.Action("Payments", "Admin")"><i class="bi bi-credit-card me-2 text-success"></i> Payment Ledger</a></li>
                }

                <li><hr class="dropdown-divider my-1"></li>
                <li>
                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "m-0 p-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item py-2 text-danger fw-semibold border-0 bg-transparent w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                        </button>
                    }
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav align-items-center gap-2 mb-0 ms-lg-auto">
        <li class="nav-item">
            <a class="nav-search-btn me-1" href="@Url.Action("Index", "Courses")" title="Search Courses" aria-label="Search Catalog">
                <i class="bi bi-search fs-6"></i>
            </a>
        </li>
        <li class="nav-item">
            <a class="btn-nav-login" href="@Url.Action("Login", "Account")">
                Log in
            </a>
        </li>
        <li class="nav-item">
            <a class="btn-nav-register" href="@Url.Action("Register", "Account")">
                Register Free
            </a>
        </li>
    </ul>
}
