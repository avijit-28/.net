@model IEnumerable<LMS.Models.Module>
@{
    var course = ViewBag.Course as LMS.Models.Course;
    ViewBag.Title = "Modules - " + (course?.Title ?? "Course");
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")">Course Studio</a></li>
                    <li class="breadcrumb-item active">Curriculum Modules</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0">Modules: @(course?.Title ?? "Course")</h3>
            <p class="text-muted small">Structure your syllabus into sequential chapters and modules</p>
        </div>
        <div>
            <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addModuleModal">
                <i class="bi bi-plus-circle me-1"></i> Add Module
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm">
            <i class="bi bi-diagram-3 fs-1 text-muted mb-3"></i>
            <h5 class="fw-bold">No modules created yet.</h5>
            <p class="text-muted small mb-3">Organize your course content by creating your first module below.</p>
            <div>
                <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addModuleModal">
                    Add Module
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var mod in Model)
            {
                <div class="col-12">
                    <div class="card card-custom p-4 shadow-sm">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-secondary-subtle text-secondary small mb-1">Order #@mod.ModuleOrder</span>
                                <h5 class="fw-bold text-dark mb-1">@mod.ModuleName</h5>
                                <p class="small text-muted mb-2">@(string.IsNullOrEmpty(mod.Description) ? "No description provided." : mod.Description)</p>
                                <span class="badge bg-primary-subtle text-primary small">
                                    <i class="bi bi-collection-play me-1"></i> @mod.Lessons.Count Lessons Included
                                </span>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("Lessons", "Instructor", new { moduleId = mod.ModuleId })" class="btn btn-sm btn-primary rounded-pill px-3">
                                    <i class="bi bi-folder2-open me-1"></i> Manage Lessons
                                </a>
                                @using (Html.BeginForm("DeleteModule", "Instructor", new { id = mod.ModuleId }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" onclick="return confirm('Delete this module and all its lessons?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add Module Modal -->
<div class="modal fade" id="addModuleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add Course Module</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("CreateModule", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="CourseId" value="@(course?.CourseId ?? 0)" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Module Name</label>
                        <input type="text" name="ModuleName" class="form-control" placeholder="e.g. Module 1: Introduction to Architecture" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Outline topics covered in this module..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sequence Order</label>
                        <input type="number" name="ModuleOrder" class="form-control" value="@(Model.Count() + 1)" min="1" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Save Module</button>
                </div>
            }
        </div>
    </div>
</div>
