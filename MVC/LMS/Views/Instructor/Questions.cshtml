@model IEnumerable<LMS.Models.Question>
@{
    var quiz = ViewBag.Quiz as LMS.Models.Quiz;
    ViewBag.Title = "Questions - " + (quiz?.Title ?? "Quiz");
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")" class="text-decoration-none">My Courses</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Quizzes", "Instructor", new { courseId = quiz?.CourseId })" class="text-decoration-none">Quizzes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Question Bank</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-patch-question-fill text-warning me-1"></i> Question Bank
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Question Bank: @(quiz?.Title ?? "Quiz")</h2>
            <p class="text-muted small mb-0">Total Score: <strong>@quiz.TotalMarks Marks</strong> &bull; Passing Standard: <strong>@quiz.PassingPercentage%</strong></p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Quizzes", "Instructor", new { courseId = quiz?.CourseId })" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Quizzes
            </a>
            <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addQuestionModal">
                <i class="bi bi-plus-circle me-1"></i> Add Question
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white border-0">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-patch-question text-muted display-4"></i>
            </div>
            <h4 class="fw-bold">No questions added to this quiz yet</h4>
            <p class="text-muted small mb-3">Add multiple-choice assessment questions and designate the correct answer key.</p>
            <div>
                <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addQuestionModal">
                    <i class="bi bi-plus-circle me-1"></i> Add First Question
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @for (int i = 0; i < Model.Count(); i++)
            {
                var q = Model.ElementAt(i);
                <div class="col-12">
                    <div class="card card-custom p-4 shadow-sm bg-white border-0 card-hover">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-primary rounded-pill px-3 py-2 small fw-bold">
                                Question @(i + 1) of @Model.Count()
                            </span>
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-1 font-monospace">@q.Marks Marks</span>
                        </div>

                        <h5 class="fw-bold text-dark mb-3" style="line-height: 1.5;">@q.QuestionText</h5>

                        <div class="row g-2">
                            @foreach (var opt in q.Options.OrderBy(o => o.OptionOrder))
                            {
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 border @(opt.IsCorrect ? "bg-success-subtle border-success text-success fw-bold" : "bg-light text-dark")">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span>@opt.OptionText</span>
                                            @if (opt.IsCorrect)
                                            {
                                                <span class="badge bg-success rounded-pill px-2 py-1 small"><i class="bi bi-check-circle-fill me-1"></i>Correct Key</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add Question Modal -->
<div class="modal fade" id="addQuestionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-plus-circle me-2 text-primary"></i>Add Question with 4 Multiple-Choice Options</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("CreateQuestion", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="quizId" value="@(quiz?.QuizId ?? 0)" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Question Prompt</label>
                        <textarea name="questionText" class="form-control" rows="3" placeholder="e.g. Which of the following data structures provides O(1) average time complexity for key-based lookups?" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Allocated Marks</label>
                        <input type="number" name="marks" class="form-control" value="1" min="1" required style="max-width: 150px;" />
                    </div>

                    <label class="form-label fw-bold small text-dark mb-2">Answer Choices:</label>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Option A</label>
                            <input type="text" name="opt1" class="form-control" placeholder="Choice 1" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Option B</label>
                            <input type="text" name="opt2" class="form-control" placeholder="Choice 2" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Option C</label>
                            <input type="text" name="opt3" class="form-control" placeholder="Choice 3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Option D</label>
                            <input type="text" name="opt4" class="form-control" placeholder="Choice 4" required />
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border">
                        <label class="form-label fw-bold small text-success mb-1"><i class="bi bi-check-circle-fill me-1"></i>Select Correct Answer Key:</label>
                        <select name="correctOption" class="form-select border-success fw-bold">
                            <option value="1">Option A is the Correct Answer</option>
                            <option value="2">Option B is the Correct Answer</option>
                            <option value="3">Option C is the Correct Answer</option>
                            <option value="4">Option D is the Correct Answer</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Save Question</button>
                </div>
            }
        </div>
    </div>
</div>
