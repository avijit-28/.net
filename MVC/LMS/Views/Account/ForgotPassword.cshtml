@model LMS.ViewModels.PasswordRecoveryFlowViewModel
@{
    ViewBag.Title = "Password Recovery Portal";
    string activeTab = Model?.ActiveTab ?? "request";
    bool isApproved = Model != null && (Model.IsApproved || Model.Status == "Approved");
    bool isPending = Model != null && Model.Status == "Pending" && !Model.IsApproved;
    bool isRejected = Model != null && Model.Status == "Rejected";
    bool isCompleted = Model != null && Model.Status == "Completed";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6">
        <div class="card card-custom p-4 p-md-5 shadow-lg border-0" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25) !important; border-radius: 20px; backdrop-filter: blur(16px); color: #FFFFFF;">
            
            <!-- Header Icon & Title -->
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 shadow-sm" style="background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.3);">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </div>
                <h3 class="fw-extrabold text-white tracking-tight mb-1">Password Recovery Portal</h3>
                <p class="small mb-0" style="color: #94A3B8;">
                    Submit a recovery request for administrator review, check your approval status, and set your new password.
                </p>
            </div>

            <!-- Global Feedback Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert" style="background: rgba(53, 201, 138, 0.2); color: #35C98A; border-left: 4px solid #35C98A !important;">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert" style="background: rgba(239, 68, 68, 0.2); color: #EF4444; border-left: 4px solid #EF4444 !important;">
                    <i class="bi bi-x-circle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small border-0 border-start border-4 border-danger mb-4", style = "background: rgba(239, 68, 68, 0.15); color: #EF4444;" })

            <!-- Mode Tabs -->
            <ul class="nav nav-pills nav-fill mb-4 p-1 rounded-pill" style="background: rgba(4, 24, 34, 0.9); border: 1px solid rgba(255, 255, 255, 0.1);">
                <li class="nav-item">
                    <button type="button" class="nav-link rounded-pill py-2 fw-semibold @(activeTab == "request" ? "active text-white" : "text-white-50")" id="tab-request-btn" onclick="switchRecoveryTab('request')" style="@(activeTab == "request" ? "background-color: #FF7A18 !important;" : "")">
                        <i class="bi bi-send me-1"></i> 1. Submit Request
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link rounded-pill py-2 fw-semibold @(activeTab == "status" ? "active text-white" : "text-white-50")" id="tab-status-btn" onclick="switchRecoveryTab('status')" style="@(activeTab == "status" ? "background-color: #27B8D6 !important;" : "")">
                        <i class="bi bi-patch-check me-1"></i> 2. Check Status & Reset
                    </button>
                </li>
            </ul>

            <!-- TAB 1: SUBMIT RECOVERY REQUEST -->
            <div id="section-request" style="display: @(activeTab == "request" ? "block" : "none");">
                @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form", id = "recoveryRequestForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ActiveTab" value="request" />

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-white">Registered Email Address <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-envelope"></i></span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "e.g. instructor@lms.com or student@lms.com", required = "required", id = "submitEmailInput", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-white">Reason / Verification Details for Administrator</label>
                        @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = 3, placeholder = "Explain your password issue or identity confirmation details (e.g. course taught, full name, phone)...", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                        <div class="form-text small" style="color: #94A3B8;">Providing your name or course context helps the administrator verify and approve your request faster.</div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary py-2 rounded-pill fw-bold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                            <i class="bi bi-send-fill me-1"></i> Submit Recovery Request
                        </button>
                        <button type="button" class="btn btn-outline-cyan py-2 rounded-pill fw-semibold" style="border-color: #27B8D6; color: #27B8D6;" onclick="switchRecoveryTab('status')">
                            <i class="bi bi-clock-history me-1"></i> Already Requested? Check Status
                        </button>
                    </div>
                }
            </div>

            <!-- TAB 2: CHECK STATUS & SET NEW PASSWORD -->
            <div id="section-status" style="display: @(activeTab == "status" ? "block" : "none");">
                
                <!-- Email Status Lookup Input Form -->
                <div class="mb-4 p-3 rounded-4" style="background: rgba(4, 24, 34, 0.7); border: 1px solid rgba(255, 255, 255, 0.1);">
                    <label class="form-label fw-bold small text-white">Enter Your Registered Email to Check Status</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-search"></i></span>
                        <input type="email" id="lookupEmailInput" class="form-control" placeholder="Enter your email address..." value="@Model.Email" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" />
                        <button type="button" class="btn fw-bold px-3" id="btnCheckStatus" onclick="performStatusLookup()" style="background: #27B8D6; color: #041822;">
                            <i class="bi bi-arrow-repeat me-1" id="lookupSpinner"></i> Check Status
                        </button>
                    </div>
                    <div id="lookupFeedback" class="small mt-2" style="display: none;"></div>
                </div>

                <!-- Dynamic Status Outcome Container -->
                <div id="statusOutcomeContainer">
                    @if (Model != null && !string.IsNullOrEmpty(Model.Email) && !string.IsNullOrEmpty(Model.Status))
                    {
                        if (isApproved)
                        {
                            <!-- APPROVED CARD + PASSWORD RESET FORM -->
                            <div class="p-3 mb-4 rounded-4" style="background: rgba(53, 201, 138, 0.15); border: 1px solid rgba(53, 201, 138, 0.35);">
                                <div class="d-flex align-items-center gap-2 mb-2 text-success">
                                    <i class="bi bi-check-circle-fill fs-5"></i>
                                    <span class="fw-bold fs-6">Request Approved by Administrator!</span>
                                </div>
                                <p class="small text-white-50 mb-1">
                                    Your password reset request for <strong class="text-white">@Model.Email</strong> was approved by the administration.
                                </p>
                                @if (Model.RequestDate.HasValue)
                                {
                                    <div class="small text-muted mb-0">Requested: @Model.RequestDate.Value.ToString("MMM dd, yyyy hh:mm tt") UTC</div>
                                }
                            </div>

                            <!-- SET NEW PASSWORD FORM -->
                            using (Html.BeginForm("SetNewPassword", "Account", FormMethod.Post, new { role = "form", id = "setNewPasswordForm" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.Email, new { id = "approvedEmailHidden" })
                                @Html.HiddenFor(m => m.ResetToken)

                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-white">New Password <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-key"></i></span>
                                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", id = "newPasswordInput", placeholder = "Enter new password (min. 6 characters)", required = "required", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                                        <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('newPasswordInput', this)" style="border-color: rgba(255, 255, 255, 0.15); color: #94A3B8;">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-white">Confirm New Password <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-shield-check"></i></span>
                                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", id = "confirmPasswordInput", placeholder = "Re-enter new password", required = "required", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                                        <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('confirmPasswordInput', this)" style="border-color: rgba(255, 255, 255, 0.15); color: #94A3B8;">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                                </div>

                                <div class="d-grid gap-2 mt-4">
                                    <button type="submit" class="btn py-2 rounded-pill fw-bold text-white shadow-sm" style="background-color: #FF7A18 !important; border: none;">
                                        <i class="bi bi-check2-circle me-1"></i> Save New Password & Log In
                                    </button>
                                </div>
                            }
                        }
                        else if (isPending)
                        {
                            <!-- PENDING APPROVAL CARD -->
                            <div class="p-4 rounded-4 text-center mb-4" style="background: rgba(255, 122, 24, 0.1); border: 1px solid rgba(255, 122, 24, 0.3);">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2" style="background: rgba(255, 122, 24, 0.2); color: #FF7A18;">
                                    <i class="bi bi-hourglass-split fs-3"></i>
                                </div>
                                <h5 class="fw-bold text-white mb-1">Awaiting Administrator Approval</h5>
                                <p class="small text-white-50 mb-2">
                                    Your password recovery request for <span class="text-cyan fw-bold">@Model.Email</span> is currently under administrative verification.
                                </p>
                                <div class="p-2 rounded-3 text-start small mb-3" style="background: rgba(4, 24, 34, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
                                    <div class="text-white-50"><strong class="text-white">Reason logged:</strong> @(string.IsNullOrEmpty(Model.Reason) ? "No reason specified" : Model.Reason)</div>
                                    @if (Model.RequestDate.HasValue)
                                    {
                                        <div class="text-white-50 mt-1"><strong class="text-white">Submitted:</strong> @Model.RequestDate.Value.ToString("MMM dd, yyyy hh:mm tt") UTC</div>
                                    }
                                </div>
                                <div class="badge px-3 py-2 rounded-pill mb-2" style="background: rgba(255, 193, 7, 0.2); color: #FFC107; border: 1px solid rgba(255, 193, 7, 0.4);">
                                    <i class="bi bi-clock-history me-1"></i> Status: Pending Admin Approval
                                </div>
                                <p class="small text-muted mb-0">
                                    Please check back shortly. Once the admin approves your request, the password reset form will activate right here.
                                </p>
                            </div>
                        }
                        else if (isRejected)
                        {
                            <!-- REJECTED CARD -->
                            <div class="p-4 rounded-4 text-center mb-4" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3);">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2" style="background: rgba(239, 68, 68, 0.2); color: #EF4444;">
                                    <i class="bi bi-x-circle fs-3"></i>
                                </div>
                                <h5 class="fw-bold text-danger mb-1">Request Declined</h5>
                                <p class="small text-white-50 mb-2">
                                    Your password recovery request for <span class="text-white fw-bold">@Model.Email</span> was declined by the administrator.
                                </p>
                                @if (!string.IsNullOrEmpty(Model.AdminNotes))
                                {
                                    <div class="p-2 rounded-3 text-start small mb-3" style="background: rgba(4, 24, 34, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
                                        <div class="text-white-50"><strong class="text-white">Admin notes:</strong> @Model.AdminNotes</div>
                                    </div>
                                }
                                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" onclick="switchRecoveryTab('request')">
                                    <i class="bi bi-arrow-repeat me-1"></i> Submit a New Request
                                </button>
                            </div>
                        }
                        else if (isCompleted)
                        {
                            <!-- COMPLETED CARD -->
                            <div class="p-4 rounded-4 text-center mb-4" style="background: rgba(39, 184, 214, 0.12); border: 1px solid rgba(39, 184, 214, 0.3);">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2" style="background: rgba(39, 184, 214, 0.2); color: #27B8D6;">
                                    <i class="bi bi-check2-all fs-3"></i>
                                </div>
                                <h5 class="fw-bold text-white mb-1">Password Already Reset</h5>
                                <p class="small text-white-50 mb-3">
                                    This recovery request has already been completed. You can sign in using your updated password.
                                </p>
                                <a href="@Url.Action("Login", "Account")" class="btn btn-sm text-white rounded-pill px-4" style="background-color: #FF7A18;">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In Now
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center p-4 text-muted small" id="initialStatusPrompt">
                            <i class="bi bi-info-circle fs-3 d-block mb-2 text-cyan"></i>
                            Enter your registered email address above and click <strong>Check Status</strong> to see if your recovery request has been reviewed and approved by the administrator.
                        </div>
                    }
                </div>
            </div>

            <!-- Footer Navigation -->
            <div class="text-center mt-4 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                <a href="@Url.Action("Login", "Account")" class="text-decoration-none small text-white-50 hover-text-white">
                    <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                </a>
            </div>

        </div>
    </div>
</div>

<script>
    function switchRecoveryTab(tab) {
        var reqSec = document.getElementById('section-request');
        var statusSec = document.getElementById('section-status');
        var reqBtn = document.getElementById('tab-request-btn');
        var statusBtn = document.getElementById('tab-status-btn');

        if (tab === 'request') {
            reqSec.style.display = 'block';
            statusSec.style.display = 'none';
            reqBtn.classList.add('active', 'text-white');
            reqBtn.classList.remove('text-white-50');
            reqBtn.style.backgroundColor = '#FF7A18';
            statusBtn.classList.remove('active', 'text-white');
            statusBtn.classList.add('text-white-50');
            statusBtn.style.backgroundColor = 'transparent';
        } else {
            reqSec.style.display = 'none';
            statusSec.style.display = 'block';
            statusBtn.classList.add('active', 'text-white');
            statusBtn.classList.remove('text-white-50');
            statusBtn.style.backgroundColor = '#27B8D6';
            reqBtn.classList.remove('active', 'text-white');
            reqBtn.classList.add('text-white-50');
            reqBtn.style.backgroundColor = 'transparent';

            // Sync email if entered in request tab
            var submitEmail = document.getElementById('submitEmailInput');
            var lookupEmail = document.getElementById('lookupEmailInput');
            if (submitEmail && submitEmail.value && (!lookupEmail.value || lookupEmail.value === '')) {
                lookupEmail.value = submitEmail.value;
            }
        }
    }

    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }

    function performStatusLookup() {
        var emailInput = document.getElementById('lookupEmailInput');
        var feedback = document.getElementById('lookupFeedback');
        var container = document.getElementById('statusOutcomeContainer');
        var spinner = document.getElementById('lookupSpinner');

        if (!emailInput || !emailInput.value.trim()) {
            feedback.style.display = 'block';
            feedback.className = 'small mt-2 text-danger';
            feedback.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> Please enter an email address.';
            emailInput.focus();
            return;
        }

        var email = emailInput.value.trim();
        spinner.className = 'spinner-border spinner-border-sm me-1';
        feedback.style.display = 'none';

        var formData = new FormData();
        formData.append('email', email);

        fetch('@Url.Action("CheckResetStatus", "Account")', {
            method: 'POST',
            body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            spinner.className = 'bi bi-arrow-repeat me-1';
            if (!data.success) {
                feedback.style.display = 'block';
                feedback.className = 'small mt-2 text-danger';
                feedback.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> ' + (data.message || 'Error checking status.');
                return;
            }

            if (!data.found) {
                container.innerHTML = `
                    <div class="p-4 rounded-4 text-center mb-4" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15);">
                        <i class="bi bi-question-circle fs-3 text-white-50 d-block mb-2"></i>
                        <h6 class="text-white fw-bold">No Request Found</h6>
                        <p class="small text-white-50 mb-3">${data.message}</p>
                        <button type="button" class="btn btn-sm text-white rounded-pill px-4" style="background-color: #FF7A18;" onclick="switchRecoveryTab('request')">
                            <i class="bi bi-send me-1"></i> Submit Recovery Request Now
                        </button>
                    </div>
                `;
                return;
            }

            if (data.isApproved || data.status === 'Approved') {
                container.innerHTML = `
                    <div class="p-3 mb-4 rounded-4" style="background: rgba(53, 201, 138, 0.15); border: 1px solid rgba(53, 201, 138, 0.35);">
                        <div class="d-flex align-items-center gap-2 mb-2 text-success">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <span class="fw-bold fs-6">Request Approved by Administrator!</span>
                        </div>
                        <p class="small text-white-50 mb-1">
                            Your password reset request for <strong class="text-white">${data.email}</strong> was verified and approved by the administration.
                        </p>
                        <div class="small text-muted mb-0">Requested: ${data.requestDate}</div>
                    </div>

                    <form action="@Url.Action("SetNewPassword", "Account")" method="post" id="setNewPasswordForm">
                        <input name="__RequestVerificationToken" type="hidden" value="@Html.AntiForgeryToken().ToHtmlString().Split(new string[] { "value=\"" }, StringSplitOptions.None)[1].Split('"')[0]" />
                        <input type="hidden" name="Email" value="${data.email}" />
                        <input type="hidden" name="ResetToken" value="${data.token}" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-white">New Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-key"></i></span>
                                <input type="password" name="NewPassword" id="ajaxNewPassword" class="form-control" placeholder="Enter new password (min. 6 characters)" required style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('ajaxNewPassword', this)" style="border-color: rgba(255, 255, 255, 0.15); color: #94A3B8;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-white">Confirm New Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-shield-check"></i></span>
                                <input type="password" name="ConfirmPassword" id="ajaxConfirmPassword" class="form-control" placeholder="Re-enter new password" required style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('ajaxConfirmPassword', this)" style="border-color: rgba(255, 255, 255, 0.15); color: #94A3B8;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn py-2 rounded-pill fw-bold text-white shadow-sm" style="background-color: #FF7A18 !important; border: none;">
                                <i class="bi bi-check2-circle me-1"></i> Save New Password & Log In
                            </button>
                        </div>
                    </form>
                `;
            } else if (data.status === 'Pending') {
                container.innerHTML = `
                    <div class="p-4 rounded-4 text-center mb-4" style="background: rgba(255, 122, 24, 0.1); border: 1px solid rgba(255, 122, 24, 0.3);">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2" style="background: rgba(255, 122, 24, 0.2); color: #FF7A18;">
                            <i class="bi bi-hourglass-split fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-white mb-1">Awaiting Administrator Approval</h5>
                        <p class="small text-white-50 mb-2">
                            Your password recovery request for <span class="text-cyan fw-bold">${data.email}</span> is currently under administrative verification.
                        </p>
                        <div class="p-2 rounded-3 text-start small mb-3" style="background: rgba(4, 24, 34, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <div class="text-white-50"><strong class="text-white">Reason logged:</strong> ${data.reason}</div>
                            <div class="text-white-50 mt-1"><strong class="text-white">Submitted:</strong> ${data.requestDate}</div>
                        </div>
                        <div class="badge px-3 py-2 rounded-pill mb-2" style="background: rgba(255, 193, 7, 0.2); color: #FFC107; border: 1px solid rgba(255, 193, 7, 0.4);">
                            <i class="bi bi-clock-history me-1"></i> Status: Pending Admin Approval
                        </div>
                        <p class="small text-muted mb-0">
                            Please check back shortly. Once the admin approves your request, the password reset form will activate right here.
                        </p>
                    </div>
                `;
            } else if (data.status === 'Rejected') {
                container.innerHTML = `
                    <div class="p-4 rounded-4 text-center mb-4" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3);">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2" style="background: rgba(239, 68, 68, 0.2); color: #EF4444;">
                            <i class="bi bi-x-circle fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-danger mb-1">Request Declined</h5>
                        <p class="small text-white-50 mb-2">
                            Your password recovery request for <span class="text-white fw-bold">${data.email}</span> was declined by the administrator.
                        </p>
                        ${data.adminNotes ? `<div class="p-2 rounded-3 text-start small mb-3" style="background: rgba(4, 24, 34, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);"><div class="text-white-50"><strong class="text-white">Admin notes:</strong> ${data.adminNotes}</div></div>` : ''}
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" onclick="switchRecoveryTab('request')">
                            <i class="bi bi-arrow-repeat me-1"></i> Submit a New Request
                        </button>
                    </div>
                `;
            } else if (data.status === 'Completed') {
                container.innerHTML = `
                    <div class="p-4 rounded-4 text-center mb-4" style="background: rgba(39, 184, 214, 0.12); border: 1px solid rgba(39, 184, 214, 0.3);">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2" style="background: rgba(39, 184, 214, 0.2); color: #27B8D6;">
                            <i class="bi bi-check2-all fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-white mb-1">Password Already Reset</h5>
                        <p class="small text-white-50 mb-3">
                            This recovery request has already been completed. You can sign in using your updated password.
                        </p>
                        <a href="@Url.Action("Login", "Account")" class="btn btn-sm text-white rounded-pill px-4" style="background-color: #FF7A18;">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In Now
                        </a>
                    </div>
                `;
            }
        })
        .catch(function(err) {
            spinner.className = 'bi bi-arrow-repeat me-1';
            feedback.style.display = 'block';
            feedback.className = 'small mt-2 text-danger';
            feedback.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> Network error checking status. Please try again.';
        });
    }
</script>
