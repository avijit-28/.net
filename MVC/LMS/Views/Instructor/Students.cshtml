@model IEnumerable<LMS.Models.Enrollment>
@{
    var course = (LMS.Models.Course)ViewBag.Course;
    ViewBag.Title = "Enrolled Students - " + course.Title;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")">My Courses</a></li>
            <li class="breadcrumb-item active" aria-current="page">Enrolled Students: @course.Title</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-people-fill me-2 text-primary"></i>Enrolled Students</h2>
            <p class="text-muted mb-0">Roster and progress tracking for <strong>@course.Title</strong></p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 p-2">
                Total Enrolled: @Model.Count()
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-person-x text-muted display-4"></i>
                <h4 class="mt-3 fw-bold">No students currently enrolled</h4>
                <p class="text-muted">Once learners enroll in your course, their learning progress and activity will appear here.</p>
                <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary mt-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to Courses
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student ID</th>
                            <th>Enrolled Date</th>
                            <th>Progress</th>
                            <th>Status</th>
                            <th>Completed Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-light text-primary rounded-circle p-2 me-2">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div class="fw-semibold font-monospace small">@item.StudentId</div>
                                    </div>
                                </td>
                                <td>@item.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                                <td style="width: 250px;">
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @item.ProgressPercentage%;" aria-valuenow="@item.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="small fw-bold">@item.ProgressPercentage%</span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">In Progress</span>
                                    }
                                </td>
                                <td>
                                    @(item.CompletedDate.HasValue ? item.CompletedDate.Value.ToString("MMM dd, yyyy") : "--")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
