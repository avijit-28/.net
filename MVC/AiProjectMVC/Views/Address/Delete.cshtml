@model AiProjectMVC.Models.Address

@{
    ViewBag.Title = "Delete Address";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <!-- Back Breadcrumb Link -->
        <div class="mb-3">
            <a href="@Url.Action("Index")" class="text-decoration-none text-muted small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Address Directory
            </a>
        </div>

        <div class="custom-card border-danger border-opacity-25">
            <!-- Warning Header -->
            <div class="p-4 bg-danger bg-opacity-10 border-bottom border-danger border-opacity-10 text-center">
                <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                </div>
                <h4 class="fw-bold text-danger mb-1">Delete Address Record?</h4>
                <p class="text-muted small mb-0">This will remove Address #@Model.AddressId from the database.</p>
            </div>

            <!-- Address Info Summary -->
            <div class="custom-card-body">
                <div class="alert alert-warning border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-info-circle-fill text-warning fs-5"></i>
                    <div class="small">Ensure no critical employee records are relying on this address before deleting.</div>
                </div>

                <div class="list-group list-group-flush border rounded-3 mb-4">
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Address ID</span>
                        <span class="fw-bold">#@Model.AddressId</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">City</span>
                        <span class="fw-bold">@Model.City</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">State</span>
                        <span class="fw-semibold">@Model.State</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Country</span>
                        <span class="badge bg-light text-dark border">@Model.Country</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">PIN Code</span>
                        <span class="fw-bold font-monospace">@Model.Pin</span>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg"></i> Cancel & Keep
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill"></i> Permanently Delete
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
