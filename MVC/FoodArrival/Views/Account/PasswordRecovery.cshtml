@model FoodArrival.Models.PasswordRecoveryViewModel
@{
    ViewBag.Title = "Password Recovery & Reset - FoodReady";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string activeTab = Model?.ActiveTab ?? "submit";
    var req = Model?.CurrentRequest;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <!-- Header Card -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle p-3 mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-shield-lock-fill fs-1 text-primary"></i>
                </div>
                <h2 class="fw-bold text-dark">Password Recovery</h2>
                <p class="text-muted">Request administrator approval to securely reset or recover your FoodReady account password.</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <!-- Nav Tabs -->
                <div class="card-header bg-white border-bottom p-0">
                    <ul class="nav nav-tabs nav-fill border-0" id="recoveryTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link py-3 fw-semibold border-0 rounded-0 @(activeTab == "submit" ? "active border-bottom border-primary border-3 text-primary" : "text-muted")" 
                               href="@Url.Action("PasswordRecovery", "Account", new { tab = "submit", email = Model?.Email })">
                                <i class="bi bi-send-fill me-2"></i> 1. Send Recovery Request
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link py-3 fw-semibold border-0 rounded-0 @(activeTab == "check" ? "active border-bottom border-primary border-3 text-primary" : "text-muted")" 
                               href="@Url.Action("PasswordRecovery", "Account", new { tab = "check", email = Model?.Email })">
                                <i class="bi bi-search me-2"></i> 2. Check Status & Reset
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (activeTab == "submit")
                    {
                        <!-- TAB 1: SUBMIT RECOVERY REQUEST -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-1"><i class="bi bi-envelope-paper-fill text-primary me-2"></i>Submit Password Reset Request</h5>
                            <p class="text-muted small">Enter your registered account email and provide a brief reason. The admin will verify your identity and approve the reset.</p>
                        </div>

                        using (Html.BeginForm("SubmitPasswordRecovery", "Account", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3" })

                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark">Your Registered Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0 py-2", placeholder = "e.g. user@example.com", required = "required", type = "email" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                                <div class="form-text small text-muted">Works for all account roles (Customer, Restaurant, Kitchen Staff, Rider, Admin).</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark">Reason for Password Reset / Recovery <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 align-items-start pt-2"><i class="bi bi-chat-left-dots text-muted"></i></span>
                                    @Html.TextAreaFor(m => m.Reason, new { @class = "form-control border-start-0", rows = "3", placeholder = "e.g., Forgot password and unable to access old email; Requesting administrative password reset.", required = "required" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                            </div>

                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold py-3 shadow-sm">
                                    <i class="bi bi-send-check-fill me-2"></i> Send Request to Admin
                                </button>
                            </div>
                        }

                        <div class="p-3 bg-light rounded-3 text-muted small border">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>
                            <strong>Already submitted a request?</strong> Click the <a href="@Url.Action("PasswordRecovery", "Account", new { tab = "check" })" class="fw-semibold text-decoration-none">"Check Status & Reset"</a> tab to verify if the admin has approved it.
                        </div>
                    }
                    else
                    {
                        <!-- TAB 2: CHECK STATUS & RESET PASSWORD -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-1"><i class="bi bi-search text-primary me-2"></i>Check Request Status</h5>
                            <p class="text-muted small">Enter your email address to check if your password reset request has been approved by the admin.</p>
                        </div>

                        using (Html.BeginForm("CheckPasswordStatus", "Account", FormMethod.Post, new { @class = "mb-4" }))
                        {
                            @Html.AntiForgeryToken()
                            <div class="input-group mb-2">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input type="email" name="email" class="form-control border-start-0 py-2" placeholder="Enter your registered email..." value="@Model.Email" required />
                                <button type="submit" class="btn btn-dark px-4 fw-bold">
                                    <i class="bi bi-arrow-right-circle me-1"></i> Check Status
                                </button>
                            </div>
                        }

                        if (!string.IsNullOrEmpty(Model.StatusMessage))
                        {
                            if (req != null && req.Status == "Approved")
                            {
                                <div class="alert alert-success rounded-4 p-4 shadow-sm mb-4 border-success">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                                        <div>
                                            <h5 class="fw-bold text-success mb-0">Request Approved!</h5>
                                            <div class="small text-muted">Approved by Administrator on @(req.ApprovedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Recently")</div>
                                        </div>
                                    </div>
                                    <p class="mb-0 text-dark">The admin has verified your account. <strong>Enter and confirm your new password below</strong> to complete your password update.</p>
                                </div>

                                <!-- RESET PASSWORD INPUTS -->
                                <div class="card border rounded-3 p-4 bg-light mb-3">
                                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-key-fill text-primary me-2"></i>Set New Password for @Model.Email</h6>

                                    using (Html.BeginForm("ResetPasswordConfirm", "Account", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.Email)

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold text-dark">New Password <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control border-start-0 border-end-0 bg-white", id = "newPwdInput", placeholder = "Min 8 chars, alphanumeric + symbol", required = "required" })
                                                <button class="btn btn-outline-secondary bg-white border-start-0" type="button" onclick="togglePasswordVisibility('newPwdInput', this)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-semibold text-dark">Confirm New Password <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock-fill text-muted"></i></span>
                                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control border-start-0 border-end-0 bg-white", id = "confirmPwdInput", placeholder = "Re-enter new password", required = "required" })
                                                <button class="btn btn-outline-secondary bg-white border-start-0" type="button" onclick="togglePasswordVisibility('confirmPwdInput', this)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                                        </div>

                                        <div class="small text-muted mb-4 p-2 bg-white rounded border">
                                            <i class="bi bi-shield-check text-success me-1"></i>
                                            Must be at least <strong>8 characters</strong>, include letters, numbers, and at least one symbol (@@$!%*#?&).
                                        </div>

                                        <button type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-bold py-3 shadow-sm">
                                            <i class="bi bi-check2-circle me-2"></i> Save New Password & Proceed to Login
                                        </button>
                                    }
                                </div>
                            }
                            else if (req != null && req.Status == "Pending")
                            {
                                <div class="alert alert-warning rounded-4 p-4 shadow-sm border-warning">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="spinner-border text-warning spinner-border-sm me-3" role="status"></div>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-0">Pending Administrator Approval</h5>
                                            <div class="small text-muted">Request #@req.RequestId submitted on @req.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                                        </div>
                                    </div>
                                    <p class="mb-2 text-dark">The admin is yet to approve the request. Please check back shortly.</p>
                                    <div class="small bg-white bg-opacity-75 p-2 rounded border border-warning text-muted">
                                        <strong>Your Submitted Reason:</strong> "@req.Reason"
                                    </div>
                                </div>
                            }
                            else if (req != null && req.Status == "Rejected")
                            {
                                <div class="alert alert-danger rounded-4 p-4 shadow-sm border-danger">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-x-circle-fill text-danger fs-3 me-3"></i>
                                        <div>
                                            <h5 class="fw-bold text-danger mb-0">Request Rejected</h5>
                                            <div class="small text-muted">Status: Rejected by Admin</div>
                                        </div>
                                    </div>
                                    <p class="mb-2 text-dark">Your password recovery request could not be approved.</p>
                                    @if (!string.IsNullOrEmpty(req.AdminNotes))
                                    {
                                        <div class="small bg-white p-2 rounded border border-danger text-muted">
                                            <strong>Admin Note:</strong> @req.AdminNotes
                                        </div>
                                    }
                                    <div class="mt-3">
                                        <a href="@Url.Action("PasswordRecovery", "Account", new { tab = "submit", email = Model.Email })" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-arrow-repeat me-1"></i> Submit New Request
                                        </a>
                                    </div>
                                </div>
                            }
                            else if (req != null && req.Status == "Completed")
                            {
                                <div class="alert alert-info rounded-4 p-4 shadow-sm border-info">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-0">Password Reset Completed</h5>
                                            <div class="small text-muted">Reset completed on @(req.CompletedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Recently")</div>
                                        </div>
                                    </div>
                                    <p class="mb-3 text-dark">Password has already been reset for this request. Please login with your new password.</p>
                                    <a href="@Url.Action("Login", "Account")" class="btn btn-primary fw-bold px-4">
                                        <i class="bi bi-box-arrow-in-right me-2"></i> Go to Login
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary rounded-4 p-3 shadow-sm">
                                    <i class="bi bi-info-circle me-2"></i> @Model.StatusMessage
                                </div>
                            }
                        }
                    }
                </div>

                <div class="card-footer bg-light p-3 text-center border-top">
                    <span class="text-muted small">Remembered your password?</span>
                    <a href="@Url.Action("Login", "Account")" class="fw-bold text-primary text-decoration-none ms-1">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }
</script>
