@model FoodArrival.Models.DeliveryDashboardViewModel
@{
    ViewBag.Title = "Deliveries";
}
<p class="eyebrow mb-1">On the road</p><h1 class="section-heading mb-4">Your deliveries</h1>
<div class="mb-3"><a class="btn btn-sm @(Model.IncludeCompleted ? "btn-outline-dark" : "btn-dark")" href="@Url.Action("Index")">Active</a> <a class="btn btn-sm @(Model.IncludeCompleted ? "btn-dark" : "btn-outline-dark")" href="@Url.Action("Index", new { includeCompleted = true })">Include completed</a></div>
@if (!Model.Assignments.Any()) { <div class="empty-state"><h2 class="h5">All caught up</h2><p class="text-muted mb-0">New delivery assignments will appear here.</p></div> }
@foreach (var item in Model.Assignments)
{
    <article class="surface-card p-4 mb-3"><div class="d-flex justify-content-between"><div><p class="eyebrow mb-1">@item.OrderNumber</p><h2 class="h5 fw-bold">@item.RestaurantName</h2></div><span class="status-pill">@item.Status</span></div>
        <div class="row g-3 mt-1"><div class="col-md-6"><h3 class="h6 fw-bold">Pickup</h3><p>@item.PickupAddress</p></div><div class="col-md-6"><h3 class="h6 fw-bold">Drop-off</h3><p class="mb-1">@item.Recipient · @item.Phone</p><p>@item.DeliveryAddress, @item.City @item.PostalCode</p></div></div>
        <div class="d-flex gap-2">
            @if (item.Status == "Assigned" || item.Status == "PickedUp")
            {
                using (Html.BeginForm("Status", "Delivery", FormMethod.Post, new { @class = "d-flex gap-2" })) { @Html.AntiForgeryToken() @Html.Hidden("orderId", item.OrderId) @if (item.Status == "Assigned") { <button name="status" value="PickedUp" class="btn btn-dark btn-sm">Picked up</button> } else { <button name="status" value="Delivered" class="btn btn-success btn-sm">Delivered</button> } <button name="status" value="Failed" class="btn btn-outline-danger btn-sm">Report issue</button> }
            }
        </div>
    </article>
}
