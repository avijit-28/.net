@model IEnumerable<LMS.Models.Payment>
@{
    ViewBag.Title = "Transaction Log";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-2">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Payments & Financials</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">Financial Ledger</span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Financial Transactions Log</h2>
            <p class="text-muted small mb-0">Record of all paid course purchases, simulated checkouts, and payment audits</p>
        </div>
        <div>
            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill shadow-xs">
                Total Revenue: <span class="rupee-symbol">₹</span>@(Model.Where(p => p.PaymentStatus == "Completed").Sum(p => (decimal?)p.Amount ?? 0).ToString("N2"))
            </span>
        </div>
    </div>

    <div class="card card-custom border-0 shadow-sm overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Payment ID</th>
                        <th>Transaction Ref</th>
                        <th>Student ID</th>
                        <th>Course</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Date & Time</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-credit-card fs-1 d-block mb-2 text-secondary"></i>
                                <h6 class="fw-bold">No financial transactions recorded yet.</h6>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td><span class="fw-bold text-dark">#@p.PaymentId</span></td>
                                <td><code class="small text-dark font-monospace">@(p.TransactionId ?? "TXN-" + p.PaymentId)</code></td>
                                <td><span class="small font-monospace text-secondary">@p.StudentId</span></td>
                                <td>
                                    <div class="fw-semibold text-truncate text-dark" style="max-width: 250px;">
                                        @(p.Course != null ? p.Course.Title : "Course #" + p.CourseId)
                                    </div>
                                </td>
                                <td class="fw-extrabold text-success"><span class="rupee-symbol">₹</span>@p.Amount.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@p.PaymentMethod</span>
                                </td>
                                <td>
                                    @if (p.PaymentStatus == "Completed")
                                    {
                                        <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                    }
                                    else if (p.PaymentStatus == "Failed")
                                    {
                                        <span class="badge bg-danger rounded-pill">Failed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill">Pending</span>
                                    }
                                </td>
                                <td><small class="text-muted">@p.PaymentDate.ToString("MMM dd, yyyy HH:mm")</small></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
