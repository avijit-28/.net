# ==============================================================================
# EduPlatform AIService - Environment Configuration Template
# Copy this file to .env and configure your secrets.
# ==============================================================================

# Primary LLM: Google Gemini API (Free Tier)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# Failover LLM: Groq API (Free Tier)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.1-8b-instant

# Active LLM Provider: "gemini" or "groq"
DEFAULT_LLM_PROVIDER=gemini

# Local Embedding Model (Sentence Transformers - Local, zero cost)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Database (Qdrant)
# If Qdrant Docker is running on port 6333, set QDRANT_URL=http://localhost:6333
# If left empty, AIService automatically uses embedded on-disk Qdrant storage.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=./qdrant_data
QDRANT_COLLECTION=lms_course_knowledge

# Service-to-Service Security Key (Shared with ASP.NET MVC Web.config)
AISERVICE_INTERNAL_KEY=lms_rag_secret_auth_token_2026_xyz987

# RAG Hyperparameters
TOP_K=5
SIMILARITY_THRESHOLD=0.55
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.2

# Host & Port
HOST=127.0.0.1
PORT=8000
