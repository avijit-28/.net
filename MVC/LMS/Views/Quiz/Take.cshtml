@model LMS.ViewModels.QuizAttemptViewModel
@{
    ViewBag.Title = Model.Quiz.Title;
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <!-- Assessment Header -->
        <div class="card card-custom p-4 shadow-sm mb-4 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                        <i class="bi bi-patch-question-fill me-1"></i> Assessment Test
                    </span>
                    <h3 class="fw-bold mb-1">@Model.Quiz.Title</h3>
                    <p class="text-muted small mb-0">Passing standard: @Model.Quiz.PassingPercentage% • Total Questions: @Model.Questions.Count</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-danger px-3 py-2 rounded-pill fs-6">
                        <i class="bi bi-stopwatch me-1"></i> @(Model.TimeLimitMinutes ?? 30) Min
                    </span>
                </div>
            </div>
        </div>

        <!-- Quiz Questions Form -->
        @using (Html.BeginForm("Submit", "Quiz", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="AttemptId" value="@Model.AttemptId" />

            for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                <div class="card card-custom p-4 shadow-sm mb-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-primary rounded-pill px-3 py-2 fw-bold">
                            Question @(i + 1) of @Model.Questions.Count
                        </span>
                        <span class="small text-muted fw-semibold">@q.Marks Marks</span>
                    </div>

                    <h5 class="fw-bold text-dark mb-4">@q.QuestionText</h5>

                    <input type="hidden" name="Answers[@i].QuestionId" value="@q.QuestionId" />

                    <div class="d-flex flex-column gap-3">
                        @foreach (var opt in q.Options)
                        {
                            <div class="form-check p-3 border rounded-3 bg-light">
                                <input class="form-check-input ms-0 me-3" type="radio"
                                       name="Answers[@i].SelectedOptionId"
                                       id="opt_@(opt.OptionId)"
                                       value="@opt.OptionId" />
                                <label class="form-check-label fw-semibold text-dark w-100" for="opt_@(opt.OptionId)">
                                    @opt.OptionText
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="card card-custom p-4 shadow-sm text-center bg-white mb-5">
                <h6 class="fw-bold mb-2">Review & Submit</h6>
                <p class="text-muted small mb-3">Ensure you have selected an answer for all questions before submitting.</p>
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-warning px-5 py-2 rounded-pill fw-bold shadow-sm" onclick="return confirm('Are you sure you want to finalize and submit your quiz attempt?');">
                        <i class="bi bi-send-check me-1"></i> Finalize and Submit Quiz
                    </button>
                </div>
            </div>
        }
    </div>
</div>
