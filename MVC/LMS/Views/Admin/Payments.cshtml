@model LMS.ViewModels.AdminPaymentsViewModel
@{
    ViewBag.Title = "Payments & Transactions Ledger";
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Payments &amp; Financials</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-shield-check text-primary me-1"></i> Central Audit Ledger
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Platform Payment Transactions</h2>
            <p class="text-muted small mb-0">Comprehensive record of all course sales, purchases made by students and educators across the platform</p>
        </div>
        <div>
            <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-2 rounded-pill shadow-xs">
                Total Platform Revenue: <span class="rupee-symbol">&#8377;</span>@Model.TotalRevenue.ToString("N2")
            </span>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card card-custom p-3 p-md-4 bg-white border-0 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Total Revenue</span>
                    <div class="rounded-circle bg-success-subtle text-success p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-cash-stack fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-extrabold mb-1 text-success tracking-tight">
                    <span class="rupee-symbol">&#8377;</span>@Model.TotalRevenue.ToString("N2")
                </h3>
                <small class="text-muted">@Model.TotalTransactionsCount total transactions</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-custom p-3 p-md-4 bg-white border-0 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Student Purchases</span>
                    <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-extrabold mb-1 text-primary tracking-tight">
                    <span class="rupee-symbol">&#8377;</span>@Model.StudentPurchasesTotal.ToString("N2")
                </h3>
                <small class="text-muted">@Model.StudentPurchasesCount enrollments by students</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-custom p-3 p-md-4 bg-white border-0 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Instructor Purchases</span>
                    <div class="rounded-circle bg-info-subtle text-info p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-person-badge-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-extrabold mb-1 text-info tracking-tight">
                    <span class="rupee-symbol">&#8377;</span>@Model.InstructorPurchasesTotal.ToString("N2")
                </h3>
                <small class="text-muted">@Model.InstructorPurchasesCount cross-course teacher enrollments</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-custom p-3 p-md-4 bg-white border-0 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Average Sale Value</span>
                    <div class="rounded-circle bg-warning-subtle text-warning p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-pie-chart-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-extrabold mb-1 text-dark tracking-tight">
                    <span class="rupee-symbol">&#8377;</span>@(Model.TotalTransactionsCount > 0 ? (Model.TotalRevenue / Model.TotalTransactionsCount).ToString("N2") : "0.00")
                </h3>
                <small class="text-muted">Platform transaction average</small>
            </div>
        </div>
    </div>

    <!-- Filter Buttons / Tabs -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div class="btn-group p-1 bg-light rounded-pill border" role="group">
            <a href="@Url.Action("Payments", "Admin", new { filter = "All" })"
               class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.CurrentFilter == "All" || string.IsNullOrEmpty(Model.CurrentFilter) ? "btn-primary shadow-xs" : "btn-light text-muted border-0")">
                All Purchases (@Model.TotalTransactionsCount)
            </a>
            <a href="@Url.Action("Payments", "Admin", new { filter = "Student" })"
               class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.CurrentFilter == "Student" ? "btn-primary shadow-xs" : "btn-light text-muted border-0")">
                <i class="bi bi-mortarboard me-1"></i> Purchased by Students (@Model.StudentPurchasesCount)
            </a>
            <a href="@Url.Action("Payments", "Admin", new { filter = "Instructor" })"
               class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.CurrentFilter == "Instructor" ? "btn-primary shadow-xs" : "btn-light text-muted border-0")">
                <i class="bi bi-person-badge me-1"></i> Purchased by Instructors (@Model.InstructorPurchasesCount)
            </a>
        </div>

        <div class="small text-muted">
            Displaying @Model.Transactions.Count transaction@(Model.Transactions.Count == 1 ? "" : "s")
        </div>
    </div>

    <!-- Master Transaction Table -->
    <div class="card card-custom border-0 shadow-sm overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Course Title</th>
                        <th>Course Instructor</th>
                        <th>Buyer Name &amp; Email</th>
                        <th>Buyer Role</th>
                        <th>Amount</th>
                        <th>Transaction ID</th>
                        <th>Date &amp; Time</th>
                        <th class="text-end pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Transactions.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="py-4">
                                    <i class="bi bi-credit-card fs-1 d-block mb-2 text-secondary"></i>
                                    <h6 class="fw-bold mb-1">No transactions recorded</h6>
                                    <p class="small text-muted mb-0">
                                        @(Model.CurrentFilter != "All" ? "No purchases found matching the selected role filter." : "Transactions will appear here when courses are purchased on the platform.")
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var txn in Model.Transactions)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-light text-primary p-2 me-2 d-flex align-items-center justify-content-center shadow-xs" style="width: 36px; height: 36px;">
                                            <i class="bi bi-journal-text fs-6"></i>
                                        </div>
                                        <div>
                                            <a href="@Url.Action("Details", "Courses", new { id = txn.CourseId })" class="fw-bold text-dark text-decoration-none" target="_blank">
                                                @txn.CourseTitle
                                            </a>
                                            <div class="text-muted small" style="font-size: 11px;">Course ID: #@txn.CourseId</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">
                                        <i class="bi bi-person-workspace text-secondary me-1"></i>@txn.InstructorName
                                    </div>
                                    <small class="text-muted">@txn.InstructorEmail</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@txn.BuyerName</div>
                                    <small class="text-muted">@txn.BuyerEmail</small>
                                </td>
                                <td>
                                    @if (txn.BuyerRole == "Instructor")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1 small">
                                            <i class="bi bi-person-badge me-1"></i> Instructor Buyer
                                        </span>
                                    }
                                    else if (txn.BuyerRole == "Admin")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small">
                                            <i class="bi bi-shield-lock me-1"></i> Admin Buyer
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
                                            <i class="bi bi-mortarboard me-1"></i> Student Buyer
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-extrabold text-success">
                                        <span class="rupee-symbol">&#8377;</span>@txn.Amount.ToString("N2")
                                    </span>
                                </td>
                                <td>
                                    <code class="small text-dark font-monospace bg-light px-2 py-1 rounded border">@txn.TransactionId</code>
                                </td>
                                <td>
                                    <small class="text-muted">@txn.PaymentDate.ToString("MMM dd, yyyy HH:mm")</small>
                                </td>
                                <td class="text-end pe-4">
                                    @if (txn.PaymentStatus == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Completed
                                        </span>
                                    }
                                    else if (txn.PaymentStatus == "Failed")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Failed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-clock-history me-1"></i> @txn.PaymentStatus
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
