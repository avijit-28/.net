@model LMS.ViewModels.ProfileViewModel
@{
    ViewBag.Title = "Account Profile";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Profile Settings</li>
            </ol>
        </nav>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="position-relative" style="width: 64px; height: 64px;">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePicture))
                    {
                        <img src="@Model.ProfilePicture" id="profileHeaderImg" class="rounded-circle shadow-sm" style="width: 64px; height: 64px; object-fit: cover;" alt="@Model.FullName" onerror="this.style.display='none'; document.getElementById('profileHeaderFallback').style.display='flex';" />
                    }
                    <div id="profileHeaderFallback" class="rounded-circle bg-primary text-white align-items-center justify-content-center fw-bold shadow-sm" style="width: 64px; height: 64px; font-size: 24px; display: @(string.IsNullOrWhiteSpace(Model.ProfilePicture) ? "flex" : "none");">
                        @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                </div>
                <div>
                    <h3 class="fw-extrabold mb-0 tracking-tight">@Model.FullName</h3>
                    <p class="text-muted small mb-0">@Model.Email</p>
                </div>
            </div>
            <div>
                <span class="badge badge-primary-subtle px-3 py-2 rounded-pill fs-6 fw-semibold">
                    Role: @Model.Role
                </span>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card card-custom p-4 p-md-5 shadow-lg border-0 mb-4" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25) !important; border-radius: 20px; backdrop-filter: blur(16px); color: #FFFFFF;">
            <h5 class="fw-bold text-white mb-4"><i class="bi bi-person-gear me-2 text-cyan"></i>Personal Information</h5>

            @using (Html.BeginForm("Profile", "Account", FormMethod.Post, new { enctype = "multipart/form-data", id = "profileForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 mb-4" })
                @Html.HiddenFor(m => m.SignatureData, new { id = "signatureDataInput" })

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FullName, "Full Name", new { @class = "form-label fw-bold small text-white" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Email, "Registered Email Address", new { @class = "form-label fw-bold small text-white" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly", disabled = "disabled", style = "background: rgba(4, 24, 34, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); color: #94A3B8;" })
                        <small style="color: #94A3B8; font-size: 11px;">Primary identity email address cannot be changed.</small>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PhoneNumber, "Phone Number", new { @class = "form-label fw-bold small text-white" })
                        <div class="input-group">
                            <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-telephone"></i></span>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+1 (555) 000-0000", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ProfilePicture, "Profile Avatar Image Address (URL)", new { @class = "form-label fw-bold small text-white" })
                        <div class="input-group">
                            <span class="input-group-text" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;"><i class="bi bi-image"></i></span>
                            @Html.TextBoxFor(m => m.ProfilePicture, new { @class = "form-control", id = "inputProfilePicture", placeholder = "https://images.unsplash.com/... or image link", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                        </div>
                        <small style="color: #94A3B8; font-size: 11px;">Paste any direct image URL. It will automatically show as your avatar across the platform.</small>
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.Bio, "Professional Biography / Study Interests", new { @class = "form-label fw-bold small text-white" })
                        @Html.TextAreaFor(m => m.Bio, new { @class = "form-control", rows = 3, placeholder = "Share your background, technical focus areas, and learning ambitions...", style = "background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" })
                    </div>

                    <!-- Instructor & Lead Author Official Signature Studio -->
                    <div class="col-12 mt-4 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.12) !important;">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <h6 class="fw-bold text-white mb-1">
                                    <i class="bi bi-pen-fill text-orange me-2"></i>Official Instructor &amp; Author Signature
                                </h6>
                                <p class="small mb-0" style="color: #94A3B8;">
                                    Your verified signature is dynamically embedded on certificates awarded to learners completing your courses.
                                </p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.SignaturePath))
                            {
                                <span class="badge rounded-pill px-3 py-2 small fw-semibold" style="background: rgba(53, 201, 138, 0.15); color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.3);">
                                    <i class="bi bi-check-circle-fill me-1"></i> Signature Active
                                </span>
                            }
                        </div>

                        <!-- Current Signature Preview Card if available -->
                        @if (!string.IsNullOrWhiteSpace(Model.SignaturePath))
                        {
                            <div class="p-3 rounded-3 mb-3 d-flex align-items-center justify-content-between" style="background: rgba(4, 24, 34, 0.7); border: 1px solid rgba(39, 184, 214, 0.2);">
                                <div>
                                    <small class="text-uppercase fw-bold d-block mb-1" style="color: #27B8D6; font-size: 10px;">Current Stored Signature</small>
                                    <div class="p-2 rounded-2 bg-white d-inline-block" style="min-width: 180px; text-align: center;">
                                        <img src="@Model.SignaturePath" alt="Official Signature" style="max-height: 48px; max-width: 220px; object-fit: contain;" />
                                    </div>
                                </div>
                                <span class="small" style="color: #94A3B8;"><i class="bi bi-shield-check text-cyan me-1"></i> Affixed to student certificates</span>
                            </div>
                        }

                        <!-- Interactive Signature Pad & Upload Tabs -->
                        <div class="p-3 rounded-3" style="background: rgba(11, 52, 69, 0.4); border: 1px solid rgba(255, 255, 255, 0.1);">
                            <ul class="nav nav-pills mb-3 gap-2" id="signatureTab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active rounded-pill px-3 py-1 small fw-bold" id="draw-tab" data-bs-toggle="pill" data-bs-target="#draw-panel" type="button" role="tab">
                                        <i class="bi bi-pencil-square me-1"></i> Draw Signature Pad
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link rounded-pill px-3 py-1 small fw-bold" id="upload-tab" data-bs-toggle="pill" data-bs-target="#upload-panel" type="button" role="tab">
                                        <i class="bi bi-cloud-arrow-up me-1"></i> Upload Signature Image
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content" id="signatureTabContent">
                                <!-- Draw Tab -->
                                <div class="tab-pane fade show active" id="draw-panel" role="tabpanel">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <small style="color: #94A3B8;">Sign smoothly in the box below using your mouse, trackpad, or touch stylus:</small>
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" id="btnClearSignature">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Pad
                                            </button>
                                        </div>
                                    </div>
                                    <div class="position-relative rounded-3 overflow-hidden bg-white shadow-sm" style="height: 150px; border: 2px dashed rgba(39, 184, 214, 0.5);">
                                        <canvas id="signatureCanvas" width="700" height="150" class="w-100 h-100" style="cursor: crosshair; touch-action: none;"></canvas>
                                        <div id="canvasPlaceholder" class="position-absolute top-50 start-50 translate-middle pointer-events-none text-muted small" style="opacity: 0.4;">
                                            <i class="bi bi-pen me-1"></i> Draw your handwritten signature here
                                        </div>
                                    </div>
                                    <small class="d-block mt-1" style="color: #94A3B8; font-size: 11px;">
                                        Tip: Drawing will automatically be converted to a transparent official signature on certificates upon saving.
                                    </small>
                                </div>

                                <!-- Upload Tab -->
                                <div class="tab-pane fade" id="upload-panel" role="tabpanel">
                                    <label class="form-label small fw-bold text-white">Select Handwritten Signature Image (PNG, JPG, or SVG)</label>
                                    <input type="file" name="signatureFile" id="signatureFileInput" accept="image/png, image/jpeg, image/jpg, image/svg+xml" class="form-control" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" />
                                    <small class="d-block mt-1" style="color: #94A3B8; font-size: 11px;">
                                        Recommended: Transparent background PNG with dark ink for best certificate rendering.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between align-items-center pt-3 border-top mt-4" style="border-color: rgba(255, 255, 255, 0.12) !important;">
                        <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-light rounded-pill px-4" style="border-color: rgba(255, 255, 255, 0.25);">
                            <i class="bi bi-key me-1"></i> Change Password
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                            <i class="bi bi-check2 me-1"></i> Save Profile &amp; Signature
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Profile Picture preview sync
            var input = document.getElementById('inputProfilePicture');
            var headerImg = document.getElementById('profileHeaderImg');
            var headerFallback = document.getElementById('profileHeaderFallback');

            if (input && headerFallback) {
                input.addEventListener('input', function () {
                    var url = (this.value || '').trim();
                    if (url) {
                        if (!headerImg) {
                            headerImg = document.createElement('img');
                            headerImg.id = 'profileHeaderImg';
                            headerImg.className = 'rounded-circle shadow-sm';
                            headerImg.style.width = '64px';
                            headerImg.style.height = '64px';
                            headerImg.style.objectFit = 'cover';
                            headerFallback.parentNode.insertBefore(headerImg, headerFallback);
                        }
                        headerImg.src = url;
                        headerImg.style.display = 'block';
                        headerFallback.style.display = 'none';

                        headerImg.onerror = function () {
                            headerImg.style.display = 'none';
                            headerFallback.style.display = 'flex';
                        };
                    } else {
                        if (headerImg) headerImg.style.display = 'none';
                        headerFallback.style.display = 'flex';
                    }
                });
            }

            // HTML5 Signature Canvas Pad
            var canvas = document.getElementById('signatureCanvas');
            var placeholder = document.getElementById('canvasPlaceholder');
            var clearBtn = document.getElementById('btnClearSignature');
            var dataInput = document.getElementById('signatureDataInput');
            var form = document.getElementById('profileForm');

            if (canvas) {
                var ctx = canvas.getContext('2d');
                var isDrawing = false;
                var hasDrawn = false;

                // Configure smooth drawing
                ctx.strokeStyle = '#062330';
                ctx.lineWidth = 2.5;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';

                function getCanvasPos(e) {
                    var rect = canvas.getBoundingClientRect();
                    var scaleX = canvas.width / rect.width;
                    var scaleY = canvas.height / rect.height;
                    var clientX = e.clientX;
                    var clientY = e.clientY;
                    if (e.touches && e.touches.length > 0) {
                        clientX = e.touches[0].clientX;
                        clientY = e.touches[0].clientY;
                    }
                    return {
                        x: (clientX - rect.left) * scaleX,
                        y: (clientY - rect.top) * scaleY
                    };
                }

                function startDraw(e) {
                    isDrawing = true;
                    hasDrawn = true;
                    if (placeholder) placeholder.style.display = 'none';
                    var pos = getCanvasPos(e);
                    ctx.beginPath();
                    ctx.moveTo(pos.x, pos.y);
                    e.preventDefault();
                }

                function drawMove(e) {
                    if (!isDrawing) return;
                    var pos = getCanvasPos(e);
                    ctx.lineTo(pos.x, pos.y);
                    ctx.stroke();
                    e.preventDefault();
                }

                function stopDraw() {
                    if (isDrawing) {
                        isDrawing = false;
                        ctx.closePath();
                    }
                }

                canvas.addEventListener('mousedown', startDraw);
                canvas.addEventListener('mousemove', drawMove);
                window.addEventListener('mouseup', stopDraw);

                canvas.addEventListener('touchstart', startDraw, { passive: false });
                canvas.addEventListener('touchmove', drawMove, { passive: false });
                canvas.addEventListener('touchend', stopDraw);

                if (clearBtn) {
                    clearBtn.addEventListener('click', function () {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        hasDrawn = false;
                        if (placeholder) placeholder.style.display = 'block';
                        if (dataInput) dataInput.value = '';
                    });
                }

                if (form) {
                    form.addEventListener('submit', function () {
                        if (hasDrawn && dataInput) {
                            dataInput.value = canvas.toDataURL('image/png');
                        }
                    });
                }
            }
        });
    </script>
}
