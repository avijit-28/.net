@model JQuery.Models.UserDetails
@{
    ViewBag.Title = "User Details Management & Routing";
}

<div class="container-fluid px-4 pt-4">
    <!-- Top Executive Header -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-lg-7">
            <div class="d-flex align-items-center">
                <div class="bg-success text-white p-3 rounded-4 me-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="fa-solid fa-users-gear fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1 text-slate-900 tracking-tight">User Management &amp; Redirection Hub</h3>
                    <p class="text-muted mb-0 small">
                        SQL Server <code>Assignmet.dbo.userdetails</code> &bull; Stored Procedure <code>usercrudoperations</code>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-5 text-lg-end">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary me-2">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
            </a>
            <button id="btnClientRedirectDemo" class="btn btn-primary">
                <i class="fa-brands fa-js me-1"></i> jQuery window.location.href
            </button>
        </div>
    </div>

    <!-- Quick Action / Routing Toolbars -->
    <div class="row g-3 mb-4">
        <!-- Redirections Card -->
        <div class="col-lg-6">
            <div class="card card-modern h-100">
                <div class="card-header-modern bg-white">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-share-from-square text-primary me-2"></i> Server Redirection ActionResults</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        Test standard ASP.NET MVC redirection methods:
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="@Url.Action("RedirectToActionDemo", "User")" class="btn btn-sm btn-outline-success">
                            <i class="fa-solid fa-arrow-right me-1"></i> RedirectToAction
                        </a>
                        <a href="@Url.Action("RedirectToRouteDemo", "User")" class="btn btn-sm btn-outline-info">
                            <i class="fa-solid fa-route me-1"></i> RedirectToRoute
                        </a>
                        <a href="@Url.Action("RedirectToExternal", "User")" class="btn btn-sm btn-outline-warning" target="_blank">
                            <i class="fa-solid fa-globe me-1"></i> Redirect("https://mccit.net")
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Status Results Card -->
        <div class="col-lg-6">
            <div class="card card-modern h-100">
                <div class="card-header-modern bg-white">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-shield-halved text-danger me-2"></i> HTTP Status Results</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        Test ActionResult types returning HTTP status codes:
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="@Url.Action("UnauthorizedStatusCode", "User")" class="btn btn-sm btn-outline-danger" target="_blank">
                            <i class="fa-solid fa-lock me-1"></i> 401 Unauthorized
                        </a>
                        <a href="@Url.Action("BadGateway", "User")" class="btn btn-sm btn-outline-danger" target="_blank">
                            <i class="fa-solid fa-server me-1"></i> 502 Bad Gateway
                        </a>
                        <a href="@Url.Action("UnauthorizedResult", "User")" class="btn btn-sm btn-outline-secondary" target="_blank">
                            <i class="fa-solid fa-user-slash me-1"></i> HttpUnauthorizedResult
                        </a>
                        <a href="@Url.Action("NotFoundAction", "User")" class="btn btn-sm btn-outline-dark" target="_blank">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> HttpNotFoundResult (404)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Registration Form & User Table -->
    <div class="row g-4">
        <!-- User Registration Form -->
        <div class="col-lg-4">
            <div class="card card-modern h-100">
                <div class="card-header-modern bg-white">
                    <div>
                        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-user-plus text-success me-2"></i> User Registration Form</h5>
                        <small class="text-muted"><code>usercrudoperations (&#64;status='INSERT')</code></small>
                    </div>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("InsertUserDetails", "User", FormMethod.Post, new { id = "formClassicRegister" }))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold">User Name *</label>
                            @Html.TextBoxFor(u => u.UserName, new { @class = "form-control", placeholder = "Enter full name", required = "required" })
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Education *</label>
                            @Html.TextBoxFor(u => u.Education, new { @class = "form-control", placeholder = "Enter degree/qualification", required = "required" })
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Location *</label>
                            @Html.TextBoxFor(u => u.Location, new { @class = "form-control", placeholder = "Enter city or country", required = "required" })
                        </div>
                        <div class="d-grid mt-4">
                            <input type="submit" value="Register User" class="btn btn-success" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Registered User List Table -->
        <div class="col-lg-8">
            <div class="card card-modern h-100">
                <div class="card-header-modern bg-white">
                    <div>
                        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-users text-primary me-2"></i> Registered Users</h5>
                        <small class="text-muted"><code>usercrudoperations (&#64;status='GET')</code></small>
                    </div>
                    <span class="badge bg-primary rounded-pill">
                        Total: @(Model != null && Model.usersinfo != null ? Model.usersinfo.Count : 0)
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                        @if (Model != null && Model.usersinfo != null && Model.usersinfo.Count > 0)
                        {
                            <table class="table table-striped table-hover mb-0 align-middle">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th style="width: 85px;">User Id</th>
                                        <th>User Name</th>
                                        <th>Education</th>
                                        <th>Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.usersinfo)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary badge-code">@Html.DisplayFor(m => item.UserId)</span></td>
                                            <td class="fw-bold text-slate-900">@Html.DisplayFor(m => item.UserName)</td>
                                            <td>@Html.DisplayFor(m => item.Education)</td>
                                            <td><span class="badge bg-light text-dark border">@Html.DisplayFor(m => item.Location)</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="fa-solid fa-user-slash fs-1 text-secondary mb-3 d-block"></i>
                                <b>No Details Found.</b>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script type="text/javascript">
    $(function () {
        // jQuery client-side redirect on button click
        $("#btnClientRedirectDemo").on("click", function () {
            window.location.href = "@Url.Action("InsertUserDetails", "User")";
        });

        // Feedback alert and client-side redirect on successful form post
        var msg = '@ViewData["result"]';
        if (msg === '1') {
            Swal.fire({
                icon: 'success',
                title: 'User Details Inserted Successfully!',
                text: 'Registered and refreshed via stored procedure usercrudoperations.',
                timer: 2000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        }
    });
</script>
}
