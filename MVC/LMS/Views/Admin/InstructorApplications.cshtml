@model IEnumerable<LMS.ViewModels.InstructorApplicationViewModel>
@{
    ViewBag.Title = "Instructor Applications";
    int pendingCount = ViewBag.PendingInstructorCount != null ? (int)ViewBag.PendingInstructorCount : 0;
    int totalPending = ViewBag.TotalPendingCount != null ? (int)ViewBag.TotalPendingCount : 0;
    string currentStatus = ViewBag.StatusFilter as string ?? "Pending";
    string search = ViewBag.Search as string ?? "";
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Users", "Admin")" class="text-decoration-none">Users</a></li>
            <li class="breadcrumb-item active" aria-current="page">Instructor Applications</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold">
                    <i class="bi bi-mortarboard-fill me-1"></i> Teacher Verification Portal
                </span>
                @if (pendingCount > 0)
                {
                    <span class="badge bg-danger rounded-pill px-2 py-1">@pendingCount Instructor(s) Awaiting Review</span>
                }
            </div>
            <h2 class="fw-extrabold mb-1 tracking-tight">Instructor Registration Applications</h2>
            <p class="text-muted small mb-0">
                Verify educator qualifications, review professional bios, and approve or decline instructor teaching privileges.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="@Url.Action("PendingApprovals", "Admin")" class="btn btn-outline-warning text-dark rounded-pill px-3 fw-semibold">
                <i class="bi bi-clock-history me-1"></i> All Pending Registrations (@totalPending)
            </a>
            <a href="@Url.Action("Users", "Admin", new { roleFilter = "Instructor" })" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
                <i class="bi bi-people me-1"></i> Active Instructors
            </a>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-primary rounded-pill px-3 fw-semibold shadow-sm">
                <i class="bi bi-speedometer2 me-1"></i> Control Center
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-warning mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>@TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-danger mb-4" role="alert">
            <i class="bi bi-x-circle-fill me-2 text-danger"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter & Search Controls -->
    <div class="card card-custom p-3 mb-4 shadow-sm bg-white">
        @using (Html.BeginForm("InstructorApplications", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-lg-7 d-flex flex-wrap gap-2 align-items-center">
                <span class="small fw-bold text-muted text-uppercase me-1" style="font-size: 11px;">Status:</span>
                <a href="@Url.Action("InstructorApplications", "Admin", new { statusFilter = "Pending", search = search })" 
                   class="btn btn-sm @(currentStatus == "Pending" ? "btn-warning text-dark fw-bold" : "btn-light border") rounded-pill px-3">
                    <i class="bi bi-clock-history me-1"></i> Pending (@pendingCount)
                </a>
                <a href="@Url.Action("InstructorApplications", "Admin", new { statusFilter = "Approved", search = search })" 
                   class="btn btn-sm @(currentStatus == "Approved" ? "btn-success fw-bold" : "btn-light border") rounded-pill px-3">
                    <i class="bi bi-check-circle me-1"></i> Approved
                </a>
                <a href="@Url.Action("InstructorApplications", "Admin", new { statusFilter = "Declined", search = search })" 
                   class="btn btn-sm @(currentStatus == "Declined" ? "btn-danger fw-bold" : "btn-light border") rounded-pill px-3">
                    <i class="bi bi-x-circle me-1"></i> Declined
                </a>
                <a href="@Url.Action("InstructorApplications", "Admin", new { statusFilter = "All", search = search })" 
                   class="btn btn-sm @(currentStatus == "All" ? "btn-primary fw-bold" : "btn-light border") rounded-pill px-3">
                    All Applications
                </a>
            </div>

            <div class="col-lg-5">
                <div class="input-group input-group-sm">
                    <input type="hidden" name="statusFilter" value="@currentStatus" />
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Search applicant name, email, or bio..." />
                    <button type="submit" class="btn btn-primary px-3">
                        <i class="bi bi-search"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(search) || currentStatus != "Pending")
                    {
                        <a href="@Url.Action("InstructorApplications", "Admin")" class="btn btn-outline-secondary" title="Reset Filters">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Instructor Applications Table Card -->
    <div class="card card-custom shadow-sm bg-white overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-mortarboard me-2 text-primary"></i>Instructor Candidate Dossiers
                <span class="badge bg-light text-muted border ms-2">@Model.Count() records</span>
            </h5>
            <span class="small text-muted">Filter: <strong>@currentStatus</strong></span>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="mb-3 text-muted">
                    <i class="bi bi-check2-circle fs-1 text-success d-block mb-2"></i>
                    <h5 class="fw-bold text-dark">No instructor applications found</h5>
                    <p class="small text-muted mb-3">There are currently no instructor applications matching the selected criteria.</p>
                </div>
                @if (currentStatus != "Pending")
                {
                    <a href="@Url.Action("InstructorApplications", "Admin", new { statusFilter = "Pending" })" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3">
                        <i class="bi bi-clock-history me-1"></i> View Pending Queue
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-4">Teacher / Applicant</th>
                            <th style="min-width: 250px;">Bio / Qualifications / Experience</th>
                            <th>Applied On</th>
                            <th>Verification Status</th>
                            <th>Admin Decision Notes</th>
                            <th class="text-end pe-4">Direct Actions</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var app in Model)
                        {
                            bool isPending = string.Equals(app.ApprovalStatus, "Pending", StringComparison.OrdinalIgnoreCase);
                            bool isApproved = string.Equals(app.ApprovalStatus, "Approved", StringComparison.OrdinalIgnoreCase);
                            bool isDeclined = string.Equals(app.ApprovalStatus, "Declined", StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-info-subtle text-info border border-info-subtle d-flex align-items-center justify-content-center fw-bold shadow-xs" style="width: 42px; height: 42px;">
                                            @(string.IsNullOrEmpty(app.FullName) ? "T" : app.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-6">@app.FullName</div>
                                            <div class="text-muted" style="font-size: 11px;">
                                                <i class="bi bi-envelope me-1"></i>@app.Email
                                            </div>
                                            @if (!string.IsNullOrEmpty(app.PhoneNumber))
                                            {
                                                <div class="text-muted" style="font-size: 11px;">
                                                    <i class="bi bi-telephone me-1"></i>@app.PhoneNumber
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(app.Bio))
                                    {
                                        <div class="p-2 bg-light rounded-2 border text-dark" style="max-width: 320px; font-size: 11.5px; line-height: 1.5;">
                                            <i class="bi bi-quote text-primary me-1"></i>@app.Bio
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic" style="font-size: 11px;">No bio details provided</span>
                                    }
                                </td>

                                <td class="text-muted">
                                    <div>@app.RegisteredDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div style="font-size: 11px;">@app.RegisteredDate.ToLocalTime().ToString("hh:mm tt")</div>
                                </td>

                                <td>
                                    @if (isPending)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1">
                                            <span class="spinner-grow spinner-grow-sm me-1" role="status" aria-hidden="true" style="width: 7px; height: 7px;"></span> Pending Verification
                                        </span>
                                    }
                                    else if (isApproved)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approved Instructor
                                        </span>
                                    }
                                    else if (isDeclined)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Declined
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(app.RejectionReason))
                                    {
                                        <span class="text-danger small" title="@app.RejectionReason">
                                            <i class="bi bi-exclamation-circle me-1"></i>@(app.RejectionReason.Length > 32 ? app.RejectionReason.Substring(0, 30) + "..." : app.RejectionReason)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end align-items-center">
                                        @if (!isApproved)
                                        {
                                            using (Html.BeginForm("ApproveInstructor", "Admin", FormMethod.Post, new { @class = "d-inline m-0" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@app.Id" />
                                                <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold shadow-xs" onclick="return confirm('Confirm approval for instructor candidate: @app.FullName?');">
                                                    <i class="bi bi-check-lg me-1"></i> Approve
                                                </button>
                                            }
                                        }

                                        @if (!isDeclined)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold shadow-xs" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#declineInstructorModal" 
                                                    data-userid="@app.Id" 
                                                    data-fullname="@app.FullName" 
                                                    data-email="@app.Email">
                                                <i class="bi bi-x-lg me-1"></i> Decline
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Declined</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Decline Instructor Modal -->
<div class="modal fade" id="declineInstructorModal" tabindex="-1" aria-labelledby="declineInstructorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            @using (Html.BeginForm("DeclineInstructor", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalInstructorId" name="userId" value="" />
                <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="declineInstructorModalLabel">
                        <i class="bi bi-shield-x"></i> Decline Instructor Application
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        You are about to decline the instructor teaching application for <strong id="modalInstructorName" class="text-dark">Candidate</strong> (<span id="modalInstructorEmail">email</span>).
                    </p>

                    <div class="mb-3">
                        <label for="modalInstructorReason" class="form-label fw-bold small text-dark">
                            Reason for Declining (Optional):
                        </label>
                        <textarea class="form-control" id="modalInstructorReason" name="reason" rows="3" placeholder="e.g. Incomplete instructor bio/qualifications, credentials verification failed, duplicate application, or platform teaching standards mismatch..."></textarea>
                        <div class="form-text small text-muted">
                            This feedback is communicated to the applicant on their status page and in their notification center.
                        </div>
                    </div>

                    <div class="alert alert-warning py-2 small border-0 border-start border-3 border-warning mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i> Declining will revoke instructor permissions and prevent portal login.
                    </div>
                </div>

                <div class="modal-footer border-top py-2 px-4 bg-light">
                    <button type="button" class="btn btn-sm btn-light border rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="bi bi-x-circle me-1"></i> Confirm Decline
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var declineInstructorModalEl = document.getElementById('declineInstructorModal');
        if (declineInstructorModalEl) {
            declineInstructorModalEl.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var userId = button.getAttribute('data-userid');
                var fullName = button.getAttribute('data-fullname');
                var email = button.getAttribute('data-email');

                document.getElementById('modalInstructorId').value = userId;
                document.getElementById('modalInstructorName').textContent = fullName;
                document.getElementById('modalInstructorEmail').textContent = email;
                document.getElementById('modalInstructorReason').value = '';
            });
        }
    </script>
}
