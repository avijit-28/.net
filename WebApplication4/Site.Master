                    <li><a href="<%= ResolveUrl("~/URLRouting") %>">Articles</a></li>
                    <li><a href="<%= ResolveUrl("~/CheckAvailability") %>">Live Validation</a></li>
                    <li><a href="<%= ResolveUrl("~/GetUserDetails") %>">WS Search</a></li>
                    <li><a href="<%= ResolveUrl("~/GridViewAll") %>">Employee Directory</a></li>
                    <li><a href="<%= ResolveUrl("~/AllGridProp") %>">GridView Hub</a></li>
                </ul>
            </div>
        </footer>

        <script type="text/javascript">
            // Smart dropdown alignment to prevent overflowing screen edges
            function alignMenuDropdown() {
                var panel = document.getElementById('megaMenuPanel');
                var btn = document.getElementById('megaMenuBtn');
                if (!panel || !btn) return;

                var btnRect = btn.getBoundingClientRect();
                var panelWidth = panel.offsetWidth || 780;
                var viewportWidth = window.innerWidth;

                if (viewportWidth > 640) {
                    if (btnRect.left + panelWidth > viewportWidth - 20) {
                        panel.style.left = 'auto';
                        panel.style.right = '0';
                    } else {
                        panel.style.left = '0';
                        panel.style.right = 'auto';
                    }
                }
            }

            <% if (Session["UserName"] != null && !string.IsNullOrWhiteSpace(Session["UserName"].ToString())) { %>
            // Real-time Session Countdown & Auto-Redirect upon Expiry
            (function () {
                var sessionTotalSeconds = <%= Session.Timeout * 60 %>;
                var sessionRemaining = sessionTotalSeconds;
                var sessionTimerInterval = null;

                function formatTime(sec) {
                    var m = Math.floor(sec / 60);
                    var s = sec % 60;
                    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
                }

                function tickSession() {
                    var timerText = document.getElementById('sessionTimerText');
                    if (timerText) {
                        timerText.textContent = formatTime(sessionRemaining);
                    }

                    if (sessionRemaining <= 0) {
                        clearInterval(sessionTimerInterval);
                        // When session ends, automatically redirect to sign in page
                        window.location.href = '<%= ResolveUrl("~/FirstPage?timeout=1") %>';
                        return;
                    }
                    sessionRemaining--;
                }

                function startSessionCountdown() {
                    if (sessionTimerInterval) clearInterval(sessionTimerInterval);
                    sessionRemaining = sessionTotalSeconds;
                    tickSession();
                    sessionTimerInterval = setInterval(tickSession, 1000);
                }

                startSessionCountdown();

                // If user performs an asynchronous AJAX request (UpdatePanel), reset the countdown
                if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                    Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                        startSessionCountdown();
                    });
                }
            })();
            <% } %>

            document.addEventListener('DOMContentLoaded', function () {
                var menuBtn = document.getElementById('megaMenuBtn');
                var menuWrapper = document.querySelector('.menu-dropdown-wrapper');

                if (menuBtn && menuWrapper) {
                    menuBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        var willBeActive = !menuWrapper.classList.contains('active');
                        menuWrapper.classList.toggle('active');
                        if (willBeActive) {
                            alignMenuDropdown();
                        }
                    });

                    menuWrapper.addEventListener('mouseenter', function () {
                        alignMenuDropdown();
                    });
                }

                document.addEventListener('click', function (e) {
                    if (menuWrapper && !menuWrapper.contains(e.target)) {
                        menuWrapper.classList.remove('active');
                    }
                });

                // Close dropdown on Escape key
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        if (menuWrapper) {
                            menuWrapper.classList.remove('active');
                        }
                    }
                });

                window.addEventListener('resize', function () {
                    if (menuWrapper && menuWrapper.classList.contains('active')) {
                        alignMenuDropdown();
                    }
                });
            });
        </script>
    </form>
</body>
</html>
