@model IEnumerable<LMS.Models.Assignment>
@{
    var course = (LMS.Models.Course)ViewBag.Course;
    ViewBag.Title = "Course Assignments - " + course.Title;
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")" class="text-decoration-none">My Courses</a></li>
            <li class="breadcrumb-item active" aria-current="page">Assignments: @course.Title</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-info-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-file-earmark-code-fill text-info me-1"></i> Project Assignments
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Course Assignments: @course.Title</h2>
            <p class="text-muted small mb-0">Manage homework challenges, project specifications, and grade student submissions</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Courses
            </a>
            <a href="@Url.Action("CreateAssignment", "Instructor", new { courseId = course.CourseId })" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Assignment
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white border-0">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-journal-code text-muted display-4"></i>
            </div>
            <h4 class="fw-bold">No assignments posted yet</h4>
            <p class="text-muted small mb-3">Create practical projects with submission deadlines and grading rubrics for your students.</p>
            <div>
                <a href="@Url.Action("CreateAssignment", "Instructor", new { courseId = course.CourseId })" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Create First Assignment
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom shadow-sm overflow-hidden bg-white border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-4">Assignment Title</th>
                            <th>Curriculum Link</th>
                            <th>Due Date</th>
                            <th>Max Marks</th>
                            <th>Submission Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var subsCount = item.Submissions != null ? item.Submissions.Count : 0;
                            var gradedCount = item.Submissions != null ? item.Submissions.Count(s => s.Status == "Graded") : 0;
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <small class="text-muted">Created @item.CreatedDate.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1 small">
                                        @(item.Lesson != null ? item.Lesson.Title : "Course Level")
                                    </span>
                                </td>
                                <td>
                                    @if (item.DueDate.HasValue)
                                    {
                                        var isOverdue = item.DueDate.Value < DateTime.UtcNow;
                                        <span class="badge @(isOverdue ? "bg-secondary-subtle text-secondary" : "bg-warning-subtle text-warning border border-warning-subtle") rounded-pill px-3 py-1 small fw-semibold">
                                            <i class="bi bi-clock me-1"></i> @item.DueDate.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No deadline</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1 font-monospace">@item.MaxMarks pts</span>
                                </td>
                                <td>
                                    <span class="badge badge-primary-subtle rounded-pill px-3 py-1">@subsCount total</span>
                                    @if (subsCount > 0)
                                    {
                                        <small class="text-muted ms-1">(@gradedCount graded)</small>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <a href="@Url.Action("EditAssignment", "Instructor", new { id = item.AssignmentId })" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold" title="Edit Task Details">
                                            <i class="bi bi-pencil me-1"></i> Edit Task
                                        </a>
                                        <a href="@Url.Action("Submissions", "Instructor", new { assignmentId = item.AssignmentId })" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-eye me-1"></i> Review Submissions
                                        </a>
                                        @using (Html.BeginForm("DeleteAssignment", "Instructor", new { id = item.AssignmentId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete Task" onclick="return confirm('Are you sure you want to delete assignment \'@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Title))\'?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
