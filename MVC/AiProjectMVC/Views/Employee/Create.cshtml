@model AiProjectMVC.Models.Employee

@{
    ViewBag.Title = "Create Employee";
    var addressList = ViewBag.Addresses as List<AiProjectMVC.Models.Address> ?? new List<AiProjectMVC.Models.Address>();
    var availableUsers = ViewBag.AvailableUsers as List<AiProjectMVC.Models.EmployeeUser> ?? new List<AiProjectMVC.Models.EmployeeUser>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Back Breadcrumb Link -->
        <div class="mb-3">
            <a href="@Url.Action("Index", "Employee")" class="text-decoration-none text-muted small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Employee Directory
            </a>
        </div>

        <div class="custom-card">
            <div class="custom-card-header">
                <div>
                    <h4 class="mb-1 fw-bold text-dark"><i class="bi bi-person-plus-fill text-primary me-2"></i> Add New Employee</h4>
                    <p class="text-muted small mb-0">Fill in employee details and assign a verified regional address.</p>
                </div>
            </div>

            <div class="custom-card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                    {
                        <div class="custom-alert custom-alert-danger" role="alert">
                            <i class="bi bi-exclamation-circle-fill fs-5 text-danger"></i>
                            <div>@Html.ValidationSummary(true, "", new { @class = "mb-0" })</div>
                        </div>
                    }

                    <div class="row g-3">
                        <!-- Employee ID (from EmployeeUser) -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.ID, "Employee ID (Select Registered User)", new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person-badge text-muted"></i></span>
                                @if (availableUsers.Any())
                                {
                                    <select name="ID" id="ID" class="form-select" required>
                                        <option value="">-- Select Registered User ID --</option>
                                        @foreach (var u in availableUsers)
                                        {
                                            <option value="@u.ID" data-name="@u.Name" data-role="@u.Role" @(Model != null && Model.ID == u.ID ? "selected" : "")>
                                                #@u.ID - @u.Name (@u.UserName - @u.Role)
                                            </option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <select name="ID" id="ID" class="form-select" disabled>
                                        <option value="">-- All registered users already assigned --</option>
                                    </select>
                                }
                            </div>
                            @Html.ValidationMessageFor(model => model.ID, "", new { @class = "text-danger small mt-1 d-block" })
                            @if (availableUsers.Any())
                            {
                                <span class="text-muted small">Select a user registered in EmployeeUser to add to the employee database.</span>
                            }
                            else
                            {
                                <span class="text-warning small d-block mt-1">
                                    <i class="bi bi-info-circle me-1"></i> All registered users currently have employee records. <a href="@Url.Action("Register", "Account")" class="fw-semibold">Register a new user first</a>.
                                </span>
                            }
                        </div>

                        <!-- Full Name -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.Name, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter full name", required = "required" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Department -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.Dept, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-building text-muted"></i></span>
                                <select name="Dept" id="Dept" class="form-select" required>
                                    <option value="">-- Select Department --</option>
                                    <option value="IT" @(Model != null && Model.Dept == "IT" ? "selected" : "")>IT</option>
                                    <option value="HR" @(Model != null && Model.Dept == "HR" ? "selected" : "")>HR</option>
                                    <option value="Finance" @(Model != null && Model.Dept == "Finance" ? "selected" : "")>Finance</option>
                                    <option value="Marketing" @(Model != null && Model.Dept == "Marketing" ? "selected" : "")>Marketing</option>
                                    <option value="Sales" @(Model != null && Model.Dept == "Sales" ? "selected" : "")>Sales</option>
                                    <option value="Operations" @(Model != null && Model.Dept == "Operations" ? "selected" : "")>Operations</option>
                                </select>
                            </div>
                            @Html.ValidationMessageFor(model => model.Dept, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Salary -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.Salary, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-muted">&#8377;</span>
                                <input type="number" 
                                       name="Salary" 
                                       id="Salary" 
                                       class="form-control" 
                                       value="@(Model != null && Model.Salary > 0 ? Model.Salary.ToString() : "")" 
                                       min="1" 
                                       max="10000000" 
                                       step="500" 
                                       placeholder="e.g. 50000" 
                                       required />
                            </div>
                            @Html.ValidationMessageFor(model => model.Salary, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Gender -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.Gender, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-gender-ambiguous text-muted"></i></span>
                                <select name="Gender" id="Gender" class="form-select" required>
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male" @(Model != null && Model.Gender == "Male" ? "selected" : "")>Male</option>
                                    <option value="Female" @(Model != null && Model.Gender == "Female" ? "selected" : "")>Female</option>
                                    <option value="Other" @(Model != null && Model.Gender == "Other" ? "selected" : "")>Other</option>
                                </select>
                            </div>
                            @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.City, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-alt text-muted"></i></span>
                                @Html.EditorFor(model => model.City, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g. Mumbai, Delhi, Bangalore", required = "required" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Address ID Link -->
                        <div class="col-md-12">
                            @Html.LabelFor(model => model.AddressId, "Linked Address (Optional)", new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-fill text-muted"></i></span>
                                @if (addressList.Any())
                                {
                                    <select name="AddressId" id="AddressId" class="form-select">
                                        <option value="">-- None (No Address Linked) --</option>
                                        @foreach (var addr in addressList)
                                        {
                                            <option value="@addr.AddressId" @(Model != null && Model.AddressId == addr.AddressId ? "selected" : "")>
                                                #@addr.AddressId - @addr.City, @addr.State (@addr.Country, @addr.Pin)
                                            </option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    @Html.EditorFor(model => model.AddressId, new { htmlAttributes = new { @class = "form-control", type = "number", placeholder = "Enter Address ID (e.g. 1)" } })
                                }
                            </div>
                            @Html.ValidationMessageFor(model => model.AddressId, "", new { @class = "text-danger small mt-1 d-block" })
                            <span class="text-muted small">Select an existing address or leave blank if none.</span>
                        </div>
                    </div>

                    <hr class="my-4 text-muted" />

                    <!-- Form Buttons -->
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary-gradient px-4">
                            <i class="bi bi-check-lg"></i> Register Employee
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // When an Employee ID is selected from EmployeeUser, auto-fill Full Name while remaining fields stay intact
            $('#ID').on('change', function () {
                var selectedOpt = $(this).find('option:selected');
                var name = selectedOpt.data('name');
                if (name) {
                    $('#Name').val(name);
                }
            });

            // If an ID is already selected on page load, ensure Name is populated
            var initialSelected = $('#ID').find('option:selected');
            if (initialSelected.val() && !$('#Name').val()) {
                var initialName = initialSelected.data('name');
                if (initialName) {
                    $('#Name').val(initialName);
                }
            }
        });
    </script>
}
