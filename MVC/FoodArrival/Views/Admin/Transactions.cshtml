@model List<FoodArrival.Models.Transaction>
@{
    ViewBag.Title = "Platform Transactions & Financials - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";

    decimal totalGross = Model.Where(t => t.PaymentStatus == "Success").Sum(t => t.Amount);
    decimal totalPlatform = Model.Where(t => t.PaymentStatus == "Success").Sum(t => t.PlatformFee);
    decimal totalRestShare = Model.Where(t => t.PaymentStatus == "Success").Sum(t => t.RestaurantShare);
    decimal totalDelivery = Model.Where(t => t.PaymentStatus == "Success").Sum(t => t.DeliveryFee);
}

<div class="container-fluid py-4 px-lg-5">
    <div class="row g-4">
        <!-- Admin Left Sidebar -->
        <div class="col-lg-2 col-md-3">
            <div class="admin-sidebar sticky-top" style="top: 85px;">
                <div class="d-flex align-items-center gap-2 mb-4 px-2">
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1"><i class="bi bi-shield-lock-fill me-1"></i> Admin Panel</span>
                </div>
                <div class="nav flex-column gap-1">
                    <a href="@Url.Action("Dashboard", "Admin")" class="admin-nav-item">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("Approvals", "Admin")" class="admin-nav-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Approvals</span>
                    </a>
                    <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })" class="admin-nav-item">
                        <i class="bi bi-card-checklist"></i>
                        <span>Orders</span>
                    </a>
                    <a href="@Url.Action("FoodItems", "Admin")" class="admin-nav-item">
                        <i class="bi bi-egg-fried"></i>
                        <span>Food Menu</span>
                    </a>
                    <a href="@Url.Action("Riders", "Admin")" class="admin-nav-item">
                        <i class="bi bi-bicycle"></i>
                        <span>Rider Fleet</span>
                    </a>
                    <a href="@Url.Action("Transactions", "Admin")" class="admin-nav-item active">
                        <i class="bi bi-cash-stack"></i>
                        <span>Transactions</span>
                    </a>
                    <a href="@Url.Action("Bulletins", "Admin")" class="admin-nav-item">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>Bulletins</span>
                    </a>
                    <hr class="border-secondary my-3" />
                    <a href="@Url.Action("Logout", "Admin")" class="admin-nav-item text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-10 col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-0">Platform Transactions & Payouts</h2>
                    <p class="text-muted small mb-0">Audited financial records, payment gateway settlements, restaurant disbursements, and platform fee income</p>
                </div>
            </div>

            <!-- Financial Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: #FFF3E0; color: #E65100;">
                            <i class="bi bi-receipt"></i>
                        </div>
                        <div>
                            <div class="stat-number text-dark">&#8377;@totalGross.ToString("N0")</div>
                            <div class="stat-label">Total Gross Volume</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-card" style="background: linear-gradient(135deg, #1A202C, #2D3748); color: #FFFFFF;">
                        <div class="stat-icon" style="background: rgba(255,255,255,0.1); color: #FFE600;">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <div>
                            <div class="stat-number" style="color: #FFE600;">&#8377;@totalPlatform.ToString("N0")</div>
                            <div class="stat-label text-white-50">Platform Fee (10%)</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: #E8F5E9; color: #2E7D32;">
                            <i class="bi bi-shop"></i>
                        </div>
                        <div>
                            <div class="stat-number text-success">&#8377;@totalRestShare.ToString("N0")</div>
                            <div class="stat-label">Restaurant Payouts</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: #E0F2FE; color: #0284C7;">
                            <i class="bi bi-bicycle"></i>
                        </div>
                        <div>
                            <div class="stat-number text-primary">&#8377;@totalDelivery.ToString("N0")</div>
                            <div class="stat-label">Delivery Charges</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Transactions Table -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-list-check text-primary me-1"></i> Transaction Ledger (@Model.Count entries)</h6>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0 custom-table">
                        <thead>
                            <tr>
                                <th>Ref #</th>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Restaurant</th>
                                <th>Total Paid</th>
                                <th>Rest. Share</th>
                                <th>Platform Fee</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th>Date/Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var txn in Model)
                                {
                                    string badge = txn.PaymentStatus == "Success" ? "bg-success" : (txn.PaymentStatus == "Pending" ? "bg-warning text-dark" : "bg-danger");
                                    <tr>
                                        <td class="fw-bold text-dark"><span class="badge bg-light text-dark border">@txn.TransactionReference</span></td>
                                        <td><a href="@Url.Action("Orders", "Admin")" class="fw-bold text-primary">#FD@(1000 + txn.OrderId)</a></td>
                                        <td>@txn.CustomerName</td>
                                        <td><span class="fw-bold text-dark">@txn.RestaurantName</span></td>
                                        <td class="fw-bold text-dark">&#8377;@txn.Amount.ToString("F2")</td>
                                        <td class="text-success small fw-bold">&#8377;@txn.RestaurantShare.ToString("F2")</td>
                                        <td class="text-warning small fw-bold">&#8377;@txn.PlatformFee.ToString("F2")</td>
                                        <td><span class="badge bg-light text-dark border">@txn.PaymentMethod</span></td>
                                        <td><span class="badge @badge">@txn.PaymentStatus</span></td>
                                        <td class="small text-muted">@txn.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5 text-muted">No transactions recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
