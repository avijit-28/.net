@model IEnumerable<LMS.Models.Lesson>
@{
    var module = ViewBag.Module as LMS.Models.Module;
    ViewBag.Title = "Lessons - " + (module?.ModuleName ?? "Module");
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")">Course Studio</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Modules", "Instructor", new { courseId = module?.CourseId })">Modules</a></li>
                    <li class="breadcrumb-item active">Lessons</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0">Lessons: @(module?.ModuleName ?? "Module")</h3>
            <p class="text-muted small">Add and manage videos, articles, downloadable assets, and assessments</p>
        </div>
        <div>
            <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addLessonModal">
                <i class="bi bi-plus-circle me-1"></i> Add Lesson
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm">
            <i class="bi bi-play-circle fs-1 text-muted mb-3"></i>
            <h5 class="fw-bold">No lessons added to this module yet.</h5>
            <p class="text-muted small mb-3">Create video lessons, reading articles, quizzes, or assignments.</p>
            <div>
                <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addLessonModal">
                    Add First Lesson
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Order</th>
                            <th>Lesson Title</th>
                            <th>Type</th>
                            <th>Duration</th>
                            <th>Preview</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary-subtle text-secondary">#@l.LessonOrder</span></td>
                                <td>
                                    <div class="fw-bold text-dark">@l.Title</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 350px;">
                                        @(string.IsNullOrEmpty(l.Description) ? "No overview provided." : l.Description)
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary">@l.LessonType</span>
                                </td>
                                <td class="small text-muted">@l.DurationInMinutes min</td>
                                <td>
                                    @if (l.IsPreview)
                                    {
                                        <span class="badge bg-success small">Free Preview</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border small">Enrolled Only</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @using (Html.BeginForm("DeleteLesson", "Instructor", new { id = l.LessonId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('Delete this lesson?');">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Add Lesson Modal -->
<div class="modal fade" id="addLessonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Create New Lesson</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("CreateLesson", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ModuleId" value="@(module?.ModuleId ?? 0)" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Lesson Title</label>
                            <input type="text" name="Title" class="form-control" placeholder="e.g. Understanding Data Structures" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Lesson Type</label>
                            <select name="LessonType" class="form-select">
                                <option value="Video">Video</option>
                                <option value="Article">Article / Notes</option>
                                <option value="PDF">PDF Document</option>
                                <option value="Link">External Link</option>
                                <option value="Quiz">Quiz Assessment</option>
                                <option value="Assignment">Practical Assignment</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Video URL / Embed Link</label>
                            <input type="text" name="VideoUrl" class="form-control" placeholder="https://www.youtube.com/embed/... or stream link" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Duration (Min)</label>
                            <input type="number" name="DurationInMinutes" class="form-control" value="15" min="1" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Sequence Order</label>
                            <input type="number" name="LessonOrder" class="form-control" value="@(Model.Count() + 1)" min="1" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Resource / Download URL</label>
                            <input type="text" name="ResourceUrl" class="form-control" placeholder="https://example.com/handout.pdf or GitHub repo link" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Lesson Summary / Description</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="Brief summary of what this lesson demonstrates..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Article Notes & Markdown Content</label>
                            <textarea name="Content" class="form-control" rows="5" placeholder="Detailed reading materials, code snippets, notes..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="IsPreview" id="chkPreview" value="true" class="form-check-input" />
                                <input type="hidden" name="IsPreview" value="false" />
                                <label class="form-check-label fw-semibold small" for="chkPreview">
                                    Allow Free Preview (Non-enrolled users can view this lesson)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Save Lesson</button>
                </div>
            }
        </div>
    </div>
</div>
