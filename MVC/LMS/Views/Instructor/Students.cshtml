@model IEnumerable<LMS.Models.Enrollment>
@{
    var course = (LMS.Models.Course)ViewBag.Course;
    ViewBag.Title = "Enrolled Students - " + course.Title;
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")" class="text-decoration-none">My Courses</a></li>
            <li class="breadcrumb-item active" aria-current="page">Enrolled Students</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-info-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Course Roster
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Enrolled Students: @course.Title</h2>
            <p class="text-muted small mb-0">Active student roster, curriculum progress tracking, and graduation dates</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-xs">
                Total Enrolled: <strong>@Model.Count()</strong>
            </span>
            <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Courses
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white border-0">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-person-x text-muted display-4"></i>
            </div>
            <h4 class="fw-bold">No students currently enrolled</h4>
            <p class="text-muted small mb-3">Once learners enroll in your course, their learning progress and activity will appear here.</p>
            <div>
                <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to Courses
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom shadow-sm overflow-hidden bg-white border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-4">Student Key</th>
                            <th>Enrolled Date</th>
                            <th>Curriculum Trajectory</th>
                            <th>Completion Status</th>
                            <th class="pe-4">Completed Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center shadow-xs" style="width: 36px; height: 36px;">
                                            <i class="bi bi-person-fill fs-6"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark font-monospace small">#@item.StudentId.Substring(0, Math.Min(12, item.StudentId.Length))</div>
                                            <small class="text-muted">Learner ID</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="small text-muted">@item.EnrollmentDate.ToString("MMM dd, yyyy")</span></td>
                                <td style="width: 250px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @(item.ProgressPercentage >= 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @item.ProgressPercentage%;"></div>
                                        </div>
                                        <span class="small fw-bold @(item.ProgressPercentage >= 100 ? "text-success" : "text-primary")">@item.ProgressPercentage%</span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                            <span class="pulse-dot pulse-primary"></span> In Progress
                                        </span>
                                    }
                                </td>
                                <td class="pe-4">
                                    <span class="small text-muted">@(item.CompletedDate.HasValue ? item.CompletedDate.Value.ToString("MMM dd, yyyy") : "--")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
