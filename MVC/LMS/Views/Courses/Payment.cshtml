@model LMS.Models.Course
@{
    ViewBag.Title = "Secure Checkout - " + Model.Title;
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Courses")" class="text-decoration-none">Courses</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Details", "Courses", new { id = Model.CourseId })" class="text-decoration-none">@Model.Title</a></li>
                <li class="breadcrumb-item active" aria-current="page">Checkout</li>
            </ol>
        </nav>

        <div class="row g-4">
            <!-- Course Summary -->
            <div class="col-md-5 order-md-2">
                <div class="card card-custom p-4 shadow-sm bg-white card-gradient-top">
                    <h5 class="fw-bold mb-3"><i class="bi bi-cart3 me-2 text-primary"></i> Order Summary</h5>
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <h6 class="fw-bold mb-1 text-dark">@Model.Title</h6>
                        <span class="badge badge-primary-subtle small">@(Model.Category?.CategoryName ?? "General")</span>
                        <div class="small text-muted mt-2"><i class="bi bi-clock me-1"></i> @Model.DurationInHours Hours Content &bull; Lifetime Access</div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Curriculum Access</span>
                        <span><span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Verifiable Certificate</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>Platform Discount</span>
                        <span class="text-success"><span class="rupee-symbol">&#8377;</span>0.00</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between fs-4 fw-extrabold text-dark mb-4">
                        <span>Total Due</span>
                        <span class="text-primary"><span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2")</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border small text-secondary d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-3"></i>
                        <span>Instant automated enrollment and full classroom unlock.</span>
                    </div>
                </div>
            </div>

            <!-- Payment Form -->
            <div class="col-md-7 order-md-1">
                <div class="card card-custom p-4 p-md-5 shadow-sm bg-white">
                    <h4 class="fw-extrabold mb-1 tracking-tight">Payment Method</h4>
                    <p class="text-muted small mb-4">Select your preferred payment channel to finalize your enrollment.</p>

                    @using (Html.BeginForm("Payment", "Courses", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@Model.CourseId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-dark">Select Payment Option:</label>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check p-3 border rounded-3 bg-light card-hover">
                                    <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="pmCard" value="Credit Card (Mock / Test)" checked>
                                    <label class="form-check-label fw-bold text-dark" for="pmCard">
                                        <i class="bi bi-credit-card-2-front text-primary me-2 fs-5"></i> Credit / Debit Card (Sandbox Test)
                                    </label>
                                </div>
                                <div class="form-check p-3 border rounded-3 bg-light card-hover">
                                    <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="pmUPI" value="UPI / QR Payment (Mock)">
                                    <label class="form-check-label fw-bold text-dark" for="pmUPI">
                                        <i class="bi bi-qr-code-scan text-success me-2 fs-5"></i> UPI / QR Code (Google Pay, PhonePe, Paytm)
                                    </label>
                                </div>
                                <div class="form-check p-3 border rounded-3 bg-light card-hover">
                                    <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="pmNetBanking" value="Net Banking (Mock)">
                                    <label class="form-check-label fw-bold text-dark" for="pmNetBanking">
                                        <i class="bi bi-bank text-primary me-2 fs-5"></i> Net Banking (All Indian Banks)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning small border-warning border-0 border-start border-4 border-warning bg-warning-subtle text-dark p-3 rounded-3 mb-4">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-info-circle-fill text-warning fs-5"></i>
                                <div>
                                    <strong>Development Sandbox Environment:</strong> This payment flow runs in simulated demo mode. No sensitive financial credentials are requested or stored. Submitting generates a genuine database payment record and unlocks student enrollment.
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-lock-fill me-1"></i> Authorize Payment & Start Learning
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
