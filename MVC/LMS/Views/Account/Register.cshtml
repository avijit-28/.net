@model LMS.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Create an Account";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 p-md-5 shadow-sm bg-white card-gradient-top">
            <div class="text-center mb-4">
                <span class="rounded-circle bg-primary-subtle text-primary p-3 d-inline-flex mb-2 shadow-xs">
                    <i class="bi bi-person-plus fs-3"></i>
                </span>
                <h3 class="fw-extrabold tracking-tight mb-1">Get Started Today</h3>
                <p class="text-muted small">Join our community of students and verified instructors on EduPlatform</p>
            </div>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form", id = "registerForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small border-0 border-start border-4 border-danger" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-bold small text-dark" })
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control border-start-0", placeholder = "e.g. John Doe", required = "required" })
                    </div>
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold small text-dark" })
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0", placeholder = "name@example.com", required = "required", type = "email" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label fw-bold small text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0 border-end-0", placeholder = "Create password", required = "required", id = "regPassword" })
                            <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-bold small text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control border-start-0 border-end-0", placeholder = "Confirm password", required = "required" })
                            <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <!-- Password Requirements Helper -->
                <div class="p-2 mb-3 bg-light rounded-3 border">
                    <div class="text-muted fw-semibold mb-1" style="font-size: 11px;">
                        <i class="bi bi-shield-lock me-1 text-primary"></i> Password Rules (Must contain all 4):
                    </div>
                    <div class="d-flex flex-wrap gap-1" style="font-size: 11px;">
                        <span class="badge bg-white text-secondary border"><i class="bi bi-check2 text-success me-1"></i>Min 8 characters</span>
                        <span class="badge bg-white text-secondary border"><i class="bi bi-check2 text-success me-1"></i>Uppercase (A-Z)</span>
                        <span class="badge bg-white text-secondary border"><i class="bi bi-check2 text-success me-1"></i>Lowercase (a-z)</span>
                        <span class="badge bg-white text-secondary border"><i class="bi bi-check2 text-success me-1"></i>Digit (0-9)</span>
                        <span class="badge bg-white text-secondary border"><i class="bi bi-check2 text-success me-1"></i>Symbol (!@@#$%...)</span>
                    </div>
                </div>

                <!-- Role Selection Cards -->
                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Select Your Account Role:</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Role" id="roleStudent" value="Student" @(Model == null || Model.Role != "Instructor" ? "checked" : "") />
                            <label class="btn btn-outline-primary w-100 py-3 d-flex flex-column align-items-center rounded-3 shadow-xs" for="roleStudent">
                                <i class="bi bi-backpack2 fs-3 mb-1"></i>
                                <span class="fw-bold">Student Learner</span>
                                <small class="text-muted" style="font-size: 11px;">Instant Account Activation</small>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Role" id="roleInstructor" value="Instructor" @(Model != null && Model.Role == "Instructor" ? "checked" : "") />
                            <label class="btn btn-outline-primary w-100 py-3 d-flex flex-column align-items-center rounded-3 shadow-xs" for="roleInstructor">
                                <i class="bi bi-mortarboard fs-3 mb-1"></i>
                                <span class="fw-bold">Educator / Teacher</span>
                                <small class="text-muted" style="font-size: 11px;">Subject to Admin Review</small>
                            </label>
                        </div>
                    </div>
                    @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger small" })
                </div>

                <!-- Bio / Qualifications Field (Shown especially for Instructors) -->
                <div class="mb-3" id="bioSection" style="@(Model != null && Model.Role == "Instructor" ? "" : "display:none;")">
                    @Html.LabelFor(m => m.Bio, new { @class = "form-label fw-bold small text-dark" })
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-card-text text-muted"></i></span>
                        @Html.TextAreaFor(m => m.Bio, new { @class = "form-control border-start-0", rows = "3", placeholder = "Share your educational background, subject expertise, degrees, or certifications (helps administrators verify your profile faster)..." })
                    </div>
                    <div class="form-text small text-muted" id="bioHelpText">
                        Recommended for instructor applicants to facilitate swift administrator approval.
                    </div>
                    @Html.ValidationMessageFor(m => m.Bio, "", new { @class = "text-danger small" })
                </div>

                <!-- Admin Approval Notice Banner -->
                <div class="alert alert-info py-2 px-3 small border-0 border-start border-3 border-info mb-3" id="approvalNotice">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-check text-info fs-5 me-2" id="noticeIcon"></i>
                        <div id="noticeText">
                            <strong>Registration Policy:</strong> Student accounts are activated immediately. Instructor accounts require administrator review and approval before platform access is granted.
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-3">
                    <i class="bi bi-check2-circle me-1"></i> Complete Registration
                </button>
            }

            <div class="text-center mt-3 small text-muted">
                Already registered? <a href="@Url.Action("Login", "Account")" class="text-primary fw-bold text-decoration-none">Sign In to Account</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            function updateRoleUi() {
                var isInstructor = $('#roleInstructor').is(':checked');
                if (isInstructor) {
                    $('#bioSection').slideDown();
                    $('#noticeIcon').removeClass('text-info').addClass('text-warning');
                    $('#approvalNotice').removeClass('alert-info').addClass('alert-warning');
                    $('#noticeText').html('<strong>Instructor Review Required:</strong> When you register as an Educator, your account will be placed in review until approved by an administrator. You will be redirected to a waiting screen upon submitting.');
                    $('#bioHelpText').html('<span class="text-primary fw-bold"><i class="bi bi-info-circle me-1"></i>Important:</span> Providing details about your qualifications and teaching experience will help administrators approve your application promptly.');
                } else {
                    $('#bioSection').slideUp();
                    $('#noticeIcon').removeClass('text-warning').addClass('text-info');
                    $('#approvalNotice').removeClass('alert-warning').addClass('alert-info');
                    $('#noticeText').html('<strong>Instant Access:</strong> As a student, your account is approved immediately upon registration. You can start browsing and enrolling in courses right away.');
                    $('#bioHelpText').html('Optional: Share a brief intro for your student profile.');
                }
            }

            $('input[name="Role"]').on('change', updateRoleUi);
            updateRoleUi();
        });
    </script>
}
