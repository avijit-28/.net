@model IEnumerable<LMS.Models.Course>
@{
    ViewBag.Title = "Course Portfolio Studio";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Course Studio</h2>
            <p class="text-muted small">Manage all created courses, curriculum structure, quizzes, and publish states</p>
        </div>
        <a href="@Url.Action("CreateCourse", "Instructor")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Course
        </a>
    </div>

    <div class="card card-custom shadow-sm border-0" style="overflow: visible !important; min-height: 280px;">
        <div class="table-responsive" style="overflow: visible !important; min-height: 250px;">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Course Title</th>
                        <th>Category</th>
                        <th>Level</th>
                        <th>Price</th>
                        <th>Students</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">No courses found. Click "Add New Course" to get started.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@c.Title</div>
                                    <small class="text-muted">Created: @c.CreatedDate.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@(c.Category?.CategoryName ?? "General")</span></td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@c.Level</span></td>
                                <td class="fw-semibold">@if (c.Price == 0) { <span class="text-success fw-bold">FREE</span> } else { <span><span class="rupee-symbol">&#8377;</span>@c.Price.ToString("N2")</span> }</td>
                                <td>
                                    <a href="@Url.Action("Students", "Instructor", new { courseId = c.CourseId })" class="text-decoration-none">
                                        @c.TotalStudents students &rarr;
                                    </a>
                                </td>
                                <td>
                                    <span class="rating-stars small"><i class="bi bi-star-fill"></i> @c.Rating.ToString("0.0")</span>
                                </td>
                                <td>
                                    <span class="badge @(c.Status == "Published" ? "bg-success" : (c.Status == "Draft" ? "bg-secondary" : "bg-dark")) px-2 py-1 rounded-pill">
                                        @c.Status
                                    </span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a href="@Url.Action("Modules", "Instructor", new { courseId = c.CourseId })" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold shadow-sm" title="Manage Modules and Lessons">
                                            <i class="bi bi-diagram-3 me-1"></i> Modules
                                        </a>
                                        <a href="@Url.Action("EditCourse", "Instructor", new { id = c.CourseId })" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Edit Course Details">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <div class="dropdown d-inline-block dropstart">
                                            <button class="btn btn-sm btn-light border rounded-pill px-2" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" title="More Options">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2" style="z-index: 1060; min-width: 190px;">
                                                <li><a class="dropdown-item" href="@Url.Action("Quizzes", "Instructor", new { courseId = c.CourseId })"><i class="bi bi-patch-question me-2"></i> Quizzes</a></li>
                                                <li><a class="dropdown-item" href="@Url.Action("Assignments", "Instructor", new { courseId = c.CourseId })"><i class="bi bi-file-earmark-text me-2"></i> Assignments</a></li>
                                                <li><a class="dropdown-item" href="@Url.Action("Students", "Instructor", new { courseId = c.CourseId })"><i class="bi bi-people me-2"></i> Enrolled Students</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                @if (c.Status != "Published")
                                                {
                                                    <li>
                                                        @using (Html.BeginForm("PublishCourse", "Instructor", new { id = c.CourseId }, FormMethod.Post))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-success fw-bold">
                                                                <i class="bi bi-cloud-upload me-2"></i> Publish Course
                                                            </button>
                                                        }
                                                    </li>
                                                }
                                                @if (c.TotalStudents == 0 || c.Status == "Draft")
                                                {
                                                    <li>
                                                        @using (Html.BeginForm("DeleteCourse", "Instructor", new { id = c.CourseId }, FormMethod.Post))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Are you sure you want to permanently delete course \'@Html.Raw(HttpUtility.JavaScriptStringEncode(c.Title))\'? This cannot be undone.');">
                                                                <i class="bi bi-trash me-2"></i> Delete Course
                                                            </button>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
