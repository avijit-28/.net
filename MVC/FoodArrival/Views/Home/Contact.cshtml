@{
    ViewBag.Title = "Contact Us - FoodReady";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<div class="py-5 text-white" style="background: linear-gradient(135deg, #1A202C 0%, #2D3748 100%);">
    <div class="container text-center py-4">
        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-3 shadow-sm">
            <i class="bi bi-headset me-1"></i> We're Here to Help
        </span>
        <h1 class="display-4 fw-bold mb-3">Get in Touch with FoodReady</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 680px;">
            Have questions about an active order, restaurant partnership, staff onboarding, or delivery fleet integration? Reach out to our 24/7 support teams.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 mb-5">
        <!-- Contact Information Cards -->
        <div class="col-lg-5">
            <h4 class="fw-bold mb-4">Direct Communication Channels</h4>

            <div class="d-flex align-items-start gap-3 p-3 bg-white rounded-4 shadow-sm border mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 48px; height: 48px; background: #FF5E1E;">
                    <i class="bi bi-telephone-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Customer Support Hotline</h6>
                    <p class="small text-muted mb-1">Available 24/7 for live order updates</p>
                    <a href="tel:18002004567" class="fw-bold text-primary text-decoration-none">+91 1800 200 4567 (Toll-Free)</a>
                </div>
            </div>

            <div class="d-flex align-items-start gap-3 p-3 bg-white rounded-4 shadow-sm border mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 48px; height: 48px; background: #0284C7;">
                    <i class="bi bi-shop fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Restaurant Partners & Fleet Desk</h6>
                    <p class="small text-muted mb-1">Inquiries for kitchen onboarding & affiliations</p>
                    <a href="mailto:partners@foodready.in" class="fw-bold text-primary text-decoration-none">partners@foodready.in</a>
                </div>
            </div>

            <div class="d-flex align-items-start gap-3 p-3 bg-white rounded-4 shadow-sm border mb-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 48px; height: 48px; background: #16A34A;">
                    <i class="bi bi-envelope-check-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Administrative Headquarters</h6>
                    <p class="small text-muted mb-1">FoodReady Technologies Pvt. Ltd.</p>
                    <div class="small text-dark fw-semibold">Sector 5, Salt Lake, Kolkata, West Bengal - 700091</div>
                </div>
            </div>

            <!-- Role Portals Direct Links -->
            <div class="p-3 rounded-4 bg-light border">
                <h6 class="fw-bold small text-muted mb-2 text-uppercase">Role Support Shortcuts</h6>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("Login", "Admin")" class="badge bg-dark text-white text-decoration-none p-2">Admin Portal</a>
                    <a href="@Url.Action("Login", "Restaurant")" class="badge bg-danger text-white text-decoration-none p-2">Restaurant Portal</a>
                    <a href="@Url.Action("Login", "Staff")" class="badge bg-primary text-white text-decoration-none p-2">Staff Portal</a>
                    <a href="@Url.Action("Login", "Rider")" class="badge bg-info text-dark text-decoration-none p-2">Rider Portal</a>
                </div>
            </div>
        </div>

        <!-- Interactive Contact Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h4 class="fw-bold mb-2">Send Us a Message</h4>
                <p class="text-muted small mb-4">Fill out the form below and our operations desk will reply within 30 minutes.</p>

                <form onsubmit="handleContactSubmit(event)">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Your Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="e.g. Priya Rout" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email Address <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" placeholder="priya@example.com" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Contact Phone (10 digits) <span class="text-danger">*</span></label>
                            <input type="tel" pattern="[0-9]{10}" class="form-control" placeholder="9876543210" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">I am reaching out as a:</label>
                            <select class="form-select">
                                <option value="Customer">Customer (Foodie)</option>
                                <option value="Restaurant">Restaurant Owner / Partner</option>
                                <option value="Staff">Kitchen Staff Member</option>
                                <option value="Rider">Delivery Rider</option>
                                <option value="General">General Inquiry</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Subject / Query Topic <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="e.g. Order Delivery Query or Partner Verification" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Detailed Message <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="4" placeholder="Describe your request in detail..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary-food w-100 py-2 fs-6 fw-bold shadow-sm" style="background: linear-gradient(135deg, #FF7A18, #FF5E1E); border-radius: 12px; height: 48px;">
                        <i class="bi bi-send-fill me-1"></i> Send Support Message
                    </button>
                </form>

                <div id="contactSuccessMsg" class="alert alert-success mt-3 rounded-3 small py-2 d-none" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> Thank you! Your support request has been logged. Ticket #FR-@(new Random().Next(10000, 99999)) created.
                </div>
            </div>
        </div>
    </div>

    <!-- Frequently Asked Questions Accordion -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <h4 class="fw-bold mb-4 text-center">Frequently Asked Questions</h4>
        <div class="accordion accordion-flush" id="faqAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="faqOne">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                        What is the 5-Minute Auto-Rejection Rule?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        To maintain high delivery velocity and prevent customers from waiting indefinitely, any order that remains in the Pending state for more than 5 minutes without kitchen confirmation is automatically marked as Rejected by our automated workflow, immediately notifying the customer.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="faqTwo">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                        How does restaurant verification work?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        When a restaurant owner registers, their application enters the administrative approval queue. Our platform admin verifies the kitchen address, food safety credentials, and contact details before activating the restaurant on the public menu.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="faqThree">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                        Can a delivery rider partner with more than one restaurant?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        Yes! A rider registers with an initial partner restaurant. Once verified, the rider can apply to partner with additional restaurants from their Rider Portal dashboard. Each affiliation is verified by that restaurant's owner or platform admin.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function handleContactSubmit(e) {
        e.preventDefault();
        var alertBox = document.getElementById("contactSuccessMsg");
        alertBox.classList.remove("d-none");
        e.target.reset();
    }
</script>
