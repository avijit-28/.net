@model IEnumerable<LMS.Models.Certificate>
@{
    ViewBag.Title = "My Earned Certificates";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">My Certificates of Completion</h2>
            <p class="text-muted small">Official credentials earned across verified course curriculums</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm">
            <i class="bi bi-award fs-1 text-muted mb-3"></i>
            <h5 class="fw-bold">No certificates earned yet.</h5>
            <p class="text-muted small mb-3">Complete 100% of the lessons in any enrolled course to automatically receive your verified certificate.</p>
            <div>
                <a href="@Url.Action("MyCourses", "Student")" class="btn btn-primary rounded-pill px-4">Go to My Courses</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cert in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom p-4 shadow-sm h-100 border-top border-4 border-warning">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 rounded-pill small fw-bold">
                                <i class="bi bi-award-fill me-1"></i> Verified
                            </span>
                            <small class="text-muted">@cert.IssueDate.ToString("MMM dd, yyyy")</small>
                        </div>

                        <h5 class="fw-bold text-dark mb-2">@(cert.Course?.Title ?? "Course")</h5>
                        <p class="small text-muted mb-3">Certificate ID: <strong>@cert.CertificateNumber</strong></p>

                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-3 border">
                            <span class="small text-muted">Final Score:</span>
                            <span class="fw-bold text-success">@(cert.FinalScore.HasValue ? cert.FinalScore.Value.ToString("0.0") + "%" : "100.0%")</span>
                        </div>

                        <div class="d-flex gap-2 mt-auto">
                            <a href="@Url.Action("ViewCertificate", "Certificate", new { id = cert.CertificateId })" class="btn btn-sm btn-primary rounded-pill w-100 fw-semibold">
                                <i class="bi bi-eye-fill me-1"></i> View Certificate
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
