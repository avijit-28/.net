@model FoodArrival.Models.LoginViewModel
@{
    ViewBag.Title = "Account Login - FoodReady";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="auth-container shadow-lg rounded-5 overflow-hidden" style="max-width: 900px; margin: 0 auto; background: #FFFFFF;">
        <div class="row g-0">
            <!-- Left Banner (Matching Image 3: Dark food backdrop with bowl of noodles) -->
            <div class="col-lg-5 p-5 text-white d-flex flex-column justify-content-center position-relative" style="background: linear-gradient(rgba(17, 24, 39, 0.88), rgba(17, 24, 39, 0.95)), url('/Content/images/noodles.jpg') center/cover no-repeat; min-height: 480px;">
                <div class="mb-4">
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2C9.5 2 7.5 3.8 7.1 6.1C5.3 6.6 4 8.2 4 10.2C4 12.3 5.5 14 7.5 14.3V18C7.5 19.1 8.4 20 9.5 20H14.5C15.6 20 16.5 19.1 16.5 18V14.3C18.5 14 20 12.3 20 10.2C20 8.2 18.7 6.6 16.9 6.1C16.5 3.8 14.5 2 12 2Z" fill="#FF5E1E" />
                        <path d="M9 11V16M12 10V16M15 11V16" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </div>
                <h1 class="fw-bold mb-3" style="font-size: 2.2rem; letter-spacing: -0.5px;">Welcome Back!</h1>
                <p class="text-white-50 mb-4" style="line-height: 1.6; font-size: 1.05rem;">
                    Login to your FoodReady account and continue ordering delicious food.
                </p>

                <!-- Bowl of noodles / food image accent -->
                <div class="mt-auto text-center">
                    <img src="~/Content/images/noodles.jpg" alt="Delicious Food" class="rounded-circle shadow-lg border border-3 border-warning border-opacity-50" style="width: 120px; height: 120px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=200&q=80'" />
                </div>
            </div>

            <!-- Right Login Form (Faithfully matching Image 3) -->
            <div class="col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center bg-white">
                <div class="text-center mb-4">
                    <!-- Orange User Avatar Icon -->
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 56px; height: 56px; background: #FFF0EB; color: #FF5E1E;">
                        <i class="bi bi-person-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Customer / Partner Login</h3>
                    <p class="text-muted small">Enter your credentials to access your portal</p>
                </div>

                @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                    <!-- Email Address or Username -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Email or Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0 ps-0", placeholder = "Email address or username", required = "required" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Password with Eye Toggle Icon -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0 border-end-0 ps-0", id = "loginPassword", placeholder = "Enter password", required = "required" })
                            <button type="button" class="input-group-text bg-white border-start-0 text-muted btn-toggle-password" onclick="togglePasswordVisibility('loginPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Remember me & Forgot Password -->
                    <div class="d-flex justify-content-between align-items-center mb-4 small">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "rememberMeCheck" })
                            <label class="form-check-label text-muted" for="rememberMeCheck">Remember me</label>
                        </div>
                        <a href="@Url.Action("PasswordRecovery", "Account")" class="text-primary text-decoration-none fw-semibold">Forgot Password?</a>
                    </div>

                    <!-- Big Vibrant Orange Login Button -->
                    <button type="submit" class="btn btn-primary-food w-100 py-2 fs-6 fw-bold shadow-sm" style="background: linear-gradient(135deg, #FF7A18, #FF5E1E); border-radius: 12px; height: 48px;">
                        Login
                    </button>

                    <!-- Sign Up Switcher -->
                    <div class="text-center mt-4 small text-muted">
                        Don't have an account? <a href="@Url.Action("Register", "Account")" class="fw-bold text-decoration-none" style="color: #FF5E1E;">Sign Up</a>
                    </div>

                    <!-- Demo Credentials Helper Pill -->
                    <div class="mt-4 p-3 bg-light rounded-4 small text-muted border">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-key-fill text-warning me-1"></i> Quick Test Credentials:</div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-dark">Admin: avi@123 / 28072003</span>
                            <span class="badge bg-secondary">Customer: john@example.com / 12345</span>
                            <span class="badge bg-danger">Restaurant: restaurant@example.com / rest123</span>
                            <span class="badge bg-primary">Staff: staff@example.com / Staff@123</span>
                            <span class="badge bg-info text-dark">Rider: rider@example.com / rider123</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon = btn.querySelector('i');
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = "password";
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye-solid');
        }
    }
</script>
