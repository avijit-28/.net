@model IEnumerable<LMS.Models.Module>
@{
    var course = ViewBag.Course as LMS.Models.Course;
    ViewBag.Title = "Modules - " + (course?.Title ?? "Course");
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")" class="text-decoration-none">My Courses</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modules</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-info-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Curriculum Architecture
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Syllabus Modules: @(course?.Title ?? "Course")</h2>
            <p class="text-muted small mb-0">Structure your curriculum into sequential learning chapters, lessons, and assignments</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Courses
            </a>
            <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addModuleModal">
                <i class="bi bi-plus-circle me-1"></i> Add Module
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white border-0">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-diagram-3 text-muted display-4"></i>
            </div>
            <h4 class="fw-bold">No modules created yet</h4>
            <p class="text-muted small mb-3">Organize your course syllabus by creating your first module below.</p>
            <div>
                <button class="btn btn-primary rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#addModuleModal">
                    <i class="bi bi-plus-circle me-1"></i> Add First Module
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var mod in Model)
            {
                <div class="col-12">
                    <div class="card card-custom p-4 shadow-sm bg-white border-0 card-hover">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <span class="badge bg-secondary-subtle text-secondary small mb-1 rounded-pill px-3 py-1">Chapter Order #@mod.ModuleOrder</span>
                                <h5 class="fw-bold text-dark mb-1">@mod.ModuleName</h5>
                                <p class="small text-muted mb-2">@(string.IsNullOrEmpty(mod.Description) ? "Comprehensive module curriculum unit." : mod.Description)</p>
                                <span class="badge badge-primary-subtle text-primary small rounded-pill px-3 py-1">
                                    <i class="bi bi-collection-play me-1"></i> @mod.Lessons.Count Lessons Included
                                </span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-self-start align-self-md-auto">
                                <a href="@Url.Action("Lessons", "Instructor", new { moduleId = mod.ModuleId })" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold shadow-sm">
                                    <i class="bi bi-folder2-open me-1"></i> Manage Lessons (@mod.Lessons.Count)
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#editModuleModal_@mod.ModuleId">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </button>
                                @using (Html.BeginForm("DeleteModule", "Instructor", new { id = mod.ModuleId }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Are you sure you want to permanently delete module \'@Html.Raw(HttpUtility.JavaScriptStringEncode(mod.ModuleName))\' and all its lessons?');">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Edit Module Modal for @mod.ModuleId -->
                    <div class="modal fade" id="editModuleModal_@mod.ModuleId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow-lg rounded-4">
                                <div class="modal-header border-bottom py-3">
                                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Course Module</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                @using (Html.BeginForm("EditModule", "Instructor", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ModuleId" value="@mod.ModuleId" />
                                    <input type="hidden" name="CourseId" value="@mod.CourseId" />
                                    <div class="modal-body p-4">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold small text-dark">Module Name</label>
                                            <input type="text" name="ModuleName" class="form-control" value="@mod.ModuleName" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold small text-dark">Description</label>
                                            <textarea name="Description" class="form-control" rows="3">@mod.Description</textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold small text-dark">Sequence Order</label>
                                            <input type="number" name="ModuleOrder" class="form-control" value="@mod.ModuleOrder" min="1" required />
                                        </div>
                                    </div>
                                    <div class="modal-footer border-top py-3">
                                        <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">Save Changes</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add Module Modal -->
<div class="modal fade" id="addModuleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-diagram-3 me-2 text-primary"></i>Add Course Module</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("CreateModule", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="CourseId" value="@(course?.CourseId ?? 0)" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Module Name</label>
                        <input type="text" name="ModuleName" class="form-control" placeholder="e.g. Module 1: Foundational Architecture" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Outline specific competencies and topics covered in this module..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Sequence Order</label>
                        <input type="number" name="ModuleOrder" class="form-control" value="@(Model.Count() + 1)" min="1" required />
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">Save Module</button>
                </div>
            }
        </div>
    </div>
</div>
