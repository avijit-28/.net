@model LMS.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "Platform Reports & Analytics";
    var completionRate = Model.TotalEnrollments > 0 ? (int)((double)Model.TotalCertificates / Model.TotalEnrollments * 100) : 0;
    var avgRevenuePerStudent = Model.TotalStudents > 0 ? Model.TotalRevenue / Model.TotalStudents : 0;

    var catNames = Model.CategoryStats != null && Model.CategoryStats.Any() 
        ? string.Join(",", Model.CategoryStats.Select(c => $"\"{HttpUtility.JavaScriptStringEncode(c.CategoryName)}\""))
        : "\"General\"";
    var catCounts = Model.CategoryStats != null && Model.CategoryStats.Any()
        ? string.Join(",", Model.CategoryStats.Select(c => c.CourseCount))
        : "1";

    var adminShare = Model.TotalRevenue * 0.05m;
    var teacherShare = Model.TotalRevenue * 0.95m;
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Reports & Analytics</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Executive Telemetry
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Operational Reports & Analytics</h2>
            <p class="text-muted small mb-0">Platform health KPIs, interactive analytics charts, completion velocity, and financial breakdown</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("ExportReportPdf", "Admin")" class="btn btn-outline-danger rounded-pill px-3 fw-semibold shadow-xs">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Export PDF Report
            </a>
            <a href="@Url.Action("ExportReportCsv", "Admin")" class="btn btn-outline-success rounded-pill px-3 fw-semibold shadow-xs">
                <i class="bi bi-file-earmark-spreadsheet-fill me-1"></i> Export CSV
            </a>
            <button class="btn btn-outline-secondary rounded-pill px-3 fw-semibold shadow-xs" onclick="window.print();">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- Core KPI Matrix -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card p-4 shadow-sm h-100 card-hover border-0" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12) !important; border-left: 4px solid #10b981 !important;">
                <span class="small text-white-50 fw-bold text-uppercase" style="font-size: 11px;">Completion Rate</span>
                <div class="fs-2 fw-extrabold text-success mt-1">@completionRate%</div>
                <small class="text-white-50 mt-1">@Model.TotalCertificates / @Model.TotalEnrollments finished</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card p-4 shadow-sm h-100 card-hover border-0" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12) !important; border-left: 4px solid #4f46e5 !important;">
                <span class="small text-white-50 fw-bold text-uppercase" style="font-size: 11px;">Avg Revenue / Learner</span>
                <div class="fs-2 fw-extrabold text-cyan mt-1"><span class="rupee-symbol">&#8377;</span>@avgRevenuePerStudent.ToString("N2")</div>
                <small class="text-white-50 mt-1">Gross lifetime learner value</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card p-4 shadow-sm h-100 card-hover border-0" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12) !important; border-left: 4px solid #06b6d4 !important;">
                <span class="small text-white-50 fw-bold text-uppercase" style="font-size: 11px;">Published Catalog Ratio</span>
                <div class="fs-2 fw-extrabold text-info mt-1">
                    @(Model.TotalCourses > 0 ? ((int)((double)Model.PublishedCourses / Model.TotalCourses * 100)).ToString() : "0")%
                </div>
                <small class="text-white-50 mt-1">@Model.PublishedCourses active of @Model.TotalCourses total</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card p-4 shadow-sm h-100 card-hover border-0" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12) !important; border-left: 4px solid #FF7A18 !important;">
                <span class="small text-white-50 fw-bold text-uppercase" style="font-size: 11px;">Learner-Instructor Ratio</span>
                <div class="fs-2 fw-extrabold text-orange mt-1">
                    @(Model.TotalInstructors > 0 ? (Model.TotalStudents / Model.TotalInstructors).ToString() : "0"):1
                </div>
                <small class="text-white-50 mt-1">@Model.TotalStudents learners / @Model.TotalInstructors faculty</small>
            </div>
        </div>
    </div>

    <!-- Interactive Data Visualization Charts -->
    <div class="row g-4 mb-4">
        <!-- Revenue Distribution & Earnings Stream -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 p-4 h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12) !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-white"><i class="bi bi-graph-up-arrow me-2 text-cyan"></i>Financial Distribution Telemetry</h5>
                        <small class="text-white-50">Total platform revenue split: Instructor payout (95%) vs Admin reserve (5%)</small>
                    </div>
                    <span class="badge rounded-pill px-3 py-1 font-monospace fw-bold" style="background: rgba(39, 184, 214, 0.2); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.4);">
                        Total: <span class="rupee-symbol">&#8377;</span>@Model.TotalRevenue.ToString("N2")
                    </span>
                </div>
                <div style="position: relative; height: 280px;">
                    <canvas id="revenueBreakdownChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Category & Domain Share Doughnut Chart -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 p-4 h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12) !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-white"><i class="bi bi-pie-chart-fill me-2 text-info"></i>Domain Distribution</h5>
                        <small class="text-white-50">Curriculum share across categories</small>
                    </div>
                    <span class="badge rounded-pill px-2 py-1 small" style="background: rgba(255, 255, 255, 0.1); color: #E2E8F0; border: 1px solid rgba(255, 255, 255, 0.2);">
                        @(Model.CategoryStats != null ? Model.CategoryStats.Count : 0) Domains
                    </span>
                </div>
                <div style="position: relative; height: 280px;">
                    <canvas id="categoryDistributionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Learner Completion Funnel Bar Chart -->
    <div class="card shadow-sm border-0 p-4 mb-4" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12) !important;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-0 text-white"><i class="bi bi-bar-chart-line-fill me-2 text-success"></i>Learner Milestone & Completion Funnel</h5>
                <small class="text-white-50">Overview of platform user pipeline: registered accounts, enrolled learners, and verified certificate recipients</small>
            </div>
            <span class="badge rounded-pill px-3 py-1 fw-bold" style="background: rgba(53, 201, 138, 0.2); color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.4);">
                @Model.TotalCertificates Credentials Issued
            </span>
        </div>
        <div style="position: relative; height: 240px;">
            <canvas id="learnerMilestoneChart"></canvas>
        </div>
    </div>

    <!-- Category Distribution & System Health Details Table -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-0 overflow-hidden" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12) !important;">
                <div class="card-header py-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="background: rgba(11, 52, 69, 0.7); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                    <h5 class="fw-bold mb-0 text-white"><i class="bi bi-list-check me-2 text-cyan"></i>Category Details</h5>
                    <span class="badge rounded-pill small" style="background: rgba(39, 184, 214, 0.2); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.4);">@(Model.CategoryStats != null ? Model.CategoryStats.Count : 0) Active</span>
                </div>
                <div class="card-body p-4">
                    @if (Model.CategoryStats == null || !Model.CategoryStats.Any())
                    {
                        <p class="text-white-50 text-center py-4">No categories recorded.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 text-white" style="border-color: rgba(255, 255, 255, 0.08);">
                                <thead style="background: rgba(4, 24, 34, 0.8); font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                    <tr>
                                        <th class="text-white-50">Category Name</th>
                                        <th class="text-white-50">Courses</th>
                                        <th class="text-white-50">Catalog Share</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cat in Model.CategoryStats)
                                    {
                                        var pct = Model.TotalCourses > 0 ? (int)((double)cat.CourseCount / Model.TotalCourses * 100) : 0;
                                        <tr>
                                            <td class="fw-semibold text-white">@cat.CategoryName</td>
                                            <td><span class="badge rounded-pill px-2 py-1" style="background: rgba(39, 184, 214, 0.2); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.4);">@cat.CourseCount courses</span></td>
                                            <td style="width: 45%;">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 6px; background: rgba(255, 255, 255, 0.1);">
                                                        <div class="progress-bar" role="progressbar" style="width: @pct%; background-color: #27B8D6;"></div>
                                                    </div>
                                                    <span class="small fw-bold text-white">@pct%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-0 overflow-hidden" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12) !important;">
                <div class="card-header py-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="background: rgba(11, 52, 69, 0.7); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                    <h5 class="fw-bold mb-0 text-white"><i class="bi bi-shield-check me-2 text-success"></i>System Health & Infrastructure</h5>
                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(53, 201, 138, 0.2); color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.4);">
                        <span class="pulse-dot pulse-success"></span> All Services Online
                    </span>
                </div>
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3" style="background: transparent; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                            <div>
                                <div class="fw-bold text-white">Database Engine</div>
                                <small class="text-white-50">Microsoft SQL Server & Entity Framework 6 Live</small>
                            </div>
                            <span class="badge rounded-pill px-3 py-1" style="background: rgba(53, 201, 138, 0.2); color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.4);"><i class="bi bi-check-circle me-1"></i>Operational</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3" style="background: transparent; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                            <div>
                                <div class="fw-bold text-white">Report & Document Engine</div>
                                <small class="text-white-50">High-precision vector PDF rendering pipeline</small>
                            </div>
                            <span class="badge rounded-pill px-3 py-1" style="background: rgba(53, 201, 138, 0.2); color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.4);"><i class="bi bi-check-circle me-1"></i>Ready</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3" style="background: transparent; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                            <div>
                                <div class="fw-bold text-white">Commission Split Engine</div>
                                <small class="text-white-50">Automated 5% Platform / 95% Faculty revenue allocation</small>
                            </div>
                            <span class="badge rounded-pill px-3 py-1" style="background: rgba(53, 201, 138, 0.2); color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.4);"><i class="bi bi-check-circle me-1"></i>Active</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3" style="background: transparent; border-bottom: none;">
                            <div>
                                <div class="fw-bold text-white">Certification Gatekeeper</div>
                                <small class="text-white-50">Mandatory 100% module + final exam clearance verification</small>
                            </div>
                            <span class="badge rounded-pill px-3 py-1" style="background: rgba(53, 201, 138, 0.2); color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.4);"><i class="bi bi-check-circle me-1"></i>Enforced</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Revenue Breakdown Bar Chart
            var revCtx = document.getElementById('revenueBreakdownChart');
            if (revCtx) {
                new Chart(revCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Gross Revenue', 'Faculty Earnings (95%)', 'Admin Platform Fee (5%)'],
                        datasets: [{
                            label: 'Amount (INR)',
                            data: [@Model.TotalRevenue, @teacherShare, @adminShare],
                            backgroundColor: [
                                'rgba(79, 70, 229, 0.85)',
                                'rgba(16, 185, 129, 0.85)',
                                'rgba(245, 158, 11, 0.85)'
                            ],
                            borderColor: [
                                '#4f46e5',
                                '#10b981',
                                '#f59e0b'
                            ],
                            borderWidth: 1,
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return '\u20B9' + value.toLocaleString(); }
                                }
                            }
                        }
                    }
                });
            }

            // 2. Category Distribution Doughnut Chart
            var catCtx = document.getElementById('categoryDistributionChart');
            if (catCtx) {
                new Chart(catCtx, {
                    type: 'doughnut',
                    data: {
                        labels: [@Html.Raw(catNames)],
                        datasets: [{
                            data: [@catCounts],
                            backgroundColor: [
                                '#4f46e5', '#06b6d4', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#14b8a6'
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }

            // 3. Learner Milestone Funnel Chart
            var mileCtx = document.getElementById('learnerMilestoneChart');
            if (mileCtx) {
                new Chart(mileCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Total Students Registered', 'Total Course Enrollments', 'Certificates Earned'],
                        datasets: [{
                            label: 'Volume',
                            data: [@Model.TotalStudents, @Model.TotalEnrollments, @Model.TotalCertificates],
                            backgroundColor: [
                                'rgba(6, 182, 212, 0.8)',
                                'rgba(79, 70, 229, 0.8)',
                                'rgba(16, 185, 129, 0.8)'
                            ],
                            borderColor: ['#06b6d4', '#4f46e5', '#10b981'],
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { beginAtZero: true }
                        }
                    }
                });
            }
        });
    </script>
}
