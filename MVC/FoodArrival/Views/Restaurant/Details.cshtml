@model FoodArrival.Models.Restaurant
@{
    ViewBag.Title = "Restaurant Details - FoodReady";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center mb-4">
                <div class="mx-auto mb-3" style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #EA580C, #C2410C); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 2rem;">
                    <i class="bi bi-shop"></i>
                </div>
                <h5 class="fw-bold mb-0">@Model.RestaurantName</h5>
                <span class="badge bg-warning bg-opacity-25 text-dark border rounded-pill mt-1">Restaurant Partner</span>
                <p class="text-muted small mt-2 mb-0">@Model.Email</p>
                <div class="mt-2 text-warning small">
                    <i class="bi bi-star-fill"></i> @Model.Rating.ToString("F1") Rating
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="nav flex-column">
                    <a href="@Url.Action("Dashboard", "Restaurant")" class="category-pill">
                        <i class="bi bi-receipt me-2"></i> Kitchen Queue
                    </a>
                    <a href="@Url.Action("Details", "Restaurant")" class="category-pill active">
                        <i class="bi bi-info-circle me-2"></i> Restaurant Details
                    </a>
                    <hr class="my-2" />
                    <a href="@Url.Action("Logout", "Restaurant")" class="category-pill text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Restaurant Details Form -->
        <div class="col-lg-9 col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold mb-1">Restaurant Details & Settings</h3>
                        <p class="text-muted small mb-0">Manage kitchen profile, address, contact phone, and cuisine specifications</p>
                    </div>
                    <a href="@Url.Action("Dashboard", "Restaurant")" class="btn btn-outline-food btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Kitchen Orders
                    </a>
                </div>

                @using (Html.BeginForm("Details", "Restaurant", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3 small" })
                    @Html.HiddenFor(m => m.RestaurantId)
                    @Html.HiddenFor(m => m.Email)

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Restaurant Name</label>
                            @Html.TextBoxFor(m => m.RestaurantName, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.RestaurantName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Login Email (Read-only)</label>
                            <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Contact Phone</label>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "10-digit contact number" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Primary Cuisine Specialization</label>
                            @Html.TextBoxFor(m => m.Cuisine, new { @class = "form-control", placeholder = "e.g. Multi-Cuisine, Italian, Burgers" })
                            @Html.ValidationMessageFor(m => m.Cuisine, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Physical Kitchen Address</label>
                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "3", placeholder = "Street, Area, City" })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Restaurant Banner / Storefront Photo</label>
                        <input type="file" name="bannerImage" class="form-control mb-2" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-2">
                                <img src="@Model.ImageUrl" alt="Restaurant Front" class="rounded-3 shadow-sm" style="max-height: 120px; object-fit: cover;" />
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Dashboard", "Restaurant")" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary-food px-4 fw-bold">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
