<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FoodReady | Delicious Food Delivered</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    @{
        var cart = Session["Cart"] as List<FoodArrival.Models.CartItem>;
        int cartCount = cart != null ? cart.Sum(x => x.Quantity) : 0;
        string userRole = Session["UserRole"]?.ToString() ?? "Guest";
        bool isCustomer = userRole == "Customer";
        bool isAdmin = userRole == "Admin";
        bool isRestaurant = userRole == "Restaurant";
        bool isStaff = userRole == "RestaurantStaff";
        bool isRider = userRole == "Rider";
        string userName = null;
        if (isCustomer) { userName = Session["CustomerName"]?.ToString(); }
        else if (isAdmin) { userName = Session["AdminName"]?.ToString(); }
        else if (isRestaurant) { userName = Session["RestaurantName"]?.ToString(); }
        else if (isStaff) { userName = Session["StaffName"]?.ToString(); }
        else if (isRider) { userName = Session["RiderName"]?.ToString(); }
    }

    <!-- Main Navigation Bar (Clean matching Image 2 & 3 without top announcement bar) -->
    <header>
        <nav class="navbar navbar-expand-lg foodready-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand brand-logo" href="@Url.Action("Index", "Home")">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C9.5 2 7.5 3.8 7.1 6.1C5.3 6.6 4 8.2 4 10.2C4 12.3 5.5 14 7.5 14.3V18C7.5 19.1 8.4 20 9.5 20H14.5C15.6 20 16.5 19.1 16.5 18V14.3C18.5 14 20 12.3 20 10.2C20 8.2 18.7 6.6 16.9 6.1C16.5 3.8 14.5 2 12 2Z" fill="#FF5E1E" />
                        <path d="M9 11V16M12 10V16M15 11V16" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <span>Food<span class="highlight">Ready</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" href="@Url.Action("Index", "Home")">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Food" ? "active" : "")" href="@Url.Action("Index", "Food")">Menu</a>
                        </li>
                        <li class="nav-item">
                            @if (isRider)
                            {
                                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rider" ? "active" : "")" href="@Url.Action("Dashboard", "Rider")">Track Trips</a>
                            }
                            else if (isRestaurant)
                            {
                                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Restaurant" ? "active" : "")" href="@Url.Action("Dashboard", "Restaurant")">Live Orders</a>
                            }
                            else if (isStaff)
                            {
                                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" ? "active" : "")" href="@Url.Action("Dashboard", "Staff")">Kitchen Queue</a>
                            }
                            else if (isAdmin)
                            {
                                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "active" : "")" href="@Url.Action("Orders", "Admin")">Manage Orders</a>
                            }
                            else
                            {
                                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" && ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")" href="@Url.Action("History", "Order")">Track Order</a>
                            }
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" href="@Url.Action("About", "Home")">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" href="@Url.Action("Contact", "Home")">Contact</a>
                        </li>

                        @if (isRestaurant)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-danger fw-bold" href="@Url.Action("Dashboard", "Restaurant")">
                                    <i class="bi bi-shop me-1"></i> Kitchen Dashboard
                                </a>
                            </li>
                        }
                        @if (isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-primary fw-bold" href="@Url.Action("Dashboard", "Staff")">
                                    <i class="bi bi-person-badge-fill me-1"></i> Staff PMS
                                </a>
                            </li>
                        }
                        @if (isRider)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-info fw-bold" href="@Url.Action("Dashboard", "Rider")">
                                    <i class="bi bi-scooter me-1"></i> Rider Trips
                                </a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-warning fw-bold" href="@Url.Action("Dashboard", "Admin")">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Admin Panel
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Notifications Bell Dropdown -->
                        <div class="dropdown position-relative">
                            <button class="btn btn-light rounded-circle position-relative p-2 border-0" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                                <i class="bi bi-bell fs-5 text-dark"></i>
                                <span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light" style="display:none; font-size:0.65rem;">
                                    0
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 rounded-4" style="width: 320px; max-height: 420px; overflow-y: auto;" aria-labelledby="notifDropdown">
                                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bell-fill text-warning me-1"></i> Notifications</h6>
                                    <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted" id="btn-mark-notif-read">Mark all read</button>
                                </div>
                                <div id="notif-list" class="p-2">
                                    <div class="text-center py-4 text-muted small">Loading updates...</div>
                                </div>
                            </div>
                        </div>

                        <!-- Cart Icon -->
                        <a href="@Url.Action("PlaceOrder", "Order")" class="position-relative text-dark p-2" title="View Cart">
                            <i class="bi bi-cart3 fs-4 text-dark"></i>
                            <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger @(cartCount > 0 ? "" : "d-none")">
                                @cartCount
                            </span>
                        </a>

                        @if (isCustomer)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-food dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@userName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li><a class="dropdown-item py-2" href="@Url.Action("History", "Order")"><i class="bi bi-bag-check me-2 text-warning"></i> My Orders</a></li>
                                    <li><a class="dropdown-item py-2" href="@Url.Action("Profile", "Account")"><i class="bi bi-person me-2 text-primary"></i> My Profile</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                                </ul>
                            </div>
                        }
                        else if (isAdmin)
                        {
                            <div class="dropdown">
                                <button class="btn btn-primary-food dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-check"></i>
                                    <span>Admin: @userName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li><a class="dropdown-item py-2" href="@Url.Action("Dashboard", "Admin")"><i class="bi bi-speedometer2 me-2 text-warning"></i> Dashboard Overview</a></li>
                                    <li><a class="dropdown-item py-2" href="@Url.Action("Orders", "Admin")"><i class="bi bi-card-checklist me-2 text-primary"></i> Orders Queue</a></li>
                                    <li><a class="dropdown-item py-2" href="@Url.Action("FoodItems", "Admin")"><i class="bi bi-egg-fried me-2 text-success"></i> Food Items</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Admin")"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                                </ul>
                            </div>
                        }
                        else if (isRestaurant)
                        {
                            <div class="dropdown">
                                <button class="btn btn-danger dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shop"></i>
                                    <span>Kitchen: @userName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li><a class="dropdown-item py-2" href="@Url.Action("Dashboard", "Restaurant")"><i class="bi bi-receipt me-2"></i> Kitchen Queue</a></li>
                                    <li><a class="dropdown-item py-2" href="@Url.Action("Details", "Restaurant")"><i class="bi bi-info-circle me-2"></i> Restaurant Details</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Restaurant")"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                                </ul>
                            </div>
                        }
                        else if (isStaff)
                        {
                            <div class="dropdown">
                                <button class="btn btn-primary dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-badge"></i>
                                    <span>Staff: @userName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li><a class="dropdown-item py-2" href="@Url.Action("Dashboard", "Staff")"><i class="bi bi-speedometer2 me-2"></i> PMS Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Staff")"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                                </ul>
                            </div>
                        }
                        else if (isRider)
                        {
                            <div class="dropdown">
                                <button class="btn btn-info text-white dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-scooter"></i>
                                    <span>Rider: @userName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li><a class="dropdown-item py-2" href="@Url.Action("Dashboard", "Rider")"><i class="bi bi-bicycle me-2"></i> Deliveries</a></li>
                                    <li><a class="dropdown-item py-2" href="@Url.Action("Profile", "Rider")"><i class="bi bi-person-badge me-2"></i> Rider Profile</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Rider")"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-food">Login</a>
                            <a href="@Url.Action("Register", "Account")" class="btn btn-primary-food">Sign Up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Toast / TempData Alerts -->
    <div class="container mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div>@TempData["Error"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="foodready-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2C9.5 2 7.5 3.8 7.1 6.1C5.3 6.6 4 8.2 4 10.2C4 12.3 5.5 14 7.5 14.3V18C7.5 19.1 8.4 20 9.5 20H14.5C15.6 20 16.5 19.1 16.5 18V14.3C18.5 14 20 12.3 20 10.2C20 8.2 18.7 6.6 16.9 6.1C16.5 3.8 14.5 2 12 2Z" fill="#FF5E1E" />
                        </svg>
                        <h5 class="text-white mb-0 fw-bold">Food<span class="text-warning">Ready</span></h5>
                    </div>
                    <p class="small text-muted mb-3">
                        Fresh, hot and delicious meals delivered fast to your doorstep. Supporting Customers, Restaurants, Riders, and Staff on a unified platform.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-light fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-light fs-5"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-light fs-5"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="mb-2"><a href="@Url.Action("Index", "Food")">Browse Menu</a></li>
                        <li class="mb-2"><a href="@Url.Action("PlaceOrder", "Order")">My Cart</a></li>
                        <li class="mb-2"><a href="@Url.Action("History", "Order")">Track Orders</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Ecosystem Roles</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="@Url.Action("Register", "Account", new { role = "Customer" })"><i class="bi bi-person-heart me-1 text-warning"></i> Customer Sign Up</a></li>
                        <li class="mb-2"><a href="@Url.Action("Register", "Account", new { role = "RestaurantOwner" })"><i class="bi bi-shop me-1 text-danger"></i> Restaurant Owner</a></li>
                        <li class="mb-2"><a href="@Url.Action("Register", "Account", new { role = "RestaurantStaff" })"><i class="bi bi-person-badge me-1 text-primary"></i> Restaurant Staff</a></li>
                        <li class="mb-2"><a href="@Url.Action("Register", "Account", new { role = "Rider" })"><i class="bi bi-scooter me-1 text-info"></i> Delivery Rider</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">24/7 Helpline</h6>
                    <p class="small text-muted mb-1"><i class="bi bi-geo-alt-fill text-warning me-2"></i> 124 Food Street, Central City</p>
                    <p class="small text-muted mb-1"><i class="bi bi-telephone-fill text-warning me-2"></i> +91 98765 43210</p>
                    <p class="small text-muted mb-1"><i class="bi bi-envelope-fill text-warning me-2"></i> support@foodready.com</p>
                </div>
            </div>
            <hr class="border-secondary my-3" />
            <div class="d-flex flex-wrap justify-content-between align-items-center small text-muted">
                <p class="mb-0">&copy; @DateTime.Now.Year FoodReady Platform. All rights reserved.</p>
                <div>
                    <a href="@Url.Action("About", "Home")" class="me-3">About Us</a>
                    <a href="@Url.Action("Contact", "Home")">Contact Support</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/site.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
