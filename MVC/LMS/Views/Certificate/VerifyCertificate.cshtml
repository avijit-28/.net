@{
    ViewBag.Title = "Verify Certificate of Completion";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 p-md-5 shadow-sm text-center">
            <div class="mb-3">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-6 fw-bold">
                    <i class="bi bi-patch-check-fill me-1"></i> Credential Verification
                </span>
            </div>
            <h2 class="fw-bold mb-2">Verify Certificate</h2>
            <p class="text-muted small mb-4">
                Enter the unique certificate number found on any official LMS certificate to verify its validity and accreditation.
            </p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show text-start mb-4" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>@ViewBag.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @using (Html.BeginForm("Verify", "Certificate", FormMethod.Get, new { @class = "text-start" }))
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Certificate ID / Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-upc-scan text-muted"></i></span>
                        <input type="text" name="certNumber" class="form-control" placeholder="e.g. LMS-2026-123456" required />
                    </div>
                    <small class="text-muted">Format: LMS-YEAR-XXXXXX</small>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold shadow-sm">
                        <i class="bi bi-search me-1"></i> Verify Credential
                    </button>
                </div>
            }

            <div class="mt-4 pt-3 border-top">
                <a href="@Url.Action("Index", "Home")" class="text-decoration-none small text-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>
