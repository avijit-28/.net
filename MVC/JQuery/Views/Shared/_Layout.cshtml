<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Enterprise MVC Data Hub</title>
    
    <!-- Bootstrap 5 CSS -->
    @Styles.Render("~/Content/css")
    
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- jQuery DataTables + Bootstrap 5 Theme + Responsive + Buttons -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    
    <!-- JSGrid CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid-theme.min.css" />
    
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    
    <!-- Core jQuery (Pre-loaded in head for early scripts) -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- Top Navigation Header -->
    <header class="app-header navbar navbar-expand-xl navbar-dark sticky-top shadow-sm py-2">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center me-4" href="@Url.Action("Index", "Home")">
                <div class="bg-primary text-white p-2 rounded-3 me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div>
                    <span class="fw-bold tracking-tight text-white">Enterprise Data Hub</span>
                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 ms-1 small">ASP.NET MVC</span>
                </div>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarAppHub"
                    aria-controls="navbarAppHub" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarAppHub">
                <ul class="navbar-nav me-auto mb-2 mb-xl-0 gap-1" id="mainNavbarNav">
                    <li class="nav-item">
                        <a class="nav-link text-light nav-hub-item" data-tab-target="#tab-datatable" href="@Url.Action("Index", "Home")#tab-datatable">
                            <i class="fa-solid fa-table me-1 text-primary"></i> DataTables Studio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light nav-hub-item" data-tab-target="#tab-jsgrid" href="@Url.Action("Index", "Home")#tab-jsgrid">
                            <i class="fa-solid fa-table-cells me-1 text-info"></i> JSGrid Workspace
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light nav-hub-item" data-tab-target="#tab-userdetails" href="@Url.Action("Index", "Home")#tab-userdetails">
                            <i class="fa-solid fa-users me-1 text-success"></i> User CRUD
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light nav-hub-item" data-tab-target="#tab-redirects" href="@Url.Action("Index", "Home")#tab-redirects">
                            <i class="fa-solid fa-share-from-square me-1 text-warning"></i> Redirects &amp; Routing
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light nav-hub-item" data-tab-target="#tab-status" href="@Url.Action("Index", "Home")#tab-status">
                            <i class="fa-solid fa-shield-halved me-1 text-danger"></i> Status Results Lab
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light nav-hub-item" data-tab-target="#tab-workflow" href="@Url.Action("Index", "Home")#tab-workflow">
                            <i class="fa-solid fa-diagram-project me-1 text-purple"></i> Architecture Workflow
                        </a>
                    </li>
                    <li class="nav-item ms-xl-2 border-start border-secondary border-opacity-25 ps-xl-2">
                        <a class="nav-link text-light nav-hub-item" data-page="user-page" href="@Url.Action("InsertUserDetails", "User")">
                            <i class="fa-solid fa-id-card me-1 text-info"></i> User Page (Standalone)
                        </a>
                    </li>
                </ul>

                <!-- Top Right Live Status Pill -->
                <div class="d-flex align-items-center gap-3 mt-3 mt-xl-0">
                    <div class="d-flex align-items-center bg-dark bg-opacity-50 px-3 py-1 rounded-pill border border-secondary border-opacity-25 text-white small">
                        <span class="spinner-grow spinner-grow-sm text-success me-2" role="status" style="width: 8px; height: 8px;"></span>
                        <span class="fw-semibold text-slate-300">SQL Server (Assignmet)</span>
                        <span class="mx-2 text-muted">|</span>
                        <span class="text-success fw-bold">Live</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- App Footer -->
    <footer class="bg-white border-top py-4 mt-auto">
        <div class="container-fluid px-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
                <div>
                    <strong>ASP.NET MVC 5</strong> &bull; jQuery DataTables &bull; JSGrid &bull; SQL Server Stored Procedures
                </div>
                <div class="mt-2 mt-md-0">
                    <span class="badge bg-light text-dark border me-2">Connection: DBConn</span>
                    <span class="badge bg-light text-dark border">Procedures: sp_SearchCustomers &bull; usercrudoperations</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    @Scripts.Render("~/bundles/bootstrap")
    
    <!-- DataTables JS & Extensions -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    
    <!-- DataTables Export Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    
    <!-- JSGrid JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid.min.js"></script>
    
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
