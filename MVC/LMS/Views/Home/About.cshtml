@{
    ViewBag.Title = "About EduPlatform LMS";
}

<div class="py-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-3 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> System Architecture
            </span>
            <h1 class="fw-extrabold display-5 mb-3 tracking-tight">Enterprise-Grade Learning Management Architecture</h1>
            <p class="lead text-secondary" style="line-height: 1.6;">
                EduPlatform LMS is a full-featured, database-backed learning system engineered with ASP.NET MVC 5, .NET Framework 4.8, Entity Framework 6, and Microsoft SQL Server.
            </p>
            <p class="text-secondary" style="line-height: 1.6;">
                Designed to provide robust role-based access control (Admin, Instructor, and Student), automated quiz scoring, interactive curriculums, progress tracking, assignment submissions, verifiable certificate issuance, and comprehensive administrative oversight.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="card card-custom p-4 shadow-sm bg-white card-gradient-top">
                <h5 class="fw-bold mb-3"><i class="bi bi-stack me-2 text-primary"></i> Technology Architecture</h5>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="fw-semibold">ASP.NET MVC 5</span>
                        <span class="badge bg-primary rounded-pill">v5.2.9</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="fw-semibold">Runtime Target</span>
                        <span class="badge bg-secondary rounded-pill">.NET Framework 4.8</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="fw-semibold">Database Engine</span>
                        <span class="badge bg-success rounded-pill">Microsoft SQL Server</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="fw-semibold">ORM & Identity</span>
                        <span class="badge bg-info text-dark rounded-pill">Entity Framework 6.4 + ASP.NET Identity 2.2</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="fw-semibold">Frontend Design System</span>
                        <span class="badge bg-warning text-dark rounded-pill">Bootstrap 5 + Plus Jakarta Sans + Modern Tokens</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="card card-custom p-4 h-100 bg-white card-hover">
                <div class="rounded-circle bg-primary-subtle text-primary p-3 d-inline-flex mb-3" style="width: 52px; height: 52px; align-items: center; justify-content: center;">
                    <i class="bi bi-person-workspace fs-4"></i>
                </div>
                <h5 class="fw-bold mb-2">Instructor Studio</h5>
                <p class="text-muted small mb-0">Course authoring with hierarchical modules, multi-format lessons (Video, Article, Quiz, Project), quiz construction, and assignment grading with feedback.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-4 h-100 bg-white card-hover">
                <div class="rounded-circle bg-success-subtle text-success p-3 d-inline-flex mb-3" style="width: 52px; height: 52px; align-items: center; justify-content: center;">
                    <i class="bi bi-mortarboard fs-4"></i>
                </div>
                <h5 class="fw-bold mb-2">Student Experience</h5>
                <p class="text-muted small mb-0">Dedicated learning classroom, live curriculum navigation, lesson completion tracking, real-time quiz assessment, and instant certificate generation.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-4 h-100 bg-white card-hover">
                <div class="rounded-circle bg-warning-subtle text-warning p-3 d-inline-flex mb-3" style="width: 52px; height: 52px; align-items: center; justify-content: center;">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
                <h5 class="fw-bold mb-2">Admin Governance</h5>
                <p class="text-muted small mb-0">Complete administrative control over user accounts, role delegations, course catalogs, categories, enrollment tracking, payments, and system announcements.</p>
            </div>
        </div>
    </div>
</div>