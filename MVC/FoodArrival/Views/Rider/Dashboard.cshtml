@model IEnumerable<FoodArrival.Models.Order>
@{
    ViewBag.Title = "Rider Delivery Hub - FoodReady";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var available = ViewBag.AvailableDeliveries as List<FoodArrival.Models.Order> ?? new List<FoodArrival.Models.Order>();
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-white" style="background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-white text-dark rounded-pill px-3 py-1 fw-bold mb-2">Delivery Partner</span>
                <h2 class="fw-bold mb-1">Rider: @Session["RiderName"]</h2>
                <p class="text-white-50 mb-0"><i class="bi bi-geo-alt-fill me-1"></i> Active Routing & Food Drop-offs</p>
            </div>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Dashboard", "Rider")" class="btn btn-light rounded-pill px-3 fw-bold">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh Orders
                </a>
                <a href="@Url.Action("Logout", "Rider")" class="btn btn-outline-light rounded-pill px-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Available for Pickup -->
        <div class="col-lg-6">
            <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-bell-fill text-warning"></i>
                <span>Ready for Pickup (@available.Count)</span>
            </h4>

            @if (available.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var order in available)
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4 border-start border-4 border-info">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0 text-dark">Order #FD@(1000 + order.OrderId)</h5>
                                <span class="badge bg-info text-dark rounded-pill px-3 py-1">Ready for Delivery</span>
                            </div>

                            <p class="text-muted small mb-2"><i class="bi bi-clock me-1"></i> Placed at @order.OrderedAt.ToString("hh:mm tt")</p>

                            <div class="p-3 bg-light rounded-3 my-2 small">
                                <div class="mb-1"><strong>Deliver To:</strong> @order.CustomerName</div>
                                <div class="mb-1 text-danger"><strong>Address:</strong> <i class="bi bi-geo-alt-fill me-1"></i>@(string.IsNullOrEmpty(order.Address) ? "Central City area" : order.Address)</div>
                                <div><strong>Phone:</strong> <a href="tel:@order.PhoneNumber" class="text-decoration-none">@(string.IsNullOrEmpty(order.PhoneNumber) ? "9876543210" : order.PhoneNumber)</a></div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="fw-bold fs-5 text-dark">&#8377;@order.TotalAmount.ToString("F0")</span>
                                @using (Html.BeginForm("AcceptDelivery", "Rider", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <button type="submit" class="btn btn-primary-food rounded-pill px-4 fw-bold">
                                        <i class="bi bi-scooter me-1"></i> Accept Delivery
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm p-4">
                    <i class="bi bi-check2-circle display-4 text-success"></i>
                    <h5 class="fw-bold mt-3">All Caught Up!</h5>
                    <p class="text-muted small">No pending orders waiting for pickup at the moment.</p>
                </div>
            }
        </div>

        <!-- My Active & Completed Deliveries -->
        <div class="col-lg-6">
            <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-scooter text-primary"></i>
                <span>My Assigned Trips</span>
            </h4>

            @if (Model != null && Model.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var order in Model)
                    {
                        bool isDelivered = order.DeliveryStatus == "Delivered";
                        <div class="card border-0 shadow-sm rounded-4 p-4 @(isDelivered ? "border-start border-4 border-success bg-light" : "border-start border-4 border-warning")">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0">Order #FD@(1000 + order.OrderId)</h5>
                                <span class="badge @(isDelivered ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-1">
                                    @(isDelivered ? "Delivered" : "Out for Delivery")
                                </span>
                            </div>

                            <div class="small text-muted mb-2">
                                Customer: <strong>@order.CustomerName</strong> (<a href="tel:@order.PhoneNumber">@order.PhoneNumber</a>)
                            </div>
                            <div class="small text-dark mb-3">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @order.Address
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="fw-bold text-dark">&#8377;@order.TotalAmount.ToString("F0")</span>
                                @if (!isDelivered)
                                {
                                    using (Html.BeginForm("CompleteDelivery", "Rider", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                                            <i class="bi bi-check-circle-fill me-1"></i> Mark Delivered
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-success small fw-bold"><i class="bi bi-check-all fs-5 me-1"></i> Trip Completed</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm p-4">
                    <i class="bi bi-bicycle display-4 text-muted"></i>
                    <h5 class="fw-bold mt-3">No Active Trips</h5>
                    <p class="text-muted small">Accept an order from the left column to begin your delivery.</p>
                </div>
            }
        </div>
    </div>
</div>
