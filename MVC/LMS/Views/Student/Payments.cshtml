@model IEnumerable<LMS.ViewModels.StudentReceiptViewModel>
@{
    ViewBag.Title = "Payment Receipts & Billing History";
    var completedList = Model != null ? Model.Where(m => m.PaymentStatus == "Completed").ToList() : new List<LMS.ViewModels.StudentReceiptViewModel>();
    decimal totalSpent = completedList.Sum(m => m.Amount);
}

<div class="py-4">
    <!-- Header with Bulk Print Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-receipt me-1"></i> Financial Records
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight text-white">Payment Receipts &amp; Billing History</h2>
            <p class="small mb-0" style="color: #94A3B8;">Download official transaction receipts and consolidated course enrollment statements</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("AllReceipts", "Student")" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                <i class="bi bi-printer-fill me-1"></i> Print All Receipts / Statement
            </a>
            <a href="@Url.Action("MyCourses", "Student")" class="btn btn-outline-light rounded-pill px-3 fw-semibold" style="border-color: rgba(255, 255, 255, 0.25);">
                <i class="bi bi-arrow-left me-1"></i> My Courses
            </a>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-4 shadow-sm h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12); border-left: 4px solid #FF7A18 !important; color: #FFFFFF;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-bold text-uppercase" style="font-size: 11px; color: #94A3B8;">Total Invested</div>
                        <div class="fs-2 fw-extrabold text-white mt-1"><span class="rupee-symbol">&#8377;</span>@totalSpent.ToString("N2")</div>
                        <small style="color: #35C98A;"><i class="bi bi-check-circle me-1"></i>All curriculums</small>
                    </div>
                    <div class="rounded-circle p-3 shadow-xs" style="background: rgba(255, 122, 24, 0.15); color: #FF7A18;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-4 shadow-sm h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12); border-left: 4px solid #27B8D6 !important; color: #FFFFFF;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-bold text-uppercase" style="font-size: 11px; color: #94A3B8;">Enrolled Tracks</div>
                        <div class="fs-2 fw-extrabold mt-1" style="color: #27B8D6;">@(Model != null ? Model.Count() : 0)</div>
                        <small style="color: #94A3B8;">Active student portfolio</small>
                    </div>
                    <div class="rounded-circle p-3 shadow-xs" style="background: rgba(39, 184, 214, 0.15); color: #27B8D6;">
                        <i class="bi bi-mortarboard-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-4 shadow-sm h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12); border-left: 4px solid #35C98A !important; color: #FFFFFF;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-bold text-uppercase" style="font-size: 11px; color: #94A3B8;">Paid Invoices</div>
                        <div class="fs-2 fw-extrabold text-success mt-1">@completedList.Count</div>
                        <small style="color: #35C98A;"><i class="bi bi-shield-check me-1"></i>Verified tax receipts</small>
                    </div>
                    <div class="rounded-circle p-3 shadow-xs" style="background: rgba(53, 201, 138, 0.15); color: #35C98A;">
                        <i class="bi bi-receipt-cutoff fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-custom p-4 shadow-sm h-100" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(255, 255, 255, 0.12); border-left: 4px solid #8B5CF6 !important; color: #FFFFFF;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-bold text-uppercase" style="font-size: 11px; color: #94A3B8;">Billing Status</div>
                        <div class="fs-4 fw-extrabold text-white mt-1">In Good Standing</div>
                        <small style="color: #94A3B8;">Zero pending balances</small>
                    </div>
                    <div class="rounded-circle p-3 shadow-xs" style="background: rgba(139, 92, 246, 0.15); color: #8B5CF6;">
                        <i class="bi bi-patch-check-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions & Receipts Table Card -->
    <div class="card card-custom shadow-lg mb-4 border-0" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25) !important; border-radius: 18px; overflow: hidden; color: #FFFFFF;">
        <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center border-bottom" style="background: rgba(11, 52, 69, 0.7); border-color: rgba(255, 255, 255, 0.1) !important;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-credit-card-2-front text-orange fs-5"></i>
                <h5 class="fw-bold mb-0 text-white">Itemized Enrollment Transactions</h5>
            </div>
            <a href="@Url.Action("AllReceipts", "Student")" class="small fw-semibold text-decoration-none" style="color: #27B8D6;">
                <i class="bi bi-file-earmark-pdf me-1"></i> Download All Course Receipts &rarr;
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-white" style="color: #FFFFFF !important;">
                <thead class="small" style="background: rgba(4, 24, 34, 0.95); color: #94A3B8; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3 px-4">Invoice / Txn ID</th>
                        <th class="py-3">Course Curriculum</th>
                        <th class="py-3">Faculty Instructor</th>
                        <th class="py-3">Amount</th>
                        <th class="py-3">Date</th>
                        <th class="py-3">Payment Method</th>
                        <th class="py-3">Status</th>
                        <th class="text-end py-3 px-4">Receipt</th>
                    </tr>
                </thead>
                <tbody style="border-top: none;">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5" style="color: #94A3B8;">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 text-orange"></i>
                                <h6 class="fw-bold text-white">No payment transactions recorded yet.</h6>
                                <p class="small mb-3">When you enroll in premium courses, official receipts will appear here.</p>
                                <a href="@Url.Action("Index", "Courses")" class="btn btn-sm btn-primary rounded-pill px-4" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">Explore Course Catalog</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                                <td class="px-4 py-3">
                                    <div class="fw-bold text-white font-monospace" style="font-size: 13px;">@item.InvoiceNumber</div>
                                    <small style="color: #27B8D6; font-size: 11px;">@item.TransactionId</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-white">@item.CourseTitle</div>
                                    <small class="badge rounded-pill px-2 py-0" style="background: rgba(39, 184, 214, 0.15); color: #27B8D6; font-size: 10px;">@item.CategoryName</small>
                                </td>
                                <td>
                                    <small class="text-white"><i class="bi bi-person-circle text-orange me-1"></i>@item.InstructorName</small>
                                </td>
                                <td class="fw-bold">
                                    @if (item.Amount == 0)
                                    {
                                        <span class="text-success fw-bold">FREE</span>
                                    }
                                    else
                                    {
                                        <span class="text-white fs-6"><span class="rupee-symbol">&#8377;</span>@item.Amount.ToString("N2")</span>
                                    }
                                </td>
                                <td>
                                    <small style="color: #94A3B8;"><i class="bi bi-calendar3 me-1"></i>@item.PaymentDate.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td>
                                    <small class="text-white-50"><i class="bi bi-credit-card me-1"></i>@item.PaymentMethod</small>
                                </td>
                                <td>
                                    <span class="badge @(item.PaymentStatus == "Completed" ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-1 small">
                                        @item.PaymentStatus
                                    </span>
                                </td>
                                <td class="text-end px-4">
                                    <a href="@Url.Action("Receipt", "Student", new { id = item.PaymentId })" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 shadow-xs fw-semibold" style="border-color: rgba(255, 255, 255, 0.25);" title="View & Print Official Receipt">
                                        <i class="bi bi-printer me-1 text-orange"></i> Receipt
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
