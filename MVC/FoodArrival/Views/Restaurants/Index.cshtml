@model IList<FoodArrival.Models.RestaurantCard>
@{
    ViewBag.Title = "Find your next favorite";
}
<section class="hero-panel mb-5">
    <p class="eyebrow">A little joy, delivered</p>
    <h1 class="hero-title mb-3">Good food is closer than you think.</h1>
    <p class="hero-copy mb-4">Find local kitchens, explore their menus, and get something lovely on the table.</p>
    @using (Html.BeginForm("Index", "Restaurants", FormMethod.Get, new { @class = "row g-2 position-relative", style = "z-index:2;max-width:720px" }))
    {
        <div class="col-md-4"><label class="visually-hidden" for="city">City</label><input id="city" class="form-control" name="city" value="@ViewBag.City" placeholder="City" /></div>
        <div class="col-md-6"><label class="visually-hidden" for="search">Restaurant or dish</label><input id="search" class="form-control" name="search" value="@ViewBag.Search" placeholder="Restaurant, cuisine, or dish" /></div>
        <div class="col-md-2 d-grid"><button class="btn btn-dark" type="submit">Search</button></div>
    }
</section>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div><p class="eyebrow mb-1">Made around here</p><h2 class="section-heading mb-0">Restaurants to explore</h2></div>
    <span class="text-muted small">@Model.Count places</span>
</div>
@if (ViewBag.DatabaseError != null)
{
    <div class="alert alert-warning" role="alert"><strong>Database connection needed.</strong> @ViewBag.DatabaseError Configure the FoodDeliveryDB connection string in Web.config, then run FoodDeliveryDatabase.sql.</div>
}
else if (!Model.Any())
{
    <div class="empty-state"><div class="fs-1 mb-2">🍽</div><h3 class="h5">No kitchens found just yet</h3><p class="text-muted mb-3">Try another search or check back soon.</p><a class="btn btn-outline-dark" href="@Url.Action("Index")">Clear filters</a></div>
}
else
{
    <div class="row g-4">
        @foreach (var restaurant in Model)
        {
            <div class="col-sm-6 col-xl-4">
                <article class="restaurant-card">
                    <div class="restaurant-art">
                        @if (!String.IsNullOrWhiteSpace(restaurant.ImageUrl)) { <img src="@restaurant.ImageUrl" alt="Food from @restaurant.Name" /> } else { <span aria-hidden="true">🥘</span> }
                    </div>
                    <div class="restaurant-card-body">
                        <div class="d-flex justify-content-between gap-2"><h3 class="h5 fw-bold mb-1">@restaurant.Name</h3><span class="small text-nowrap">@(restaurant.AverageRating.HasValue ? "★ " + restaurant.AverageRating.Value.ToString("0.0") : "New")</span></div>
                        <p class="text-muted small mb-3">@restaurant.Cuisine · @restaurant.City</p>
                        <p class="mb-3">@(String.IsNullOrWhiteSpace(restaurant.Description) ? restaurant.AddressLine : restaurant.Description)</p>
                        <div class="d-flex justify-content-between align-items-center"><span class="text-muted small">@restaurant.ReviewCount reviews</span><a class="btn btn-dark btn-sm px-3" href="@Url.Action("Details", new { id = restaurant.RestaurantId })">View menu</a></div>
                    </div>
                </article>
            </div>
        }
    </div>
}
