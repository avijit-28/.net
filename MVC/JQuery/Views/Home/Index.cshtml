                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark"><i class="fa-solid fa-code text-primary me-1"></i> HomeController.cs</h6>
                        <pre class="code-block"><code>public class HomeController : Controller
{
    // GET: Home - Returns the Razor HTML view
    public ActionResult Index()
    {
        return View();
    }

    // Handles the jQuery AJAX operation - Returns JSON from Stored Procedure
    [HttpPost]
    public JsonResult AjaxMethod(string searchTerm = null)
    {
        // Calls the stored procedure dbo.sp_SearchCustomers via CustomerRepository
        List&lt;Customer&gt; customers = CustomerRepository.GetCustomers(searchTerm);
        
        return Json(customers);
    }
}</code></pre>
                    </div>
                </div>

