@model FoodArrival.Models.LoginViewModel
@{
    ViewBag.Title = "Customer Login - FoodReady";
}

<div class="container py-5">
    <div class="auth-container">
        <div class="row g-0">
            <!-- Left Banner -->
            <div class="col-lg-5 auth-hero-side text-center">
                <div class="mb-4">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2C9.5 2 7.5 3.8 7.1 6.1C5.3 6.6 4 8.2 4 10.2C4 12.3 5.5 14 7.5 14.3V18C7.5 19.1 8.4 20 9.5 20H14.5C15.6 20 16.5 19.1 16.5 18V14.3C18.5 14 20 12.3 20 10.2C20 8.2 18.7 6.6 16.9 6.1C16.5 3.8 14.5 2 12 2Z" fill="#FFFFFF" />
                        <path d="M9 11V16M12 10V16M15 11V16" stroke="#FF5E1E" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </div>
                <h2 class="fw-bold mb-3">Welcome Back!</h2>
                <p class="text-white-50 mb-4">
                    Login to your FoodReady account and continue ordering delicious food.
                </p>
                <div class="py-4">
                    <i class="bi bi-egg-fried display-1 text-white opacity-75"></i>
                </div>
                <p class="small text-white-50 mt-auto mb-0">
                    Don't have an account? <a href="@Url.Action("Register", "Account")" class="text-white fw-bold text-decoration-underline">Sign Up here</a>
                </p>
            </div>

            <!-- Right Login Form -->
            <div class="col-lg-7 auth-form-card">
                <div class="text-center mb-4">
                    <div class="stat-icon items mx-auto mb-2" style="width: 48px; height: 48px;">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Customer Login</h3>
                    <p class="text-muted small">Enter your credentials to access your account</p>
                </div>

                @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3 small" })

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0", type = "email", placeholder = "e.g. john@example.com" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0", placeholder = "Password" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 small">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                            <label class="form-check-label text-muted" for="RememberMe">Remember me</label>
                        </div>
                        <a href="#" class="text-muted text-decoration-none" onclick="alert('Demo account: john@example.com / password: 12345'); return false;">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary-food w-100 py-2 fs-6 fw-bold shadow">
                        Login
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        Don't have an account? <a href="@Url.Action("Register", "Account")" class="text-primary fw-bold">Sign Up</a>
                    </div>

                    <div class="mt-4 p-3 bg-light rounded text-center small text-muted border">
                        <i class="bi bi-info-circle me-1 text-primary"></i> <strong>Demo Customer:</strong> john@example.com | <strong>Pass:</strong> 12345
                    </div>
                }
            </div>
        </div>
    </div>
</div>
