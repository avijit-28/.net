@model FoodArrival.Models.RegisterViewModel
@{
    ViewBag.Title = "Create Account - FoodReady";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var restaurants = ViewBag.Restaurants as List<FoodArrival.Models.Restaurant> ?? new List<FoodArrival.Models.Restaurant>();
}

<div class="container py-5">
    <div class="auth-container shadow-lg rounded-5 overflow-hidden" style="max-width: 1020px; margin: 0 auto; background: #FFFFFF;">
        <div class="row g-0">
            <!-- Left Banner (Matching Image 2: Join FoodReady with Rider Scooter Illustration) -->
            <div class="col-lg-5 p-5 text-white d-flex flex-column justify-content-between position-relative" style="background: linear-gradient(145deg, #FF7A18 0%, #FF5E1E 100%); min-height: 580px;">
                <div>
                    <div class="mb-4">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2C9.5 2 7.5 3.8 7.1 6.1C5.3 6.6 4 8.2 4 10.2C4 12.3 5.5 14 7.5 14.3V18C7.5 19.1 8.4 20 9.5 20H14.5C15.6 20 16.5 19.1 16.5 18V14.3C18.5 14 20 12.3 20 10.2C20 8.2 18.7 6.6 16.9 6.1C16.5 3.8 14.5 2 12 2Z" fill="#FFFFFF" />
                            <path d="M9 11V16M12 10V16M15 11V16" stroke="#FF5E1E" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </div>
                    <h1 class="fw-bold mb-3" style="font-size: 2.3rem; letter-spacing: -0.5px;">Join <span style="color: #FFE600;">FoodReady</span></h1>
                    <p class="text-white-50 mb-4" style="line-height: 1.6; font-size: 1.05rem;">
                        Create an account and start ordering your favorite food, or join our community as a Restaurant Partner, Kitchen Staff, or Delivery Rider!
                    </p>
                </div>

                <!-- Delivery Rider & Food 3D Graphic -->
                <div class="my-3 text-center position-relative">
                    <div class="position-relative d-inline-block w-100 py-2">
                        <!-- Soft Glow Backdrop -->
                        <div class="position-absolute start-50 top-50 translate-middle rounded-circle"
                             style="width: 240px; height: 240px; background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.08) 60%, transparent 80%); pointer-events: none;">
                        </div>
                        <img src="@Url.Content("~/Content/images/hero-rider-food.png")"
                             alt="Join FoodReady Community"
                             class="img-fluid position-relative"
                             style="max-height: 250px; width: auto; object-fit: contain; filter: drop-shadow(0 15px 25px rgba(0,0,0,0.30));"
                             onerror="this.src='/Content/images/hero-rider-food.jpg'" />
                    </div>

                    <!-- Highlight Badges -->
                    <div class="d-flex flex-column gap-2 mt-2 text-start small">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-warning fs-6"></i>
                            <span class="text-white fw-semibold">Express 25-35 min multi-restaurant delivery</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-warning fs-6"></i>
                            <span class="text-white fw-semibold">Verified partner kitchens & certified riders</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill text-warning fs-6"></i>
                            <span class="text-white fw-semibold">Live GPS delivery tracking & instant updates</span>
                        </div>
                    </div>
                </div>

                <div class="mt-auto pt-3 border-top border-white border-opacity-25 text-white-50 small">
                    Already have an account? 
                    <a href="@Url.Action("Login", "Account")" class="text-white fw-bold text-decoration-underline ms-1">Login here</a>
                </div>
            </div>

            <!-- Right Registration Form -->
            <div class="col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center bg-white">
                <div class="text-center mb-4">
                    <!-- Orange User Icon -->
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 52px; height: 52px; background: #FFF0EB; color: #FF5E1E;">
                        <i class="bi bi-person-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Create Account</h3>
                    <p class="text-muted small">Select your role and fill in your registration details</p>
                </div>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { enctype = "multipart/form-data", id = "registerForm", @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                    <!-- Role Dropdown Selector (Top Requirement) -->
                    <div class="mb-3 p-3 rounded-4" style="background: #FFF7F2; border: 1.5px dashed #FFB899;">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-person-badge text-warning me-1"></i> Registering As (Role)
                        </label>
                        @Html.DropDownListFor(m => m.Role, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Customer (Order Food)", Value = "Customer" },
                            new SelectListItem { Text = "Restaurant Owner (Partner / Manage Food)", Value = "RestaurantOwner" },
                            new SelectListItem { Text = "Restaurant Staff (Kitchen / PMS)", Value = "RestaurantStaff" },
                            new SelectListItem { Text = "Delivery Rider (Deliver Orders)", Value = "Rider" }
                        }, new { @class = "form-select fw-bold", id = "roleSelector", onchange = "onRoleChanged()" })
                        <div class="small text-muted mt-1" id="roleDescription">
                            Browse dishes, place orders, and track your delicious food live.
                        </div>
                    </div>

                    <!-- Common Basic Details -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Full Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control border-start-0 ps-0", placeholder = "e.g. Rahul Das", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">User Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-at"></i></span>
                                @Html.TextBoxFor(m => m.Username, new { @class = "form-control border-start-0 ps-0", placeholder = "e.g. rahul123", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email Address <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0 ps-0", type = "email", placeholder = "rahul@example.com", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Phone Number (10 digits) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control border-start-0 ps-0", placeholder = "9876543210", maxlength = "10", pattern = "[0-9]{10}", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- 1. Customer Section -->
                    <div id="sectionCustomer" class="role-section mb-3">
                        <label class="form-label small fw-bold text-muted">Delivery Address <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control border-start-0 ps-0", placeholder = "Flat / House No, Street, City" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                    </div>

                    <!-- 2. Restaurant Owner Section -->
                    <div id="sectionRestaurantOwner" class="role-section mb-3" style="display: none;">
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="fw-bold small text-dark mb-2"><i class="bi bi-shop text-primary me-1"></i> Restaurant Credentials</div>
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted">Restaurant Name <span class="text-danger">*</span></label>
                                    @Html.TextBoxFor(m => m.RestaurantName, new { @class = "form-control form-control-sm", placeholder = "e.g. Spice Symphony" })
                                    @Html.ValidationMessageFor(m => m.RestaurantName, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted">Owner Full Name</label>
                                    @Html.TextBoxFor(m => m.OwnerName, new { @class = "form-control form-control-sm", placeholder = "Leave blank to use Full Name" })
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small text-muted">Restaurant Physical Address <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.RestaurantAddress, new { @class = "form-control form-control-sm", placeholder = "Shop / Landmark, Street, City" })
                                @Html.ValidationMessageFor(m => m.RestaurantAddress, "", new { @class = "text-danger small" })
                            </div>
                            <div class="mb-1">
                                <label class="form-label small text-muted">Cuisine Specialization</label>
                                @Html.TextBoxFor(m => m.Cuisine, new { @class = "form-control form-control-sm", placeholder = "e.g. Indian, Italian, Chinese, Fast Food" })
                            </div>
                            <div class="form-text small text-warning mt-2">
                                <i class="bi bi-info-circle me-1"></i> New restaurants require verification by Admin before going live. Your unique Restaurant ID will be generated upon approval.
                            </div>
                        </div>
                    </div>

                    <!-- 3. Restaurant Staff Section -->
                    <div id="sectionRestaurantStaff" class="role-section mb-3" style="display: none;">
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="fw-bold small text-dark mb-2"><i class="bi bi-person-workspace text-primary me-1"></i> Restaurant Staff Details</div>
                            <div class="mb-2">
                                <label class="form-label small text-muted">Select Restaurant <span class="text-danger">*</span></label>
                                <select name="SelectedRestaurantId" id="staffRestSelect" class="form-select form-select-sm">
                                    <option value="">-- Choose Partner Restaurant --</option>
                                    @foreach (var rest in restaurants)
                                    {
                                        <option value="@rest.RestaurantId">@rest.RestaurantName - @rest.Cuisine (@rest.Address)</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.SelectedRestaurantId, "", new { @class = "text-danger small" })
                            </div>
                            <div class="mb-1">
                                <label class="form-label small text-muted">Designation / Role Title</label>
                                @Html.TextBoxFor(m => m.RoleTitle, new { @class = "form-control form-control-sm", placeholder = "e.g. Kitchen Staff, Head Chef, Line Cook" })
                            </div>
                            <div class="form-text small text-info mt-2">
                                <i class="bi bi-shield-check me-1"></i> A unique Staff ID (e.g., STF-R1-001) will be generated for your restaurant. Your account will be verified by the Restaurant Owner or Admin.
                            </div>
                        </div>
                    </div>

                    <!-- 4. Delivery Rider Section -->
                    <div id="sectionRider" class="role-section mb-3" style="display: none;">
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="fw-bold small text-dark mb-2"><i class="bi bi-bicycle text-primary me-1"></i> Delivery Rider Profile</div>
                            <div class="mb-2">
                                <label class="form-label small text-muted">Select Primary Restaurant <span class="text-danger">*</span></label>
                                <select name="SelectedRestaurantId" id="riderRestSelect" class="form-select form-select-sm">
                                    <option value="">-- Choose Restaurant to partner with --</option>
                                    @foreach (var rest in restaurants)
                                    {
                                        <option value="@rest.RestaurantId">@rest.RestaurantName (@rest.Address)</option>
                                    }
                                </select>
                                <div class="form-text small text-muted">You can affiliate with additional restaurants later from your Rider portal.</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small text-muted">Vehicle Type <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.VehicleType, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Bicycle (Eco Friendly)", Value = "Bicycle" },
                                    new SelectListItem { Text = "Electric Bicycle", Value = "Electric Bicycle" },
                                    new SelectListItem { Text = "Motorcycle / Bike", Value = "Motorcycle / Bike" },
                                    new SelectListItem { Text = "Scooter", Value = "Scooter" }
                                }, new { @class = "form-select form-select-sm", id = "vehicleTypeSelect", onchange = "onVehicleChanged()" })
                            </div>

                            <!-- Driving License Container for Motorized Vehicles -->
                            <div id="licenseContainer" class="p-2 bg-white rounded-2 border mt-2">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted">Driving License Number <span class="text-danger">*</span></label>
                                        @Html.TextBoxFor(m => m.LicenseNumber, new { @class = "form-control form-control-sm", id = "licenseNumberInput", placeholder = "DL-XXXXXXXXXXXXX" })
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted">Upload License Document</label>
                                        <input type="file" name="LicenseDocumentFile" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.pdf" />
                                    </div>
                                </div>
                                <div class="form-text small text-muted mt-1">Driving license is verified by the Restaurant Owner or Admin.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Password and Confirm Password with Eye Toggle -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0 border-end-0 ps-0", id = "regPassword", placeholder = "Min 8 chars, symbol", required = "required" })
                                <button type="button" class="input-group-text bg-white border-start-0 text-muted" onclick="togglePasswordVisibility('regPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Confirm Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control border-start-0 border-end-0 ps-0", id = "regConfirmPassword", placeholder = "Confirm password", required = "required" })
                                <button type="button" class="input-group-text bg-white border-start-0 text-muted" onclick="togglePasswordVisibility('regConfirmPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="small text-muted mb-3">
                        <i class="bi bi-shield-check text-success me-1"></i> Password must be at least 8 characters long and contain letters, numbers, and at least one special symbol.
                    </div>

                    <!-- Vibrant Orange Sign Up Button -->
                    <button type="submit" class="btn btn-primary-food w-100 py-2 fs-6 fw-bold shadow-sm" style="background: linear-gradient(135deg, #FF7A18, #FF5E1E); border-radius: 12px; height: 48px;">
                        Sign Up
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        Already have an account? <a href="@Url.Action("Login", "Account")" class="fw-bold text-decoration-none" style="color: #FF5E1E;">Login</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function onRoleChanged() {
        var role = document.getElementById("roleSelector").value;
        var secCustomer = document.getElementById("sectionCustomer");
        var secRest = document.getElementById("sectionRestaurantOwner");
        var secStaff = document.getElementById("sectionRestaurantStaff");
        var secRider = document.getElementById("sectionRider");
        var roleDesc = document.getElementById("roleDescription");

        secCustomer.style.display = "none";
        secRest.style.display = "none";
        secStaff.style.display = "none";
        secRider.style.display = "none";

        if (role === "Customer") {
            secCustomer.style.display = "block";
            roleDesc.textContent = "Browse dishes, place orders, and track your delicious food live.";
        } else if (role === "RestaurantOwner") {
            secRest.style.display = "block";
            roleDesc.textContent = "Register your restaurant, manage your menu items, track kitchen orders and monitor staff.";
        } else if (role === "RestaurantStaff") {
            secStaff.style.display = "block";
            roleDesc.textContent = "Join a partner restaurant, receive a unique Staff ID, track kitchen prep and propose new dishes.";
        } else if (role === "Rider") {
            secRider.style.display = "block";
            roleDesc.textContent = "Deliver food orders for partner restaurants, manage multiple affiliations and track earnings.";
            onVehicleChanged();
        }
    }

    function onVehicleChanged() {
        var vType = document.getElementById("vehicleTypeSelect").value;
        var licContainer = document.getElementById("licenseContainer");
        var licInput = document.getElementById("licenseNumberInput");
        if (vType === "Bicycle" || vType === "Electric Bicycle") {
            licContainer.style.display = "none";
            if (licInput) licInput.removeAttribute("required");
        } else {
            licContainer.style.display = "block";
            if (licInput) licInput.setAttribute("required", "required");
        }
    }

    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon = btn.querySelector('i');
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = "password";
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }

    // Initialize on page load
    document.addEventListener("DOMContentLoaded", function () {
        onRoleChanged();
    });
</script>
