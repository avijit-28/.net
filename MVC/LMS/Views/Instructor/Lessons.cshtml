@model IEnumerable<LMS.Models.Lesson>
@{
    var module = ViewBag.Module as LMS.Models.Module;
    ViewBag.Title = "Lessons - " + (module?.ModuleName ?? "Module");
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")" class="text-decoration-none">My Courses</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Modules", "Instructor", new { courseId = module?.CourseId })" class="text-decoration-none">Modules</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lessons</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-info-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Lesson Management
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Lessons: @(module?.ModuleName ?? "Module")</h2>
            <p class="text-muted small mb-0">Publish video lectures, interactive articles, downloadable assets, and assessments</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Modules", "Instructor", new { courseId = module?.CourseId })" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Modules
            </a>
            <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addLessonModal">
                <i class="bi bi-plus-circle me-1"></i> Add Lesson
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white border-0">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-play-circle text-muted display-4"></i>
            </div>
            <h4 class="fw-bold">No lessons added to this module yet</h4>
            <p class="text-muted small mb-3">Create video lessons, reading articles, quizzes, or assignments for students.</p>
            <div>
                <button class="btn btn-primary rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#addLessonModal">
                    <i class="bi bi-plus-circle me-1"></i> Add First Lesson
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom shadow-sm overflow-hidden bg-white border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-4">Sequence</th>
                            <th>Lesson Title</th>
                            <th>Delivery Format</th>
                            <th>Duration</th>
                            <th>Access Model</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 font-monospace">#@l.LessonOrder</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@l.Title</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 350px;">
                                        @(string.IsNullOrEmpty(l.Description) ? "Comprehensive pedagogical lesson unit." : l.Description)
                                    </small>
                                </td>
                                <td>
                                    @if (l.LessonType == "Video")
                                    {
                                        <span class="badge badge-primary-subtle rounded-pill px-3 py-1"><i class="bi bi-play-circle me-1"></i>Video</span>
                                    }
                                    else if (l.LessonType == "Quiz")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1"><i class="bi bi-patch-question me-1"></i>Quiz</span>
                                    }
                                    else if (l.LessonType == "Assignment")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1"><i class="bi bi-file-earmark-code me-1"></i>Project</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill px-3 py-1"><i class="bi bi-file-text me-1"></i>Article</span>
                                    }
                                </td>
                                <td><span class="small text-muted font-monospace"><i class="bi bi-clock me-1"></i>@l.DurationInMinutes min</span></td>
                                <td>
                                    @if (l.IsPreview)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-eye me-1"></i>Free Preview
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border rounded-pill px-3 py-1">
                                            <i class="bi bi-lock me-1"></i>Enrolled Only
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#editLessonModal_@l.LessonId">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </button>
                                        @using (Html.BeginForm("DeleteLesson", "Instructor", new { id = l.LessonId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Are you sure you want to permanently delete lesson \'@Html.Raw(HttpUtility.JavaScriptStringEncode(l.Title))\'?');">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        }
                                    </div>

                                    <!-- Edit Lesson Modal for @l.LessonId -->
                                    <div class="modal fade text-start" id="editLessonModal_@l.LessonId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-lg modal-dialog-centered">
                                            <div class="modal-content border-0 shadow-lg rounded-4">
                                                <div class="modal-header border-bottom py-3">
                                                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Lesson</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                @using (Html.BeginForm("EditLesson", "Instructor", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="LessonId" value="@l.LessonId" />
                                                    <input type="hidden" name="ModuleId" value="@l.ModuleId" />
                                                    <div class="modal-body p-4">
                                                        <div class="row g-3">
                                                            <div class="col-md-8">
                                                                <label class="form-label fw-bold small text-dark">Lesson Title</label>
                                                                <input type="text" name="Title" class="form-control" value="@l.Title" required />
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label fw-bold small text-dark">Lesson Format</label>
                                                                <select name="LessonType" class="form-select">
                                                                    <option value="Video" @(l.LessonType == "Video" ? "selected" : "")>Video Stream</option>
                                                                    <option value="Article" @(l.LessonType == "Article" ? "selected" : "")>Article / Notes</option>
                                                                    <option value="PDF" @(l.LessonType == "PDF" ? "selected" : "")>PDF Reference Guide</option>
                                                                    <option value="Link" @(l.LessonType == "Link" ? "selected" : "")>External Link / Lab</option>
                                                                    <option value="Quiz" @(l.LessonType == "Quiz" ? "selected" : "")>Quiz Assessment</option>
                                                                    <option value="Assignment" @(l.LessonType == "Assignment" ? "selected" : "")>Practical Project</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-bold small text-dark">Video Stream / Embed URL</label>
                                                                <input type="text" name="VideoUrl" class="form-control" value="@l.VideoUrl" placeholder="https://www.youtube.com/embed/... or CDN link" />
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="form-label fw-bold small text-dark">Duration (Minutes)</label>
                                                                <input type="number" name="DurationInMinutes" class="form-control" value="@l.DurationInMinutes" min="1" required />
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="form-label fw-bold small text-dark">Sequence Order</label>
                                                                <input type="number" name="LessonOrder" class="form-control" value="@l.LessonOrder" min="1" required />
                                                            </div>
                                                            <div class="col-12">
                                                                <label class="form-label fw-bold small text-dark">Downloadable Assets / GitHub Repo Link</label>
                                                                <input type="text" name="ResourceUrl" class="form-control" value="@l.ResourceUrl" placeholder="https://github.com/repository or drive link" />
                                                            </div>
                                                            <div class="col-12">
                                                                <label class="form-label fw-bold small text-dark">Summary Overview</label>
                                                                <textarea name="Description" class="form-control" rows="5" placeholder="Brief outline of concepts mastered in this lesson...">@l.Description</textarea>
                                                            </div>
                                                            <div class="col-12">
                                                                <label class="form-label fw-bold small text-dark">Article Notes & Code Documentation</label>
                                                                <textarea name="Content" class="form-control font-monospace small" rows="5" placeholder="Formatted explanation, code snippets, reference architectural notes...">@l.Content</textarea>
                                                            </div>
                                                            <div class="col-12">
                                                                <div class="p-3 bg-light rounded-3 border">
                                                                    <div class="form-check form-switch mb-0">
                                                                        <input type="checkbox" name="IsPreview" id="chkPreview_@l.LessonId" value="true" class="form-check-input" @(l.IsPreview ? "checked" : "") />
                                                                        <input type="hidden" name="IsPreview" value="false" />
                                                                        <label class="form-check-label fw-semibold small text-dark" for="chkPreview_@l.LessonId">
                                                                            Allow Free Preview (Non-enrolled prospective students can preview this lesson)
                                                                        </label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top py-3">
                                                        <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Save Changes</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Add Lesson Modal -->
<div class="modal fade" id="addLessonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-plus-circle me-2 text-primary"></i>Create New Lesson</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("CreateLesson", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ModuleId" value="@(module?.ModuleId ?? 0)" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-dark">Lesson Title</label>
                            <input type="text" name="Title" class="form-control" placeholder="e.g. Asynchronous Controller Patterns" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-dark">Lesson Format</label>
                            <select name="LessonType" class="form-select">
                                <option value="Video">Video Stream</option>
                                <option value="Article">Article / Notes</option>
                                <option value="PDF">PDF Reference Guide</option>
                                <option value="Link">External Link / Lab</option>
                                <option value="Quiz">Quiz Assessment</option>
                                <option value="Assignment">Practical Project</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Video Stream / Embed URL</label>
                            <input type="text" name="VideoUrl" class="form-control" placeholder="https://www.youtube.com/embed/... or CDN link" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-dark">Duration (Minutes)</label>
                            <input type="number" name="DurationInMinutes" class="form-control" value="15" min="1" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-dark">Sequence Order</label>
                            <input type="number" name="LessonOrder" class="form-control" value="@(Model.Count() + 1)" min="1" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Downloadable Assets / GitHub Repo Link</label>
                            <input type="text" name="ResourceUrl" class="form-control" placeholder="https://github.com/repository or drive link" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Summary Overview</label>
                            <textarea name="Description" class="form-control" rows="5" placeholder="Brief outline of concepts mastered in this lesson..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Article Notes & Code Documentation</label>
                            <textarea name="Content" class="form-control font-monospace small" rows="5" placeholder="Formatted explanation, code snippets, reference architectural notes..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="form-check form-switch mb-0">
                                    <input type="checkbox" name="IsPreview" id="chkPreview" value="true" class="form-check-input" />
                                    <input type="hidden" name="IsPreview" value="false" />
                                    <label class="form-check-label fw-semibold small text-dark" for="chkPreview">
                                        Allow Free Preview (Non-enrolled prospective students can preview this lesson)
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Save Lesson</button>
                </div>
            }
        </div>
    </div>
</div>
