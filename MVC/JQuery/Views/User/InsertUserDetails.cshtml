@model JQuery.Models.UserDetails
@{
    ViewBag.Title = "User Details - Redirect & Status Results Demo";
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-4 bg-white rounded-3 shadow-sm border">
                <h2 class="fw-bold text-dark mb-1">
                    <i class="fa-solid fa-arrows-split-up-and-left text-primary me-2"></i>
                    Redirect, RedirectToRoute, RedirectToAction &amp; Status Results
                </h2>
                <p class="text-muted mb-0">
                    Basic level implementation in ASP.NET MVC with SQL Server Stored Procedure (<code>usercrudoperations</code>).
                </p>
            </div>
        </div>
    </div>

    <!-- Quick Action / Demonstration Toolbars -->
    <div class="row g-3 mb-4">
        <!-- Redirect Demonstrations Card -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-share-from-square me-2"></i> Redirect Demonstrations</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        Test different types of redirects in ASP.NET MVC and jQuery:
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <!-- 1. jQuery window.location.href -->
                        <button id="btnRedirect" class="btn btn-outline-primary btn-sm">
                            <i class="fa-brands fa-js me-1"></i> jQuery window.location.href
                        </button>

                        <!-- 2. Controller RedirectToAction -->
                        <a href="@Url.Action("RedirectToActionDemo", "User")" class="btn btn-outline-success btn-sm">
                            <i class="fa-solid fa-arrow-right me-1"></i> RedirectToAction
                        </a>

                        <!-- 3. Controller RedirectToRoute -->
                        <a href="@Url.Action("RedirectToRouteDemo", "User")" class="btn btn-outline-info btn-sm">
                            <i class="fa-solid fa-route me-1"></i> RedirectToRoute
                        </a>

                        <!-- 4. Controller Redirect (External URL) -->
                        <a href="@Url.Action("RedirectToExternal", "User")" class="btn btn-outline-warning btn-sm" target="_blank">
                            <i class="fa-solid fa-globe me-1"></i> Redirect("https://mccit.net")
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Status Results Card -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i> Status Results (HTTP Error Codes)</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        Test ActionResult types that return standard HTTP status codes:
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <!-- 1. HttpStatusCodeResult Unauthorized -->
                        <a href="@Url.Action("UnauthorizedStatusCode", "User")" class="btn btn-outline-danger btn-sm" target="_blank">
                            <i class="fa-solid fa-lock me-1"></i> 401 Unauthorized
                        </a>

                        <!-- 2. HttpStatusCodeResult BadGateway -->
                        <a href="@Url.Action("BadGateway", "User")" class="btn btn-outline-danger btn-sm" target="_blank">
                            <i class="fa-solid fa-server me-1"></i> 502 Bad Gateway
                        </a>

                        <!-- 3. HttpUnauthorizedResult -->
                        <a href="@Url.Action("UnauthorizedResult", "User")" class="btn btn-outline-secondary btn-sm" target="_blank">
                            <i class="fa-solid fa-user-slash me-1"></i> HttpUnauthorizedResult
                        </a>

                        <!-- 4. HttpNotFoundResult -->
                        <a href="@Url.Action("NotFoundAction", "User")" class="btn btn-outline-dark btn-sm" target="_blank">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> HttpNotFoundResult (404)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- User Details Form & List Grid -->
    <div class="row g-4">
        <!-- Form for InsertUserDetails -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-user-plus text-primary me-2"></i> Register User</h5>
                    <small class="text-muted">Stored Procedure: <code>usercrudoperations (&#64;status='INSERT')</code></small>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("InsertUserDetails", "User", FormMethod.Post))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold small">User Name:</label>
                            @Html.TextBoxFor(u => u.UserName, new { @class = "form-control", placeholder = "Enter name", required = "required" })
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Education:</label>
                            @Html.TextBoxFor(u => u.Education, new { @class = "form-control", placeholder = "Enter education", required = "required" })
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Location:</label>
                            @Html.TextBoxFor(u => u.Location, new { @class = "form-control", placeholder = "Enter location", required = "required" })
                        </div>
                        <div class="d-grid mt-4">
                            <input type="submit" value="Register" class="btn btn-primary" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Table displaying registered User Details -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-users text-primary me-2"></i> User Details</h5>
                        <small class="text-muted">Stored Procedure: <code>usercrudoperations (&#64;status='GET')</code></small>
                    </div>
                    <span class="badge bg-primary">Total: @(Model != null && Model.usersinfo != null ? Model.usersinfo.Count : 0)</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        @if (Model != null && Model.usersinfo != null && Model.usersinfo.Count > 0)
                        {
                            <table class="table table-striped table-hover mb-0 align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 90px;">UserId</th>
                                        <th>UserName</th>
                                        <th>Education</th>
                                        <th>Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.usersinfo)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@Html.DisplayFor(modelitem => item.UserId)</span></td>
                                            <td class="fw-bold">@Html.DisplayFor(modelitem => item.UserName)</td>
                                            <td>@Html.DisplayFor(modelitem => item.Education)</td>
                                            <td><span class="badge bg-light text-dark border">@Html.DisplayFor(modelitem => item.Location)</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <b>No Details Found.</b>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script type="text/javascript">
    $(function () {
        // jQuery client-side redirect on button click
        $("#btnRedirect").click(function () {
            window.location.href = "@Url.Action("InsertUserDetails", "User")";
        });

        // Check if insertion was successful, alert, and redirect
        var msg = '@ViewData["result"]';
        if (msg == '1') {
            alert("User Details Inserted Successfully");
            window.location.href = "@Url.Action("InsertUserDetails", "User")";
        }
    });
</script>
}
