		{
			"name": "3. Get Tariff Updates",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is an array of tariff slabs\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an(\"array\");",
							"    pm.expect(jsonData.length).to.be.above(0);",
							"});",
							"",
							"pm.test(\"Tariff slab contains required fields\", function () {",
							"    const jsonData = pm.response.json();",
							"    const first = jsonData[0];",
							"    pm.expect(first).to.have.property(\"slabId\").that.is.a(\"number\");",
							"    pm.expect(first).to.have.property(\"feederId\").that.is.a(\"string\");",
							"    pm.expect(first).to.have.property(\"slabName\").that.is.a(\"string\");",
							"    pm.expect(first).to.have.property(\"minUnits\").that.is.a(\"number\");",
							"    pm.expect(first).to.have.property(\"ratePerUnit\").that.is.a(\"number\");",
							"    pm.expect(first.ratePerUnit).to.be.above(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "X-API-Key",
						"value": "{{apiKey}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/tariff-updates",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"tariff-updates"
					]
				},
				"description": "Retrieves active tariff structures and billing slabs."
			},
			"response": []
		},
		{
			"name": "4. Get Dispatch Alerts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is an array of dispatch alerts\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an(\"array\");",
							"});",
							"",
							"pm.test(\"Alert records contain valid severity levels\", function () {",
							"    const jsonData = pm.response.json();",
							"    const validSeverities = [\"Low\", \"Medium\", \"High\", \"Critical\"];",
							"    jsonData.forEach(function(alert) {",
							"        pm.expect(alert).to.have.property(\"alertId\");",
							"        pm.expect(alert).to.have.property(\"feederId\");",
							"        pm.expect(alert).to.have.property(\"severity\");",
							"        pm.expect(alert).to.have.property(\"message\");",
							"        pm.expect(validSeverities).to.include(alert.severity);",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "X-API-Key",
						"value": "{{apiKey}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/dispatch-alerts",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"dispatch-alerts"
					]
				},
				"description": "Queries real-time grid alerts and dispatch notifications."
			},
			"response": []
		}
