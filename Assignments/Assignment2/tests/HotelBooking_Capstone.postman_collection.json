    {
      "name": "Module_03_User",
      "item": [
        {
          "name": "01_Login_Admin_Positive200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Admin token received', function() {",
                  "  pm.expect(json.data.token).to.be.a('string');",
                  "  pm.expect(json.data.role).to.eql('Admin');",
                  "  pm.environment.set('adminToken', json.data.token);",
                  "  pm.environment.set('adminUserId', json.data.userId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
