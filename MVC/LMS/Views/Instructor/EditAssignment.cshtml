@model LMS.ViewModels.AssignmentFormViewModel
@{
    ViewBag.Title = "Edit Assignment Task - " + (Model.CourseTitle ?? "Course");
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")" class="text-decoration-none">My Courses</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Assignments", "Instructor", new { courseId = Model.CourseId })" class="text-decoration-none">Assignments</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit Task</li>
            </ol>
        </nav>

        <div class="card card-custom p-4 p-md-5 shadow-sm bg-white card-gradient-top border-0">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="rounded-circle bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center shadow-xs" style="width: 50px; height: 50px;">
                    <i class="bi bi-pencil-square fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-extrabold mb-0 tracking-tight">Edit Practical Task / Assignment</h3>
                    <p class="text-muted small mb-0">Update assignment instructions, due date, and grading rubric parameters</p>
                </div>
            </div>

            @using (Html.BeginForm("EditAssignment", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.AssignmentId)
                @Html.HiddenFor(m => m.CourseId)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, "Assignment Title", new { @class = "form-label fw-bold small text-dark" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Architect a Distributed Microservices Solution", required = "required" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Description, "Project Specification & Criteria", new { @class = "form-label fw-bold small text-dark" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 6, placeholder = "Detail the project objectives, required technologies, implementation deliverables, and repository submission instructions...", required = "required" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.MaxMarks, "Maximum Score (Marks)", new { @class = "form-label fw-bold small text-dark" })
                        @Html.TextBoxFor(m => m.MaxMarks, new { @class = "form-control", type = "number", min = "1", max = "1000", placeholder = "100", required = "required" })
                        @Html.ValidationMessageFor(m => m.MaxMarks, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.DueDate, "Submission Deadline", new { @class = "form-label fw-bold small text-dark" })
                        @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        <small class="text-muted">Optional submission deadline for enrolled students.</small>
                        @Html.ValidationMessageFor(m => m.DueDate, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="@Url.Action("Assignments", "Instructor", new { courseId = Model.CourseId })" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Update Task Details
                    </button>
                </div>
            }
        </div>
    </div>
</div>
