@{
    ViewBag.Title = "Password Reset Request Received";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom p-4 p-md-5 text-center shadow-lg border-0" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25) !important; border-radius: 20px; backdrop-filter: blur(16px); color: #FFFFFF;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3 shadow-sm" style="background: rgba(53, 201, 138, 0.15); color: #35C98A; border: 1px solid rgba(53, 201, 138, 0.3);">
                <i class="bi bi-envelope-check-fill display-4"></i>
            </div>
            
            <h3 class="fw-extrabold text-white tracking-tight mb-2">Request Submitted</h3>
            <p class="small mb-4" style="color: #94A3B8; line-height: 1.7;">
                Your password reset verification request has been securely logged and forwarded to the system administrators and faculty directors.
            </p>

            <div class="p-3 rounded-3 text-start mb-4" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.1);">
                <div class="d-flex align-items-start gap-2 mb-2">
                    <i class="bi bi-shield-check text-cyan fs-5 flex-shrink-0 mt-1"></i>
                    <div>
                        <strong class="text-white small d-block">Admin Verification Protocol</strong>
                        <span style="color: #94A3B8; font-size: 12px;">For security, password changes for instructors and faculty members require administrator authorization.</span>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-lightning-charge-fill text-orange fs-5 flex-shrink-0 mt-1"></i>
                    <div>
                        <strong class="text-white small d-block">Reset Link Activation</strong>
                        <span style="color: #94A3B8; font-size: 12px;">Once approved in the Admin Control Center, the secure reset link is immediately dispatched and activated for your account.</span>
                    </div>
                </div>
            </div>

            <div>
                <a href="@Url.Action("Login", "Account")" class="btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Return to Sign In
                </a>
            </div>
        </div>
    </div>
</div>
