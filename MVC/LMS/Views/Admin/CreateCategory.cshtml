@model LMS.ViewModels.CategoryViewModel
@{
    ViewBag.Title = "Add Category";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")">Admin</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Categories", "Admin")">Categories</a></li>
            <li class="breadcrumb-item active" aria-current="page">New Category</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-tag-fill me-2"></i>Create Course Category</h4>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("CreateCategory", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CategoryName, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.CategoryName, new { @class = "form-control", placeholder = "e.g. Cloud Computing & DevOps" })
                            @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Description, new { @class = "form-label fw-bold" })
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4, placeholder = "Brief description of the domain topics and skills covered in this category." })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-check form-switch mb-4">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", @checked = "checked" })
                            @Html.LabelFor(m => m.IsActive, "Active (visible in course catalog filter)", new { @class = "form-check-label fw-semibold" })
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="@Url.Action("Categories", "Admin")" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i> Save Category
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
