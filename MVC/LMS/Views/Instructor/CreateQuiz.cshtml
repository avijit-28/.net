@model LMS.ViewModels.QuizFormViewModel
@{
    ViewBag.Title = "Create Quiz";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <div class="card card-custom p-4 p-md-5 shadow-sm">
            <h3 class="fw-bold mb-1">Create Assessment Quiz</h3>
            <p class="text-muted small mb-4">Set quiz parameters, time limits, and passing standards</p>

            @using (Html.BeginForm("CreateQuiz", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CourseId)
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Midterm Evaluation Assessment" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "Explain topics tested and guidance for test takers..." })
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PassingPercentage, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.PassingPercentage, new { @class = "form-control", placeholder = "40" })
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.TimeLimitMinutes, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.TimeLimitMinutes, new { @class = "form-control", placeholder = "30" })
                            <span class="input-group-text">Minutes</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="@Url.Action("Quizzes", "Instructor", new { courseId = Model.CourseId })" class="btn btn-outline-secondary rounded-pill">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                        Create Quiz & Add Questions &rarr;
                    </button>
                </div>
            }
        </div>
    </div>
</div>
