<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - jQuery DataTables & JSGrid AJAX Dashboard</title>
    
    <!-- Bootstrap CSS -->
    @Styles.Render("~/Content/css")
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- jQuery DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    
    <!-- JSGrid CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid-theme.min.css" />
    
    <!-- Core jQuery (Loaded early in head for smooth execution) -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <i class="fa-solid fa-table-cells text-primary me-2 fs-4"></i>
                <span class="fw-bold">AJAX Grid Hub</span>
                <span class="badge bg-primary ms-2 rounded-pill fs-7">ASP.NET MVC</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="#dashboard-overview"><i class="fa-solid fa-chart-pie me-1"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#interactive-workflow"><i class="fa-solid fa-diagram-project me-1"></i> Architecture Workflow</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#live-datatable"><i class="fa-solid fa-table me-1"></i> jQuery DataTable</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#live-jsgrid"><i class="fa-solid fa-grip me-1"></i> JSGrid Component</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#ajax-inspector"><i class="fa-solid fa-terminal me-1"></i> AJAX Inspector</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-warning fw-semibold" href="@Url.Action("InsertUserDetails", "User")">
                            <i class="fa-solid fa-arrows-split-up-and-left me-1"></i> Redirects &amp; Status
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center text-white">
                    <span class="badge bg-success me-2"><i class="fa-solid fa-circle-check me-1"></i> Backend Online</span>
                    <span class="small text-secondary">ASP.NET MVC + jQuery AJAX</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 body-content">
        @RenderBody()
        
        <footer class="mt-5 pt-4 pb-3 border-top text-muted small text-center">
            <p class="mb-1">&copy; @DateTime.Now.Year - ASP.NET MVC with jQuery DataTables & JSGrid Integration</p>
            <p class="text-secondary mb-0">End-to-End Client/Server Architecture with Entity Framework &amp; JsonResult</p>
        </footer>
    </div>

    <!-- Bootstrap Bundle JS -->
    @Scripts.Render("~/bundles/bootstrap")
    
    <!-- jQuery DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    
    <!-- JSGrid JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid.min.js"></script>
    
    @RenderSection("scripts", required: false)
</body>
</html>
