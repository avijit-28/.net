@{
    ViewBag.Title = "Verify Certificate of Completion";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 p-md-5 shadow-lg text-center border-0 rounded-4" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.12); backdrop-filter: blur(8px);">
            <div class="mb-3">
                <span class="badge rounded-pill px-3 py-2 fs-6 fw-bold shadow-xs" style="background: rgba(39, 184, 214, 0.15); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.3);">
                    <i class="bi bi-patch-check-fill me-1"></i> Credential Verification Portal
                </span>
            </div>
            <h2 class="fw-extrabold mb-2 tracking-tight text-white">Verify Official Credential</h2>
            <p class="small mb-4" style="color: rgba(255, 255, 255, 0.7);">
                Enter the unique cryptographic certificate number found on any official LMS certificate to verify its academic validity and accreditation.
            </p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show text-start mb-4 border-0 border-start border-4 border-danger shadow-xs" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2 text-danger"></i>@ViewBag.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @using (Html.BeginForm("VerifyCertificate", "Certificate", FormMethod.Get, new { @class = "text-start" }))
            {
                <div class="mb-3">
                    <label class="form-label fw-bold small text-white">Certificate ID Number</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0" style="background: rgba(11, 52, 69, 0.8); border-color: rgba(255, 255, 255, 0.15); color: #27B8D6;"><i class="bi bi-upc-scan"></i></span>
                        <input type="text" name="certNumber" class="form-control border-start-0 font-monospace text-white" placeholder="e.g. LMS-2026-123456" required style="background: rgba(6, 35, 48, 0.8); border-color: rgba(255, 255, 255, 0.15);" />
                    </div>
                    <small style="color: rgba(255, 255, 255, 0.55);">Standard format: LMS-YEAR-XXXXXX (case-insensitive)</small>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary rounded-pill py-3 fw-bold text-white shadow-sm">
                        <i class="bi bi-search me-1"></i> Verify Credential Authenticity
                    </button>
                </div>
            }

            <div class="mt-4 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                <a href="@Url.Action("Index", "Home")" class="text-decoration-none small text-white-50">
                    <i class="bi bi-arrow-left me-1"></i> Return to EduPlatform Homepage
                </a>
            </div>
        </div>
    </div>
</div>
