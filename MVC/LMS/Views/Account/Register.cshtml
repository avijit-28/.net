@model LMS.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Create an Account";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 p-md-5 shadow-sm bg-white card-gradient-top">
            <div class="text-center mb-4">
                <span class="rounded-circle bg-primary-subtle text-primary p-3 d-inline-flex mb-2 shadow-xs">
                    <i class="bi bi-person-plus fs-3"></i>
                </span>
                <h3 class="fw-extrabold tracking-tight mb-1">Get Started Today</h3>
                <p class="text-muted small">Join our community of students and verified instructors on EduPlatform</p>
            </div>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small border-0 border-start border-4 border-danger" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-bold small text-dark" })
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control border-start-0", placeholder = "John Doe", required = "required" })
                    </div>
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold small text-dark" })
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0", placeholder = "name@example.com", required = "required" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label fw-bold small text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0 border-end-0", placeholder = "••••••••", required = "required" })
                            <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-bold small text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control border-start-0 border-end-0", placeholder = "••••••••", required = "required" })
                            <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-dark">Select Your Account Role:</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Role" id="roleStudent" value="Student" checked />
                            <label class="btn btn-outline-primary w-100 py-3 d-flex flex-column align-items-center rounded-3 shadow-xs" for="roleStudent">
                                <i class="bi bi-backpack2 fs-3 mb-1"></i>
                                <span class="fw-bold">Student Learner</span>
                                <small class="text-muted" style="font-size: 11px;">Enroll & Earn Credentials</small>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Role" id="roleInstructor" value="Instructor" />
                            <label class="btn btn-outline-primary w-100 py-3 d-flex flex-column align-items-center rounded-3 shadow-xs" for="roleInstructor">
                                <i class="bi bi-mortarboard fs-3 mb-1"></i>
                                <span class="fw-bold">Educator / Instructor</span>
                                <small class="text-muted" style="font-size: 11px;">Publish & Teach Curriculums</small>
                            </label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-3">
                    <i class="bi bi-check2-circle me-1"></i> Complete Registration
                </button>
            }

            <div class="text-center mt-3 small text-muted">
                Already registered? <a href="@Url.Action("Login", "Account")" class="text-primary fw-bold text-decoration-none">Sign In to Account</a>
            </div>
        </div>
    </div>
</div>
