@model IEnumerable<LMS.Models.Course>
@{
    ViewBag.Title = "Course Governance";
}

<div class="container-fluid py-4 px-lg-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Course Governance</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-collection-play-fill me-2 text-primary"></i>Course Catalog Governance</h2>
            <p class="text-muted mb-0">Oversee all platform courses, verify quality, and manage publication states</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 p-2">Total Courses: @Model.Count()</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Course</th>
                        <th>Category</th>
                        <th>Level</th>
                        <th>Price</th>
                        <th>Enrolled</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th class="text-end">Update Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(course.Thumbnail))
                                    {
                                        <img src="@course.Thumbnail" class="rounded me-3" style="width: 50px; height: 35px; object-fit: cover;" alt="" />
                                    }
                                    <div>
                                        <a href="@Url.Action("Details", "Courses", new { id = course.CourseId })" target="_blank" class="fw-bold text-dark text-decoration-none">
                                            @course.Title
                                        </a>
                                        <div class="small text-muted">Created @course.CreatedDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(course.Category != null ? course.Category.CategoryName : "Unassigned")</td>
                            <td><span class="badge bg-light text-dark border">@course.Level</span></td>
                            <td class="fw-bold">
                                @(course.Price == 0 ? "Free" : "$" + course.Price.ToString("N2"))
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info border border-info">@course.TotalStudents learners</span>
                            </td>
                            <td>
                                <span class="text-warning"><i class="bi bi-star-fill me-1"></i></span>@course.Rating.ToString("0.0")
                            </td>
                            <td>
                                @if (course.Status == "Published")
                                {
                                    <span class="badge bg-success"><i class="bi bi-broadcast me-1"></i>Published</span>
                                }
                                else if (course.Status == "Draft")
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Archived</span>
                                }
                            </td>
                            <td class="text-end">
                                @using (Html.BeginForm("UpdateCourseStatus", "Admin", FormMethod.Post, new { @class = "d-inline-flex gap-1 justify-content-end" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="courseId" value="@course.CourseId" />
                                    <select name="status" class="form-select form-select-sm" style="width: 120px;">
                                        <option value="Published" @(course.Status == "Published" ? "selected" : "")>Published</option>
                                        <option value="Draft" @(course.Status == "Draft" ? "selected" : "")>Draft</option>
                                        <option value="Archived" @(course.Status == "Archived" ? "selected" : "")>Archived</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        Update
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
