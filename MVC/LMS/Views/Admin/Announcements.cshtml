@model IEnumerable<LMS.Models.Announcement>
@{
    ViewBag.Title = "System Announcements";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Announcements</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-megaphone-fill me-2 text-primary"></i>System Broadcasts & Announcements</h2>
            <p class="text-muted mb-0">Publish platform alerts, maintenance banners, and notices across the LMS</p>
        </div>
        <div>
            <a href="@Url.Action("CreateAnnouncement", "Admin")" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> New Announcement
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-broadcast text-muted display-4"></i>
                <h4 class="mt-3 fw-bold">No announcements broadcasted</h4>
                <p class="text-muted">Post your first system-wide announcement to inform all learners and instructors.</p>
                <a href="@Url.Action("CreateAnnouncement", "Admin")" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Create Announcement
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold text-dark mb-0">@item.Title</h5>
                                <div>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Archived</span>
                                    }
                                </div>
                            </div>
                            <small class="text-muted d-block mb-3">
                                <i class="bi bi-clock me-1"></i> Posted @item.CreatedDate.ToString("MMM dd, yyyy HH:mm")
                            </small>
                            <p class="text-secondary" style="white-space: pre-wrap;">@item.Message</p>
                            <div class="pt-3 border-top d-flex justify-content-end">
                                @using (Html.BeginForm("DeleteAnnouncement", "Admin", new { id = item.AnnouncementId }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this announcement?');">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
