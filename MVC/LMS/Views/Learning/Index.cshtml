@model LMS.ViewModels.LearningViewModel
@{
    ViewBag.Title = Model.CurrentLesson != null ? Model.CurrentLesson.Title + " - " + Model.Course.Title : Model.Course.Title;
    var currentLessonId = Model.CurrentLesson != null ? Model.CurrentLesson.LessonId : 0;
}

<div class="classroom-container card card-custom shadow-sm border-0 overflow-hidden mb-4">
    <!-- Top Classroom Header Bar -->
    <div class="classroom-top-bar bg-dark text-white p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-3 border-bottom border-secondary" style="border-color: rgba(255,255,255,0.1) !important;">
        <div class="d-flex align-items-center gap-3">
            <a href="@Url.Action("MyCourses", "Student")" class="btn btn-sm btn-outline-light rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> My Courses
            </a>
            <div>
                <h5 class="fw-bold mb-0 text-white text-truncate" style="max-width: 480px;">@Model.Course.Title</h5>
                <small class="text-secondary">@(Model.CurrentModule != null ? Model.CurrentModule.ModuleName : "Curriculum")</small>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Syllabus Toggle (Visible in Focus Mode) -->
            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 d-none" id="btnToggleSidebarInFocus" title="Toggle Syllabus Sidebar">
                <i class="bi bi-layout-sidebar-inset me-1"></i> Syllabus
            </button>

            <!-- Focus / Theater Mode Switch -->
            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold" id="btnToggleTheater" title="Toggle Distraction-Free Focus Mode">
                <i class="bi bi-moon-stars me-1"></i> Focus Mode
            </button>

            <!-- Progress Meter -->
            <div class="d-none d-sm-block text-end ms-2" style="min-width: 130px;">
                <div class="small text-secondary" style="font-size: 11px;">Course Progress</div>
                <div class="fw-bold text-success" id="progressText">@Model.ProgressPercentage% Completed</div>
            </div>
            <div class="progress d-none d-sm-block" style="width: 110px; height: 10px; background: rgba(255,255,255,0.15);">
                <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="progressBar" role="progressbar" style="width: @Model.ProgressPercentage%;"></div>
            </div>

            @if (Model.IsCourseCompleted)
            {
                <a href="@Url.Action("Certificates", "Student")" class="btn btn-sm btn-primary fw-bold rounded-pill shadow-sm text-white ms-1">
                    <i class="bi bi-award-fill me-1"></i> Certificate Ready!
                </a>
            }
        </div>
    </div>

    <!-- Classroom Body: Split Layout -->
    <div class="row g-0">
        <!-- Curriculum Sidebar -->
        <div class="col-lg-4 col-xl-3 border-end classroom-sidebar" style="max-height: 85vh; overflow-y: auto; background: #041822; border-color: rgba(255, 255, 255, 0.1) !important;">
            <div class="p-3 border-bottom sticky-top d-flex justify-content-between align-items-center" style="background: #062330; border-color: rgba(255, 255, 255, 0.1) !important;">
                <h6 class="fw-bold text-uppercase small mb-0 text-white">
                    <i class="bi bi-list-check me-1 text-cyan"></i> Syllabus Outline
                </h6>
                <span class="badge rounded-pill px-3 py-1 small" style="background: rgba(39, 184, 214, 0.15); color: #38BDF8; border: 1px solid rgba(56, 189, 248, 0.25);">@Model.Modules.Sum(m => m.Lessons.Count) Lessons</span>
            </div>

            <div class="accordion accordion-flush" id="learningAccordion">
                @for (int mIdx = 0; mIdx < Model.Modules.Count; mIdx++)
                {
                    var module = Model.Modules[mIdx];
                    var moduleTasks = Model.CourseAssignments != null ? Model.CourseAssignments.Where(a => a.ModuleId == module.ModuleId).ToList() : new List<LMS.Models.Assignment>();
                    var moduleQuizzes = Model.ModuleQuizzes != null ? Model.ModuleQuizzes.Where(q => q.ModuleId == module.ModuleId || (q.LessonId.HasValue && module.Lessons.Any(l => l.LessonId == q.LessonId.Value))).ToList() : new List<LMS.Models.Quiz>();
                    bool isModuleActive = (Model.CurrentLesson != null && module.Lessons.Any(l => l.LessonId == Model.CurrentLesson.LessonId));
                    int totalItemsInMod = module.Lessons.Count + moduleTasks.Count + moduleQuizzes.Count;

                    <div class="accordion-item border-bottom bg-transparent">
                        <h2 class="accordion-header" id="heading-@module.ModuleId">
                            <button class="accordion-button @(isModuleActive ? "" : "collapsed") bg-transparent py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@module.ModuleId">
                                <div class="w-100 pe-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small fw-bold text-uppercase" style="font-size: 10px; color: #27B8D6;">Module @(mIdx + 1)</span>
                                        <span class="badge rounded-pill px-2 py-1" style="font-size: 9px; background: rgba(39, 184, 214, 0.15); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.3);">@totalItemsInMod items</span>
                                    </div>
                                    <div class="fw-bold text-white small">@module.ModuleName</div>
                                </div>
                            </button>
                        </h2>
                        <div id="collapse-@module.ModuleId" class="accordion-collapse collapse @(isModuleActive ? "show" : "")" data-bs-parent="#learningAccordion">
                            <div class="accordion-body p-0">
                                <div class="list-group list-group-flush">
                                    <!-- Module Lessons -->
                                    @foreach (var lesson in module.Lessons)
                                    {
                                        bool isCurrent = Model.CurrentLesson != null && lesson.LessonId == Model.CurrentLesson.LessonId;
                                        bool isDone = Model.CompletedLessonIds.Contains(lesson.LessonId);
                                        <a href="@Url.Action("Index", "Learning", new { courseId = Model.Course.CourseId, lessonId = lesson.LessonId })"
                                           class="list-group-item list-group-item-action py-3 px-3 d-flex align-items-center justify-content-between @(isCurrent ? "active-lesson border-start border-4 border-warning fw-bold text-white" : "")">
                                            <div class="d-flex align-items-center gap-2 overflow-hidden pe-2">
                                                @if (isDone)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                }
                                                else if (isCurrent)
                                                {
                                                    <i class="bi bi-play-circle-fill text-primary fs-5"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-circle text-muted fs-5"></i>
                                                }
                                                <div class="small text-truncate">@lesson.Title</div>
                                            </div>
                                            <span class="badge bg-secondary-subtle text-secondary small" style="font-size: 10px;">
                                                @lesson.DurationInMinutes m
                                            </span>
                                        </a>
                                    }

                                    <!-- Module Hands-On Tasks / Assignments -->
                                    @foreach (var task in moduleTasks)
                                    {
                                        bool isSubmitted = Model.SubmittedAssignmentIds != null && Model.SubmittedAssignmentIds.Contains(task.AssignmentId);
                                        <a href="@Url.Action("Details", "Assignment", new { id = task.AssignmentId })" class="list-group-item list-group-item-action py-3 px-3 d-flex align-items-center justify-content-between bg-info-subtle bg-opacity-10">
                                            <div class="d-flex align-items-center gap-2 overflow-hidden pe-2">
                                                @if (isSubmitted)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-file-earmark-code-fill text-info fs-5"></i>
                                                }
                                                <div class="small text-truncate"><span class="badge bg-info-subtle text-info me-1 py-0 px-1" style="font-size: 9px;">TASK</span> @task.Title</div>
                                            </div>
                                            <span class="badge @(isSubmitted ? "bg-success-subtle text-success" : "bg-info-subtle text-info") small" style="font-size: 10px;">
                                                @(isSubmitted ? "Submitted" : task.MaxMarks + " pts")
                                            </span>
                                        </a>
                                    }

                                    <!-- Module Checkpoint Quizzes -->
                                    @foreach (var quiz in moduleQuizzes)
                                    {
                                        bool isPassed = Model.PassedQuizIds != null && Model.PassedQuizIds.Contains(quiz.QuizId);
                                        <a href="@Url.Action("Take", "Quiz", new { id = quiz.QuizId })" class="list-group-item list-group-item-action py-3 px-3 d-flex align-items-center justify-content-between bg-warning-subtle bg-opacity-10">
                                            <div class="d-flex align-items-center gap-2 overflow-hidden pe-2">
                                                @if (isPassed)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-patch-question-fill text-warning fs-5"></i>
                                                }
                                                <div class="small text-truncate"><span class="badge bg-warning-subtle text-dark me-1 py-0 px-1" style="font-size: 9px;">QUIZ</span> @quiz.Title</div>
                                            </div>
                                            <span class="badge @(isPassed ? "bg-success-subtle text-success" : "bg-warning-subtle text-dark") small" style="font-size: 10px;">
                                                @(isPassed ? "Passed" : (quiz.TimeLimitMinutes ?? 30) + "m")
                                            </span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Course-Wide Projects / Capstones (unassigned to a single module) -->
                @{
                    var generalTasks = Model.CourseAssignments != null ? Model.CourseAssignments.Where(a => !a.ModuleId.HasValue).ToList() : new List<LMS.Models.Assignment>();
                }
                @if (generalTasks.Any())
                {
                    <div class="accordion-item border-bottom bg-transparent">
                        <h2 class="accordion-header" id="heading-general-tasks">
                            <button class="accordion-button collapsed bg-transparent py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-general-tasks">
                                <div class="w-100 pe-2">
                                    <div class="small text-info fw-bold text-uppercase" style="font-size: 10px;">Capstone Projects</div>
                                    <div class="fw-bold text-dark small"><i class="bi bi-folder-check text-info me-1"></i> Course-Wide Tasks (@generalTasks.Count)</div>
                                </div>
                            </button>
                        </h2>
                        <div id="collapse-general-tasks" class="accordion-collapse collapse" data-bs-parent="#learningAccordion">
                            <div class="accordion-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var task in generalTasks)
                                    {
                                        bool isSubmitted = Model.SubmittedAssignmentIds != null && Model.SubmittedAssignmentIds.Contains(task.AssignmentId);
                                        <a href="@Url.Action("Details", "Assignment", new { id = task.AssignmentId })" class="list-group-item list-group-item-action py-3 px-3 d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-2 overflow-hidden pe-2">
                                                @if (isSubmitted)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-file-earmark-code text-info fs-5"></i>
                                                }
                                                <div class="small text-truncate">@task.Title</div>
                                            </div>
                                            <span class="badge @(isSubmitted ? "bg-success-subtle text-success" : "bg-info-subtle text-info") small" style="font-size: 10px;">
                                                @(isSubmitted ? "Submitted" : task.MaxMarks + " pts")
                                            </span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Dedicated Final Mandatory Certification Exam Section -->
                @if (Model.FinalExam != null)
                {
                    <div class="p-3 border-top" style="background: #062330; border-color: rgba(255, 255, 255, 0.1) !important;">
                        <div class="card p-3 rounded-3 shadow-xs" style="background: rgba(11, 52, 69, 0.65); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge rounded-pill px-2 py-1" style="font-size: 10px; background: @(Model.HasPassedFinalExam ? "#35C98A" : (Model.IsFinalExamUnlocked ? "#FF7A18" : "rgba(255, 255, 255, 0.15)")); color: #FFFFFF;">
                                    <i class="bi @(Model.HasPassedFinalExam ? "bi-check2-circle" : (Model.IsFinalExamUnlocked ? "bi-unlock-fill" : "bi-lock-fill")) me-1"></i>
                                    @(Model.HasPassedFinalExam ? "EXAM CLEARED" : (Model.IsFinalExamUnlocked ? "FINAL EXAM READY" : "FINAL EXAM LOCKED"))
                                </span>
                                <span class="font-monospace small" style="font-size: 10px; color: #94A3B8;">Pass: @Model.FinalExam.PassingPercentage%</span>
                            </div>

                            <h6 class="fw-bold mb-1 text-white" style="font-size: 13px;">
                                <i class="bi bi-award-fill text-orange me-1"></i> @Model.FinalExam.Title
                            </h6>

                            <p class="small mb-2" style="font-size: 11px; color: #94A3B8;">
                                @if (Model.HasPassedFinalExam)
                                {
                                    <span class="text-white">Cleared with <strong class="text-success">@Model.FinalExamScore%</strong>. Official certificate unlocked!</span>
                                }
                                else if (Model.IsFinalExamUnlocked)
                                {
                                    <span class="text-white fw-semibold">100% Modules complete! Clear this exam to get your certificate.</span>
                                }
                                else
                                {
                                    <span>Complete 100% of curriculum lessons, tasks, and quizzes to unlock.</span>
                                }
                            </p>

                            @if (Model.HasPassedFinalExam)
                            {
                                <a href="@Url.Action("Certificates", "Student")" class="btn btn-sm btn-success rounded-pill fw-bold w-100 py-1" style="font-size: 12px; background-color: #35C98A !important; border-color: #35C98A !important;">
                                    <i class="bi bi-award me-1"></i> View Credential
                                </a>
                            }
                            else if (Model.IsFinalExamUnlocked)
                            {
                                <a href="@Url.Action("Take", "Quiz", new { id = Model.FinalExam.QuizId })" class="btn btn-sm btn-primary text-white rounded-pill fw-bold w-100 py-1 shadow-xs" style="font-size: 12px; background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                                    <i class="bi bi-lightning-charge-fill me-1"></i> Take Final Exam Now
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm rounded-pill w-100 py-1" disabled style="font-size: 12px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); color: #94A3B8;">
                                    <i class="bi bi-lock-fill me-1"></i> Unlocks at 100%
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Main Lesson Stage -->
        <div class="col-lg-8 col-xl-9 classroom-stage p-4 p-md-5 d-flex flex-column" style="min-height: 85vh; background: linear-gradient(180deg, #062330 0%, #041822 100%); color: #FFFFFF;">
            @if (Model.CurrentLesson == null)
            {
                <div class="text-center my-auto py-5">
                    <i class="bi bi-journal-check display-1 text-white-50 mb-3"></i>
                    <h4 class="fw-bold text-white">Welcome to the Classroom</h4>
                    <p class="text-white-50">Select a lesson from the curriculum sidebar on the left to begin learning.</p>
                </div>
            }
            else
            {
                if (Model.IsFinalExamUnlocked && !Model.HasPassedFinalExam && Model.FinalExam != null)
                {
                    <div class="alert alert-warning border-0 border-start border-4 border-warning shadow-sm rounded-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-award-fill text-warning fs-3"></i>
                            <div>
                                <strong class="d-block text-dark">100% Curriculum Modules Completed!</strong>
                                <span class="small text-muted">Clear the Mandatory Final Certification Exam to unlock your official credential.</span>
                            </div>
                        </div>
                        <a href="@Url.Action("Take", "Quiz", new { id = Model.FinalExam.QuizId })" class="btn btn-primary text-white rounded-pill fw-bold px-4 shadow-sm">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Take Final Exam Now
                        </a>
                    </div>
                }
                else if (Model.HasPassedFinalExam || Model.IsCourseCompleted)
                {
                    <div class="alert alert-success border-0 border-start border-4 border-success shadow-sm rounded-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-patch-check-fill text-success fs-3"></i>
                            <div>
                                <strong class="d-block text-success">Congratulations! Course Completed & Final Exam Cleared!</strong>
                                <span class="small text-muted">Your official verified digital certificate is available for download and verification.</span>
                            </div>
                        </div>
                        <a href="@Url.Action("Certificates", "Student")" class="btn btn-success rounded-pill fw-bold px-4 shadow-sm">
                            <i class="bi bi-award-fill me-1"></i> View Certificate
                        </a>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge rounded-pill px-3 py-1" style="background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.3);">
                                @Model.CurrentLesson.LessonType Lesson
                            </span>
                            <span class="small" style="color: rgba(255, 255, 255, 0.7);"><i class="bi bi-clock me-1 text-orange"></i> @Model.CurrentLesson.DurationInMinutes minutes</span>
                        </div>
                        <h3 class="fw-extrabold mb-0 text-white">@Model.CurrentLesson.Title</h3>
                    </div>

                    <div class="mt-2 mt-md-0" id="completionStatusContainer">
                        @if (Model.IsCurrentCompleted)
                        {
                            <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill">
                                <i class="bi bi-check2-circle me-1"></i> Lesson Completed
                            </span>
                        }
                        else
                        {
                            using (Html.BeginForm("MarkComplete", "Learning", FormMethod.Post, new { id = "markCompleteForm", @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lessonId" value="@Model.CurrentLesson.LessonId" />
                                <button type="submit" id="btnMarkComplete" class="btn btn-outline-success rounded-pill px-4 fw-semibold shadow-sm">
                                    <i class="bi bi-check-lg me-1"></i> Mark as Complete
                                </button>
                            }
                        }
                    </div>
                </div>

                <!-- Lesson Content Area -->
                <div class="lesson-viewer flex-grow-1 mb-4">
                    @if (Model.CurrentLesson.LessonType == "Video")
                    {
                        <div class="bg-dark rounded-3 overflow-hidden shadow mb-4 position-relative" style="min-height: 420px; display: flex; align-items: center; justify-content: center; background: #000000;">
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentLesson.VideoUrl))
                            {
                                if (LMS.Helpers.VideoHelper.IsDirectVideoFile(Model.CurrentLesson.VideoUrl))
                                {
                                    <div class="ratio ratio-16x9 w-100 rounded-2 overflow-hidden shadow-lg">
                                        <video controls playsinline class="w-100 h-100" style="object-fit: contain; background: #000;">
                                            <source src="@Model.CurrentLesson.VideoUrl" type="video/mp4" />
                                            Your browser does not support the video tag.
                                        </video>
                                    </div>
                                }
                                else
                                {
                                    var embedUrl = LMS.Helpers.VideoHelper.ToEmbedUrl(Model.CurrentLesson.VideoUrl);
                                    <div class="ratio ratio-16x9 w-100 rounded-2 overflow-hidden shadow-lg">
                                        <iframe src="@embedUrl" title="@Model.CurrentLesson.Title" class="w-100 h-100 border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="py-5 text-center p-4">
                                    <div class="rounded-circle bg-primary bg-opacity-25 text-primary p-4 d-inline-flex mb-3 shadow-sm">
                                        <i class="bi bi-camera-video-off-fill display-4"></i>
                                    </div>
                                    <h5 class="text-white fw-bold">Video Lecture Coming Soon</h5>
                                    <p class="text-secondary small mb-0">The instructor has not attached a video stream link for this lesson yet.</p>
                                </div>
                            }
                        </div>
                    }
                    else if (Model.CurrentLesson.LessonType == "PDF" || (!string.IsNullOrEmpty(Model.CurrentLesson.ResourceUrl) && Model.CurrentLesson.ResourceUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)))
                    {
                        var pdfUrl = !string.IsNullOrEmpty(Model.CurrentLesson.ResourceUrl) ? Model.CurrentLesson.ResourceUrl : Model.CurrentLesson.VideoUrl;
                        <div class="card card-custom p-0 rounded-4 overflow-hidden shadow-lg mb-4" style="background: #062330; border: 1px solid rgba(39, 184, 214, 0.3); color: #FFFFFF;">
                            <!-- PDF Viewer Toolbar -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom gap-2" style="background: #0B3445; border-color: rgba(255, 255, 255, 0.1) !important;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background: rgba(239, 68, 68, 0.2); color: #EF4444; width: 36px; height: 36px;">
                                        <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <strong class="text-white small d-block">@Model.CurrentLesson.Title</strong>
                                        <span class="badge rounded-pill small" style="background: rgba(39, 184, 214, 0.2); color: #27B8D6; font-size: 10px;">
                                            <i class="bi bi-cloud-check me-1"></i>Cloudinary PDF &bull; API 184454516547644
                                        </span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(pdfUrl))
                                    {
                                        <a href="@pdfUrl" target="_blank" download class="btn btn-sm btn-outline-cyan rounded-pill px-3 fw-semibold shadow-xs" style="border-color: #27B8D6; color: #27B8D6;">
                                            <i class="bi bi-download me-1"></i> Download PDF
                                        </a>
                                        <a href="@pdfUrl" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-xs text-white" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                                            <i class="bi bi-arrows-fullscreen me-1"></i> Fullscreen
                                        </a>
                                    }
                                </div>
                            </div>

                            <!-- PDF Reader Container -->
                            @if (!string.IsNullOrEmpty(pdfUrl))
                            {
                                <div class="w-100 position-relative" style="height: 720px; background: #041822;">
                                    <iframe src="@pdfUrl#toolbar=1&navpanes=0" class="w-100 h-100 border-0" title="@Model.CurrentLesson.Title">
                                        <div class="p-5 text-center text-white">
                                            <p>Your browser doesn't support embedded PDFs.</p>
                                            <a href="@pdfUrl" target="_blank" class="btn btn-primary rounded-pill">Open PDF Document</a>
                                        </div>
                                    </iframe>
                                </div>
                            }
                            else
                            {
                                <div class="p-5 text-center" style="background: rgba(4, 24, 34, 0.6);">
                                    <div class="rounded-circle p-4 d-inline-flex mx-auto mb-3 shadow-sm" style="background: rgba(239, 68, 68, 0.15); color: #EF4444;">
                                        <i class="bi bi-file-earmark-x display-4"></i>
                                    </div>
                                    <h5 class="fw-bold text-white mb-2">No PDF File Attached</h5>
                                    <p class="small text-muted mb-0">The instructor has marked this lesson as a PDF document but hasn't uploaded the file yet.</p>
                                </div>
                            }
                        </div>
                    }
                    else if (Model.CurrentLesson.LessonType == "Quiz")
                    {
                        var quiz = Model.Course.Quizzes.FirstOrDefault(q => q.LessonId == Model.CurrentLesson.LessonId) ?? Model.Course.Quizzes.FirstOrDefault();
                        <div class="lesson-quiz-box card card-custom p-5 text-center my-3 shadow-lg" style="background: linear-gradient(135deg, #062330 0%, #0B3445 100%) !important; border: 1px solid rgba(39, 184, 214, 0.25) !important; color: #FFFFFF !important; border-radius: 20px;">
                            <div class="rounded-circle p-4 d-inline-flex mx-auto mb-3 shadow-sm" style="background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.3);">
                                <i class="bi bi-patch-question-fill display-4"></i>
                            </div>
                            <h4 class="fw-bold text-white mb-2">Module Knowledge Assessment</h4>
                            <p class="small mb-4" style="max-width: 500px; margin: 0 auto; color: #94A3B8;">Evaluate your understanding of the concepts covered in this module. Quizzes feature a live timer and instant score calculation.</p>
                            @if (quiz != null)
                            {
                                <div>
                                    <a href="@Url.Action("Take", "Quiz", new { id = quiz.QuizId })" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow text-white" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                                        <i class="bi bi-lightning-charge-fill me-1"></i> Start Assessment Now
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else if (Model.CurrentLesson.LessonType == "Assignment")
                    {
                        var assignment = Model.Course.Assignments.FirstOrDefault(a => a.LessonId == Model.CurrentLesson.LessonId) ?? Model.Course.Assignments.FirstOrDefault();
                        <div class="card card-custom p-5 text-center my-3 shadow-lg" style="background: linear-gradient(135deg, #062330 0%, #0B3445 100%) !important; border: 1px solid rgba(39, 184, 214, 0.25) !important; color: #FFFFFF !important; border-radius: 20px;">
                            <div class="rounded-circle p-4 d-inline-flex mx-auto mb-3 shadow-sm" style="background: rgba(39, 184, 214, 0.15); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.3);">
                                <i class="bi bi-file-earmark-code-fill display-4"></i>
                            </div>
                            <h4 class="fw-bold text-white mb-2">Practical Project Assignment</h4>
                            <p class="small mb-4" style="max-width: 500px; margin: 0 auto; color: #94A3B8;">Submit your documented solution and GitHub repository link for faculty evaluation and grading.</p>
                            @if (assignment != null)
                            {
                                <div>
                                    <a href="@Url.Action("Details", "Assignment", new { id = assignment.AssignmentId })" class="btn btn-info text-white rounded-pill px-5 py-2 fw-bold shadow" style="background-color: #27B8D6 !important; border-color: #27B8D6 !important;">
                                        <i class="bi bi-arrow-up-right-circle me-1"></i> Open Assignment Workspace
                                    </a>
                                </div>
                            }
                        </div>
                    }

                    <!-- Article / Text Content -->
                    @if (!string.IsNullOrEmpty(Model.CurrentLesson.Content))
                    {
                        <div class="lesson-notes-box p-4 rounded-3 border mb-4">
                            <h6 class="fw-bold mb-3"><i class="bi bi-book-half me-2 text-primary"></i> Lesson Explanation &amp; Notes</h6>
                            <div class="lesson-notes-body" style="line-height: 1.85;">
                                @Html.Raw(Model.CurrentLesson.Content.Replace("\n", "<br/>"))
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.CurrentLesson.Description))
                    {
                        <div class="lesson-overview-box mb-4">
                            <h6 class="fw-bold mb-2">Lesson Overview</h6>
                            <p class="lesson-overview-text" style="line-height: 1.6;">@Model.CurrentLesson.Description</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.CurrentLesson.ResourceUrl))
                    {
                        <div class="lesson-resource-box p-3 rounded-3 d-flex justify-content-between align-items-center shadow-sm mb-4" style="background: rgba(6, 35, 48, 0.95) !important; border: 1px solid rgba(39, 184, 214, 0.25) !important; border-radius: 14px !important;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center p-2" style="width: 44px; height: 44px; background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.3);">
                                    <i class="bi bi-download fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold small text-white resource-title">Supplemental Material &amp; Assets</div>
                                    <small class="resource-subtitle" style="color: #94A3B8 !important;">Downloadable guide or source code repository</small>
                                </div>
                            </div>
                            <a href="@Model.CurrentLesson.ResourceUrl" target="_blank" class="btn btn-sm btn-primary rounded-pill px-4 py-2 fw-bold text-white shadow-xs" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                                <i class="bi bi-cloud-arrow-down me-1"></i> Access Download
                            </a>
                        </div>
                    }

                    <!-- Student Interactive Scratchpad (Persisted in LocalStorage) -->
                    <div class="scratchpad-card card border-0 shadow-sm p-4 mt-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-white shadow-xs border" style="width: 36px; height: 36px;">
                                    <i class="bi bi-journal-code text-orange fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">Personal Lesson Scratchpad</h6>
                                    <span class="text-muted small" style="font-size: 11px;">Your private notes, insights &amp; code snippets (persisted automatically)</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill" id="scratchpadStatus">
                                    <i class="bi bi-cloud-check-fill me-1"></i> Autosaved locally
                                </span>
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-1" id="btnCopyNotes" title="Copy notes to clipboard" style="font-size: 11px;">
                                    <i class="bi bi-clipboard me-1"></i> Copy
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-1" id="btnClearNotes" title="Clear notes for this lesson" style="font-size: 11px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>

                        <div class="position-relative">
                            <textarea id="lessonScratchpad" class="scratchpad-textarea form-control shadow-none" 
                                      placeholder="Write your study notes, key takeaways, formulas, or code snippets here... Notes automatically save in real-time per lesson." 
                                      rows="5" style="min-height: 140px; resize: vertical;"></textarea>
                            <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-muted small" style="font-size: 11px;">
                                <span><i class="bi bi-shield-check text-success me-1"></i> Private to your browser session</span>
                                <span id="scratchpadCharCount">0 characters</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Controls Footer -->
                <div class="pt-3 border-top mt-auto d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        @if (Model.PreviousLessonId.HasValue)
                        {
                            <a href="@Url.Action("Index", "Learning", new { courseId = Model.Course.CourseId, lessonId = Model.PreviousLessonId.Value })" id="btnPrevLesson" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> Previous
                            </a>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (Model.NextLessonId.HasValue)
                        {
                            <a href="@Url.Action("Index", "Learning", new { courseId = Model.Course.CourseId, lessonId = Model.NextLessonId.Value })" id="btnNextLesson" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                Next Lesson <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Certificates", "Student")" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-award-fill me-1"></i> Finish Course & View Certificate
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMS.initClassroom({
                lessonId: @currentLessonId,
                courseId: @Model.Course.CourseId
            });

            $(document).on('submit', '#markCompleteForm', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find('#btnMarkComplete');
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> Saving...');

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res && res.success) {
                            $('#completionStatusContainer').html(
                                '<span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill"><i class="bi bi-check2-circle me-1"></i> Lesson Completed</span>'
                            );
                            $('#progressText').text(res.progress + '% Completed');
                            $('#progressBar').css('width', res.progress + '%');

                            // Update active item icon in sidebar
                            $('.list-group-item.active-lesson').find('i.bi')
                                .removeClass('bi-play-circle-fill bi-circle text-primary text-muted')
                                .addClass('bi-check-circle-fill text-success');

                            LMS.toast('Lesson marked as complete! Progress: ' + res.progress + '%', 'success');

                            if (res.isCompleted) {
                                LMS.confetti({ particleCount: 100 });
                                LMS.toast('Congratulations! You have completed 100% of this course! Your official certificate is ready.', 'success', 6000);
                                setTimeout(function () {
                                    window.location.reload();
                                }, 2500);
                            }
                        } else {
                            $form.off('submit').submit();
                        }
                    },
                    error: function () {
                        $form.off('submit').submit();
                    }
                });
            });
        });
    </script>
}
