@model LMS.ViewModels.AnnouncementFormViewModel
@{
    ViewBag.Title = "Post Announcement";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-cyan text-decoration-none">Admin</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Announcements", "Admin")" class="text-cyan text-decoration-none">Announcements</a></li>
                <li class="breadcrumb-item active text-white-50" aria-current="page">Post Broadcast</li>
            </ol>
        </nav>

        <div class="card p-4 p-md-5 shadow-lg border-0" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(255, 255, 255, 0.12) !important; border-radius: 20px; backdrop-filter: blur(16px); color: #FFFFFF;">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3" style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center shadow-xs" style="width: 50px; height: 50px; background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.3);">
                    <i class="bi bi-megaphone-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-extrabold mb-0 tracking-tight text-white">Post System Announcement</h3>
                    <p class="text-white-50 small mb-0">Publish platform announcements, system updates, and maintenance advisories</p>
                </div>
            </div>

            @using (Html.BeginForm("CreateAnnouncement", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, "Announcement Headline", new { @class = "form-label fw-bold small text-white" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control text-white", placeholder = "e.g. Scheduled Infrastructure Maintenance & Upgrades", style = "background: rgba(4, 24, 34, 0.85); border-color: rgba(255, 255, 255, 0.15);" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Message, "Broadcast Message & Instructions", new { @class = "form-label fw-bold small text-white" })
                    @Html.TextAreaFor(m => m.Message, new { @class = "form-control text-white", rows = 6, placeholder = "Detail the purpose, schedule, expected impact, and any necessary actions required by learners or educators...", style = "background: rgba(4, 24, 34, 0.85); border-color: rgba(255, 255, 255, 0.15);" })
                    @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger small" })
                </div>

                <div class="p-3 rounded-3 mb-4" style="background: rgba(11, 52, 69, 0.6); border: 1px solid rgba(255, 255, 255, 0.12);">
                    <div class="form-check form-switch mb-0">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", @checked = "checked" })
                        @Html.LabelFor(m => m.IsActive, "Publish immediately across platform feeds", new { @class = "form-check-label fw-semibold small text-white ms-1" })
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
                    <a href="@Url.Action("Announcements", "Admin")" class="btn btn-outline-light rounded-pill px-4" style="border-color: rgba(255, 255, 255, 0.25);">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn text-white rounded-pill px-5 fw-bold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                        <i class="bi bi-broadcast me-1"></i> Post Announcement
                    </button>
                </div>
            }
        </div>
    </div>
</div>
