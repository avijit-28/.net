@model LMS.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "Platform Reports & Analytics";
    var completionRate = Model.TotalEnrollments > 0 ? (int)((double)Model.TotalCertificates / Model.TotalEnrollments * 100) : 0;
    var avgRevenuePerStudent = Model.TotalStudents > 0 ? Model.TotalRevenue / Model.TotalStudents : 0;
}

<div class="container-fluid py-4 px-lg-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Reports & Analytics</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-graph-up me-2 text-primary"></i>Operational Reports & Analytics</h2>
            <p class="text-muted mb-0">Platform performance KPIs, graduation metrics, and revenue distribution</p>
        </div>
        <button class="btn btn-outline-secondary" onclick="window.print();">
            <i class="bi bi-printer me-1"></i> Print / Export Report
        </button>
    </div>

    <!-- Core KPI Matrix -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-4 text-center">
                <span class="text-muted small text-uppercase fw-semibold">Course Completion Rate</span>
                <h2 class="fw-bold text-success mt-2 mb-0">@completionRate%</h2>
                <small class="text-muted mt-1">@Model.TotalCertificates out of @Model.TotalEnrollments finished</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-4 text-center">
                <span class="text-muted small text-uppercase fw-semibold">Avg Revenue / Student</span>
                <h2 class="fw-bold text-primary mt-2 mb-0">$@avgRevenuePerStudent.ToString("N2")</h2>
                <small class="text-muted mt-1">From total gross sales</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-4 text-center">
                <span class="text-muted small text-uppercase fw-semibold">Published Catalog Ratio</span>
                <h2 class="fw-bold text-info mt-2 mb-0">
                    @(Model.TotalCourses > 0 ? ((int)((double)Model.PublishedCourses / Model.TotalCourses * 100)).ToString() : "0")%
                </h2>
                <small class="text-muted mt-1">@Model.PublishedCourses active of @Model.TotalCourses total</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-4 text-center">
                <span class="text-muted small text-uppercase fw-semibold">Student-Instructor Ratio</span>
                <h2 class="fw-bold text-warning mt-2 mb-0">
                    @(Model.TotalInstructors > 0 ? (Model.TotalStudents / Model.TotalInstructors).ToString() : "0"):1
                </h2>
                <small class="text-muted mt-1">@Model.TotalStudents learners / @Model.TotalInstructors instructors</small>
            </div>
        </div>
    </div>

    <!-- Analytics Breakdown -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Category Distribution & Demand</h5>
                </div>
                <div class="card-body p-4">
                    @if (!Model.CategoryStats.Any())
                    {
                        <p class="text-muted text-center py-4">No categories recorded.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Category Name</th>
                                        <th>Courses</th>
                                        <th>Share</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cat in Model.CategoryStats)
                                    {
                                        var pct = Model.TotalCourses > 0 ? (int)((double)cat.CourseCount / Model.TotalCourses * 100) : 0;
                                        <tr>
                                            <td class="fw-semibold">@cat.CategoryName</td>
                                            <td><span class="badge bg-light text-dark border">@cat.CourseCount</span></td>
                                            <td style="width: 40%;">
                                                <div class="d-flex align-items-center">
                                                    <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @pct%;"></div>
                                                    </div>
                                                    <span class="small fw-bold">@pct%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-check me-2 text-success"></i>System Health & Infrastructure</h5>
                </div>
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-bold">Database Connectivity</div>
                                <small class="text-muted">Microsoft SQL Server 2025 Local Instance</small>
                            </div>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Operational</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-bold">Authentication Engine</div>
                                <small class="text-muted">ASP.NET Identity 2.2 / OWIN Cookie Authentication</small>
                            </div>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-bold">Role-Based Access Control</div>
                                <small class="text-muted">Strict [Authorize(Roles="...")] across 10 controllers</small>
                            </div>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Enforced</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-bold">Automated Assessment Engine</div>
                                <small class="text-muted">Quiz grading with instant certificate issuance threshold</small>
                            </div>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Ready</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-bold">Payment Gateway Simulator</div>
                                <small class="text-muted">Stripe / PayPal simulated checkout with transaction audit</small>
                            </div>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
