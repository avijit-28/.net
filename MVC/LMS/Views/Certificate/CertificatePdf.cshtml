@model LMS.ViewModels.CertificateViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Certificate - @Model.CertificateNumber</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Times New Roman', Georgia, serif;
            background-color: #ffffff;
            color: #1e293b;
            padding: 24px;
        }
        .cert-container {
            width: 1000px;
            height: 680px;
            margin: 0 auto;
            border: 12px solid #1e1b4b;
            padding: 8px;
            position: relative;
            background: #ffffff;
        }
        .cert-inner-border {
            border: 3px solid #d97706;
            height: 100%;
            padding: 30px 40px;
            text-align: center;
            position: relative;
            background: radial-gradient(circle at 50% 50%, rgba(254, 243, 199, 0.25) 0%, #ffffff 80%);
        }
        .emblem-pill {
            display: inline-block;
            background: #1e1b4b;
            color: #ffffff;
            padding: 6px 24px;
            border-radius: 9999px;
            font-size: 13px;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        }
        .cert-heading {
            font-size: 42px;
            font-weight: 900;
            letter-spacing: 5px;
            color: #0f172a;
            margin-top: 18px;
            text-transform: uppercase;
        }
        .sub-heading {
            font-size: 13px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #64748b;
            margin: 12px 0 20px 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        }
        .student-name {
            font-size: 34px;
            font-weight: bold;
            color: #3730a3;
            letter-spacing: 1.5px;
            border-bottom: 2px solid #4f46e5;
            display: inline-block;
            padding: 0 30px 6px 30px;
            margin-bottom: 16px;
        }
        .cert-statement {
            font-size: 15px;
            color: #475569;
            margin-bottom: 12px;
            line-height: 1.5;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        }
        .course-title {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 24px;
        }
        .metrics-table {
            width: 80%;
            margin: 0 auto 26px auto;
            border-collapse: collapse;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
        }
        .metrics-table td {
            padding: 10px 14px;
            text-align: center;
            border-right: 1px solid #e2e8f0;
        }
        .metrics-table td:last-child {
            border-right: none;
        }
        .metrics-label {
            font-size: 9px;
            font-weight: bold;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: block;
        }
        .metrics-val {
            font-size: 16px;
            font-weight: bold;
            color: #0f172a;
            margin-top: 3px;
            display: block;
        }
        .signatures {
            width: 90%;
            margin: 20px auto 0 auto;
            display: table;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        }
        .sig-col {
            display: table-cell;
            width: 33.33%;
            vertical-align: bottom;
            text-align: center;
        }
        .sig-line {
            width: 170px;
            border-top: 2px solid #334155;
            margin: 0 auto;
            padding-top: 4px;
            font-weight: bold;
            font-size: 13px;
            color: #0f172a;
        }
        .sig-role {
            font-size: 10px;
            color: #64748b;
            margin-top: 2px;
        }
        .seal {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            border: 3px double #d97706;
            background: #fef3c7;
            color: #b45309;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 1px;
            line-height: 1.2;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="cert-container">
        <div class="cert-inner-border">
            <div>
                <span class="emblem-pill">EduPlatform Learning Management System</span>
                <div style="font-size: 9px; color: #64748b; letter-spacing: 2px; text-transform: uppercase; margin-top: 6px; font-family: sans-serif;">Board of Academic Accreditation &amp; Quality Standards</div>
            </div>

            <h1 class="cert-heading">Certificate of Completion</h1>
            <p class="sub-heading">This certifies that</p>

            <div class="student-name">@Model.StudentName</div>

            <p class="cert-statement">
                has successfully fulfilled all curriculum requirements, modules, practical projects, and assessment milestones for
            </p>

            <h2 class="course-title">@Model.CourseTitle</h2>

            <table class="metrics-table">
                <tr>
                    <td>
                        <span class="metrics-label">Final Assessment Score</span>
                        <span class="metrics-val" style="color: #16a34a;">@(Model.FinalScore.HasValue ? Model.FinalScore.Value.ToString("0.0") + "%" : "100.0%")</span>
                    </td>
                    <td>
                        <span class="metrics-label">Issuance Date</span>
                        <span class="metrics-val">@Model.IssueDate.ToString("MMMM dd, yyyy")</span>
                    </td>
                    <td>
                        <span class="metrics-label">Cryptographic ID</span>
                        <span class="metrics-val" style="color: #4f46e5; font-family: monospace; font-size: 14px;">@Model.CertificateNumber</span>
                    </td>
                </tr>
            </table>

            <div class="signatures">
                <div class="sig-col">
                    <div class="sig-line">Dr. Evelyn Vance</div>
                    <div class="sig-role">Director of Academic Standards</div>
                </div>
                <div class="sig-col">
                    <div class="seal">
                        OFFICIAL<br />SEAL
                    </div>
                    <div style="font-size: 8px; color: #94a3b8; font-family: monospace; margin-top: 4px;">SECURE DIGITAL ID</div>
                </div>
                <div class="sig-col">
                    <div class="sig-line">Marcus Holloway</div>
                    <div class="sig-role">Faculty Lead Instructor</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
