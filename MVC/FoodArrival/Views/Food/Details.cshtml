@model FoodArrival.Models.FoodItem
@{
    ViewBag.Title = Model.ItemName + " - FoodReady";
}

<div class="container py-5">
    <div class="mb-3">
        <a href="@Url.Action("Index", "Food")" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Back to Menu
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden food-detail-card">
        <div class="row g-0">
            <div class="col-md-6 bg-light d-flex align-items-center justify-content-center p-4">
                <img src="@Model.ImageUrl" alt="@Model.ItemName" class="img-fluid rounded-4 shadow" style="max-height: 400px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&q=80'" />
            </div>
            <div class="col-md-6 p-4 p-lg-5 d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning bg-opacity-25 text-dark fw-bold px-3 py-2 rounded-pill">@Model.Category</span>
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success bg-opacity-25 text-success fw-bold px-3 py-2 rounded-pill">In Stock</span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-25 text-danger fw-bold px-3 py-2 rounded-pill">Sold Out</span>
                    }
                </div>

                <h1 class="fw-bold mb-2 text-dark">@Model.ItemName</h1>
                <h3 class="fw-bold text-danger mb-3">₹@Model.Price.ToString("F2")</h3>

                <p class="text-muted mb-4 lead fs-6">
                    @(string.IsNullOrEmpty(Model.Description) ? "Cooked fresh to order with premium ingredients and hand-selected spices." : Model.Description)
                </p>

                @if (Model.IsAvailable)
                {
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <label class="fw-bold text-muted small">Quantity:</label>
                        <div class="qty-picker">
                            <button type="button" class="qty-btn btn-qty-minus"><i class="bi bi-dash"></i></button>
                            <input type="text" class="qty-input input-quantity" value="1" readonly />
                            <button type="button" class="qty-btn btn-qty-plus"><i class="bi bi-plus"></i></button>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <button class="btn btn-primary-food px-4 py-2 fs-6 btn-add-to-cart" data-id="@Model.FoodItemId">
                            <i class="bi bi-cart-plus me-1"></i> Add to Cart
                        </button>
                        <a href="@Url.Action("PlaceOrder", "Order")" class="btn btn-outline-food px-4 py-2 fs-6">
                            View Cart & Checkout
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        This item is currently out of stock. Please check back later!
                    </div>
                }
            </div>
        </div>
    </div>
</div>
