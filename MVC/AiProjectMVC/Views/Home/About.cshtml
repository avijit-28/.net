@{
    ViewBag.Title = "About - SuperAdmin Exclusive";
    var currentRole = Session["UserRole"] as string ?? (User.Identity.IsAuthenticated ? "Authenticated" : "Guest");
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <!-- Breadcrumb navigation -->
        <div class="mb-3">
            <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Authorization Center
            </a>
        </div>

        <div class="custom-card shadow-sm border-0 overflow-hidden">
            <!-- Header -->
            <div class="p-4 bg-light border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 mb-2">
                        <i class="bi bi-shield-fill-check me-1"></i> Highest Privilege &bull; [AuthorizeRole(Role.SUPERADMIN)]
                    </span>
                    <h3 class="fw-bold mb-1 text-dark">Super Administrator Portal</h3>
                    <p class="text-muted small mb-0">@ViewBag.Message</p>
                </div>
                <div class="d-none d-sm-block text-danger fs-1">
                    <i class="bi bi-award-fill"></i>
                </div>
            </div>

            <!-- Body -->
            <div class="custom-card-body p-4">
                <div class="alert alert-danger d-flex align-items-center gap-3 p-3 rounded-3 mb-4">
                    <i class="bi bi-shield-check fs-3 text-danger flex-shrink-0"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">SuperAdmin Access Granted!</h5>
                        <p class="mb-0 small text-danger-emphasis">
                            You are successfully authenticated with the top-tier <strong>SUPERADMIN</strong> credential role.
                        </p>
                    </div>
                </div>

                <div class="card bg-light border-0 p-3 mb-4">
                    <h6 class="fw-bold text-dark small text-uppercase mb-2">
                        <i class="bi bi-shield-lock text-primary me-1"></i> Authorization Filter Code
                    </h6>
                    <pre class="bg-dark text-white p-3 rounded-3 small mb-0"><code>[AuthorizeRole(Role.SUPERADMIN)]
public ActionResult About()
{
    ViewBag.Message = "Your application description page.";
    return View();
}</code></pre>
                </div>

                <div class="card bg-light border-0 p-3 mb-4">
                    <h6 class="fw-bold text-dark small text-uppercase mb-2">
                        <i class="bi bi-person-check text-primary me-1"></i> Authenticated Session
                    </h6>
                    <div class="row g-2 small">
                        <div class="col-sm-4 text-muted">User Account:</div>
                        <div class="col-sm-8 fw-semibold text-dark">@(User.Identity.IsAuthenticated ? User.Identity.Name : "Session User")</div>

                        <div class="col-sm-4 text-muted">Role Hierarchy:</div>
                        <div class="col-sm-8"><span class="badge bg-danger">@currentRole</span></div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-2">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-house me-1"></i> Authorization Center
                    </a>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Contact", "Home")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-shield me-1"></i> Admin Contact
                        </a>
                        <a href="@Url.Action("UserPage", "Home")" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-person-badge me-1"></i> User Page
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
