@model AiProjectMVC.Models.Employee

@{
    ViewBag.Title = "Delete Employee";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <!-- Back Breadcrumb Link -->
        <div class="mb-3">
            <a href="@Url.Action("Index", "Employee")" class="text-decoration-none text-muted small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Employee Directory
            </a>
        </div>

        <div class="custom-card border-danger border-opacity-25">
            <!-- Warning Header -->
            <div class="p-4 bg-danger bg-opacity-10 border-bottom border-danger border-opacity-10 text-center">
                <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                </div>
                <h4 class="fw-bold text-danger mb-1">Delete Employee Record?</h4>
                <p class="text-muted small mb-0">This will permanently remove the employee from the database.</p>
            </div>

            <!-- Employee Info Summary -->
            <div class="custom-card-body">
                <div class="alert alert-warning border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-info-circle-fill text-warning fs-5"></i>
                    <div class="small">Please verify the record details below before confirming deletion.</div>
                </div>

                <div class="list-group list-group-flush border rounded-3 mb-4">
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Employee ID</span>
                        <span class="fw-bold">#@Model.ID</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Full Name</span>
                        <span class="fw-bold">@Model.Name</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Department</span>
                        <span class="badge bg-light text-dark border">@Model.Dept</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">City</span>
                        <span class="fw-semibold">@Model.City</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Salary</span>
                        <span class="fw-bold text-success">₹@Model.Salary.ToString("N0")</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Linked Address ID</span>
                        <span class="fw-semibold">@(Model.AddressId.HasValue ? "#" + Model.AddressId.Value : "None")</span>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg"></i> Cancel & Keep
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill"></i> Permanently Delete
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
