{
  "info": {
    "name": "HotelBooking_Capstone",
    "description": "Production Postman test collection for Enterprise Hotel Booking & Reservation System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_Authentication",
      "item": [
        {
          "name": "01_Login_Admin_Positive200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Token received and role is Admin', function() {",
                  "  pm.expect(json.data.token).to.be.a('string');",
                  "  pm.expect(json.data.role).to.eql('Admin');",
                  "  pm.environment.set('adminToken', json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "02_Login_Customer_Positive200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Token received and role is Customer', function() {",
                  "  pm.expect(json.data.token).to.be.a('string');",
                  "  pm.expect(json.data.role).to.eql('Customer');",
                  "  pm.environment.set('customerToken', json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "03_Login_InvalidPassword_Unauthorized401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function() { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/users/login"
          }
        }
      ]
    },
    {
      "name": "02_RoomTypes",
      "item": [
        {
          "name": "01_GetAll_RoomTypes_Positive200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Returns active room types', function() {",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.data.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/room-types"
          }
        },
        {
          "name": "02_Create_RoomType_Admin_Positive201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function() { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.environment.set('testRoomTypeId', json.data.roomTypeId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"typeName\": \"Royal Suite Dynamic\",\n  \"description\": \"Grand luxury suite with panoramic terrace.\",\n  \"basePrice\": 450.00,\n  \"maxOccupancy\": 5\n}"
            },
            "url": "{{baseUrl}}/api/room-types"
          }
        },
        {
          "name": "03_Create_RoomType_Customer_Forbidden403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 Forbidden for non-admin', function() { pm.response.to.have.status(403); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"typeName\": \"Unauthorized Type\",\n  \"basePrice\": 100.00,\n  \"maxOccupancy\": 2\n}"
            },
            "url": "{{baseUrl}}/api/room-types"
          }
        }
      ]
    },
    {
      "name": "03_Rooms",
      "item": [
        {
          "name": "01_GetAll_Rooms_Positive200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Returns room list', function() {",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.environment.set('testRoomId', json.data[0].roomId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/rooms"
          }
        },
        {
          "name": "02_GetById_Room_Positive200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Room details and amenities loaded', function() {",
                  "  pm.expect(json.data.roomId).to.eql(parseInt(pm.environment.get('testRoomId')));",
                  "  pm.expect(json.data.amenities).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/rooms/{{testRoomId}}"
          }
        }
      ]
    },
    {
      "name": "04_Search",
      "item": [
        {
          "name": "01_Search_AvailableRooms_Positive200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Search returned available rooms', function() {",
                  "  pm.expect(json.data.items).to.be.an('array');",
                  "  pm.expect(json.data.totalRecords).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/search?checkInDate=2026-12-01&checkOutDate=2026-12-04&guests=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "search"],
              "query": [
                { "key": "checkInDate", "value": "2026-12-01" },
                { "key": "checkOutDate", "value": "2026-12-04" },
                { "key": "guests", "value": "2" }
              ]
            }
          }
        },
        {
          "name": "02_Search_PastDate_BadRequest400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function() { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/search?checkInDate=2020-01-01&checkOutDate=2020-01-05",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "search"],
              "query": [
                { "key": "checkInDate", "value": "2020-01-01" },
                { "key": "checkOutDate", "value": "2020-01-05" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "05_Bookings",
      "item": [
        {
          "name": "01_Create_Booking_Customer_Positive201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function() { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('Booking confirmed with valid reference', function() {",
                  "  pm.expect(json.data.bookingReference).to.match(/^BK-\\d{8}-\\d{4}$/);",
                  "  pm.expect(json.data.bookingStatus).to.eql('Confirmed');",
                  "  pm.environment.set('testBookingId', json.data.bookingId);",
                  "  pm.environment.set('bookingReference', json.data.bookingReference);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{testRoomId}},\n  \"checkInDate\": \"2026-12-10\",\n  \"checkOutDate\": \"2026-12-14\",\n  \"numberOfGuests\": 1,\n  \"customerNotes\": \"Automated API Test Booking\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "02_Create_Booking_DoubleBooking_Conflict409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Double-booking triggers 409 Conflict', function() { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{testRoomId}},\n  \"checkInDate\": \"2026-12-12\",\n  \"checkOutDate\": \"2026-12-16\",\n  \"numberOfGuests\": 1,\n  \"customerNotes\": \"Should fail with double booking conflict\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "03_Get_My_Bookings_Positive200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('User bookings retrieved', function() {",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/bookings/my-bookings"
          }
        }
      ]
    },
    {
      "name": "06_Cancellations",
      "item": [
        {
          "name": "01_Cancel_Booking_Tier1_100PercentRefund200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('100% Refund calculated for >48h cancellation', function() {",
                  "  pm.expect(json.data.refundPercentage).to.eql(100.00);",
                  "  pm.expect(json.data.cancellationCharge).to.eql(0.00);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Flight rescheduling\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{testBookingId}}/cancel"
          }
        },
        {
          "name": "02_Cancel_AlreadyCancelled_BadRequest400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Attempting to re-cancel triggers 400 Bad Request', function() { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Attempt duplicate cancel\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{testBookingId}}/cancel"
          }
        }
      ]
    }
  ]
}
