@model System.Web.Mvc.HandleErrorInfo
@{
    ViewBag.Title = "Error - Application Exception";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm p-4 p-md-5">
                <div class="mb-4">
                    <div class="avatar bg-danger bg-opacity-10 text-danger rounded-circle p-4 d-inline-flex">
                        <i class="bi bi-exclamation-triangle-fill display-4"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark">Oops! An Error Occurred</h2>
                <p class="text-muted mb-4">
                    We encountered an unexpected error while processing your request. Please try again or return to the platform dashboard.
                </p>

                @if (Model != null && !string.IsNullOrEmpty(Model.Exception?.Message))
                {
                    <div class="alert alert-danger text-start font-monospace small mb-4">
                        <strong>Exception:</strong> @Model.Exception.Message
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4">
                        <i class="bi bi-house-door me-1"></i> Return Home
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Go Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
