@model IEnumerable<LMS.Models.QuizAttempt>
@{
    ViewBag.Title = "Quiz Attempt History";
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Student")" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Quiz Assessments</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-patch-question-fill text-warning me-1"></i> Assessment History
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight">Quiz Assessment Records</h2>
            <p class="text-muted small mb-0">Review exam performance, percentage scores, pass/fail evaluations, and breakdowns</p>
        </div>
        <div>
            <a href="@Url.Action("MyCourses", "Student")" class="btn btn-outline-primary rounded-pill px-4 fw-semibold shadow-xs">
                <i class="bi bi-play-circle me-1"></i> Continue Courses
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm bg-white border-0">
            <div class="rounded-circle bg-light p-4 d-inline-flex mx-auto mb-3">
                <i class="bi bi-patch-question text-muted display-4"></i>
            </div>
            <h4 class="fw-bold">No quizzes taken yet</h4>
            <p class="text-muted small mb-3">Interactive assessments can be launched directly within each module in the classroom.</p>
            <div>
                <a href="@Url.Action("MyCourses", "Student")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    Go to My Courses
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom shadow-sm overflow-hidden bg-white border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-4">Quiz Title</th>
                            <th>Curriculum Track</th>
                            <th>Score %</th>
                            <th>Earned Marks</th>
                            <th>Evaluation Outcome</th>
                            <th>Completed Timestamp</th>
                            <th class="text-end pe-4">Breakdown</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@a.Quiz.Title</div>
                                    <small class="text-muted font-monospace" style="font-size: 11px;">Attempt ID: #@a.AttemptId</small>
                                </td>
                                <td><span class="badge bg-light text-dark border rounded-pill px-3 py-1">@(a.Quiz.Course?.Title ?? "Course")</span></td>
                                <td>
                                    <div class="fw-extrabold fs-6 @(a.IsPassed ? "text-success" : "text-danger")">
                                        @a.Score%
                                    </div>
                                </td>
                                <td><span class="small font-monospace text-dark">@a.ObtainedMarks / @a.TotalMarks pts</span></td>
                                <td>
                                    @if (a.IsPassed)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>PASSED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>FAILED
                                        </span>
                                    }
                                </td>
                                <td><span class="small text-muted">@(a.CompletedAt.HasValue ? a.CompletedAt.Value.ToString("MMM dd, yyyy HH:mm") : "-")</span></td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Result", "Quiz", new { attemptId = a.AttemptId })" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                        View Result &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
