```cshtml
@model FirstMVCProject.ViewModels.EmployeeDetailsViewModel

@{
    ViewBag.Title = Model.PageTitle;
}

<h2>@Model.PageHeader</h2>

<hr />

<!-- Employee Details -->
<h3>Employee Details</h3>

<dl class="dl-horizontal">

    <dt>
        ID
    </dt>
    <dd>
        @Model.Employee.ID
    </dd>

    <dt>
        Name
    </dt>
    <dd>
        @Model.Employee.Name
    </dd>

    <dt>
        Salary
    </dt>
    <dd>
        @Model.Employee.Salary
    </dd>

    <dt>
        Gender
    </dt>
    <dd>
        @Model.Employee.Gender
    </dd>

    <dt>
        City
    </dt>
    <dd>
        @Model.Employee.City
    </dd>

    <dt>
        Department
    </dt>
    <dd>
        @Model.Employee.Dept
    </dd>

    <dt>
        Address ID
    </dt>
    <dd>
        @Model.Employee.AddressId
    </dd>

</dl>

<hr />

<!-- Address Details -->
<h3>Address Details</h3>

@if (Model.Address != null)
{
    <dl class="dl-horizontal">

        <dt>
            Address ID
        </dt>
        <dd>
            @Model.Address.AddressId
        </dd>

        <dt>
            Country
        </dt>
        <dd>
            @Model.Address.Country
        </dd>

        <dt>
            State
        </dt>
        <dd>
            @Model.Address.State
        </dd>

        <dt>
            City
        </dt>
        <dd>
            @Model.Address.City
        </dd>

        <dt>
            PIN
        </dt>
        <dd>
            @Model.Address.Pin
        </dd>

    </dl>
}
else
{
    <p class="text-danger">
        Address details are not available.
    </p>
}

<hr />

<p>
    @Html.ActionLink("Back to List", "Index")
</p>
```