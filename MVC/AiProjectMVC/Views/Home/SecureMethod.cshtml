@{
    ViewBag.Title = "Secure Method";
    var currentRole = Session["UserRole"] as string ?? (User.Identity.IsAuthenticated ? "Authenticated" : "Unknown");
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <!-- Breadcrumb navigation -->
        <div class="mb-3">
            <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Authorization Center
            </a>
        </div>

        <div class="custom-card shadow-sm border-0 overflow-hidden">
            <!-- Header -->
            <div class="p-4 bg-light border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 mb-2">
                        <i class="bi bi-shield-lock-fill me-1"></i> Authenticated Access &bull; [Authorize]
                    </span>
                    <h3 class="fw-bold mb-1 text-dark">Secure Method</h3>
                    <p class="text-muted small mb-0">Action filter demonstration of protected endpoint access</p>
                </div>
                <div class="d-none d-sm-block text-primary fs-1">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>

            <!-- Body -->
            <div class="custom-card-body p-4">
                <div class="alert alert-primary d-flex align-items-center gap-3 p-3 rounded-3 mb-4">
                    <i class="bi bi-patch-check-fill fs-3 text-primary flex-shrink-0"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">This method needs to be accessed by authorized users as it is SecureMethod.</h5>
                        <p class="mb-0 small text-primary-emphasis">
                            Unauthenticated users attempting to access this URL are intercepted by the Authorization Filter and redirected to the Login page.
                        </p>
                    </div>
                </div>

                <div class="card bg-light border-0 p-3 mb-4">
                    <h6 class="fw-bold text-dark small text-uppercase mb-2">
                        <i class="bi bi-person-check text-primary me-1"></i> Current Authentication Identity
                    </h6>
                    <div class="row g-2 small">
                        <div class="col-sm-4 text-muted">User Name:</div>
                        <div class="col-sm-8 fw-semibold text-dark">@User.Identity.Name</div>

                        <div class="col-sm-4 text-muted">Authentication Type:</div>
                        <div class="col-sm-8 fw-semibold text-dark">@(User.Identity.AuthenticationType ?? "FormsAuthentication")</div>

                        <div class="col-sm-4 text-muted">Role Membership:</div>
                        <div class="col-sm-8"><span class="badge bg-primary">@currentRole</span></div>
                    </div>
                </div>

                <div class="card bg-light border-0 p-3 mb-4">
                    <h6 class="fw-bold text-dark small text-uppercase mb-2">
                        <i class="bi bi-code-slash text-primary me-1"></i> Technical Implementation
                    </h6>
                    <pre class="bg-dark text-white p-3 rounded-3 small mb-0"><code>[Authorize]
public class HomeController : Controller
{
    public ActionResult SecureMethod()
    {
        return View();
    }
}</code></pre>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-2">
                    <a href="@Url.Action("NonSecureMethod", "Home")" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-unlock me-1"></i> Test Non-Secure Method
                    </a>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("UserPage", "Home")" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-person-badge me-1"></i> Test User Page
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary-gradient btn-sm">
                            <i class="bi bi-house me-1"></i> Return to Hub
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
