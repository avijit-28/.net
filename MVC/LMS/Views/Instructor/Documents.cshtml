@model IEnumerable<LMS.Models.AI.AiDocument>
@{
    var course = ViewBag.Course as LMS.Models.Course;
    var modules = ViewBag.Modules as List<LMS.Models.Module> ?? new List<LMS.Models.Module>();
    ViewBag.Title = "RAG AI Knowledge Documents - " + (course?.Title ?? "Course");
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")" class="text-decoration-none">Studio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Courses", "Instructor")" class="text-decoration-none">My Courses</a></li>
            <li class="breadcrumb-item active" aria-current="page">AI Knowledge Documents</li>
        </ol>
    </nav>

    <!-- Header & Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge badge-info-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                <span class="pulse-dot pulse-primary"></span> Enterprise RAG Knowledge Repository
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight text-white">Course Knowledge: @(course?.Title ?? "Course")</h2>
            <p class="small mb-0" style="color: #94A3B8;">
                Upload PDFs, DOCX, PPTX, or TXT curriculum files. Content is extracted, chunked, and embedded into Qdrant vector space for real-time AI grounded retrieval.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Courses
            </a>
            <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Document
            </button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3 border-0 shadow-sm" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1) !important;">
                <span class="small" style="color: #94A3B8;">Total Documents</span>
                <h3 class="fw-bold text-white mb-0 mt-1">@Model.Count()</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3 border-0 shadow-sm" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1) !important;">
                <span class="small" style="color: #94A3B8;">Vector Chunks</span>
                <h3 class="fw-bold mb-0 mt-1" style="color: #27B8D6;">@Model.Sum(d => d.TotalChunks)</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3 border-0 shadow-sm" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1) !important;">
                <span class="small" style="color: #94A3B8;">Indexed Pages</span>
                <h3 class="fw-bold mb-0 mt-1" style="color: #10B981;">@Model.Sum(d => d.TotalPages)</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3 border-0 shadow-sm" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.1) !important;">
                <span class="small" style="color: #94A3B8;">Index Status</span>
                <h3 class="fw-bold mb-0 mt-1 text-white">
                    @(Model.All(d => d.Status == "Indexed") && Model.Any() ? "Healthy" : (Model.Any(d => d.Status == "Processing") ? "Indexing..." : "Ready"))
                </h3>
            </div>
        </div>
    </div>

    <!-- Document Table -->
    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-lg border-0" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.12) !important; color: #FFFFFF;">
            <div class="rounded-circle p-4 d-inline-flex mx-auto mb-3" style="background: rgba(39, 184, 214, 0.12); border: 1px solid rgba(39, 184, 214, 0.35);">
                <i class="bi bi-file-earmark-arrow-up display-4" style="color: #27B8D6;"></i>
            </div>
            <h4 class="fw-bold text-white">No documents uploaded yet</h4>
            <p class="small mb-3" style="color: #94A3B8;">Supercharge this course with AI RAG by uploading course syllabus notes, slides, readings, or past question banks.</p>
            <div>
                <button class="btn btn-primary rounded-pill px-4 fw-semibold" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload First Document
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom border-0 shadow-lg overflow-hidden" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.12) !important;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-white" style="border-color: rgba(255, 255, 255, 0.08);">
                    <thead style="background: rgba(4, 24, 34, 0.6); color: #94A3B8; font-size: 12px; text-transform: uppercase;">
                        <tr>
                            <th class="ps-4">Document Details</th>
                            <th>Type & Size</th>
                            <th>Pages / Chunks</th>
                            <th>Scope / Visibility</th>
                            <th>Status</th>
                            <th>Uploaded</th>
                            <th class="pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background: rgba(39, 184, 214, 0.15); border: 1px solid rgba(39, 184, 214, 0.3);">
                                            @if (doc.FileType == "PDF") { <i class="bi bi-file-earmark-pdf fs-4 text-danger"></i> }
                                            else if (doc.FileType == "DOCX") { <i class="bi bi-file-earmark-word fs-4 text-primary"></i> }
                                            else if (doc.FileType == "PPTX") { <i class="bi bi-file-earmark-slides fs-4 text-warning"></i> }
                                            else { <i class="bi bi-file-earmark-text fs-4 text-info"></i> }
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">@doc.Title</div>
                                            <div class="small" style="color: #94A3B8;">
                                                @doc.FileName
                                                @if (doc.Module != null)
                                                {
                                                    <span class="ms-1 badge bg-dark border border-secondary text-light">@doc.Module.ModuleName</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@doc.FileType</span>
                                    <span class="small d-block" style="color: #94A3B8;">@((doc.FileSize / 1024.0 / 1024.0).ToString("0.00")) MB</span>
                                </td>
                                <td>
                                    <span class="text-white fw-semibold">@doc.TotalPages pages</span>
                                    <span class="small d-block" style="color: #27B8D6;">@doc.TotalChunks vectors</span>
                                </td>
                                <td>
                                    @if (doc.Visibility == "instructor_only")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-lock-fill me-1"></i>Instructor Only</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="bi bi-people-fill me-1"></i>Enrolled Students</span>
                                    }
                                </td>
                                <td>
                                    @if (doc.Status == "Indexed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Indexed
                                        </span>
                                    }
                                    else if (doc.Status == "Processing")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info px-2 py-1">
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span> Indexing
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1" title="@doc.ErrorMessage">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Failed
                                        </span>
                                    }
                                </td>
                                <td class="small" style="color: #94A3B8;">
                                    @doc.UploadedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group btn-group-sm">
                                        @using (Html.BeginForm("ReindexDocument", "Instructor", new { id = doc.DocumentId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-light studio-action-btn" title="Re-Index Vector Embeddings">
                                                <i class="bi bi-arrow-repeat text-info"></i>
                                            </button>
                                        }
                                        @using (Html.BeginForm("DeleteDocument", "Instructor", new { id = doc.DocumentId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Are you sure you want to delete this document from the course knowledge base?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-light studio-action-btn" title="Delete Document">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Upload Document Modal -->
<div class="modal fade" id="uploadDocModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4" style="background: #062330; border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;">
            <div class="modal-header border-bottom py-3" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-cloud-arrow-up-fill me-2 text-warning"></i>Upload Course Document</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("UploadDocument", "Instructor", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" value="@(course?.CourseId ?? 0)" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-white">Document Display Title</label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. Chapter 3: Concurrency & Asynchronous Programming" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-white">Select File (PDF, DOCX, PPTX, TXT - Max 50MB)</label>
                        <input type="file" name="file" class="form-control" accept=".pdf,.docx,.pptx,.txt" required style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-white">Associated Module</label>
                            <select name="moduleId" class="form-select" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;">
                                <option value="">Entire Course (Global)</option>
                                @foreach (var m in modules)
                                {
                                    <option value="@m.ModuleId">@m.ModuleName</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-white">Access Visibility (RBAC)</label>
                            <select name="visibility" class="form-select" style="background: rgba(4, 24, 34, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); color: #FFFFFF;">
                                <option value="student">Enrolled Students & Faculty</option>
                                <option value="instructor_only">Instructor & Faculty Only (Rubrics/Keys)</option>
                            </select>
                        </div>
                    </div>

                    <div class="p-3 rounded-3" style="background: rgba(39, 184, 214, 0.08); border: 1px solid rgba(39, 184, 214, 0.25);">
                        <div class="d-flex align-items-center gap-2 small" style="color: #27B8D6;">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>The file will be cleaned, chunked semantically, embedded using Gemini (3072-dim), and indexed into Qdrant for RAG searches.</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                        <i class="bi bi-cpu me-1"></i> Upload & Index
                    </button>
                </div>
            }
        </div>
    </div>
</div>
