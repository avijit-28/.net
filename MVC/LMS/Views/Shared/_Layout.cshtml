<body class="@pageClass">
    <!-- Global Brand Preloader (ONLY displays on the first time the website is opened in a session) -->
    <script>
        try {
            if (sessionStorage.getItem('lms_preloader_shown')) {
                document.write('<style>#globalPreloader { display: none !important; }</style>');
            }
        } catch (e) { }
    </script>
    <div id="globalPreloader" aria-hidden="true">
        <div class="preloader-card">
            <div class="preloader-logo-wrap">
                <img src="@Url.Content("~/Content/images/logo-icon.png")" alt="LMS" class="preloader-logo" />
                <div class="preloader-spinner-ring"></div>
            </div>
            <div class="preloader-title">LMS</div>
            <div class="preloader-subtitle">Loading EduPlatform LMS...</div>
            <div class="preloader-bar-wrap">
                <div class="preloader-bar-fill"></div>
            </div>
        </div>
    </div>
    <script>
        (function () {
            var preloader = document.getElementById('globalPreloader');
            if (!preloader) return;

            try {
                if (sessionStorage.getItem('lms_preloader_shown')) {
                    preloader.remove();
                    return;
                }
                sessionStorage.setItem('lms_preloader_shown', 'true');
            } catch (e) { }

            function dismiss() {
                if (preloader && !preloader.classList.contains('fade-out')) {
                    preloader.classList.add('fade-out');
                    setTimeout(function () {
                        if (preloader.parentNode) preloader.remove();
                    }, 400);
                }
            }

            if (document.readyState === 'complete') {
                setTimeout(dismiss, 100);
            } else {
                window.addEventListener('load', function () {
                    setTimeout(dismiss, 120);
                });
                setTimeout(dismiss, 1200);
            }
        })();
    </script>

