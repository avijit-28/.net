@model AiProjectMVC.Models.Employee

@{
    ViewBag.Title = "Edit Employee";
    var addressList = ViewBag.Addresses as List<AiProjectMVC.Models.Address> ?? new List<AiProjectMVC.Models.Address>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Back Breadcrumb Link -->
        <div class="mb-3">
            <a href="@Url.Action("Index", "Employee")" class="text-decoration-none text-muted small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Employee Directory
            </a>
        </div>

        <div class="custom-card">
            <div class="custom-card-header d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1 fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i> Edit Employee Profile</h4>
                    <p class="text-muted small mb-0">Update the details and linked address for <strong>@Model.Name</strong>.</p>
                </div>
                <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                    <i class="bi bi-hash text-muted"></i> ID: <strong>@Model.ID</strong>
                </span>
            </div>

            <div class="custom-card-body">
                @using (Html.BeginForm("Edit", "Employee", new { id = Model.ID }, FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ID)

                    if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                    {
                        <div class="custom-alert custom-alert-danger" role="alert">
                            <i class="bi bi-exclamation-circle-fill fs-5 text-danger"></i>
                            <div>@Html.ValidationSummary(true, "", new { @class = "mb-0" })</div>
                        </div>
                    }

                    <div class="row g-3">
                        <!-- Employee ID (Readonly Display) -->
                        <div class="col-md-6">
                            <label class="form-label">Employee ID (Fixed)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                                <input type="text" class="form-control bg-light" value="@Model.ID" disabled readonly />
                            </div>
                            <span class="text-muted small">Employee ID is a unique key and cannot be altered.</span>
                        </div>

                        <!-- Full Name -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.Name, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter full name", required = "required" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Department -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.Dept, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-building text-muted"></i></span>
                                <select name="Dept" id="Dept" class="form-select" required>
                                    <option value="">-- Select Department --</option>
                                    <option value="IT" @(Model.Dept == "IT" ? "selected" : "")>IT</option>
                                    <option value="HR" @(Model.Dept == "HR" ? "selected" : "")>HR</option>
                                    <option value="Finance" @(Model.Dept == "Finance" ? "selected" : "")>Finance</option>
                                    <option value="Marketing" @(Model.Dept == "Marketing" ? "selected" : "")>Marketing</option>
                                    <option value="Sales" @(Model.Dept == "Sales" ? "selected" : "")>Sales</option>
                                    <option value="Operations" @(Model.Dept == "Operations" ? "selected" : "")>Operations</option>
                                    @if (!new[] { "IT", "HR", "Finance", "Marketing", "Sales", "Operations" }.Contains(Model.Dept) && !string.IsNullOrWhiteSpace(Model.Dept))
                                    {
                                        <option value="@Model.Dept" selected>@Model.Dept</option>
                                    }
                                </select>
                            </div>
                            @Html.ValidationMessageFor(model => model.Dept, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Salary -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.Salary, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-muted">&#8377;</span>
                                <input type="number" 
                                       name="Salary" 
                                       id="Salary" 
                                       class="form-control" 
                                       value="@Model.Salary" 
                                       min="1" 
                                       step="1" 
                                       placeholder="e.g. 50000" 
                                       required />
                            </div>
                            @Html.ValidationMessageFor(model => model.Salary, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Gender -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.Gender, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-gender-ambiguous text-muted"></i></span>
                                <select name="Gender" id="Gender" class="form-select" required>
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male" @(Model.Gender == "Male" ? "selected" : "")>Male</option>
                                    <option value="Female" @(Model.Gender == "Female" ? "selected" : "")>Female</option>
                                    <option value="Other" @(Model.Gender == "Other" ? "selected" : "")>Other</option>
                                </select>
                            </div>
                            @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.City, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-alt text-muted"></i></span>
                                @Html.EditorFor(model => model.City, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g. Mumbai, Delhi, Bangalore", required = "required" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Address ID Link -->
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Linked Address <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-fill text-muted"></i></span>
                                @if (addressList.Any())
                                {
                                    <select name="AddressId" id="AddressId" class="form-select" required>
                                        <option value="">-- Select Linked Address --</option>
                                        @foreach (var addr in addressList)
                                        {
                                            <option value="@addr.AddressId" 
                                                    data-city="@addr.City" 
                                                    data-state="@addr.State" 
                                                    @(Model.AddressId == addr.AddressId ? "selected" : "")>
                                                #@addr.AddressId - @addr.City, @addr.State (@addr.Country, @addr.Pin)
                                            </option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    @Html.EditorFor(model => model.AddressId, new { htmlAttributes = new { @class = "form-control", type = "number", placeholder = "Enter Address ID (e.g. 1)", required = "required" } })
                                }
                            </div>
                            <div id="addressMatchFeedback" class="small mt-1" style="display:none;"></div>
                            @Html.ValidationMessageFor(model => model.AddressId, "", new { @class = "text-danger small mt-1 d-block" })
                            <span class="text-muted small">Select an address matching the employee's city.</span>
                        </div>
                    </div>

                    <hr class="my-4 text-muted" />

                    <!-- Form Buttons -->
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary-gradient px-4">
                            <i class="bi bi-check2-circle"></i> Save Changes
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Real-time City and Address correlation check
            function checkCityAddressMatch() {
                var cityInput = ($('#City').val() || '').trim();
                var selectedOption = $('#AddressId').find('option:selected');
                var addressId = selectedOption.val();
                var feedbackDiv = $('#addressMatchFeedback');

                if (!cityInput || !addressId) {
                    feedbackDiv.hide().text('').removeClass('text-danger text-success');
                    $('#AddressId, #City').removeClass('is-invalid is-valid');
                    return true;
                }

                var addrCity = (selectedOption.data('city') || '').toString().trim().toLowerCase();
                var addrState = (selectedOption.data('state') || '').toString().trim().toLowerCase();
                var empCity = cityInput.toLowerCase();

                var isMatch = false;

                // Exact equality or inclusion (e.g. "delhi" in "new delhi", or vice versa)
                if (empCity === addrCity || addrCity.indexOf(empCity) !== -1 || empCity.indexOf(addrCity) !== -1) {
                    isMatch = true;
                } else if (addrState.indexOf(empCity) !== -1 || empCity.indexOf(addrState) !== -1) {
                    isMatch = true;
                } else {
                    // Common Indian city name aliases
                    var aliases = [
                        ['bengaluru', 'bangalore'],
                        ['calcutta', 'kolkata'],
                        ['bombay', 'mumbai'],
                        ['madras', 'chennai']
                    ];
                    for (var i = 0; i < aliases.length; i++) {
                        var a = aliases[i][0];
                        var b = aliases[i][1];
                        if ((empCity.indexOf(a) !== -1 && addrCity.indexOf(b) !== -1) ||
                            (empCity.indexOf(b) !== -1 && addrCity.indexOf(a) !== -1)) {
                            isMatch = true;
                            break;
                        }
                    }
                }

                if (isMatch) {
                    feedbackDiv.show()
                        .removeClass('text-danger')
                        .addClass('text-success')
                        .html('<i class="bi bi-check-circle-fill me-1"></i> Valid match: Address is located in <strong>' + (selectedOption.data('city') || 'selected city') + '</strong>.');
                    $('#AddressId, #City').removeClass('is-invalid').addClass('is-valid');
                    return true;
                } else {
                    feedbackDiv.show()
                        .removeClass('text-success')
                        .addClass('text-danger')
                        .html('<i class="bi bi-x-circle-fill me-1"></i> <strong>Location mismatch:</strong> Address is located in <strong>' + (selectedOption.data('city') || 'different city') + '</strong>, but employee city is <strong>' + cityInput + '</strong>. Please select an address matching ' + cityInput + '.');
                    $('#AddressId, #City').removeClass('is-valid').addClass('is-invalid');
                    return false;
                }
            }

            // Trigger validation on input or change
            $('#City').on('input change blur', function () {
                checkCityAddressMatch();
            });

            $('#AddressId').on('change', function () {
                var selectedOption = $(this).find('option:selected');
                var optCity = selectedOption.data('city');
                if (optCity && !$('#City').val()) {
                    $('#City').val(optCity);
                }
                checkCityAddressMatch();
            });

            // Prevent form submit if city and address do not match
            $('form').on('submit', function (e) {
                if (!checkCityAddressMatch()) {
                    e.preventDefault();
                    $('#AddressId').focus();
                    return false;
                }
            });

            // Initial check on page load
            if ($('#City').val() && $('#AddressId').val()) {
                checkCityAddressMatch();
            }
        });
    </script>
}
