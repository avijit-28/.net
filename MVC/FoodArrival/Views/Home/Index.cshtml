@model IEnumerable<FoodArrival.Models.FoodItem>
@{
    ViewBag.Title = "FoodReady - Delicious Food Delivered to Your Doorstep";
    var categories = ViewBag.Categories as List<string> ?? new List<string> { "All items", "Pizza", "Burger", "Indian", "Chinese", "Drinks", "Snacks" };
    var featured = ViewBag.FeaturedItems as List<FoodArrival.Models.FoodItem> ?? Model.Take(8).ToList();
    var pizzas = ViewBag.PizzaItems as List<FoodArrival.Models.FoodItem> ?? Model.Where(x => x.Category == "Pizza").ToList();
    var burgers = ViewBag.BurgerItems as List<FoodArrival.Models.FoodItem> ?? Model.Where(x => x.Category == "Burger").ToList();
    var indian = ViewBag.IndianItems as List<FoodArrival.Models.FoodItem> ?? Model.Where(x => x.Category == "Indian").ToList();
    var notifications = ViewBag.Notifications as List<FoodArrival.Models.Notification> ?? new List<FoodArrival.Models.Notification>();
}

<!-- Hero Section (Faithfully matching uploaded template) -->
<section class="hero-banner-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left Hero Content -->
            <div class="col-lg-6">
                <h1 class="hero-title">
                    Delicious Food <br />
                    Delivered to <br />
                    <span class="orange">Your Doorstep</span>
                </h1>
                <p class="hero-subtitle">
                    Order your favorite meals from top restaurants and get it delivered fast, fresh, and safe.
                </p>

                <!-- Location Search Bar -->
                <form action="@Url.Action("Index", "Food")" method="get" class="location-search-box mb-4">
                    <i class="bi bi-geo-alt-fill text-danger fs-5 me-2"></i>
                    <input type="text" name="search" placeholder="Enter your delivery location" />
                    <button type="submit" class="btn btn-primary-food py-2 px-4 d-flex align-items-center gap-2">
                        <i class="bi bi-scooter fs-5"></i>
                        <span>Find Food</span>
                    </button>
                </form>

                <!-- 3 Highlights Badges -->
                <div class="d-flex flex-wrap gap-4 mt-4 pt-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background: #FFF0EB; color: #FF5E1E; width: 44px; height: 44px;">
                            <i class="bi bi-scooter fs-5"></i>
                        </div>
                        <span class="fw-bold text-dark">Fast Delivery</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background: #FFF7ED; color: #EA580C; width: 44px; height: 44px;">
                            <i class="bi bi-fire fs-5"></i>
                        </div>
                        <span class="fw-bold text-dark">Fresh & Tasty</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background: #E8F5E9; color: #2E7D32; width: 44px; height: 44px;">
                            <i class="bi bi-shield-check fs-5"></i>
                        </div>
                        <span class="fw-bold text-dark">Secure Ordering</span>
                    </div>
                </div>
            </div>

            <!-- Right Hero Graphic -->
            <div class="col-lg-6 hero-image-wrap">
                <img src="~/Content/images/hero-banner.jpg" alt="Delicious Food Delivery" class="img-fluid" onerror="this.src='https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800&q=80'" />
            </div>
        </div>
    </div>
</section>

<!-- 4 Roles Portals Showcase Section -->
<section class="py-5" style="background: #FFFFFF;">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-warning bg-opacity-25 text-dark fw-bold px-3 py-2 rounded-pill mb-2">4 Ecosystem Roles</span>
            <h2 class="fw-bold text-dark">One Platform, Seamless Experiences</h2>
            <p class="text-muted small">Choose your portal to experience FoodReady tailored for your journey</p>
        </div>

        <div class="row g-4">
            <!-- Role 1: Customer -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center transition-all" style="border-top: 4px solid #FF5E1E !important;">
                    <div class="stat-icon items mx-auto mb-3" style="width: 58px; height: 58px;">
                        <i class="bi bi-person-heart fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Customer</h5>
                    <p class="text-muted small mb-3">Browse multi-cuisine menu, place orders, make secure payments, and track food arrival.</p>
                    <a href="@Url.Action("Index", "Food")" class="btn btn-outline-food btn-sm rounded-pill w-100 mt-auto fw-bold">
                        Browse Menu <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Role 2: Restaurant -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center transition-all" style="border-top: 4px solid #EA580C !important;">
                    <div class="stat-icon pending mx-auto mb-3" style="width: 58px; height: 58px; background: #FFF7ED; color: #EA580C;">
                        <i class="bi bi-shop fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Restaurant</h5>
                    <p class="text-muted small mb-3">Receive incoming orders, control preparation time, set food readiness, and manage item prices.</p>
                    <a href="@Url.Action("Login", "Restaurant")" class="btn btn-sm btn-outline-danger rounded-pill w-100 mt-auto fw-bold">
                        Kitchen Portal <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Role 3: Rider -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center transition-all" style="border-top: 4px solid #0284C7 !important;">
                    <div class="stat-icon accepted mx-auto mb-3" style="width: 58px; height: 58px; background: #E0F2FE; color: #0284C7;">
                        <i class="bi bi-scooter fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Delivery Rider</h5>
                    <p class="text-muted small mb-3">Claim pickup orders, follow customer delivery addresses, update trip status, and deliver hot food.</p>
                    <a href="@Url.Action("Login", "Rider")" class="btn btn-sm btn-outline-primary rounded-pill w-100 mt-auto fw-bold">
                        Rider Hub <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Role 4: Admin -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center transition-all" style="border-top: 4px solid #1A202C !important;">
                    <div class="stat-icon rejected mx-auto mb-3" style="width: 58px; height: 58px; background: #F1F5F9; color: #1E293B;">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Master Admin</h5>
                    <p class="text-muted small mb-3">Complete oversight: auto-rejection rule (> 5 mins), review orders, edit catalog, and monitor real-time stats.</p>
                    <a href="@Url.Action("Login", "Admin")" class="btn btn-sm btn-outline-dark rounded-pill w-100 mt-auto fw-bold">
                        Admin Access <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Live Notification Alert Banner -->
@if (notifications != null && notifications.Any())
{
    var latest = notifications.First();
    <div class="container my-2">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-warning">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                        <i class="bi bi-bell-fill me-1"></i> Live Update
                    </span>
                    <div>
                        <strong class="text-dark">@latest.Title:</strong>
                        <span class="text-muted ms-1 small">@latest.Message</span>
                    </div>
                </div>
                <a href="@(latest.TargetUrl ?? Url.Action("Index", "Food"))" class="btn btn-outline-food btn-sm rounded-pill px-3 d-none d-md-inline-block">
                    View Details
                </a>
            </div>
        </div>
    </div>
}

<!-- Categories Quick Strip -->
<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">Explore Categories</h4>
            <a href="@Url.Action("Index", "Food")" class="text-primary fw-bold text-decoration-none small">
                See all <i class="bi bi-chevron-right"></i>
            </a>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var c in categories)
            {
                <a href="@Url.Action("Index", "Food", new { category = c })" class="btn btn-light border rounded-pill px-4 py-2 fw-bold text-dark d-flex align-items-center gap-2 category-chip">
                    @if (c == "Pizza")
                    {
                        <i class="bi bi-pie-chart text-danger"></i>
                    }
                    else if (c == "Burger")
                    {
                        <i class="bi bi-circle-fill text-warning fs-6"></i>
                    }
                    else if (c == "Indian")
                    {
                        <i class="bi bi-fire text-danger"></i>
                    }
                    else if (c == "Chinese")
                    {
                        <i class="bi bi-box2-heart text-primary"></i>
                    }
                    else if (c == "Drinks")
                    {
                        <i class="bi bi-cup-straw text-info"></i>
                    }
                    else
                    {
                        <i class="bi bi-collection text-secondary"></i>
                    }
                    <span>@c</span>
                </a>
            }
        </div>
    </div>
</section>

<!-- Featured Dishes with Proper Food Images -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-danger fw-bold small text-uppercase">Chef's Handcrafted Picks</span>
                <h2 class="fw-bold mb-0 text-dark">Most Loved Delicacies</h2>
            </div>
            <a href="@Url.Action("Index", "Food")" class="btn btn-outline-food rounded-pill px-4">
                Full Menu
            </a>
        </div>

        <div class="row g-4">
            @if (featured != null && featured.Any())
            {
                foreach (var item in featured)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="food-card" id="food-card-@item.FoodItemId">
                            <div class="food-card-img-wrap">
                                <img src="@item.ImageUrl" alt="@item.ItemName" onerror="this.src='/Content/images/margherita.jpg'" />
                                <span class="position-absolute top-0 end-0 m-2 badge bg-dark bg-opacity-75 rounded-pill px-3 py-1">
                                    @item.Category
                                </span>
                                <span class="position-absolute bottom-0 start-0 m-2 badge bg-warning text-dark rounded-pill px-2 py-1 small">
                                    <i class="bi bi-star-fill text-dark me-1"></i> 4.8 (120+)
                                </span>
                            </div>
                            <div class="food-card-body">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h5 class="food-card-title mb-0">@item.ItemName</h5>
                                </div>
                                <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @(string.IsNullOrEmpty(item.Description) ? "Prepared fresh to order using finest ingredients." : item.Description)
                                </p>
                                
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="food-card-price">₹@item.Price.ToString("F0")</span>
                                    <div class="qty-picker">
                                        <button type="button" class="qty-btn btn-qty-minus"><i class="bi bi-dash"></i></button>
                                        <input type="text" class="qty-input input-quantity" value="1" readonly />
                                        <button type="button" class="qty-btn btn-qty-plus"><i class="bi bi-plus"></i></button>
                                    </div>
                                </div>

                                <button class="btn btn-primary-food w-100 btn-add-to-cart" data-id="@item.FoodItemId">
                                    <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Pizza & Burger Showcase Sections -->
<section class="py-5 bg-white">
    <div class="container">
        <!-- Pizzas -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-3 py-1 rounded-pill mb-1">Authentic Crust</span>
                <h3 class="fw-bold mb-0">Pizzas Handcrafted With Love</h3>
            </div>
            <a href="@Url.Action("Index", "Food", new { category = "Pizza" })" class="btn btn-outline-food btn-sm rounded-pill px-3">
                View All Pizzas
            </a>
        </div>

        <div class="row g-4 mb-5">
            @foreach (var item in pizzas)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="food-card">
                        <div class="food-card-img-wrap">
                            <img src="@item.ImageUrl" alt="@item.ItemName" onerror="this.src='/Content/images/margherita.jpg'" />
                        </div>
                        <div class="food-card-body">
                            <h6 class="food-card-title">@item.ItemName</h6>
                            <p class="text-muted small mb-2 flex-grow-1">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <span class="food-card-price">₹@item.Price.ToString("F0")</span>
                                <button class="btn btn-primary-food btn-sm btn-add-to-cart px-3" data-id="@item.FoodItemId">
                                    <i class="bi bi-cart-plus me-1"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Burgers -->
        <div class="d-flex justify-content-between align-items-center mb-4 pt-3 border-top">
            <div>
                <span class="badge bg-warning bg-opacity-25 text-dark fw-bold px-3 py-1 rounded-pill mb-1">Flame Grilled</span>
                <h3 class="fw-bold mb-0">Gourmet Burgers & Crisp Fries</h3>
            </div>
            <a href="@Url.Action("Index", "Food", new { category = "Burger" })" class="btn btn-outline-food btn-sm rounded-pill px-3">
                View All Burgers
            </a>
        </div>

        <div class="row g-4">
            @foreach (var item in burgers)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="food-card">
                        <div class="food-card-img-wrap">
                            <img src="@item.ImageUrl" alt="@item.ItemName" onerror="this.src='/Content/images/veggie-burger.jpg'" />
                        </div>
                        <div class="food-card-body">
                            <h6 class="food-card-title">@item.ItemName</h6>
                            <p class="text-muted small mb-2 flex-grow-1">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <span class="food-card-price">₹@item.Price.ToString("F0")</span>
                                <button class="btn btn-primary-food btn-sm btn-add-to-cart px-3" data-id="@item.FoodItemId">
                                    <i class="bi bi-cart-plus me-1"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Mobile App Download & Live Tracking Promo -->
<section class="py-5" style="background: linear-gradient(135deg, #FF7A18 0%, #FF5E1E 100%);">
    <div class="container text-white py-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-white text-dark rounded-pill px-3 py-1 fw-bold mb-3">Fast & Reliable</span>
                <h2 class="display-6 fw-bold mb-3">Track Your Order Live In Real Time</h2>
                <p class="lead text-white-50 mb-4">
                    From the restaurant kitchen straight to your hands. Receive instant push notifications as your food is prepared and dispatched with our delivery rider.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="@Url.Action("History", "Order")" class="btn btn-light rounded-pill px-4 py-2 fw-bold text-dark shadow">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Track Live Orders
                    </a>
                    <a href="@Url.Action("Index", "Food")" class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold">
                        <i class="bi bi-bag-heart me-1"></i> Order Now
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <i class="bi bi-phone display-1 text-white opacity-75"></i>
            </div>
        </div>
    </div>
</section>
