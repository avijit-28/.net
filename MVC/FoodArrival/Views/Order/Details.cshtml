@model FoodArrival.Models.Order
@{
    ViewBag.Title = "Order #FD" + (1000 + Model.OrderId) + " Details - FoodReady";
    string badgeClass = "status-pending";
    if (Model.OrderStatus == "Accepted") { badgeClass = "status-accepted"; }
    else if (Model.OrderStatus == "Rejected") { badgeClass = "status-rejected"; }
}

<div class="container py-4">
    <div class="mb-3">
        <a href="@Url.Action("History", "Order")" class="text-decoration-none text-muted small fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Back to Order History
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-4 mb-4 gap-3">
            <div>
                <span class="badge bg-light text-muted border mb-1">Receipt</span>
                <h2 class="fw-bold text-dark mb-1">Order #FD@(1000 + Model.OrderId)</h2>
                <p class="text-muted small mb-0">
                    Placed on: <strong>@Model.OrderedAt.ToString("dd MMMM yyyy, hh:mm tt")</strong>
                </p>
            </div>
            <div class="text-md-end">
                <span class="status-badge @badgeClass fs-6 px-3 py-2">
                    @if (Model.OrderStatus == "Accepted")
                    {
                        <i class="bi bi-check-circle-fill"></i>
                    }
                    else if (Model.OrderStatus == "Rejected")
                    {
                        <i class="bi bi-x-circle-fill"></i>
                    }
                    else
                    {
                        <i class="bi bi-clock-fill"></i>
                    }
                    @Model.OrderStatus
                </span>
                @if (Model.ProcessedAt.HasValue)
                {
                    <div class="text-muted small mt-1">Processed: @Model.ProcessedAt.Value.ToString("hh:mm tt")</div>
                }
            </div>
        </div>

        @if (Model.OrderStatus == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="alert alert-danger d-flex align-items-center mb-4 rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>
                    <strong>Rejection Notice:</strong> @Model.RejectionReason
                </div>
            </div>
        }

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <h6 class="fw-bold text-muted small text-uppercase">Customer Information</h6>
                <p class="mb-1 fw-bold text-dark">@Model.CustomerName</p>
                <p class="mb-1 text-muted small"><i class="bi bi-envelope me-1"></i> @Model.Email</p>
                <p class="mb-0 text-muted small"><i class="bi bi-telephone me-1"></i> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold text-muted small text-uppercase">Delivery Destination</h6>
                <p class="mb-0 text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @(string.IsNullOrEmpty(Model.Address) ? "Default customer address" : Model.Address)</p>
            </div>
        </div>

        <h5 class="fw-bold mb-3">Order Items</h5>
        <div class="table-responsive mb-4">
            <table class="table align-middle">
                <thead class="bg-light">
                    <tr>
                        <th>Item</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.ItemName</td>
                                <td class="text-center">x @item.Quantity</td>
                                <td class="text-end text-muted">₹@item.UnitPrice.ToString("F2")</td>
                                <td class="text-end fw-bold text-dark">₹@item.SubTotal.ToString("F2")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold border-top-0 pt-3">Total Amount:</td>
                        <td class="text-end fw-bold fs-5 text-danger border-top-0 pt-3">₹@Model.TotalAmount.ToString("F2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <a href="@Url.Action("History", "Order")" class="btn btn-outline-food btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to History
            </a>
            <button onclick="window.print()" class="btn btn-light btn-sm border">
                <i class="bi bi-printer me-1"></i> Print Receipt
            </button>
        </div>
    </div>
</div>
