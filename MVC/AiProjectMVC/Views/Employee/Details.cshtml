@model AiProjectMVC.Models.Employee

@{
    ViewBag.Title = "Employee Details";
    var initials = !string.IsNullOrWhiteSpace(Model.Name) ? Model.Name.Substring(0, 1).ToUpper() : "?";
    var deptLower = (Model.Dept ?? "").ToLower();
    var deptClass = deptLower.Contains("it") ? "badge-dept-it" :
                    deptLower.Contains("hr") ? "badge-dept-hr" :
                    deptLower.Contains("sale") ? "badge-dept-sales" :
                    deptLower.Contains("fin") ? "badge-dept-finance" :
                    deptLower.Contains("market") ? "badge-dept-marketing" : "badge-dept-default";

    var genderLower = (Model.Gender ?? "").ToLower();
    var genderClass = genderLower.StartsWith("m") ? "badge-gender-male" :
                      genderLower.StartsWith("f") ? "badge-gender-female" : "badge-gender-other";
    var genderIcon = genderLower.StartsWith("m") ? "bi-gender-male" :
                     genderLower.StartsWith("f") ? "bi-gender-female" : "bi-gender-ambiguous";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Back Breadcrumb Link -->
        <div class="mb-3">
            <a href="@Url.Action("Index")" class="text-decoration-none text-muted small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Employee Directory
            </a>
        </div>

        <div class="custom-card">
            <!-- Profile Banner Header -->
            <div class="p-4" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); color: white; border-top-left-radius: var(--radius-lg); border-top-right-radius: var(--radius-lg);">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div style="width: 68px; height: 68px; border-radius: 18px; background: rgba(255,255,255,0.2); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; border: 2px solid rgba(255,255,255,0.3);">
                        @initials
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">@Model.Name</h3>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-white bg-opacity-25 text-white px-2 py-1">
                                <i class="bi bi-hash"></i> ID: @Model.ID
                            </span>
                            <span class="badge-pill @deptClass">
                                <i class="bi bi-briefcase"></i> @Model.Dept
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Details Body -->
            <div class="custom-card-body">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-lines-fill text-primary me-2"></i> Information Overview</h5>
                
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">
                                <i class="bi bi-hash text-primary me-1"></i> Employee ID
                            </div>
                            <div class="fs-5 fw-bold text-dark">#@Model.ID</div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">
                                <i class="bi bi-person text-primary me-1"></i> Full Name
                            </div>
                            <div class="fs-5 fw-bold text-dark">@Model.Name</div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">
                                <i class="bi bi-building text-primary me-1"></i> Department
                            </div>
                            <div class="fs-5 fw-bold text-dark">
                                <span class="badge-pill @deptClass">@Model.Dept</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">
                                <i class="bi bi-cash text-primary me-1"></i> Salary
                            </div>
                            <div class="fs-5 fw-bold text-success">₹@Model.Salary.ToString("N0")</div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">
                                <i class="bi @genderIcon text-primary me-1"></i> Gender
                            </div>
                            <div class="fs-5 fw-bold text-dark">
                                <span class="badge-pill @genderClass">@Model.Gender</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">
                                <i class="bi bi-geo-alt text-primary me-1"></i> Location / City
                            </div>
                            <div class="fs-5 fw-bold text-dark">@Model.City</div>
                        </div>
                    </div>
                </div>

                <hr class="my-4 text-muted" />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Directory
                    </a>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Delete", new { id = Model.ID })" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                        <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-primary-gradient px-4">
                            <i class="bi bi-pencil-square"></i> Edit Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
