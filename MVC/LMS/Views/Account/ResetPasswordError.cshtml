@{
    ViewBag.Title = "Password Reset Link Status";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom p-4 p-md-5 text-center shadow-lg border-0" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25) !important; border-radius: 20px; backdrop-filter: blur(16px); color: #FFFFFF;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3 shadow-sm" style="background: rgba(239, 68, 68, 0.15); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.3);">
                <i class="bi bi-shield-x display-4"></i>
            </div>
            
            <h3 class="fw-extrabold text-white tracking-tight mb-2">Reset Link Unavailable</h3>
            <p class="small mb-4" style="color: #94A3B8; line-height: 1.7;">
                @(ViewBag.ErrorMessage ?? "The password reset request is either invalid, pending admin approval, or has expired.")
            </p>

            <div class="d-grid gap-2">
                <a href="@Url.Action("ForgotPassword", "Account")" class="btn btn-primary py-2 rounded-pill fw-bold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important;">
                    <i class="bi bi-arrow-repeat me-1"></i> Submit New Reset Request
                </a>
                <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light py-2 rounded-pill fw-semibold" style="border-color: rgba(255, 255, 255, 0.25);">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>
