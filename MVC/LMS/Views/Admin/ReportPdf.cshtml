@model LMS.ViewModels.AdminDashboardViewModel
@{
    Layout = null;
    var completionRate = Model.TotalEnrollments > 0 ? (int)((double)Model.TotalCertificates / Model.TotalEnrollments * 100) : 0;
    var adminShare = Model.TotalRevenue * 0.05m;
    var teacherShare = Model.TotalRevenue * 0.95m;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Platform Operational Executive Report</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; background: #ffffff; color: #1e293b; padding: 25px; font-size: 13px; line-height: 1.5; }
        .header { border-bottom: 2px solid #4f46e5; padding-bottom: 15px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-end; }
        .logo-title { font-size: 22px; font-weight: 800; color: #1e1b4b; }
        .logo-title span { color: #4f46e5; }
        .doc-title { font-size: 15px; font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: 1px; }
        .meta-table { width: 100%; margin-bottom: 20px; }
        .meta-table td { padding: 4px 0; font-size: 12px; }
        .kpi-grid { width: 100%; border-collapse: separate; border-spacing: 10px; margin-bottom: 25px; }
        .kpi-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px 15px; text-align: left; }
        .kpi-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: #64748b; font-weight: bold; }
        .kpi-value { font-size: 20px; font-weight: 800; color: #0f172a; margin-top: 4px; }
        .section-title { font-size: 14px; font-weight: 700; color: #1e293b; margin: 20px 0 10px 0; border-bottom: 1px solid #cbd5e1; padding-bottom: 5px; }
        table.data-table { width: 100%; border-collapse: collapse; margin-bottom: 25px; }
        table.data-table th { background: #f1f5f9; color: #334155; font-weight: 700; text-align: left; padding: 8px 10px; border: 1px solid #cbd5e1; font-size: 11px; text-transform: uppercase; }
        table.data-table td { padding: 8px 10px; border: 1px solid #e2e8f0; font-size: 12px; }
        .text-right { text-align: right; }
        .footer { border-top: 1px solid #e2e8f0; padding-top: 15px; margin-top: 30px; font-size: 11px; color: #64748b; text-align: center; }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <div class="logo-title">Edu<span>Platform</span> LMS</div>
            <div class="doc-title">Platform Operational Executive Telemetry</div>
        </div>
        <div style="text-align: right; font-size: 11px; color: #64748b;">
            Generated: @DateTime.UtcNow.ToString("dd MMM yyyy, HH:mm") UTC<br />
            Confidential Governance Document
        </div>
    </div>

    <!-- Executive Metrics Grid -->
    <table class="kpi-grid">
        <tr>
            <td style="width: 25%;">
                <div class="kpi-card" style="border-left: 4px solid #4f46e5;">
                    <div class="kpi-label">Platform Gross Sales</div>
                    <div class="kpi-value">&#8377;@Model.TotalRevenue.ToString("N2")</div>
                </div>
            </td>
            <td style="width: 25%;">
                <div class="kpi-card" style="border-left: 4px solid #10b981;">
                    <div class="kpi-label">Faculty Payouts (95%)</div>
                    <div class="kpi-value">&#8377;@teacherShare.ToString("N2")</div>
                </div>
            </td>
            <td style="width: 25%;">
                <div class="kpi-card" style="border-left: 4px solid #f59e0b;">
                    <div class="kpi-label">Admin Commission (5%)</div>
                    <div class="kpi-value">&#8377;@adminShare.ToString("N2")</div>
                </div>
            </td>
            <td style="width: 25%;">
                <div class="kpi-card" style="border-left: 4px solid #06b6d4;">
                    <div class="kpi-label">Completion Velocity</div>
                    <div class="kpi-value">@completionRate%</div>
                </div>
            </td>
        </tr>
    </table>

    <table class="kpi-grid">
        <tr>
            <td style="width: 25%;">
                <div class="kpi-card">
                    <div class="kpi-label">Registered Learners</div>
                    <div class="kpi-value">@Model.TotalStudents</div>
                </div>
            </td>
            <td style="width: 25%;">
                <div class="kpi-card">
                    <div class="kpi-label">Verified Instructors</div>
                    <div class="kpi-value">@Model.TotalInstructors</div>
                </div>
            </td>
            <td style="width: 25%;">
                <div class="kpi-card">
                    <div class="kpi-label">Active Tracks</div>
                    <div class="kpi-value">@Model.PublishedCourses / @Model.TotalCourses</div>
                </div>
            </td>
            <td style="width: 25%;">
                <div class="kpi-card">
                    <div class="kpi-label">Certificates Issued</div>
                    <div class="kpi-value">@Model.TotalCertificates</div>
                </div>
            </td>
        </tr>
    </table>

    <!-- Domain Distribution Section -->
    <div class="section-title">Academic Domain Distribution &amp; Curriculum Share</div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Category Domain</th>
                <th class="text-right">Course Volume</th>
                <th class="text-right">Catalog Share</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.CategoryStats != null && Model.CategoryStats.Any())
            {
                foreach (var cat in Model.CategoryStats)
                {
                    var pct = Model.TotalCourses > 0 ? (int)((double)cat.CourseCount / Model.TotalCourses * 100) : 0;
                    <tr>
                        <td><strong>@cat.CategoryName</strong></td>
                        <td class="text-right">@cat.CourseCount</td>
                        <td class="text-right">@pct%</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="3" style="text-align: center;">No categories recorded.</td></tr>
            }
        </tbody>
    </table>

    <div class="footer">
        EduPlatform LMS Enterprise Telemetry &bull; Local SQL Server &bull; ASP.NET MVC 5 Entity Framework 6 &bull; Page 1 of 1
    </div>
</body>
</html>
