@model LMS.ViewModels.AnnouncementFormViewModel
@{
    ViewBag.Title = "Post Announcement";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")" class="text-decoration-none">Admin</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Announcements", "Admin")" class="text-decoration-none">Announcements</a></li>
                <li class="breadcrumb-item active" aria-current="page">Post Broadcast</li>
            </ol>
        </nav>

        <div class="card card-custom p-4 p-md-5 shadow-sm bg-white card-gradient-top border-0">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center shadow-xs" style="width: 50px; height: 50px;">
                    <i class="bi bi-megaphone-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-extrabold mb-0 tracking-tight">Post System Announcement</h3>
                    <p class="text-muted small mb-0">Publish platform announcements, system updates, and maintenance advisories</p>
                </div>
            </div>

            @using (Html.BeginForm("CreateAnnouncement", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, "Announcement Headline", new { @class = "form-label fw-bold small text-dark" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Scheduled Infrastructure Maintenance & Upgrades" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Message, "Broadcast Message & Instructions", new { @class = "form-label fw-bold small text-dark" })
                    @Html.TextAreaFor(m => m.Message, new { @class = "form-control", rows = 6, placeholder = "Detail the purpose, schedule, expected impact, and any necessary actions required by learners or educators..." })
                    @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger small" })
                </div>

                <div class="p-3 bg-light rounded-3 border mb-4">
                    <div class="form-check form-switch mb-0">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", @checked = "checked" })
                        @Html.LabelFor(m => m.IsActive, "Publish immediately across platform feeds", new { @class = "form-check-label fw-semibold small text-dark" })
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="@Url.Action("Announcements", "Admin")" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                        <i class="bi bi-broadcast me-1"></i> Post Announcement
                    </button>
                </div>
            }
        </div>
    </div>
</div>
