@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-flex align-items-center m-0" }))
    {
        @Html.AntiForgeryToken()
        <ul class="navbar-nav align-items-center gap-2">
            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="badge badge-primary-subtle text-decoration-none px-3 py-2 rounded-pill fw-semibold" href="@Url.Action("Index", "Admin")">
                        <i class="bi bi-shield-lock-fill text-danger me-1"></i> Admin Console
                    </a>
                </li>
            }
            else if (User.IsInRole("Instructor"))
            {
                <li class="nav-item">
                    <a class="badge badge-info-subtle text-decoration-none px-3 py-2 rounded-pill fw-semibold" href="@Url.Action("Index", "Instructor")">
                        <i class="bi bi-mortarboard-fill text-info me-1"></i> Instructor Studio
                    </a>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="badge badge-primary-subtle text-decoration-none px-3 py-2 rounded-pill fw-semibold" href="@Url.Action("Index", "Student")">
                        <i class="bi bi-speedometer2 text-primary me-1"></i> Student Portal
                    </a>
                </li>
            }

            <li class="nav-item">
                <a class="nav-link position-relative p-2 text-dark rounded-circle" href="@Url.Action("Index", "Notifications")" title="Notifications">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="position-absolute top-1 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="width: 8px; height: 8px;">
                        <span class="visually-hidden">New alerts</span>
                    </span>
                </a>
            </li>

            <li class="nav-item dropdown ms-1">
                <a class="nav-link dropdown-toggle text-dark fw-bold d-flex align-items-center gap-2 p-1 pe-2 rounded-pill border bg-light shadow-sm" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center fw-bold shadow-sm" style="width: 32px; height: 32px; font-size: 13px;">
                        @(string.IsNullOrEmpty(User.Identity.GetUserName()) ? "U" : User.Identity.GetUserName().Substring(0, 1).ToUpper())
                    </span>
                    <span class="d-none d-md-inline small text-truncate" style="max-width: 130px;">@(User.Identity.GetUserName() ?? "User")</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2" aria-labelledby="userMenu">
                    <li class="px-3 py-2 border-bottom bg-light">
                        <div class="fw-bold small text-dark">@User.Identity.GetUserName()</div>
                        <span class="badge bg-secondary-subtle text-secondary small" style="font-size: 10px;">
                            @(User.IsInRole("Admin") ? "System Administrator" : (User.IsInRole("Instructor") ? "Verified Instructor" : "Student"))
                        </span>
                    </li>
                    <li><a class="dropdown-item py-2" href="@Url.Action("Profile", "Account")"><i class="bi bi-person-gear me-2 text-primary"></i> Account Profile</a></li>
                    <li><a class="dropdown-item py-2" href="@Url.Action("ChangePassword", "Account")"><i class="bi bi-shield-key me-2 text-warning"></i> Change Password</a></li>
                    @if (User.IsInRole("Student"))
                    {
                        <li><a class="dropdown-item py-2" href="@Url.Action("Certificates", "Student")"><i class="bi bi-award me-2 text-warning"></i> My Certificates</a></li>
                    }
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <button type="submit" class="dropdown-item py-2 text-danger fw-semibold">
                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                        </button>
                    </li>
                </ul>
            </li>
        </ul>
    }
}
else
{
    <ul class="navbar-nav align-items-center gap-2">
        <li class="nav-item">
            <a class="nav-link fw-semibold px-3" href="@Url.Action("Login", "Account")">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary px-3 rounded-pill fw-semibold shadow-sm" href="@Url.Action("Register", "Account")">
                <i class="bi bi-rocket-takeoff-fill me-1"></i> Get Started
            </a>
        </li>
    </ul>
}
