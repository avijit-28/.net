<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
-->
<configuration>

	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
	</appSettings>

	<connectionStrings>
		<add name="DBConn"
			 connectionString="Data Source=.;Initial Catalog=Assignmet;User ID=sa;Password=mcc#1234;"
			 providerName="System.Data.SqlClient" />

		<add name="AssignmetConnectionString"
			 connectionString="Data Source=.;Initial Catalog=Assignmet;Persist Security Info=True;User ID=sa;Password=mcc#1234;Encrypt=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>

		<sessionState mode="InProc" timeout="1" />

		<compilation debug="true" targetFramework="4.8.1" />

		<httpRuntime targetFramework="4.8.1"
					 relaxedUrlToFileSystemMapping="true" />

		<webServices>
			<protocols>
				<add name="HttpGet" />
				<add name="HttpPost" />
				<add name="HttpSoap" />
			</protocols>
		</webServices>

	</system.web>

	<system.webServer>

		<defaultDocument enabled="true">
			<files>
				<clear />
				<add value="Default.aspx" />
			</files>
		</defaultDocument>

		<modules runAllManagedModulesForAllRequests="true">
			<remove name="UrlRoutingModule-4.0" />
			<add name="UrlRoutingModule-4.0"
				 type="System.Web.Routing.UrlRoutingModule"
				 preCondition="" />
		</modules>

		<validation validateIntegratedModeConfiguration="false" />

	</system.webServer>

	<system.codedom>

		<compilers>
			<compiler language="c#;cs;csharp"
					  extension=".cs"
					  type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
					  warningLevel="4"
					  compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
		</compilers>

	</system.codedom>

	<!-- Web Service Configuration -->
	<system.serviceModel>
		<bindings>
			<basicHttpBinding>
				<binding name="WebService1Soap" />
			</basicHttpBinding>
		</bindings>

		<client>
			<endpoint
			  address="http://localhost:23793/WebService1.asmx"
			  binding="basicHttpBinding"
			  bindingConfiguration="WebService1Soap"
			  contract="ServiceReference1.WebService1Soap"
			  name="WebService1Soap" />
		</client>
	</system.serviceModel>

</configuration>