@model IEnumerable<FoodArrival.Models.FoodItem>
@{
    ViewBag.Title = "Home - Delicious Food Delivered";
}

<!-- Hero Banner Section -->
<section class="hero-banner-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge bg-warning bg-opacity-25 text-dark fw-bold px-3 py-2 rounded-pill mb-3">
                    <i class="bi bi-fire text-danger me-1"></i> Hot & Fresh Delivery
                </span>
                <h1 class="hero-title">
                    Delicious Food <br />
                    Delivered to <br />
                    <span class="orange">Your Doorstep</span>
                </h1>
                <p class="hero-subtitle">
                    Order your favorite meals from top restaurants and get it delivered fast, fresh, and safe.
                </p>

                <!-- Location Search Bar -->
                <form action="@Url.Action("Index", "Food")" method="get" class="location-search-box mb-4">
                    <i class="bi bi-geo-alt-fill text-danger fs-5 me-2"></i>
                    <input type="text" name="search" placeholder="Enter your delivery location or favorite food..." />
                    <button type="submit" class="btn btn-primary-food py-2 px-4 d-flex align-items-center gap-2">
                        <i class="bi bi-bicycle"></i>
                        <span>Find Food</span>
                    </button>
                </form>

                <!-- Feature Highlights -->
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <div class="hero-badge-pill">
                        <i class="bi bi-bicycle text-warning fs-5"></i>
                        <span>Fast Delivery</span>
                    </div>
                    <div class="hero-badge-pill">
                        <i class="bi bi-fire text-danger fs-5"></i>
                        <span>Fresh & Tasty</span>
                    </div>
                    <div class="hero-badge-pill">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>Secure Ordering</span>
                    </div>
                </div>
            </div>

            <!-- Right Hero Image -->
            <div class="col-lg-6 hero-image-wrap">
                <div class="position-relative">
                    <img src="~/Content/images/hero-banner.jpg" alt="Delicious Food" class="img-fluid shadow-lg" onerror="this.src='https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800&q=80'" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Popular Dishes Preview -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Our Top Picks</h2>
                <p class="text-muted mb-0">Discover the most loved dishes by our foodies</p>
            </div>
            <a href="@Url.Action("Index", "Food")" class="btn btn-outline-food d-flex align-items-center gap-2">
                <span>View Full Menu</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="food-card">
                            <div class="food-card-img-wrap">
                                <img src="@item.ImageUrl" alt="@item.ItemName" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&q=80'" />
                            </div>
                            <div class="food-card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="food-card-title mb-0">@item.ItemName</h5>
                                    <span class="badge bg-light text-muted border">@item.Category</span>
                                </div>
                                <p class="text-muted small mb-3 flex-grow-1">@(string.IsNullOrEmpty(item.Description) ? "Prepared fresh with finest ingredients" : item.Description)</p>
                                <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                    <span class="food-card-price">₹@item.Price.ToString("F0")</span>
                                    <button class="btn btn-primary-food btn-sm btn-add-to-cart px-3" data-id="@item.FoodItemId">
                                        <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="text-center max-w-600 mx-auto mb-5">
            <h2 class="fw-bold">How FoodReady Works</h2>
            <p class="text-muted">Fast, reliable food ordering in 3 simple steps</p>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light h-100">
                    <div class="stat-icon items mx-auto mb-3">
                        <i class="bi bi-search"></i>
                    </div>
                    <h5 class="fw-bold">1. Select Food</h5>
                    <p class="text-muted small mb-0">Browse through our categorized menu of pizzas, burgers, Chinese, and drinks.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light h-100">
                    <div class="stat-icon pending mx-auto mb-3">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <h5 class="fw-bold">2. Place Order</h5>
                    <p class="text-muted small mb-0">Confirm delivery address and place order securely. Order starts in Pending status.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light h-100">
                    <div class="stat-icon accepted mx-auto mb-3">
                        <i class="bi bi-bag-heart"></i>
                    </div>
                    <h5 class="fw-bold">3. Fast Delivery</h5>
                    <p class="text-muted small mb-0">Admin accepts your order and fresh hot food arrives right at your door!</p>
                </div>
            </div>
        </div>
    </div>
</section>
