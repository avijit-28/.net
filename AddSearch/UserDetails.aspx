<%@ Page Language="C#" AutoEventWireup="true"
    CodeBehind="UserDetails.aspx.cs"
    Inherits="AddSearch.UserDetails1" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>User Details CRUD</title>
</head>
<body>
    <form id="form1" runat="server">

        <asp:ObjectDataSource ID="ObjectDataSource1"
            runat="server"
            TypeName="AddSearch.UserDetailsAccessLayer"
            SelectMethod="GetAllUsers"
            InsertMethod="InsertUser"
            UpdateMethod="UpdateUser"
            DeleteMethod="DeleteUser">
        </asp:ObjectDataSource>

        <asp:GridView ID="GridView1"
            runat="server"
            AutoGenerateColumns="False"
            DataKeyNames="UserId"
            DataSourceID="ObjectDataSource1"
            AutoGenerateEditButton="True"
            AutoGenerateDeleteButton="True"
            ShowFooter="True"
            OnRowCommand="GridView1_RowCommand" Width="858px">

            <Columns>

                <asp:TemplateField HeaderText="User ID">
                    <ItemTemplate>
                          <%# Eval("UserId") %>
                    </ItemTemplate>
               <EditItemTemplate>
               <asp:TextBox ID="txtUserIdEdit"
                        runat="server"
                        Text='<%# Bind("UserId") %>' />
               </EditItemTemplate>

               <FooterTemplate>
               <asp:TextBox ID="txtUserId"
                        runat="server" />
                </FooterTemplate>
                </asp:TemplateField>


                <asp:TemplateField HeaderText="User Name">
                    <ItemTemplate>
                        <%# Eval("UserName") %>
                    </ItemTemplate>

                    <EditItemTemplate>
                        <asp:TextBox ID="txtUserNameEdit"
                            runat="server"
                            Text='<%# Bind("UserName") %>' />
                    </EditItemTemplate>

                    <FooterTemplate>
                        <asp:TextBox ID="txtUserName"
                            runat="server" />
                    </FooterTemplate>
                </asp:TemplateField>


                <asp:TemplateField HeaderText="Password">
                    <ItemTemplate>
                        <%# Eval("Password") %>
                    </ItemTemplate>

                    <EditItemTemplate>
                        <asp:TextBox ID="txtPasswordEdit"
                            runat="server"
                            Text='<%# Bind("Password") %>' />
                    </EditItemTemplate>

                    <FooterTemplate>
                        <asp:TextBox ID="txtPassword"
                            runat="server" />
                    </FooterTemplate>
                </asp:TemplateField>

                <asp:TemplateField HeaderText="Email">
                    <ItemTemplate>
                        <%# Eval("Email") %>
                    </ItemTemplate>

                    <EditItemTemplate>
                        <asp:TextBox ID="txtEmailEdit"
                            runat="server"
                            Text='<%# Bind("Email") %>' />
                    </EditItemTemplate>

                    <FooterTemplate>
                        <asp:TextBox ID="txtEmail"
                            runat="server" />
                    </FooterTemplate>
                </asp:TemplateField>

                <asp:TemplateField HeaderText="Mobile No">
                    <ItemTemplate>
                        <%# Eval("Mobile") %>
                    </ItemTemplate>

                    <EditItemTemplate>
                        <asp:TextBox ID="txtMobileNoEdit"
                            runat="server"
                            Text='<%# Bind("Mobile") %>' />
                    </EditItemTemplate>

                    <FooterTemplate>
                        <asp:TextBox ID="txtMobileNo"
                            runat="server" />
                    </FooterTemplate>
                </asp:TemplateField>

                <asp:TemplateField HeaderText="City">
                    <ItemTemplate>
                        <%# Eval("City") %>
                    </ItemTemplate>

                    <EditItemTemplate>
                        <asp:TextBox ID="txtCityEdit"
                            runat="server"
                            Text='<%# Bind("City") %>' />
                    </EditItemTemplate>

                    <FooterTemplate>
                        <asp:TextBox ID="txtCity"
                            runat="server" />
                    </FooterTemplate>
                </asp:TemplateField>

                <asp:TemplateField>
                    <FooterTemplate>
                        <asp:Button ID="btnAdd"
                            runat="server"
                            Text="Insert"
                            CommandName="AddNew" />
                    </FooterTemplate>
                </asp:TemplateField>

            </Columns>

        </asp:GridView>

    </form>
</body>
</html>