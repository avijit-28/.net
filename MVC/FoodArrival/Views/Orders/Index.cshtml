@model IList<FoodArrival.Models.OrderSummary>
@{
    ViewBag.Title = "Your orders";
}
<p class="eyebrow mb-1">From the kitchen to your door</p><h1 class="section-heading mb-4">Your orders</h1>
@if (!Model.Any())
{
    <div class="empty-state"><div class="fs-1 mb-2">🧾</div><h2 class="h5">No orders yet</h2><p class="text-muted">Your next great meal is just around the corner.</p><a class="btn btn-dark" href="@Url.Action("Index", "Restaurants")">Find a restaurant</a></div>
}
else
{
    <div class="surface-card p-3 p-md-4">
        @foreach (var order in Model)
        {
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3 border-bottom py-3">
                <div><div class="fw-bold">@order.RestaurantName</div><div class="small text-muted">@order.OrderNumber · @order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</div></div>
                <div class="d-flex align-items-center gap-3"><span class="status-pill">@order.OrderStatus</span><strong>₹@order.TotalAmount.ToString("0.00")</strong><a class="btn btn-outline-dark btn-sm" href="@Url.Action("Details", new { id = order.OrderId })">Details</a></div>
            </div>
        }
    </div>
}
