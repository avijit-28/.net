@{
    ViewBag.Title = "User Page";
    var currentRole = Session["UserRole"] as string ?? (User.Identity.IsAuthenticated ? "Authenticated" : "Guest");
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <!-- Breadcrumb navigation -->
        <div class="mb-3">
            <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted small fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Authorization Center
            </a>
        </div>

        <div class="custom-card shadow-sm border-0 overflow-hidden">
            <!-- Header -->
            <div class="p-4 bg-light border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 mb-2">
                        <i class="bi bi-person-fill-check me-1"></i> Role-Based Access &bull; [AuthorizeRole(Role.USER)]
                    </span>
                    <h3 class="fw-bold mb-1 text-dark">@ViewBag.Title</h3>
                    <p class="text-muted small mb-0">@ViewBag.Message</p>
                </div>
                <div class="d-none d-sm-block text-success fs-1">
                    <i class="bi bi-person-workspace"></i>
                </div>
            </div>

            <!-- Body -->
            <div class="custom-card-body p-4">
                <div class="alert alert-success d-flex align-items-center gap-3 p-3 rounded-3 mb-4">
                    <i class="bi bi-check-circle-fill fs-3 text-success flex-shrink-0"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">Access Granted to User Role!</h5>
                        <p class="mb-0 small text-success-emphasis">
                            Your account is verified with the <strong>USER</strong> role required to access this endpoint.
                            Users with solely <code>ADMIN</code> role who attempt to access this view are redirected to the Access Denied page.
                        </p>
                    </div>
                </div>

                <div class="card bg-light border-0 p-3 mb-4">
                    <h6 class="fw-bold text-dark small text-uppercase mb-2">
                        <i class="bi bi-shield-lock text-primary me-1"></i> Authorization Filter Code
                    </h6>
                    <pre class="bg-dark text-white p-3 rounded-3 small mb-0"><code>[AuthorizeRole(Role.USER)]
public ActionResult UserPage()
{
    ViewBag.Message = "User Page";
    return View();
}</code></pre>
                </div>

                <div class="card bg-light border-0 p-3 mb-4">
                    <h6 class="fw-bold text-dark small text-uppercase mb-2">
                        <i class="bi bi-person-circle text-primary me-1"></i> Active Session Information
                    </h6>
                    <div class="row g-2 small">
                        <div class="col-sm-4 text-muted">User Identity:</div>
                        <div class="col-sm-8 fw-semibold text-dark">@(User.Identity.IsAuthenticated ? User.Identity.Name : "Session User")</div>

                        <div class="col-sm-4 text-muted">Authorized Role:</div>
                        <div class="col-sm-8"><span class="badge bg-success">@currentRole</span></div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-2">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-house me-1"></i> Authorization Center
                    </a>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Contact", "Home")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-shield me-1"></i> Try Admin Contact (Role Test)
                        </a>
                        <a href="@Url.Action("About", "Home")" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-shield-fill me-1"></i> Try SuperAdmin About (Role Test)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
