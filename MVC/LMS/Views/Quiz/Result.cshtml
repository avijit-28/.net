@model LMS.ViewModels.QuizResultViewModel
@{
    ViewBag.Title = "Assessment Result: " + Model.QuizTitle;
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 p-md-5 shadow-sm text-center card-gradient-top">
            @if (Model.IsPassed)
            {
                <div class="rounded-circle bg-success-subtle text-success p-4 d-inline-flex mx-auto mb-3 shadow-sm">
                    <i class="bi bi-patch-check-fill display-3"></i>
                </div>
                <h3 class="fw-extrabold text-success mb-1">Assessment Passed!</h3>
                <p class="text-secondary small">Outstanding work! You demonstrated mastery of the module competencies.</p>
            }
            else
            {
                <div class="rounded-circle bg-danger-subtle text-danger p-4 d-inline-flex mx-auto mb-3 shadow-sm">
                    <i class="bi bi-exclamation-octagon-fill display-3"></i>
                </div>
                <h3 class="fw-extrabold text-danger mb-1">Assessment Needs Review</h3>
                <p class="text-secondary small">You did not meet the passing threshold. Revisit the video lessons and notes, then attempt again.</p>
            }

            <div class="p-4 bg-light rounded-3 my-4 border">
                <div class="row g-3">
                    <div class="col-6 border-end">
                        <div class="display-5 fw-extrabold @(Model.IsPassed ? "text-success" : "text-danger")">
                            @Model.Score%
                        </div>
                        <div class="small text-muted fw-bold text-uppercase" style="font-size: 11px;">Final Score</div>
                    </div>
                    <div class="col-6">
                        <div class="display-5 fw-extrabold text-dark">
                            @Model.ObtainedMarks <span class="fs-6 text-muted">/ @Model.TotalMarks</span>
                        </div>
                        <div class="small text-muted fw-bold text-uppercase" style="font-size: 11px;">Marks Earned</div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column gap-2">
                <a href="@Url.Action("Index", "Learning", new { courseId = Model.CourseId })" class="btn btn-primary rounded-pill py-3 fw-bold shadow-sm">
                    <i class="bi bi-play-circle-fill me-1"></i> Return to Classroom Player
                </a>
                <a href="@Url.Action("Quizzes", "Student")" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">
                    View Assessment History
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.IsPassed)
    {
        <script>
            $(function () {
                LMS.confetti({ particleCount: 90 });
            });
        </script>
    }
}
